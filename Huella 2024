Reemplaza con:
```python
NOMBRE_HOJA_GYP = "G&P"


def _cargar_hoja_existente(ruta_salida, nombre_hoja: str) -> pd.DataFrame:
    ruta = FsPath(str(ruta_salida))
    if not ruta.exists():
        return pd.DataFrame()
    try:
        return pd.read_excel(str(ruta), sheet_name=nombre_hoja, engine="openpyxl")
    except Exception:
        return pd.DataFrame()


def _fusionar_con_existente(nuevo: pd.DataFrame, ruta_salida, nombre_hoja: str) -> pd.DataFrame:
    """Mismo patrón anti-duplicados que BD: fusiona con lo ya guardado en
    el archivo de salida, purgando los cortes que se están reprocesando —
    correr el pipeline 2 veces para el mismo corte NO duplica filas."""
    nuevo = nuevo.copy() if nuevo is not None else pd.DataFrame()
    if not nuevo.empty and "Corte" in nuevo.columns:
        nuevo["Corte"] = nuevo["Corte"].astype(str)
    previo = _cargar_hoja_existente(ruta_salida, nombre_hoja)
    if not previo.empty and "Corte" in previo.columns and not nuevo.empty:
        cortes_nuevos = set(nuevo["Corte"].unique())
        previo = previo[~previo["Corte"].astype(str).isin(cortes_nuevos)]
    return pd.concat([previo, nuevo], ignore_index=True) if not previo.empty else nuevo


def _escribir_gyp(xw, gyp_nuevo: pd.DataFrame, ruta_salida) -> None:
    gyp = _fusionar_con_existente(gyp_nuevo, ruta_salida, NOMBRE_HOJA_GYP)
    if gyp.empty:
        pd.DataFrame({"Aviso": ["Sin datos"]}).to_excel(xw, sheet_name=NOMBRE_HOJA_GYP, index=False)
        return
    cols = ["Corte", "AFP", "Fondo", "Portafolio", "SBS", "ISIN", "Emisor",
            "Weight_Original_BD1S", "Patrimonio", "TC_USD"]
    for c in cols:
        if c not in gyp.columns:
            gyp[c] = ""
    gyp = gyp[cols].reset_index(drop=True)
    gyp = gyp.rename(columns={"Weight_Original_BD1S": "Weight_Original",
                               "Patrimonio": "AUM_Fondo"})
    n = len(gyp)
    filas = list(range(2, n + 2))
    gyp["Suma_Weight_Fondo"] = [
        f"=SUMIFS($H$2:$H${n+1},$A$2:$A${n+1},$A{r},$B$2:$B${n+1},$B{r},$C$2:$C${n+1},$C{r})"
        for r in filas]
    gyp["Weight_Renormalizado"] = [f"=IF(K{r}=0,0,H{r}/K{r})" for r in filas]
    gyp["VVL_PEN"] = [f"=L{r}*I{r}" for r in filas]
    gyp["Inv_MM_USD"] = [f'=IF(J{r}=0,"",M{r}/J{r}/1000000)' for r in filas]
    gyp["Weight_Verif"] = [f"=IF(I{r}=0,0,M{r}/I{r})" for r in filas]
    gyp.to_excel(xw, sheet_name=NOMBRE_HOJA_GYP, index=False)

    ws = xw.sheets[NOMBRE_HOJA_GYP]
    combos = gyp[["Corte", "AFP", "Fondo"]].drop_duplicates().reset_index(drop=True)
    col_r = 19
    ws.cell(row=1, column=col_r, value="Corte")
    ws.cell(row=1, column=col_r + 1, value="AFP")
    ws.cell(row=1, column=col_r + 2, value="Fondo")
    ws.cell(row=1, column=col_r + 3, value="Suma_Weight_Original")
    ws.cell(row=1, column=col_r + 4, value="Suma_Weight_Renormalizado")
    for k, row in combos.iterrows():
        fr = k + 2
        corte_esc = str(row["Corte"]).replace('"', '""')
        afp_esc = str(row["AFP"]).replace('"', '""')
        fondo_esc = str(row["Fondo"]).replace('"', '""')
        ws.cell(row=fr, column=col_r, value=row["Corte"])
        ws.cell(row=fr, column=col_r + 1, value=row["AFP"])
        ws.cell(row=fr, column=col_r + 2, value=row["Fondo"])
        f1 = (f'=SUMIFS($H$2:$H${n+1},$A$2:$A${n+1},"{corte_esc}",'
              f'$B$2:$B${n+1},"{afp_esc}",$C$2:$C${n+1},"{fondo_esc}")')
        f2 = (f'=SUMIFS($L$2:$L${n+1},$A$2:$A${n+1},"{corte_esc}",'
              f'$B$2:$B${n+1},"{afp_esc}",$C$2:$C${n+1},"{fondo_esc}")')
        c1 = ws.cell(row=fr, column=col_r + 3, value=f1)
        c2 = ws.cell(row=fr, column=col_r + 4, value=f2)
        c1.number_format = "0.00%"
        c2.number_format = "0.00%"


