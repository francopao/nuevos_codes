def copy_file_to_directory(source, des):
    # Crear el directorio de destino si no existe
    if not os.path.exists(des):
        os.makedirs(des)
    # Extraer el nombre del archivo de la ruta de origen
    file_name = os.path.basename(source)
    # Construir la ruta de destino completa
    dest_file = os.path.join(des, file_name)

    # Nuevo: si el archivo de destino del backup está bloqueado (abierto en
    # Excel), esperamos antes de intentar sobrescribirlo.
    esperar_archivo_libre(dest_file, intentos=3, espera_seg=5, avisar=True)

    try:
        # Copiar el archivo
        shutil.copyfile(source, dest_file)
        print(f"Archivo copiado exitosamente.")
    except PermissionError as e:
        print(f"⚠ No se pudo generar el backup porque el archivo está en uso: {dest_file}")
        print(f"  Detalle: {str(e)}")
        print("  Se continúa sin backup para esta corrida.")
    except Exception as e:
        print(f"Error al copiar el archivo: {str(e)}")

