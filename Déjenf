def _clave_sis(fondo_fecha: pd.Series) -> pd.Series:
    """Clave única por fila: 'HA-FONDO1|20260616' (AFP-Fondo + fecha de reporte)."""
    p = fondo_fecha.astype(str).str.strip().str.split("_", n=1, expand=True)
    if p.shape[1] < 2:
        return pd.Series(np.nan, index=fondo_fecha.index, dtype="object")
    f = pd.to_datetime(p[1], format="mixed", dayfirst=True, errors="coerce")
    return p[0] + "|" + f.dt.strftime("%Y%m%d")
```

