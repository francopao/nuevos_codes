```python
def imprimir_resumen_benchmarking(result_bd):
    """
    Imprimo en consola cuántos instrumentos quedaron con cobertura ESG (directa
    o vía proxy) vs sin cobertura, y el % de cobertura ponderado por Weight,
    agrupado por Fondo y Afp, más el total general.
    """
    total = len(result_bd)
    benchmarkeados = int((result_bd['Cobertura'] == 'Cov').sum())
    no_benchmarkeados = int((result_bd['Cobertura'] == 'NoCov').sum())

    print("\n=== Resumen de Benchmarking ===")
    print(f"Instrumentos con cobertura ESG (directa o vía proxy): {benchmarkeados} de {total}")
    print(f"Instrumentos SIN cobertura ESG: {no_benchmarkeados} de {total}")

    print("\n=== % de Cobertura ponderado por Weight (Fondo x Afp) ===")
    resumen_pct = (
        result_bd.groupby(['Fondo', 'Afp'])
        .apply(lambda g: (g.loc[g['Cobertura'] == 'Cov', 'Weight'].sum() / g['Weight'].sum() * 100)
        if g['Weight'].sum() else np.nan)
        .reset_index(name='Cobertura_%')
    )
    for _, fila in resumen_pct.iterrows():
        valor = fila['Cobertura_%']
        valor_txt = f"{valor:.2f}%" if pd.notna(valor) else "N/A"
        print(f"Fondo: {fila['Fondo']} | Afp: {fila['Afp']} -> Cobertura ponderada: {valor_txt}")

    peso_total = result_bd['Weight'].sum()
    cobertura_total = (result_bd.loc[result_bd['Cobertura'] == 'Cov', 'Weight'].sum() / peso_total * 100) if peso_total else np.nan
    cobertura_total_txt = f"{cobertura_total:.2f}%" if pd.notna(cobertura_total) else "N/A"
    print(f"\nCobertura ponderada TOTAL (todos los Fondos/Afp): {cobertura_total_txt}")
```

