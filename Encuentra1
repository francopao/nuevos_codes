**Bloque 4 — `aplicar_proxies_esg` (línea ~333)**

Reemplazo la función completa:

```python
def aplicar_proxies_esg(result_bd, ruta_proxies, periodo_manual=None):
    """
    Para los registros sin cobertura MSCI directa (RATING nulo, i.e. 'NoCov'),
    busco su proxy por código SBS (no por ISIN) en 'Reporte ASG Mensual', y
    completo los campos ESG con la información del proxy desde la hoja mensual
    'YYYYMM' correspondiente. No modifico los atributos propios del instrumento
    (ISIN, SBS, Cod. Originador, Fondo, Afp, Weight, Fecha, Nombre, etc.).
    Dejo registrado en la columna 'Proxie' el nombre del proxy usado, para que
    en el output se vea claramente cuándo se usó un proxy.
    """
    if 'SBS' not in result_bd.columns:
        raise KeyError("[ALERTA] La base consolidada no tiene columna 'SBS'; "
                       "no puedo hacer el benchmarking de proxies por SBS.")

    periodo = calcular_periodo_proxy(periodo_manual)
    mapa_proxy = cargar_mapa_proxies(ruta_proxies)
    esg_proxy_dict = cargar_esg_proxy(ruta_proxies, periodo)

    result_bd = result_bd.copy()
    sbs_norm = result_bd['SBS'].astype(str).str.strip().str.upper()

    sin_cobertura = result_bd['RATING'].isna()

    proxy_isin = pd.Series(np.nan, index=result_bd.index, dtype=object)
    proxy_isin.loc[sin_cobertura] = sbs_norm.loc[sin_cobertura].map(mapa_proxy)

    # --- Reviso qué tan bien matcheó el proxy (lo más sensible del proceso) ---
    sbs_con_proxy = int((sin_cobertura & proxy_isin.notna()).sum())
    sbs_sin_proxy = sorted(
        result_bd.loc[sin_cobertura & proxy_isin.isna(), 'SBS'].dropna().astype(str).unique().tolist()
    )
    print(f"\n[INFO] Periodo de proxies que uso: {periodo}")
    print(f"[INFO] Instrumentos sin cobertura directa que benchmarkeo vía proxy (match por SBS): {sbs_con_proxy}")
    if sbs_sin_proxy:
        print(f"[ALERTA] {len(sbs_sin_proxy)} instrumento(s) sin cobertura ESG NO tienen proxy definido "
              f"en 'Reporte ASG Mensual'. Códigos SBS que me faltan revisar/completar:\n{sbs_sin_proxy}")

    # Nombre del proxy usado (no su ISIN), solo en las filas donde sí hubo match.
    dic_nombre_proxy = esg_proxy_dict.get('Nombre', {})
    result_bd['Proxie'] = proxy_isin.map(dic_nombre_proxy)
    result_bd['Proxie'] = result_bd['Proxie'].where(proxy_isin.notna(), '')

    for columna, clave in MAPEO_PROXY_COLUMNAS:
        if columna not in result_bd.columns:
            continue
        diccionario_campo = esg_proxy_dict.get(clave, {})
        valores_proxy = proxy_isin.map(diccionario_campo)
        mascara = sin_cobertura & result_bd[columna].isna() & proxy_isin.notna()
        result_bd.loc[mascara, columna] = valores_proxy.loc[mascara]

    return result_bd
```

