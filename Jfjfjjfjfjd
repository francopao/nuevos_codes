# %% 2. LECTURA DE DATOS
def _txt(v):
    """Texto limpio de una celda; None si está vacía/NaN. Los enteros guardados como float se devuelven sin '.0'."""
    if v is None:
        return None
    if isinstance(v, float):
        if np.isnan(v):
            return None
        if v.is_integer():
            return str(int(v))
    s = str(v).strip()
    return s or None


def _num(v):
    """Celda -> float; texto, vacío, bool o error de Excel -> NaN."""
    if isinstance(v, bool) or v is None:
        return np.nan
    if isinstance(v, (int, float, np.number)):
        return float(v)
    return np.nan


def _celda(fila, j):
    """Valor de la columna j de una fila (None si la fila es más corta)."""
    return fila[j] if (fila is not None and j is not None and j < len(fila)) else None


def _lista(a, nd=4):
    """Array -> lista JSON: NaN/inf -> None, redondeo a nd decimales."""
    return [None if not np.isfinite(v) else round(float(v), nd) for v in a]


def leer_parametria(wb):
    """Hoja Parametría (B:G desde la fila 5) -> DataFrame por ticker con columnas z, basket, indice, bbg, sbs."""
    reg = []
    for f in wb["Parametría"].iter_rows(min_row=5, max_row=150, min_col=2, max_col=7, values_only=True):
        if _txt(f[0]) is None:
            continue
        reg.append(dict(ticker=_txt(f[0]), z=_txt(f[1]), basket=_txt(f[2]), indice=_txt(f[3]),
                        bbg=_txt(f[4]), sbs=_txt(f[5])))
    if not reg:
        raise ValueError("Parametría vacía o con layout distinto al esperado (B5:G).")
    df = pd.DataFrame(reg)
    if df["ticker"].duplicated().any():
        raise ValueError(f"Tickers duplicados en Parametría: {df.loc[df['ticker'].duplicated(), 'ticker'].tolist()}")
    return df.set_index("ticker")


def leer_bd(wb):
    """Hoja BD -> DataFrame (índice = Fecha sin hora, columnas = series Z), float. Valida fechas únicas y válidas."""
    it = wb["BD"].iter_rows(values_only=True)
    cab = [_txt(c) for c in next(it)]
    filas = [f for f in it if f and f[0] is not None]
    df = pd.DataFrame(filas)
    df = df.iloc[:, :len(cab)]
    df.columns = cab[:df.shape[1]]
    df = df.loc[:, [c for c in df.columns if c is not None]]
    if df.columns.duplicated().any():
        warnings.warn("BD tiene columnas duplicadas; se conserva la primera de cada una.")
        df = df.loc[:, ~df.columns.duplicated()]
    fechas = pd.to_datetime(df["Fecha"], errors="coerce")
    if fechas.isna().any():
        raise ValueError(f"BD tiene {int(fechas.isna().sum())} fechas no válidas en la columna A.")
    if fechas.duplicated().any():
        raise ValueError("BD tiene fechas duplicadas en la columna A.")
    df = df.drop(columns="Fecha").apply(lambda s: s.map(_num)).astype(float)
    df.index = fechas.dt.normalize()
    return df.sort_index()


def leer_baskets(wb):
    """Hoja Baskets -> {ticker BBG: [comparables]} (solo informativo, para el hover)."""
    out = {}
    for f in wb["Baskets"].iter_rows(min_row=1, max_row=80, max_col=19, values_only=True):
        if _txt(f[1]) is None or _txt(f[0]) is None:
            continue
        out.setdefault(_txt(f[1]), [c.replace(" Equity", "") for c in (_txt(x) for x in f[2:]) if c])
    return out


def leer_qest(ruta, codigos):
    """Posiciones desde DQ_IN de QEST_BD.xlsm usando las filas %Fondo (con respaldo PxQ/PAT si faltara %Fondo).

    Parámetros: ruta (xlsm), codigos ({ticker: código SBS}).
    Retorna: ({'fechas': [ISO], 'bps': {'CON'|'F1'|'F2'|'F3': {ticker: [pbs por fecha]}}}, avisos).
    Supuestos: cabecera con 'Fondo' en col. A y 'SBS' en la col. de claves; claves 'IN-FONDOx_%Fondo_dd/mm/aaaa';
    PAT de cada fondo = columna VALFON de la fila PxQ. %Fondo es fracción (0.0293 = 293 pbs).
    """
    wb = load_workbook(ruta, read_only=True, data_only=True)
    try:
        if "DQ_IN" not in wb.sheetnames:
            raise KeyError(f"QEST_BD no tiene hoja 'DQ_IN' (hojas: {wb.sheetnames}).")
        filas = list(wb["DQ_IN"].iter_rows(values_only=True))
    finally:
        wb.close()
    ih = next((i for i, f in enumerate(filas)
               if f and _txt(f[0]) == "Fondo" and "SBS" in [_txt(c) for c in f[:8]]), None)
    if ih is None:
        raise ValueError("DQ_IN (QEST_BD): no se encontró la fila de cabecera (Fondo ... SBS).")
    cab = [_txt(c) for c in filas[ih]]
    c_clave = cab.index("SBS")
    c_pat = cab.index("VALFON") if "VALFON" in cab else c_clave + 1
    col = {}
    for j, c in enumerate(cab):
        if c and j > c_clave:
            col.setdefault(c, j)
    patron = re.compile(r"^IN-FONDO([123])_(%Fondo|PxQ)_(\d{2})/(\d{2})/(\d{4})$")
    reg = {}
    for f in filas:
        k = _txt(_celda(f, c_clave))
        m = patron.match(k) if k else None
        if m:
            reg[(int(m.group(1)), m.group(2), pd.Timestamp(int(m.group(5)), int(m.group(4)), int(m.group(3))))] = f
    avisos, snaps = [], []
    for d in sorted({k[2] for k in reg}):
        if any((f, "PxQ", d) not in reg for f in (1, 2, 3)):
            avisos.append(f"QEST_BD {d:%d/%m/%Y}: faltan filas PxQ de algún fondo; fecha omitida.")
            continue
        aum = [_num(_celda(reg[(f, "PxQ", d)], c_pat)) for f in (1, 2, 3)]
        if not all(np.isfinite(a) and a > 0 for a in aum):
            avisos.append(f"QEST_BD {d:%d/%m/%Y}: PAT (VALFON) inválido en algún fondo; fecha omitida.")
            continue
        snaps.append((d, aum))
    if not snaps:
        raise ValueError("DQ_IN (QEST_BD) no tiene fechas completas (PxQ de los 3 fondos).")
    bps = {k: {} for k in ("CON", "F1", "F2", "F3")}
    for t, c in codigos.items():
        j = col.get(c) if c else None
        if j is None:
            avisos.append(f"{t}: código SBS {c} no está en DQ_IN de QEST_BD; sin posición.")
        for k in bps:
            bps[k][t] = []
        for d, aum in snaps:
            p = []
            for fi, f in enumerate((1, 2, 3)):
                if j is None:
                    p.append(0.0)
                    continue
                v = _num(_celda(reg.get((f, "%Fondo", d)), j))
                if not np.isfinite(v):                                   # respaldo: PxQ / PAT
                    x = _num(_celda(reg[(f, "PxQ", d)], j))
                    v = x / aum[fi] if np.isfinite(x) else 0.0
                p.append(max(v, 0.0))
            bps["CON"][t].append(round(sum(pi * ai for pi, ai in zip(p, aum)) / sum(aum) * 1e4, 2))
            for fi in range(3):
                bps["F%d" % (fi + 1)][t].append(round(p[fi] * 1e4, 2))
    return {"fechas": [d.strftime("%Y-%m-%d") for d, _ in snaps], "bps": bps}, avisos


def construir_series(bd, param, baskets):
    """Arma, por ticker del UNIVERSO, las series Z (a = vs historia, b = vs Basket, i = vs BVL) y su metadata.

    Retorna (Z, meta, avisos): Z[t] = {'a','b','i'} arrays alineados a bd.index (Z == 0 exacto se trata como faltante).
    """
    faltan = [t for t in UNIVERSO if t not in param.index]
    if faltan:
        raise KeyError(f"Tickers del UNIVERSO sin fila en Parametría: {faltan}")
    Z, meta, avisos = {}, {}, []

    def serie(c):
        if c is None or c not in bd.columns:
            return None
        a = bd[c].to_numpy(float).copy()
        a[a == 0] = np.nan
        return a

    for i, t in enumerate(UNIVERSO):
        p = param.loc[t]
        a = serie(p["z"])
        if a is None:
            raise KeyError(f"{t}: la columna Z '{p['z']}' no existe en BD.")
        b = serie(p["basket"])
        if b is None:
            avisos.append(f"{t}: columna Basket '{p['basket']}' no existe en BD; sin Y.")
            b = np.full(len(bd), np.nan)
        iz = serie(p["indice"]) if (t not in INDICES and (not REPLICAR_TOGGLE_MONITOR or i < N_FILAS_ESCALA_C)) else None
        Z[t] = {"a": a, "b": b, "i": iz}
        meta[t] = {"ref": t in REFERENCIA, "hasIdx": iz is not None,
                   "color": COLOR_ESPECIAL.get(t, COLOR_BURBUJA), "comps": baskets.get(p["bbg"], []) if p["bbg"] else []}
    return Z, meta, avisos


def leer_z_ventanas(ruta, fechas, Z):
    """Lee Z_ventanas.csv y conserva solo las series que reproducen BD con los pesos del motor.

    Retorna ({ticker: {'a'|'b'|'i': {'1Y': lista, ...}}} o None, avisos).
    """
    ruta = Path(ruta)
    if not ruta.exists():
        return None, [f"No existe {ruta.name}: pesos de Z fijos (los de BD)."]
    df = pd.read_csv(ruta)
    df.columns = [str(c).strip() for c in df.columns]
    req = ["Fecha", "Ticker", "Marco", "Z_1Y", "Z_3Y", "Z_5Y", "Z_10Y"]
    falt = [c for c in req if c not in df.columns]
    if falt:
        raise ValueError(f"{ruta.name}: faltan columnas {falt}.")
    df["Fecha"] = pd.to_datetime(df["Fecha"]).dt.normalize()
    marco = {"ABS": "a", "ABSOLUTO": "a", "BASKET": "b", "BVL": "i", "INDICE": "i"}
    df["Marco"] = df["Marco"].astype(str).str.strip().str.upper().map(marco)
    df["Ticker"] = df["Ticker"].astype(str).str.strip()
    df = df[df["Marco"].notna()]
    idx = pd.DatetimeIndex(fechas)
    out, avisos = {}, []
    for (t, fr), g in df.groupby(["Ticker", "Marco"]):
        if t not in Z or Z[t].get(fr) is None:
            continue
        g = g.drop_duplicates("Fecha").set_index("Fecha").reindex(idx)
        W = {k: pd.to_numeric(g["Z_" + k], errors="coerce").to_numpy(float) for k in PESOS_Z_MOTOR}
        rec = sum(PESOS_Z_MOTOR[k] * W[k] for k in PESOS_Z_MOTOR if PESOS_Z_MOTOR[k] > 0)
        ok = np.isfinite(rec) & np.isfinite(Z[t][fr])
        if ok.sum() < 30:
            avisos.append(f"Z_ventanas {t}/{fr}: sin traslape suficiente con BD; serie descartada.")
            continue
        ult = np.where(ok)[0][-250:]
        dif = float(np.abs(rec[ult] - Z[t][fr][ult]).max())
        if dif > TOL_Z_VENTANAS:
            avisos.append(f"Z_ventanas {t}/{fr}: no reproduce BD (dif. máx. {dif:.3f} > {TOL_Z_VENTANAS}); descartada.")
            continue
        out.setdefault(t, {})[fr] = {k: _lista(W[k]) for k in W}
    return (out or None), avisos


