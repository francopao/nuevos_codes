function readDraft(){
  if(!S.dirty) return Object.assign({},DEFW);
  const d={}; WIN.forEach(k=>{const v=parseFloat($('w'+k).value); d[k]=isFinite(v)?v:NaN;}); return d;
}
function showDefaultInputs(){ WIN.forEach(k=>{$('w'+k).value=DEFW[k].toFixed(2);}); }
function onWeightInput(){
  S.dirty=true;
  const d=readDraft(), tot=$('wTot'), msg=$('wMsg');
  const bad=WIN.some(k=>!isFinite(d[k])||d[k]<0||d[k]>100);
  const dec=WIN.some(k=>isFinite(d[k])&&Math.abs(d[k]*100-Math.round(d[k]*100))>1e-6);
  const cents=WIN.reduce((s,k)=>s+(isFinite(d[k])?Math.round(d[k]*100):0),0);
  tot.textContent='Σ = '+(cents/100).toFixed(2)+'%';
  if(bad||dec||cents!==10000){
    tot.className='tot bad'; msg.className='msg bad';
    msg.textContent=bad?'Cada peso debe ser un número entre 0 y 100.':(dec?'Máximo 2 decimales por peso.':
      (cents<10000?'Faltan '+((10000-cents)/100).toFixed(2)+'% para llegar a 100%.':'Sobran '+((cents-10000)/100).toFixed(2)+'% sobre 100%.'))+
      ' Se mantienen los últimos pesos válidos.';
    return;
  }
  tot.className='tot ok'; msg.className='msg'; msg.textContent='Pesos válidos (100.00%): el dashboard se actualizó en vivo.';
  S.W={}; WIN.forEach(k=>{S.W[k]=d[k];});
  S.def=WIN.every(k=>Math.abs(S.W[k]-DEFW[k])<1e-9);
  renderAll();
}
function normalizar(){
  const d=readDraft(), v=WIN.map(k=>(isFinite(d[k])&&d[k]>0)?d[k]:0), s=v.reduce((a,b)=>a+b,0);
  if(s<=0) return;
  const c=v.map(x=>Math.round(x/s*10000));
  c[c.indexOf(Math.max.apply(null,c))]+=10000-c.reduce((a,b)=>a+b,0);
  WIN.forEach((k,i)=>{$('w'+k).value=(c[i]/100).toFixed(2);});
  onWeightInput();
}
function resetWeights(){
