# %% 4. GENERACIÓN
def generar_dashboard():
    """Pipeline completo: lee ZODA y QEST_BD, arma los datos y escribe el HTML autónomo.

    Retorna la ruta del HTML. Lanza excepciones explícitas si falta un archivo, hoja, columna o fecha.
    """
    for r in (RUTA_ZODA, RUTA_QEST):
        if not Path(r).exists():
            raise FileNotFoundError(f"No se encontró: {r}")
    avisos = []
    print("Leyendo ZODA (BD, Parametría, Baskets)…")
    wb = load_workbook(RUTA_ZODA, read_only=True, data_only=True)
    try:
        faltan = [h for h in ("BD", "Parametría") if h not in wb.sheetnames]
        if faltan:
            raise KeyError(f"Faltan hojas en {Path(RUTA_ZODA).name}: {faltan}")
        param = leer_parametria(wb)
        bd = leer_bd(wb)
        baskets = leer_baskets(wb) if "Baskets" in wb.sheetnames else {}
    finally:
        wb.close()
    fechas = bd.index
    print(f"  BD: {len(fechas)} fechas ({fechas.min():%d/%m/%Y} a {fechas.max():%d/%m/%Y})")

    Z, meta, av = construir_series(bd, param, baskets)
    avisos += av

    print("Leyendo posiciones (QEST_BD · DQ_IN · %Fondo)…")
    pos, av = leer_qest(RUTA_QEST, {t: param.loc[t, "sbs"] for t in UNIVERSO})
    avisos += av
    print(f"  QEST_BD: cargas de posiciones al {', '.join(pd.Timestamp(d).strftime('%d/%m/%Y') for d in pos['fechas'])}")

    zw, av = leer_z_ventanas(RUTA_Z_VENTANAS, fechas, Z)
    avisos += av
    print("  Pesos de Z en vivo: " + ("ACTIVOS" if zw else "bloqueados (sin Z_ventanas.csv válido)"))

    fecha_ini = fechas.max() if str(FECHA_INICIAL).lower() == "ultima" else pd.Timestamp(FECHA_INICIAL)
    if fecha_ini not in fechas:
        previas = fechas[fechas <= fecha_ini]
        if len(previas) == 0:
            raise ValueError(f"FECHA_INICIAL {fecha_ini:%d/%m/%Y} es anterior a toda la BD.")
        avisos.append(f"FECHA_INICIAL {fecha_ini:%d/%m/%Y} no es día hábil de BD; se usó {previas.max():%d/%m/%Y}.")
        fecha_ini = previas.max()

    datos = {
        "fechas": [d.strftime("%Y-%m-%d") for d in fechas],
        "tickers": UNIVERSO,
        "meta": meta,
        "z": {t: {"a": _lista(Z[t]["a"]), "b": _lista(Z[t]["b"]),
                  "i": (_lista(Z[t]["i"]) if Z[t]["i"] is not None else None)} for t in UNIVERSO},
        "zw": zw,
        "pos": pos,
        "avisos": avisos,
        "cfg": {"modo_inicial": MODO_INICIAL, "fecha_inicial": fecha_ini.strftime("%Y-%m-%d"),
                "eje_x": list(EJE_X), "eje_y": list(EJE_Y), "z_extremo": Z_EXTREMO, "ref_ratio": REF_RATIO,
                "escala_c_partida": ESCALA_C_PARTIDA, "n_filas_escala_c": N_FILAS_ESCALA_C},
    }
    js = json.dumps(datos, ensure_ascii=False, separators=(",", ":"), allow_nan=False).replace("</", "<\\/")
    try:
        from plotly.offline import get_plotlyjs
        plotly_tag = "<script>" + get_plotlyjs() + "</script>"
    except Exception as exc:
        warnings.warn(f"No se pudo incrustar plotly.js ({exc}); se usará CDN (requiere internet).")
        plotly_tag = '<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>'
    html = PLANTILLA.replace("__DATOS__", js).replace("__PLOTLY__", plotly_tag)
    Path(CARPETA_SALIDA).mkdir(parents=True, exist_ok=True)
    ruta = Path(CARPETA_SALIDA) / f"Monitor_ZODA_Dashboard_{fechas.max():%Y%m%d}.html"
    ruta.write_text(html, encoding="utf-8")
    print(f"[OK] HTML: {ruta}")
    for a in avisos:
        print("  *", a)
    return ruta


# %% 5. EJECUCIÓN
if __name__ == "__main__":
    generar_dashboard()
