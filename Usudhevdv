        entradas = []
        base_url = "https://www2.osinergmin.gob.pe/publicacionesgrt/pdf/TarMercadoElectrico/"
        for anio, mes in periodos:
            mes_corto = MESES[mes]["corto_cap"]
            nombre_archivo = f"TyME - {mes_corto} {anio}.pdf"
            url = base_url + quote(nombre_archivo)
            periodo_str = f"{mes:02d}/{anio}"
            entradas.append((periodo_str, [(url, nombre_archivo)]))
        return entradas

    return generar


def descargar_archivo(url, nombre_archivo, carpeta_destino, incidencias, seccion, periodo, timeout=30):
    """Descarga un archivo y lo guarda en la carpeta de destino. Devuelve True si tuvo
    exito. Cualquier problema queda registrado en la lista de incidencias con el detalle
    necesario para repararlo."""

    nombre_saneado = sanear_nombre_archivo(nombre_archivo)
    if nombre_saneado != nombre_archivo:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": f"El nombre de archivo generado '{nombre_archivo}' contenia caracteres invalidos para Windows.",
            "accion": f"Se uso el nombre saneado '{nombre_saneado}'. Revisar el patron del nombre de archivo de la seccion.",
        })
        nombre_archivo = nombre_saneado

    if not os.path.isdir(carpeta_destino):
        try:
            os.makedirs(carpeta_destino, exist_ok=True)
        except PermissionError:
            incidencias.append({
                "seccion": seccion, "periodo": periodo, "url": url,
                "descripcion": f"No se pudo crear la ruta de destino '{carpeta_destino}' por falta de permisos.",
                "accion": "Verificar permisos de escritura sobre la carpeta de red o solicitar acceso.",
            })
            return False
        except OSError as error:
            incidencias.append({
                "seccion": seccion, "periodo": periodo, "url": url,
                "descripcion": f"La ruta de destino '{carpeta_destino}' no existe y no pudo crearse: {error}",
                "accion": "Confirmar que la unidad de red Z esta montada y que la ruta es correcta.",
            })
            return False

    ruta_completa = os.path.join(carpeta_destino, nombre_archivo)

    try:
        respuesta = requests.get(url, timeout=timeout)
    except requests.exceptions.Timeout:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": "Se agoto el tiempo de espera al conectarse al servidor.",
            "accion": "Reintentar la descarga mas tarde o aumentar el timeout del script.",
        })
        return False
    except requests.exceptions.ConnectionError:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": "Error de conexion al intentar acceder al servidor.",
            "accion": "Verificar conectividad a internet y que el dominio este disponible.",
        })
        return False
    except requests.exceptions.RequestException as error:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": f"Error inesperado de conexion: {error}",
            "accion": "Revisar el detalle del error y, de ser necesario, reportarlo al equipo de soporte.",
        })
        return False

    if respuesta.status_code == 404:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": "El archivo no esta disponible para este periodo (404).",
            "accion": "Confirmar en el portal si el archivo fue publicado con otro nombre o aun no esta disponible.",
        })
        return False

    if respuesta.status_code != 200:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": f"El servidor respondio con el codigo {respuesta.status_code}.",
            "accion": "Revisar manualmente el enlace en el navegador para identificar el motivo.",
        })
        return False

    contenido = respuesta.content
    if not contenido:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": "El archivo descargado llego con tamanio cero.",
            "accion": "Reintentar la descarga y, si persiste, verificar el archivo directamente en el portal.",
        })
        return False

    try:
        with open(ruta_completa, "wb") as archivo:
            archivo.write(contenido)
    except PermissionError:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": f"Permisos insuficientes para guardar el archivo en '{ruta_completa}'.",
            "accion": "Verificar permisos de escritura sobre la carpeta de destino.",
        })
        return False
    except OSError as error:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": f"No se pudo guardar el archivo en '{ruta_completa}': {error}",
            "accion": "Revisar si el nombre de archivo es valido y si hay espacio disponible en el destino.",
        })
        return False

    if os.path.getsize(ruta_completa) == 0:
        incidencias.append({
            "seccion": seccion, "periodo": periodo, "url": url,
            "descripcion": f"El archivo guardado en '{ruta_completa}' quedo con tamanio cero o corrupto.",
            "accion": "Eliminar el archivo y reintentar la descarga.",
        })
        return False

    print(f"  {periodo}: descargado {nombre_archivo}")
    return True


def procesar_seccion(nombre_seccion, carpeta_destino, generar_entradas, incidencias):
    print(f"Procesando seccion: {nombre_seccion}")
    try:
        entradas = generar_entradas()
    except ConfiguracionPendiente as error:
        incidencias.append({
            "seccion": nombre_seccion, "periodo": "todos", "url": "no disponible",
            "descripcion": str(error),
            "accion": "Completar la formula de enlace de la seccion en el codigo con la ruta real de COES u Osinergmin.",
        })
        return

    for periodo, candidatos in entradas:
        for url, nombre_archivo in candidatos:
            try:
                if descargar_archivo(url, nombre_archivo, carpeta_destino, incidencias, nombre_seccion, periodo):
                    break
            except Exception as error:
                incidencias.append({
                    "seccion": nombre_seccion, "periodo": periodo, "url": url,
                    "descripcion": f"Error inesperado durante la descarga o el almacenamiento: {error}",
                    "accion": "Revisar el detalle del error y ejecutar la descarga de este periodo manualmente.",
                })


def imprimir_reporte(incidencias):
    print()
    print("REPORTE DE INCIDENCIAS")
    if not incidencias:
        print("Ejecución completada sin incidencias.")
        return
    for numero, incidencia in enumerate(incidencias, start=1):
        print(f"{numero}. Seccion: {incidencia['seccion']}")
        print(f"   Periodo: {incidencia['periodo']}")
        print(f"   URL: {incidencia['url']}")
        print(f"   Descripcion: {incidencia['descripcion']}")
        print(f"   Accion sugerida: {incidencia['accion']}")
        print()


