def generar_periodos_mensuales(inicio, final):
    """Devuelve una lista de tuplas (anio, mes) para cada periodo entre inicio y final,
    ambos en formato MMYYYY, inclusive."""
    mes_actual = int(inicio[:2])
    anio_actual = int(inicio[2:])
    mes_final = int(final[:2])
    anio_final = int(final[2:])

    periodos = []
    while (anio_actual, mes_actual) <= (anio_final, mes_final):
        periodos.append((anio_actual, mes_actual))
        mes_actual += 1
        if mes_actual > 12:
            mes_actual = 1
            anio_actual += 1
    return periodos


def construir_url_coes(ruta_interna):
    """Arma un enlace de descarga de COES codificando la ruta interna como parametro url,
    igual que lo hace el portal: barras, espacios y tildes quedan percent encoded."""
    return "https://www.coes.org.pe/portal/browser/download?url=" + quote(ruta_interna, safe="")


def sanear_nombre_archivo(nombre):
    """Quita caracteres no permitidos en nombres de archivo de Windows. Devuelve el
    nombre original si ya era valido."""
    caracteres_invalidos = '<>:"/\\|?*'
    nombre_limpio = "".join(caracter for caracter in nombre if caracter not in caracteres_invalidos)
    return nombre_limpio if nombre_limpio else "archivo_sin_nombre"


def crear_generador_pendiente(nombre_seccion, motivo):
    """Genera la funcion de una seccion que todavia no tiene formula de enlace completa."""

    def generar():
        raise ConfiguracionPendiente(f"{nombre_seccion}: {motivo}")

    return generar


def crear_generador_costo_gas(periodos):
    """Seccion 3, costo de combustible gas. Formula confirmada con ejemplos completos."""

    def generar():
        entradas = []
        for anio, mes in periodos:
            mes_mm = f"{mes:02d}"
            mes_corto = MESES[mes]["corto_min"]
            nombre_archivo = f"{mes_mm}{anio}_Actualización_Costo_GN_{mes_corto}{anio}.xlsx"
            ruta = f"Operación/Estudios/Costos Variables/02_GAS NATURAL/{anio}/{nombre_archivo}"
            url = construir_url_coes(ruta)
            periodo_str = f"{mes_mm}/{anio}"
            entradas.append((periodo_str, [(url, nombre_archivo)]))
        return entradas

    return generar


def crear_generador_potencia_despachada(periodos):
    """Seccion 7, potencia despachada de Osinergmin. Prueba el nombre base y, si no esta
    disponible, intenta las variantes con sufijo de version v2 y v3."""

    def generar():
        entradas = []
        base_url = "https://www2.osinergmin.gob.pe/publicacionesgrt/pdf/OperSecElectrico/"
        for anio, mes in periodos:
            mes_mayus = MESES[mes]["corto_mayus"]
            candidatos = []
            for sufijo in ("", "v2", "v3"):
                nombre_archivo = f"OSE{mes_mayus}{anio}{sufijo}.pdf"
                candidatos.append((base_url + nombre_archivo, nombre_archivo))
            periodo_str = f"{mes:02d}/{anio}"
            entradas.append((periodo_str, candidatos))
        return entradas

    return generar


def crear_generador_mercado_libre(periodos):
    """Seccion 8, mercado libre de electricidad de Osinergmin."""

    def generar():
        entradas = []
        base_url = "https://www2.osinergmin.gob.pe/publicacionesgrt/pdf/MerLibElectricidad/"
        for anio, mes in periodos:
            aa = f"{anio % 100:02d}"
            mm = f"{mes:02d}"
            mes_largo = MESES[mes]["largo_cap"]
            nombre_archivo = f"Año {aa}-Nro {mm}-{mes_largo} {anio}.xlsx"
            url = base_url + quote(nombre_archivo)
            periodo_str = f"{mm}/{anio}"
            entradas.append((periodo_str, [(url, nombre_archivo)]))
        return entradas

    return generar


def crear_generador_tarifas_mercado(periodos):
    """Seccion 9, tarifas y mercado electrico de Osinergmin."""

