function getAfps(){
  const s = new Set();
  for(const r of HIST) if(r.AFP) s.add(r.AFP);
  return [...s].sort();
}

function kpisMultiAfp(div, corte){
  const afps = getAfps();
  if(afps.length <= 1) { document.getElementById(div).innerHTML=''; return; }
  let html = '<table style="width:100%;border-collapse:collapse;font-size:13px">';
  html += '<tr style="background:#0B3C5D;color:#fff"><th style="padding:8px">AFP</th>'
    + '<th>Huella (miles Tn)</th><th>Intensidad</th><th>AUM (MM$)</th><th>Cobertura</th></tr>';
  afps.forEach((afp, i) => {
    const tot = (obj, met) => {
      let t=0; const m2 = metricaDisponible(obj, met, corte);
      for(const r of HIST) if(r.OBJETO===obj && r.METRICA===m2 &&
          String(r.FECHA_CORTE)===String(corte) && r.AFP===afp && r.DIM_1==='TOTAL')
        t += +r.VALOR||0;
      return t;
    };
    const cob = () => {
      for(const r of HIST) if(r.OBJETO==='Cobertura' && r.METRICA==='Cobertura' &&
          String(r.FECHA_CORTE)===String(corte) && r.AFP===afp) return +r.VALOR||0;
      return null;
    };
    const h = tot('Resumen_Bloques','Huella (miles Tn)');
    const inten = tot('Resumen_Bloques','Intensidad');
    const aum = tot('Resumen_Bloques','Inv MM$');
    const c = cob();
    const color = CAFP[afp] || '#666';
    const bg = i%2===0 ? '#f8fafb' : '#fff';
    html += '<tr style="background:'+bg+'">'
      + '<td style="padding:6px 8px;font-weight:600;color:'+color+'">'+afp+'</td>'
      + '<td style="text-align:right;padding:6px 8px">'+fmt(h)+'</td>'
      + '<td style="text-align:right;padding:6px 8px">'+fmt(inten)+'</td>'
      + '<td style="text-align:right;padding:6px 8px">'+fmt(aum)+'</td>'
      + '<td style="text-align:right;padding:6px 8px">'+(c!==null?(c*100).toFixed(1)+'%':'—')+'</td>'
      + '</tr>';
  });
  html += '</table>';
  document.getElementById(div).innerHTML = html;
}

