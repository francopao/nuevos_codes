def _cargar_bd1s_huella(ruta_bd1s: str, afp: str = "Integra",
                         verbose: bool = True):
    """Lee BD1_S_Huella.xlsx para una AFP y produce los inputs que
    ValorizacionBuilder espera.

    Estrategia clave: VVL = Weight × AUM (reverse-engineered) para que
    ValorizacionBuilder calcule Weight = VVL/AUM = Weight original.
    Así no se modifica el builder y el Weight queda idéntico al reporte X.

    Retorna: (df_val, caja_map, tc, aum_mm, caja_neta_mm,
              parametria_lookup, sector_lookup)
    """
    df = pd.read_excel(ruta_bd1s, engine="openpyxl")

    # --- Filtrar por AFP y solo F1/F2/F3 (excluir Multifondos) ----
    df = df[df["Afp"] == afp].copy()
    df = df[df["Fondo"].isin(["F1", "F2", "F3"])].copy()
    if df.empty:
        raise ValueError(f"No hay datos para AFP='{afp}' (F1/F2/F3) en BD1_S_Huella.")

    # --- TC ---
    tc = float(df["TC_USD"].iloc[0])

    # --- Mapear Fondo → PORTAFOLIO ---
    _fondo_a_port = {"F1": "IN-FONDO1", "F2": "IN-FONDO2", "F3": "IN-FONDO3"}
    df["PORTAFOLIO"] = df["Fondo"].map(_fondo_a_port)

    # --- Renombrar al esquema de Valorización ---
    df = df.rename(columns={
        "SBS":       "CODIGO_SBS",
        "ISIN":      "CODIGO_ISIN",
        "Nombre":    "TITULO",
        "codEmisor": "EMISOR",
    })

    # --- VVL reverse-engineered: Weight × AUM → Weight = VVL/AUM ✓ ---
    _w = pd.to_numeric(df["Weight"], errors="coerce").fillna(0.0)
    _aum = pd.to_numeric(df["AUM"], errors="coerce").fillna(0.0)
    df["VALOR_VECTOR_LOCAL"] = _w * _aum

    # --- caja_map: PORTAFOLIO → AUM (patrimonio del fondo) ---
    caja_map = {}
    for port in ["IN-FONDO1", "IN-FONDO2", "IN-FONDO3"]:
        sub = df[df["PORTAFOLIO"] == port]
        if not sub.empty:
            caja_map[port] = float(sub["AUM"].iloc[0])

    # --- AUM multifondos en USD MM ---
    aum_total_pen = sum(caja_map.values())
    aum_mm = aum_total_pen / tc / 1e6

    # --- Caja neta = 0 (no se usa en Cobertura) ---
    caja_neta_mm = 0.0

    # --- Parametria lookup desde columnas de BD1_S_Huella ---
    parametria_lookup: Dict[str, dict] = {}
    for _, row in df.drop_duplicates(subset=["CODIGO_SBS"]).iterrows():
        sbs = _to_string(row.get("CODIGO_SBS"))
        if not sbs:
            continue
        parametria_lookup[sbs] = {
            "NOMBRE":  row.get("TITULO"),
            "CODIGO":  _to_string(row.get("Categoria")),
            "RIESGOS": _to_string(row.get("Strategy")),
            "RANKEST": _to_string(row.get("RANKEST") or row.get("assetclass")),
        }

    # --- Sector lookup ---
    sector_lookup: Dict[str, str] = {}
    for _, row in df.drop_duplicates(subset=["CODIGO_SBS"]).iterrows():
        sbs = _to_string(row.get("CODIGO_SBS"))
        sector = row.get("Sector_GICS")
        if sbs and pd.notna(sector) and str(sector).strip():
            # Doble clave: por SBS y por Nombre (para compatibilidad con M12)
            sector_lookup[f"SBS::{sbs}"] = str(sector).strip()

    if verbose:
        print(f"  [BD1S] AFP={afp}: {len(df)} filas, TC={tc:.4f}, "
              f"AUM={aum_mm:,.2f} USD MM, Fondos={list(caja_map.keys())}")

    return df, caja_map, tc, aum_mm, caja_neta_mm, parametria_lookup, sector_lookup


def construir_valorizacion_bd1s(cfg: "Config", ruta_bd1s: str,
                                 afp: str = "Integra",
                                 shared: Optional[dict] = None,
                                 verbose: bool = True):
    """Módulos 1..10 usando BD1_S_Huella como cartera.

    'shared' es un dict con recursos compartidos (bd, px, perd, comp, mkt)
    para evitar recargarlos en cada AFP. Si es None, se construyen aquí.
    """
    df_val, caja_map, tc, aum_mm, caja_neta_mm, param_lk, sector_lk = \
        _cargar_bd1s_huella(ruta_bd1s, afp, verbose)

    # --- Recursos compartidos (se construyen una vez para todas las AFPs) ---
    if shared is None:
        shared = _construir_shared(cfg, verbose)

    vb = ValorizacionBuilder(
        df_val,
        caja_map=caja_map,
        usd_rate=tc,
        parametria_lookup=param_lk,
        intensidad_post=shared["intensidad_post"],
        plus_lookup=shared["plus_lookup"],
        intensidad_t1={},
        proxy_engine=shared["proxy_engine"],
        perdieron_lookup=shared["perd_lookup"],
        perdieron_mode="fill",
        attrs_lookup=shared["attrs_lookup"],
        aum_multifondos_mm=aum_mm,
        verbose=verbose,
    )
    vb.build()

    ctx = {
        "config": cfg, "tc": tc, "sector_lookup": sector_lk,
        "aum_multifondos_mm": aum_mm, "caja_neta_mm": caja_neta_mm,
        "valorizacion_builder": vb,
        "market_cap_loader": shared.get("mkt"),
        "herencias": vb.get_inherited_history(),
    }
    return vb.df, ctx


def _construir_shared(cfg: "Config", verbose: bool = True) -> dict:
    """Construye BD MSCI, Proxies, Perdieron, Comparables y MarketCap UNA vez.
    Se comparten entre todas las AFPs."""
    if verbose:
        print("  [SHARED] Construyendo recursos compartidos (BD MSCI, Proxies, etc.)...")

    bd = BDMSCIBuilder(cfg).build()
    bd.append_proxies(cfg.path_proxies)

    perd = PerdieronHuellaLoader(cfg).build()
    perd_lookup = perd.as_intensidad_lookup() if not perd.df.empty else {}

    px = ProxyEngine(cfg).load()
    intensidad_post = px.apply_to_bd(bd.as_intensidad_lookup())

    comp = ComparablesLoader(cfg, verbose=verbose).build()
    mkt = _market_cap_seguro(cfg, verbose)

    return {
        "bd": bd,
        "proxy_engine": px,
        "intensidad_post": intensidad_post,
        "plus_lookup": bd.as_plus_lookup(),
        "attrs_lookup": bd.as_attrs_lookup(),
        "perd_lookup": perd_lookup,
        "comp": comp,
        "mkt": mkt,
    }


def run_pipeline_bd1s(semestre: str,
                      ruta_bd1s: str,
                      output_dir: str = OUTPUT_DIR_DEFAULT,
                      afps: Optional[List[str]] = None,
                      ruta_historico: Optional[str] = None,
                      ruta_dashboard: Optional[str] = None,
                      verbose: bool = True):
    """Pipeline multi-AFP completo usando BD1_S_Huella como cartera.

    Para cada AFP construye Valorización + pivots y los exporta al
    histórico. Después genera el dashboard con charts existentes (por AFP)
    + charts comparativos (multi-AFP).
    """
    out = FsPath(str(output_dir))
    out.mkdir(parents=True, exist_ok=True)
    ruta_historico = ruta_historico or str(out / NOMBRE_HISTORICO)
    ruta_dashboard = ruta_dashboard or str(out / NOMBRE_DASHBOARD)

    cfg = Config.from_semestre(semestre)
    if verbose:
        print(cfg.summary())

    # --- Determinar AFPs disponibles ---
    df_full = pd.read_excel(ruta_bd1s, engine="openpyxl")
    available = sorted(df_full["Afp"].unique())
    if afps is None:
        afps = available
    if verbose:
        print(f"  [BD1S] AFPs disponibles: {available}")
        print(f"  [BD1S] AFPs a procesar: {afps}")
    del df_full

    # --- Recursos compartidos (una sola carga) ---
    faltantes = cfg.check_paths(verbose=verbose)
    shared = _construir_shared(cfg, verbose)

    # --- Procesar cada AFP ---
    exp = HistoricoExporter(ruta_historico)
    all_results: Dict[str, dict] = {}

    for afp in afps:
        if verbose:
            print(f"\n{'='*60}")
            print(f"  HUELLA — AFP: {afp}")
            print(f"{'='*60}")
        try:
            val, ctx = construir_valorizacion_bd1s(
                cfg, ruta_bd1s, afp=afp, shared=shared, verbose=verbose)

            pres = PresentacionBuilder(
                val, cfg.semestre,
                sector_lookup=ctx.get("sector_lookup", {}),
                intensidades_comp=shared["comp"].intensidades,
                aum_comp=(shared["mkt"].aum if shared["mkt"] else {}),
                caja_neta_mm=ctx.get("caja_neta_mm", 0.0),
                aum_total_mm=ctx.get("aum_multifondos_mm"),
            )
            objetos = pres.build_all()

            # --- Exportar al histórico con sufijo AFP ---
            # Inyectar columna AFP en el formato largo para el dashboard
            largo = pres.to_long()
            largo.insert(1, "AFP", afp)
            _exportar_con_afp(exp, largo, cfg.semestre, afp, pres, verbose)

            all_results[afp] = {
                "valorizacion": val, "objetos": objetos,
                "aum_mm": ctx.get("aum_multifondos_mm"),
                "presentacion": pres,
            }
            if verbose:
                print(f"  [{afp}] {len(objetos)} objetos, {len(pres.df)} registros.")

        except Exception as exc:
            if verbose:
                print(f"  [{afp}] [ERROR] {exc}")
                import traceback; traceback.print_exc()

    # --- Dashboard (existente + multi-AFP) ---
    if verbose:
        print(f"\n  [Dashboard] Generando con {len(all_results)} AFP(s)...")
    construir_dashboard(ruta_historico, ruta_dashboard)

    return {
        "config": cfg, "resultados": all_results,
        "ruta_historico": ruta_historico, "ruta_dashboard": ruta_dashboard,
    }


def _exportar_con_afp(exp: "HistoricoExporter", largo: pd.DataFrame,
                       semestre: str, afp: str,
                       builder: "PresentacionBuilder",
                       verbose: bool = True):
    """Exporta los datos de una AFP al histórico, incluyendo la columna AFP.

    Preserva cortes previos y acumula en la hoja HISTORICO.
    La hoja del corte se nombra '{semestre}_{afp}' para no colisionar.
    """
    hojas = exp._leer_existente()
    nombre_hoja = f"{semestre}_{afp}"[:31]

    # --- HISTORICO acumulado: purgar este corte+AFP y reinsertar ---
    hist_prev = hojas.get(exp.HOJA_HISTORICO, pd.DataFrame())
    if not hist_prev.empty:
        # Añadir AFP a datos históricos previos que no la tengan
        if "AFP" not in hist_prev.columns:
            hist_prev.insert(1, "AFP", "Integra")
        # Purgar este corte+AFP
        mask = ((hist_prev["FECHA_CORTE"].astype(str) == semestre) &
                (hist_prev["AFP"].astype(str) == afp))
        hist_prev = hist_prev[~mask]

    historico = (pd.concat([hist_prev, largo], ignore_index=True)
                 if not hist_prev.empty else largo)
    historico = historico.sort_values(
        ["FECHA_CORTE", "AFP", "OBJETO", "METRICA"], ignore_index=True)

    # --- Metadata ---
    meta_prev = hojas.get(exp.HOJA_META, pd.DataFrame())
    if not meta_prev.empty and "FECHA_CORTE" in meta_prev.columns:
        mask = (meta_prev["FECHA_CORTE"].astype(str) == semestre)
        if "AFP" in meta_prev.columns:
            mask = mask & (meta_prev["AFP"].astype(str) == afp)
        meta_prev = meta_prev[~mask]
    meta_new = pd.DataFrame([{
        "FECHA_CORTE": semestre, "AFP": afp,
        "GENERADO": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "N_REGISTROS_FUENTE": len(builder.df),
        "HUELLA_TOTAL": float(builder.df[COL["huella"]].sum()),
        "AUM_TOTAL_MM": float(builder.df[COL["inv"]].sum()),
    }])
    meta = (pd.concat([meta_prev, meta_new], ignore_index=True)
            if not meta_prev.empty else meta_new)

    # --- Reescritura preservando cortes previos ---
    otros = {k: v for k, v in hojas.items()
             if k not in (exp.HOJA_HISTORICO, exp.HOJA_META, nombre_hoja)}

    with pd.ExcelWriter(exp.ruta, engine="openpyxl") as xw:
        historico.to_excel(xw, sheet_name=exp.HOJA_HISTORICO, index=False)
        meta.to_excel(xw, sheet_name=exp.HOJA_META, index=False)
        largo.to_excel(xw, sheet_name=nombre_hoja, index=False)
        for nombre, df in sorted(otros.items(), reverse=True):
            df.to_excel(xw, sheet_name=str(nombre)[:31], index=False)

    if verbose:
        print(f"  [Módulo 13] {afp} -> hoja '{nombre_hoja}' en histórico.")

