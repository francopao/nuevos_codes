function topEmisoresMultiAfp(div, corte){
  const afps = getAfps();
  if(afps.length <= 1) return;
  // Get top emitters across all AFPs
  const emisorTotal = new Map();
  for(const r of HIST){
    if(r.OBJETO!=='Contrib_General' && r.OBJETO!=='Contrib_BU_TD') continue;
    if(r.METRICA!=='Huella' || String(r.FECHA_CORTE)!==String(corte)) continue;
    if(!r.DIM_1 || r.DIM_1==='TOTAL') continue;
    const key = r.DIM_1;
    emisorTotal.set(key, (emisorTotal.get(key)||0) + (+r.VALOR||0));
  }
  let topKeys = [...emisorTotal.entries()].sort((a,b)=>b[1]-a[1]).slice(0,12).map(e=>e[0]);

  const traces = afps.map(afp => {
    const vals = topKeys.map(k => {
      let t=0;
      for(const r of HIST) if((r.OBJETO==='Contrib_General'||r.OBJETO==='Contrib_BU_TD') &&
          r.METRICA==='Huella' && String(r.FECHA_CORTE)===String(corte) &&
          r.AFP===afp && r.DIM_1===k) t+=+r.VALOR||0;
      return t;
    });
    return {type:'bar', name:afp, x:topKeys, y:vals,
      marker:{color: CAFP[afp]||'#666'}};
  });
  const lay = LAYOUT();
  lay.barmode = 'group';
  lay.yaxis.title = 'Huella (Tn CO2)';
  lay.xaxis.tickangle = -35;
  lay.margin.b = 120;
  Plotly.react(div, traces, lay, OPTS);
}

