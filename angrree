**BLOQUE 3 — `gyp_pesos_universo`: modo enriquecido con Estado_Instrumento**

Ubica (Ctrl+F) toda la función actual `def gyp_pesos_universo(self) -> pd.DataFrame:` (desde su `def` hasta el `return out` final) y reemplázala por:
```python
    def gyp_pesos_universo(self, df_raw: pd.DataFrame = None) -> pd.DataFrame:
        """Universo por AFP para la hoja G&P.

        Modo básico (df_raw=None): solo el universo que sobrevivió al
        pipeline (pres.df). Compatibilidad con versión anterior.

        Modo enriquecido (df_raw provisto): parte del universo raw de
        BD1_S_Huella (antes del filtro Fondo), filtra a RF/RV/Alts, y
        agrega Estado_Instrumento con la razón por la que cada fila
        sobrevivió o fue excluida — trazabilidad end-to-end para explicar
        la brecha entre AUM del Cálculo Caja y la suma de Inv$."""
        # -- Modo básico (backwards-compat)
        if df_raw is None:
            requeridas = [COL["sbs"], "Weight_Original_BD1S", "Patrimonio", "TC_USD",
                           COL["portafolio"]]
            if any(c not in self.df.columns for c in requeridas):
                return pd.DataFrame()
            d = self.df.copy()
            cols = [COL["sbs"], COL["isin"], COL["nombre"], COL["portafolio"],
                    COL["estrategia"], "Weight_Original_BD1S", "Patrimonio", "TC_USD"]
            cols = [c for c in cols if c in d.columns]
            out = d[cols].copy()
            out = out.rename(columns={COL["sbs"]: "SBS", COL["isin"]: "ISIN",
                                       COL["nombre"]: "Emisor", COL["portafolio"]: "Portafolio",
                                       COL["estrategia"]: "Estrategia"})
            out["Fondo"] = "F" + out["Portafolio"].astype(str).str.extract(r"(\d)$")[0].fillna("")
            return out

        # -- Modo enriquecido
        raw = df_raw.copy()
        if "TIPO_RENTA" in raw.columns:
            raw = raw[raw["TIPO_RENTA"].isin(["RENTA FIJA", "RENTA VARIABLE"])].copy()
        if raw.empty:
            return pd.DataFrame()

        # Lookup: qué llegó a pres.df y con qué Huella/Inv
        _fondo_a_port = {"F0": "IN-FONDO0", "F1": "IN-FONDO1",
                          "F2": "IN-FONDO2", "F3": "IN-FONDO3"}
        _fondos_validos = {"F1", "F2", "F3"}
        pres = self.df.copy()
        pres["__k"] = (pres[COL["sbs"]].map(lambda v: _to_string(v) or "")
                        + "|" + pres[COL["portafolio"]].astype(str))
        h_num = pd.to_numeric(pres[COL["huella"]], errors="coerce").fillna(0.0)
        i_num = pd.to_numeric(pres[COL["inv"]], errors="coerce").fillna(0.0) \
                if COL["inv"] in pres.columns else pd.Series(0.0, index=pres.index)
        huella_map = dict(zip(pres["__k"], h_num))
        inv_map = dict(zip(pres["__k"], i_num))

        def _estado(sbs, fondo):
            fondo_s = _to_string(fondo) or ""
            if fondo_s not in _fondos_validos:
                return f"Filtrado: Fondo {fondo_s or 'vacío'} (no F1/F2/F3)"
            sbs_s = _to_string(sbs) or ""
            k = f"{sbs_s}|{_fondo_a_port[fondo_s]}"
            if k not in huella_map:
                return "Filtrado: otro (no llegó a pres.df)"
            h = huella_map[k]
            i = inv_map[k]
            if abs(h) > 1e-9:
                return "Considerado"
            if abs(i) > 1e-9:
                return "Sin CO2H match (Problemático)"
            return "Sin exposición"

        raw["Estado_Instrumento"] = [
            _estado(r.get("SBS"), r.get("Fondo")) for _, r in raw.iterrows()]

        # Mapear cols de raw al esquema esperado por _escribir_gyp
        col_map = {
            "SBS": "SBS", "ISIN": "ISIN", "Nombre": "Emisor", "Fondo": "Fondo",
            "Strategy": "Estrategia", "Weight": "Weight_Original_BD1S",
            "AUM": "Patrimonio", "TC_USD": "TC_USD",
            "TIPO_RENTA": "TIPO_RENTA", "Estado_Instrumento": "Estado_Instrumento",
        }
        keep = [c for c in col_map if c in raw.columns]
        out = raw[keep].rename(columns={c: col_map[c] for c in keep}).reset_index(drop=True)
        out["Portafolio"] = out["Fondo"].map(_fondo_a_port).fillna(out["Fondo"])
        return out
```

