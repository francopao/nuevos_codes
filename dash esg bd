PAT_TEMATICA = re.compile(r"(?P<mmyyyy>\d{6})(?=\.xls[xm]$)", re.IGNORECASE)


def detectar_archivos_tematica(carpeta):
    encontrados = []
    if not os.path.isdir(carpeta):
        return encontrados
    for nombre in os.listdir(carpeta):
        if not nombre.lower().endswith((".xlsx", ".xlsm")):
            continue
        if nombre.startswith("~$"):
            continue
        if "tematic" not in nombre.lower() and "temátic" not in nombre.lower() \
                and "tematica" not in nombre.lower():
            continue
        m = PAT_TEMATICA.search(nombre)
        if not m:
            continue
        try:
            fecha = parse_fecha_mmyyyy(m.group("mmyyyy"))
        except ValueError:
            continue
        encontrados.append({"path": os.path.join(carpeta, nombre),
                             "nombre": nombre, "fecha": fecha})
    return encontrados


def extraer_graf_pie(archivo, mensajes):
    path, fecha = archivo["path"], archivo["fecha"]
    wb = openpyxl.load_workbook(path, data_only=True, read_only=True)
    if "GRAF PIE" not in wb.sheetnames:
        raise ValueError(f"No tiene hoja 'GRAF PIE': {archivo['nombre']}")
    ws = wb["GRAF PIE"]
    grid = leer_grid(ws)
    wb.close()
    base = {"Fecha": fecha, "Archivo": archivo["nombre"]}

    resumen, detalle = [], []

    # A1:B4 -> composición temático vs no temático
    for r in range(2, 5):
        categoria = celda(grid, r, 1)
        monto = celda(grid, r, 2)
        if categoria is None:
            continue
        resumen.append({**base, "Categoria": str(categoria).strip(),
                         "Inv_MMUSD": safe_float(monto)})
    if not resumen:
        log(mensajes, "WARN", f"{archivo['nombre']}: 'GRAF PIE' A1:B4 vino vacío")

    # H1:L10 -> detalle por clase de activo / emisor / etiqueta
    clase_actual = None
    for r in range(2, 11):
        clase_celda = celda(grid, r, 8)    # col H
        emisor = celda(grid, r, 9)         # col I
        etiqueta = celda(grid, r, 10)      # col J
        aum = celda(grid, r, 11)           # col K
        pct = celda(grid, r, 12)           # col L
        if clase_celda is not None:
            clase_actual = str(clase_celda).strip()
        if emisor is None and aum is None:
            continue
        es_total = bool(clase_actual and clase_actual.lower().startswith("total"))
        detalle.append({
            **base,
            "Clase": clase_actual,
            "Es_Total": es_total,
            "Emisor": str(emisor).strip() if emisor is not None else None,
            "Etiqueta": str(etiqueta).strip() if etiqueta is not None else None,
            "AUM_MMUSD": safe_float(aum),
            "Pct_Clase_Activo": safe_float(pct),
        })
    if not detalle:
        log(mensajes, "WARN", f"{archivo['nombre']}: 'GRAF PIE' H1:L10 vino vacío")

    return {"tematica_resumen": resumen, "tematica_detalle": detalle}


