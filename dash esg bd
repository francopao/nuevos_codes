            continue
        out["risk"].append({
            **base, "Grupo": "Governance Risk", "Metrica": etiqueta,
            "Portfolio": safe_float(celda(grid, fila, c_p)),
            "Benchmark": safe_float(celda(grid, fila, c_b)),
            "Activo": safe_float(celda(grid, fila, c_a)),
        })

    # --- PORTFOLIO ESG RATING SUMMARY (Leader/Average/Laggard/Not Covered) ---
    r0, r1 = VENTANA_RATING_SUMMARY
    fila_leader = buscar_fila_por_etiqueta(grid, 127, "Leader", r0, r1)
    if fila_leader is not None:
        etiquetas = ["Leader", "Average", "Laggard", "Not Covered"]
