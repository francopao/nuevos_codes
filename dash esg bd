PAT_MSCI = re.compile(
    r"(?P<yyyymm>\d{6})[ _]*BD[ _]*(?P<fondo>F1|F2|F3|M)(?P<sobs>Sobs)?",
    re.IGNORECASE,
)


def detectar_archivos_msci(carpeta):
    """Recorre la carpeta y arma la lista de archivos que matchean el
    patrón 'YYYYMM BD Fx[Sobs].xlsx'. Devuelve lista de dicts con
    path, fecha, fondo, variante."""
    encontrados = []
    if not os.path.isdir(carpeta):
        return encontrados
    for nombre in os.listdir(carpeta):
        if not nombre.lower().endswith((".xlsx", ".xlsm")):
            continue
        if nombre.startswith("~$"):  # archivo temporal de Excel abierto
            continue
        m = PAT_MSCI.search(nombre)
        if not m:
            continue
        try:
            fecha = parse_fecha_yyyymm(m.group("yyyymm"))
        except ValueError:
            continue
        fondo = m.group("fondo").upper()
        variante = "Sobs" if m.group("sobs") else "Base"
        encontrados.append({
            "path": os.path.join(carpeta, nombre),
            "nombre": nombre,
            "fecha": fecha,
            "fondo": fondo,
            "variante": variante,
        })
    return encontrados


