RATINGS_ORDEN = ["AAA", "AA", "A", "BBB", "BB", "B", "CCC", "Not Rated"]


def extraer_bloque_rating_distribucion(grid, fila_ini_aaa, cols):
    """A partir de la fila donde está 'AAA', lee hacia abajo las 8
    categorías de RATINGS_ORDEN. cols=(col_label, col_companies, col_funds,
    col_total)."""
    col_label, c_comp, c_fun, c_tot = cols
    filas = []
    r = fila_ini_aaa
    for etiqueta_esperada in RATINGS_ORDEN:
        etiqueta = celda(grid, r, col_label)
        etiqueta = str(etiqueta).strip() if etiqueta is not None else None
        if etiqueta != etiqueta_esperada:
            # el layout no calza con lo esperado -> se detiene (defensivo)
            break
        filas.append({
            "Rating": etiqueta_esperada,
            "Companies": safe_float(celda(grid, r, c_comp)),
            "Funds": safe_float(celda(grid, r, c_fun)),
            "Total": safe_float(celda(grid, r, c_tot)),
        })
        r += 1
    return filas


def extraer_msci_portfolio_report(archivo, mensajes):
    """Procesa un archivo 'YYYYMM BD Fx[Sobs].xlsx' y devuelve un dict de
    listas de filas por sub-tabla. Si algo central no calza, levanta
    excepción (el llamador decide saltar el archivo completo)."""
    path, fecha, fondo, variante = (archivo["path"], archivo["fecha"],
                                     archivo["fondo"], archivo["variante"])
    wb = openpyxl.load_workbook(path, data_only=True, read_only=True)
    if "Portfolio Report" not in wb.sheetnames:
        raise ValueError(f"No tiene hoja 'Portfolio Report': {archivo['nombre']}")
    ws = wb["Portfolio Report"]
    grid = leer_grid(ws)   # una sola pasada secuencial -> todo lo demás en RAM
    wb.close()

    base = {"Fecha": fecha, "Fondo": fondo, "Variante": variante,
            "Archivo": archivo["nombre"]}

    out = {"mv_coverage": [], "scorecard": [], "rating_dist": [],
           "rating_summary": [], "rating_momentum": [], "risk": []}

    # --- Fecha "as of" real del reporte (columna 127 en la ventana 90-110) ---
    fecha_reporte = None
    for r in range(90, 115):
        v = celda(grid, r, 127)
        if isinstance(v, (datetime, date)):
            fecha_reporte = v
            break
    base["Fecha_Reporte_MSCI"] = fecha_reporte

    # --- ESG QUALITY SCORECARD ---
    r0, r1 = VENTANA_SCORECARD
    for etiqueta, _titulo, c_p, c_b, c_a in SCORECARD_METRICAS:
        fila = buscar_fila_por_etiqueta(grid, 2, etiqueta, r0, r1)
        if fila is None:
            log(mensajes, "WARN", f"{archivo['nombre']}: no se encontró '{etiqueta}'")
            continue
        out["scorecard"].append({
            **base, "Metrica": _titulo,
            "Portfolio": safe_float(celda(grid, fila, c_p)),
            "Benchmark": safe_float(celda(grid, fila, c_b)),
            "Activo": safe_float(celda(grid, fila, c_a)),
        })

    # --- ESG RATING DISTRIBUTION (Overall y Environmental) ---
    r0, r1 = VENTANA_RATING_DIST
    filas_aaa = [r for r in range(r0, min(r1, len(grid) - 1) + 1)
                 if str(celda(grid, r, 127) or "").strip() == "AAA"]
    etiquetas_dim = ["Overall", "Environmental"]
    for i, fila_aaa in enumerate(filas_aaa[:2]):
        dim = etiquetas_dim[i] if i < len(etiquetas_dim) else f"Bloque{i+1}"
        bloque = extraer_bloque_rating_distribucion(
            grid, fila_aaa, (127, 128, 129, 130))
        for fila_dict in bloque:
            out["rating_dist"].append({**base, "Dimension": dim, **fila_dict})
    if not filas_aaa:
        log(mensajes, "WARN", f"{archivo['nombre']}: no se encontró 'ESG RATING DISTRIBUTION'")

    # --- RISK: Environmental / Reputational / Governance ---
    r0, r1 = VENTANA_RISK
    for grupo, etiqueta, c_p, c_b, c_a in RISK_METRICAS:
        fila = buscar_fila_por_etiqueta(grid, 2, etiqueta, r0, r1)
        if fila is None:
            log(mensajes, "WARN", f"{archivo['nombre']}: no se encontró '{etiqueta}'")
            continue
        out["risk"].append({
            **base, "Grupo": grupo, "Metrica": etiqueta.replace("\n", " "),
            "Portfolio": safe_float(celda(grid, fila, c_p)),
            "Benchmark": safe_float(celda(grid, fila, c_b)),
            "Activo": safe_float(celda(grid, fila, c_a)),
        })
    for etiqueta, c_p, c_b, c_a in REPUTATIONAL_METRICAS:
        fila = buscar_fila_por_etiqueta(grid, 43, etiqueta, r0, r1)
        if fila is None:
            log(mensajes, "WARN", f"{archivo['nombre']}: no se encontró '{etiqueta}' (Reputational)")
            continue
        out["risk"].append({
            **base, "Grupo": "Reputational Risk", "Metrica": etiqueta,
            "Portfolio": safe_float(celda(grid, fila, c_p)),
            "Benchmark": safe_float(celda(grid, fila, c_b)),
