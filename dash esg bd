def extraer_bd1s(archivo, mensajes):
    """Tenencia cruda (sin flag de cobertura) -> hoja 'Holdings_BD1S'."""
    path, fecha = archivo["path"], archivo["fecha"]
    wb = openpyxl.load_workbook(path, data_only=True, read_only=True)
    ws = wb[wb.sheetnames[0]]
    grid = leer_grid(ws)
    wb.close()

    encabezado_real = [str(celda(grid, 1, c) or "").strip() for c in range(1, 17)]
    encabezado_esperado = ["SBS", "ISIN", "Weight", "Fondo", "assetclass",
                            "Strategy", "Afp", "AUM", "Tipo", "Q", "Nombre",
                            "Fecha", "codEmisor", "Precio", "Inversión",
                            "ISIN_Origen"]
    coincidencias = sum(1 for a, b in zip(encabezado_real, encabezado_esperado)
                         if a.lower() == b.lower())
    if coincidencias < 10:
        raise ValueError(f"Layout inesperado en {archivo['nombre']} "
                          f"(encabezados no calzan con BD1_S conocido)")

    filas = []
    r = 2
    vacios = 0
    while vacios < 50 and r <= len(grid) - 1:
        vals = [celda(grid, r, c) for c in range(1, 17)]
        if all(v is None for v in vals):
            vacios += 1
            r += 1
            continue
        vacios = 0
        fila = dict(zip(COLS_BD1S, vals))
        if fila["ISIN"] in (None, "", "#N/A", "#REF!"):
            r += 1
            continue
        fila["Weight"] = safe_float(fila["Weight"])
        fila["AUM"] = safe_float(fila["AUM"])
        fila["Precio"] = safe_float(fila["Precio"])
        fila["Inversion"] = safe_float(fila["Inversion"])
        fila["Fecha"] = fecha
        fila["Archivo"] = archivo["nombre"]
        filas.append(fila)
        r += 1

    if not filas:
        log(mensajes, "WARN", f"{archivo['nombre']}: no se extrajo ninguna fila de BD1_S")
    return filas


def _grupo_afp(afp):
    """Replica la agrupación 'Integra' vs 'Ex_Integra' que usaban las
    fórmulas SUMIFS originales de la hoja 'BD1_S' (columna G = R2/V2)."""
    if afp is None:
        return None
    return "Integra" if str(afp).strip() == "Integra" else "Ex_Integra"


def extraer_analisis_bd(archivo, mensajes):
    """Tenencia enriquecida -> hoja 'Holdings_AnalisisBD' (detalle curado)
    y cálculo de cobertura -> filas para 'Cobertura_Holdings' (reemplaza
    el cálculo SUMIFS de la hoja 'BD1_S', rango R1:Y21)."""
    path, fecha = archivo["path"], archivo["fecha"]
    wb = openpyxl.load_workbook(path, data_only=True, read_only=True)
    ws = wb[wb.sheetnames[0]]
    grid = leer_grid(ws)
    wb.close()

    cols_idx = sorted(COLS_ANALISIS_BD)
    encabezado_real = {c: str(celda(grid, 1, c) or "").strip() for c in cols_idx}
    # chequeo defensivo mínimo: que las columnas clave (Weight, Fondo, Afp,
    # Cobertura) sigan donde las esperamos
    chequeos = {4: "Weight", 5: "Fondo", 8: "Afp", 53: "Cobertura"}
    for col, esperado in chequeos.items():
        if encabezado_real.get(col, "").lower() != esperado.lower():
            raise ValueError(
                f"Layout inesperado en {archivo['nombre']}: columna {col} "
                f"es '{encabezado_real.get(col)}', se esperaba '{esperado}'")

    detalle = []
    r = 2
    vacios = 0
    while vacios < 50 and r <= len(grid) - 1:
        vals = {c: celda(grid, r, c) for c in cols_idx}
        if all(v is None for v in vals.values()):
            vacios += 1
            r += 1
            continue
        vacios = 0
        fila = {COLS_ANALISIS_BD[c]: v for c, v in vals.items()}
        if fila.get("ISIN") in (None, "", "#N/A", "#REF!"):
            r += 1
            continue
        fila["Weight"] = safe_float(fila["Weight"])
        fila["E"] = safe_float(fila.get("E"))
        fila["S"] = safe_float(fila.get("S"))
        fila["G"] = safe_float(fila.get("G"))
        fila["Controversies"] = safe_float(fila.get("Controversies"))
        fila["CO2_Sales"] = safe_float(fila.get("CO2_Sales"))
        fila["AfpGrupo"] = _grupo_afp(fila.get("Afp"))
        fila["Fecha"] = fecha
        fila["Archivo"] = archivo["nombre"]
        detalle.append(fila)
        r += 1

    if not detalle:
        log(mensajes, "WARN", f"{archivo['nombre']}: no se extrajo ninguna fila de Analisis BD")
        return [], []

    # --- Cálculo de cobertura (reemplaza BD1_S R1:Y21) ---
    df = pd.DataFrame(detalle)
    cobertura = []
    for fondo, g_fondo in df.groupby("Fondo"):
        for afp_grupo, g_afp in g_fondo.groupby("AfpGrupo"):
            cov = g_afp.loc[g_afp["Cobertura"] == "Cov", "Weight"].sum()
            nocov = g_afp.loc[g_afp["Cobertura"] == "NoCov", "Weight"].sum()
            total = cov + nocov
            cobertura.append({
                "Fecha": fecha, "Fondo": fondo, "AfpGrupo": afp_grupo,
                "Cov": cov, "NoCov": nocov, "Total": total,
                "Cobertura_pct": (cov / total) if total else None,
                "Archivo": archivo["nombre"],
            })

    return detalle, cobertura


