            })
    else:
        log(mensajes, "WARN", f"{archivo['nombre']}: no se encontró 'Upward' (Rating Momentum)")

    # --- MARKET VALUE COVERAGE (el sustituto de la cobertura "BD1_S") ---
    r0, r1 = VENTANA_MV_COVERAGE
    fila_port = buscar_fila_por_etiqueta(grid, 2, "Portfolio", r0, r1)
    fila_bench = buscar_fila_por_etiqueta(grid, 2, "Primary Benchmark", r0, r1)
