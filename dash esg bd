def _primera_hoja_con_columnas(wb, encabezados_esperados):
    """Encuentra la primera hoja cuya fila 1 matchea (parcialmente) el
    encabezado esperado de 'Peores Contribuyentes BD'. Devuelve (ws, grid)."""
    for nombre_hoja in wb.sheetnames:
        ws = wb[nombre_hoja]
        grid = leer_grid(ws)
        fila1 = [celda(grid, 1, c) for c in range(1, 15)]
        fila1_txt = [str(v).strip() if v is not None else "" for v in fila1]
        coincidencias = sum(1 for a, b in zip(fila1_txt, encabezados_esperados)
                             if a.lower() == b.lower())
        if coincidencias >= 8:   # al menos 8 de 14 encabezados calzan
            return ws, grid
    return None, None


