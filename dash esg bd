def cargar_hoja_existente(path, hoja):
    if not os.path.exists(path):
        return pd.DataFrame()
    try:
        return pd.read_excel(path, sheet_name=hoja, engine="openpyxl")
    except ValueError:
        return pd.DataFrame()  # la hoja todavía no existe en el archivo


def fusionar_y_deduplicar(df_viejo, df_nuevo, llave):
    if df_nuevo is None or df_nuevo.empty:
        return df_viejo
    if df_viejo is None or df_viejo.empty:
        combinado = df_nuevo.copy()
    else:
        # alinear columnas (por si una versión trae una columna nueva)
        for c in df_nuevo.columns:
            if c not in df_viejo.columns:
                df_viejo[c] = None
        for c in df_viejo.columns:
            if c not in df_nuevo.columns:
                df_nuevo[c] = None
        combinado = pd.concat([df_viejo, df_nuevo[df_viejo.columns]], ignore_index=True)
    # normalizar Fecha a datetime para que la dedup y el orden sean consistentes
    if "Fecha" in combinado.columns:
        combinado["Fecha"] = pd.to_datetime(combinado["Fecha"], errors="coerce")
    llave_presente = [c for c in llave if c in combinado.columns]
    combinado = combinado.drop_duplicates(subset=llave_presente, keep="last")
    orden_cols = [c for c in ["Fecha"] + llave_presente if c in combinado.columns]
    combinado = combinado.sort_values(by=orden_cols, na_position="last").reset_index(drop=True)
    return combinado


def leer_control_existente(path):
    if not os.path.exists(path):
        return {}
    df = cargar_hoja_existente(path, HOJA_CONTROL)
    if df.empty:
        return {}
    return dict(zip(df["Archivo"], df["Hash"]))


