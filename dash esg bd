    # ----------------------------------------------------------------
    archivos_bd1s = detectar_archivos_bd1s(RUTA_BD1_S)
    log(mensajes_log, "INFO", f"Encontrados {len(archivos_bd1s)} archivos 'BD1_S'")
    for archivo in archivos_bd1s:
        h = hash_archivo(archivo["path"])
        if control_previo.get(archivo["nombre"]) == h:
            continue
        try:
            filas = extraer_bd1s(archivo, mensajes_log)
            nuevas["Holdings_BD1S"].extend(filas)
            control_nuevo[archivo["nombre"]] = h
            log(mensajes_log, "INFO", f"OK: {archivo['nombre']} ({len(filas)} filas)")
        except Exception as e:
            log(mensajes_log, "ERROR", f"Se saltó {archivo['nombre']} por error: {e}")
            log(mensajes_log, "ERROR", traceback.format_exc())

    # ----------------------------------------------------------------
    # 5) Holdings enriquecidos (Analisis BD) -- Rating/E/S/G/Controversias/
    #    CO2/Cobertura -> detalle + cálculo de cobertura (reemplaza BD1_S R1:Y21)
    # ----------------------------------------------------------------
    archivos_analisis = detectar_archivos_analisis_bd(RUTA_ANALISIS_BD)
    log(mensajes_log, "INFO", f"Encontrados {len(archivos_analisis)} archivos 'Analisis BD'")
    for archivo in archivos_analisis:
        h = hash_archivo(archivo["path"])
        if control_previo.get(archivo["nombre"]) == h:
            continue
        try:
            detalle, cobertura = extraer_analisis_bd(archivo, mensajes_log)
            nuevas["Holdings_AnalisisBD"].extend(detalle)
            nuevas["Cobertura_Holdings"].extend(cobertura)
            control_nuevo[archivo["nombre"]] = h
            log(mensajes_log, "INFO", f"OK: {archivo['nombre']} ({len(detalle)} filas)")
        except Exception as e:
            log(mensajes_log, "ERROR", f"Se saltó {archivo['nombre']} por error: {e}")
            log(mensajes_log, "ERROR", traceback.format_exc())

    # ----------------------------------------------------------------
    # Fusionar con histórico y escribir el archivo madre
    # ----------------------------------------------------------------
    dfs_finales = {}
    for hoja, (llave, _clave) in HOJAS.items():
        df_viejo = cargar_hoja_existente(RUTA_SALIDA, hoja)
        df_nuevo = pd.DataFrame(nuevas[hoja])
        dfs_finales[hoja] = fusionar_y_deduplicar(df_viejo, df_nuevo, llave)

    # Controversias: NO existe un archivo mensual fuente para esto (es un
    # watchlist curado a mano). El script nunca la toca si ya existe en
    # ESG Core F.xlsx -- solo la crea vacía, con las columnas listas, la
    # primera vez (Franco pega ahí, una sola vez, el contenido actual de la
    # hoja "Controversias" de Reporte Mensual ESG.xlsm, y de ahí en
    # adelante la mantiene directamente en ESG Core F.xlsx).
    df_controversias = cargar_hoja_existente(RUTA_SALIDA, HOJA_CONTROVERSIAS)
    if df_controversias.empty:
        df_controversias = pd.DataFrame(
            columns=["Fecha", "Empresa", "Factor", "Tipo", "Estado", "Resumen"])

    df_control = pd.DataFrame(
        [{"Archivo": k, "Hash": v} for k, v in control_nuevo.items()]
    )
    df_log = pd.concat([
        cargar_hoja_existente(RUTA_SALIDA, HOJA_LOG),
        pd.DataFrame(mensajes_log),
    ], ignore_index=True)

    with pd.ExcelWriter(RUTA_SALIDA, engine="openpyxl") as writer:
        for hoja, df in dfs_finales.items():
            if df is None:
                df = pd.DataFrame()
            df.to_excel(writer, sheet_name=hoja, index=False)
        df_controversias.to_excel(writer, sheet_name=HOJA_CONTROVERSIAS, index=False)
        df_control.to_excel(writer, sheet_name=HOJA_CONTROL, index=False)
        df_log.to_excel(writer, sheet_name=HOJA_LOG, index=False)

    log(mensajes_log, "INFO", f"=== Listo. Archivo actualizado: {RUTA_SALIDA} ===")
    for hoja, df in dfs_finales.items():
        print(f"  - {hoja}: {len(df)} filas")


if __name__ == "__main__":
    main()
