def log(mensajes, nivel, texto):
    """Acumula un mensaje de log (nivel: INFO/WARN/ERROR) con timestamp."""
    mensajes.append({
        "Fecha_Proceso": datetime.now(),
        "Nivel": nivel,
        "Mensaje": texto,
    })
    print(f"[{nivel}] {texto}")


def safe_float(v):
    """Convierte a float de forma defensiva; None/'' / texto raro -> None."""
    if v is None:
        return None
    if isinstance(v, (int, float)):
        try:
            if pd.isna(v):
                return None
        except Exception:
            pass
        return float(v)
    s = str(v).strip().replace("%", "").replace(",", ".")
    if s in ("", "N/A", "n/a", "#N/A", "#REF!", "-"):
        return None
    try:
        return float(s)
    except ValueError:
        return None


def primer_dia_mes(anio, mes):
    return date(anio, mes, 1)


def parse_fecha_yyyymm(texto6):
    """'202610' -> date(2026,10,1)"""
    anio = int(texto6[0:4])
    mes = int(texto6[4:6])
    if not (1 <= mes <= 12) or not (2000 <= anio <= 2100):
        raise ValueError(f"Fecha YYYYMM inválida: {texto6}")
    return primer_dia_mes(anio, mes)


def parse_fecha_mmyyyy(texto6):
    """'112026' -> date(2026,11,1)"""
    mes = int(texto6[0:2])
    anio = int(texto6[2:6])
    if not (1 <= mes <= 12) or not (2000 <= anio <= 2100):
        raise ValueError(f"Fecha MMYYYY inválida: {texto6}")
    return primer_dia_mes(anio, mes)


def hash_archivo(path):
    """Huella rápida (tamaño + fecha de modificación) para no reprocesar
    un archivo que no ha cambiado. No se usa hash de contenido completo
    por velocidad (archivos de red, cientos de MB en conjunto)."""
    st = os.stat(path)
    base = f"{os.path.basename(path)}|{st.st_size}|{int(st.st_mtime)}"
    return hashlib.md5(base.encode("utf-8")).hexdigest()


def leer_grid(ws):
    """Carga TODA la hoja a memoria de una sola pasada secuencial
    (ws.iter_rows es rápido incluso en modo read_only) y la devuelve como
    lista de tuplas 1-indexada (grid[0] queda vacío para que grid[r][c]
    corresponda directamente a la fila/columna de Excel).

    Acceder celda por celda con ws.cell(row, column) en modo read_only es
    muchísimo más lento (cada llamada reconstruye estado interno), así que
    TODAS las funciones de extracción trabajan sobre este grid en memoria
    en vez de volver a tocar el objeto worksheet."""
    grid = [()]  # índice 0 sin uso, para que grid[r] = fila r de Excel
    for fila in ws.iter_rows(values_only=True):
        grid.append(fila)
    return grid


def celda(grid, row, col):
    """Valor de la celda (row, col), 1-indexado, tolerante a fuera de rango."""
    if row <= 0 or row >= len(grid):
        return None
    fila = grid[row]
    if col <= 0 or col > len(fila):
        return None
    return fila[col - 1]


def buscar_fila_por_etiqueta(grid, col, etiqueta, fila_ini, fila_fin):
    """Busca en la columna `col` (1-indexed) entre fila_ini y fila_fin una
    celda cuyo texto (stripeado) sea exactamente `etiqueta`. Devuelve el
    número de fila o None si no la encuentra."""
    fila_fin = min(fila_fin, len(grid) - 1)
    for r in range(fila_ini, fila_fin + 1):
        v = celda(grid, r, col)
        if v is not None and str(v).strip() == etiqueta:
            return r
    return None


