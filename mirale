function buildRegionGroups(){
  const grupos = {};
  D.forEach(d=>{
    const label = regionLabelOfDep(normDep(d.dep));
    if(!label) return;
    const g = grupos[label] || (grupos[label]={aum:0, emp:{}});
    (d.ap||[]).forEach(a=>{
      const m = a.m * classFrac(a.e);
      if(m<=0) return;
      const nAct = (a.ac && a.ac.length) ? a.ac.length : 1;
      g.aum += m;
      const e = g.emp[a.e] || (g.emp[a.e]={sector: EMP_SEC[a.e]||a.s||'', n:0, aum:0});
      e.n += nAct;
      e.aum += m;
    });
  });
  // Conteo "Activos Físicos" de emisores departamentales (InRetail / Shopping
  // Malls): usar el conteo físico de 'Activos Departamentales' por región.
  Object.keys(ACTIVOS_FISICOS_FEN).forEach(emisor=>{
    const porReg = ACTIVOS_FISICOS_FEN[emisor] || {};
    Object.keys(porReg).forEach(label=>{
      const g = grupos[label] || (grupos[label]={aum:0, emp:{}});
      const e = g.emp[emisor] || (g.emp[emisor]={sector: EMP_SEC[emisor]||'', n:0, aum:0});
      e.n = porReg[label];
    });
  });
  return grupos;
}
```

