def _norm_cols(df):
    """Normaliza etiquetas de columnas: quita espacios sobrantes y saltos de linea.
    Evita KeyError por nombres con espacios invisibles (causa tipica del error 7)."""
    nuevas = []
    for c in df.columns:
        if isinstance(c, str):
            nuevas.append(c.strip().replace("\n", " ").replace("\r", " "))
        else:
            nuevas.append(c)
    df.columns = nuevas
    return df

def calcular_categorias(DF, bloque, mes="", anio=""):
    """Calcula Normal / Con Problemas / Deficiente / Dudoso / Perdida validando
    que existan las columnas requeridas. Si falta alguna, imprime un diagnostico
    claro (bloque, mes, columnas presentes) y detiene la ejecucion con mensaje util."""
    DF = _norm_cols(DF)
    requeridas = ["Normal_", "Con Problemas_", "Deficiente_", "Dudoso_",
                  "Pérdida_", "Total Créditos_"]
    faltantes = [c for c in requeridas if c not in DF.columns]
    if faltantes:
        print("=" * 70)
        print(f"[ERROR CALCULO] Bloque: {bloque}  |  {mes} {anio}")
        print(f"  -> Faltan columnas requeridas: {faltantes}")
        print(f"  -> Columnas presentes ({len(DF.columns)}): {list(DF.columns)}")
        print("  -> Revisar estructura del XLS de la SBS (filas de encabezado / "
              "cambio de formato) o el Diccionario_SBS (Nombre_Nuevo).")
        print("=" * 70)
        raise KeyError(
            f"[{bloque} - {mes} {anio}] Columnas faltantes para el calculo: {faltantes}"
        )
    tc = DF["Total Créditos_"]
    DF["Normal"]        = DF["Normal_"]        * tc / 100
    DF["Con Problemas"] = DF["Con Problemas_"] * tc / 100
    DF["Deficiente"]    = DF["Deficiente_"]    * tc / 100
    DF["Dudoso"]        = DF["Dudoso_"]        * tc / 100
    DF["Pérdida"]       = DF["Pérdida_"]       * tc / 100
    return DF

def _leer_excel_seguro(ruta, bloque, mes="", anio=""):
    """Lectura de Excel con mensaje claro si el archivo no existe o no se puede abrir."""
    if not os.path.isfile(ruta):
        print("=" * 70)
        print(f"[ERROR ARCHIVO] Bloque: {bloque}  |  {mes} {anio}")
        print(f"  -> No se encontro el archivo: {ruta}")
        print("=" * 70)
        raise FileNotFoundError(f"[{bloque} - {mes} {anio}] No existe: {ruta}")
    try:
        return pd.read_excel(ruta, sheet_name=0)
    except Exception as e:
        print("=" * 70)
        print(f"[ERROR LECTURA] Bloque: {bloque}  |  {mes} {anio}")
        print(f"  -> Ruta: {ruta}")
        print(f"  -> Detalle: {e}")
        print("=" * 70)
        raise

