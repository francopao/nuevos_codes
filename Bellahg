            Set ser = cht.Chart.SeriesCollection(i)
            frm = ser.Formula
            If Err.Number <> 0 Then
                Debug.Print "IGNORADO -> " & cht.Name & " | Serie " & i & " | " & Err.Description
                Ignorados = Ignorados + 1
