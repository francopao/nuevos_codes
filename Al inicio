function renderChart4(){
  const c4 = PAYLOAD.chart4;
  const conf = c4.conflicto, guia = c4.guia, tabla = c4.tabla, coords = c4.coords;

  const confTrace = {
    type:"scattergeo", mode:"markers", name:"Conflictividad", showlegend:false,
    lat: conf.map(d=>coords[d.dpto][0]), lon: conf.map(d=>coords[d.dpto][1]),
    marker:{ size:34, color: conf.map(d=>d.indice), colorscale:"Blues",
             cmin:0, cmax:10, showscale:true,
             colorbar:{ title:{text:"+ Conflictos", font:{size:9}}, thickness:12, len:0.65, x:1.02 },
             line:{color:"#7f8fa6", width:1}, opacity:0.55 },
    text: conf.map(d=>`${d.dpto}<br>Índice de conflictividad: ${d.indice.toFixed(1)}`),
    hovertemplate:"%{text}<extra></extra>"
  };
  const guiaTrace = {
    type:"scattergeo", mode:"markers+text", showlegend:false,
    lat: guia.map(g=>coords[g.dpto][0]), lon: guia.map(g=>coords[g.dpto][1]),
    text: guia.map(g=>String(g.n)), textfont:{color:"#1F3864", size:11},
    marker:{size:20, color:"#ffffff", line:{color:"#1F3864", width:1.4}},
    hovertext: guia.map(g=>g.dpto), hovertemplate:"%{hovertext}<extra></extra>"
  };
  const porEmpresa = {};
  tabla.forEach(t=>{ (porEmpresa[t.empresa]=porEmpresa[t.empresa]||[]).push(t); });
  const empresaTraces = Object.keys(porEmpresa).map((emp,ei)=>{
    const arr = porEmpresa[emp];
    return {
      type:"scattergeo", mode:"markers", name: emp,
      lat: arr.map((t,i)=>coords[t.dpto][0] + i*0.12),
      lon: arr.map((t,i)=>coords[t.dpto][1] + (ei*0.10 - 0.3)),
      marker:{ size: arr.map(t=>6+16*Math.sqrt(t.ing/1037)),
               color: c4.colores[emp], line:{color:"#fff", width:1} },
      text: arr.map(t=>`<b>${emp}</b><br>${t.dpto}<br>Ingreso: US$ ${fmtMM(t.ing)} MM (${t.pct}%)`),
      hovertemplate:"%{text}<extra></extra>"
    };
  });

  const layout = {
    margin:{l:0,r:0,t:0,b:0},
    legend:{ orientation:"h", x:0.5, xanchor:"center", y:-0.06, font:{size:9} },
    geo: geoLayout()
  };
  Plotly.newPlot("c4_plot", [confTrace, guiaTrace, ...empresaTraces], layout, CFG);

  document.getElementById("c4_guia").textContent =
    guia.map(g=>`${g.n}. ${g.dpto}`).join("   ·   ");

  const tbody = document.getElementById("c4_tabla_body");
  let lastEmp = null;
  tabla.forEach(t=>{
    const tr = document.createElement("tr");
    const showEmp = t.empresa !== lastEmp;
    lastEmp = t.empresa;
    tr.innerHTML = `<td style="${showEmp?'font-weight:700;color:#1F3864;':''}">${showEmp?t.empresa:""}</td>`
      + `<td>${t.dpto}</td><td style="text-align:right;">${fmtMM(t.ing)}</td>`
      + `<td style="text-align:right;">${t.pct}%</td>`;
    tbody.appendChild(tr);
  });
}

