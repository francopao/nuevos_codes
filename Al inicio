// ---------------------------------------------------------------- CHART 3
function renderChart3(){
  const data = PAYLOAD.chart3.amenazas;
  const traces = data.map(a=>({
    type:"scatter", mode:"lines", fill:"toself",
    x: a.puntos.map(p=>p[0]), y: a.puntos.map(p=>p[1]),
    line:{color:a.color, width:1}, fillcolor:a.color,
    name:a.nombre, hoverinfo:"name", opacity:0.96
  }));
  const annotations = data.map(a=>{
    const cx = a.puntos.reduce((s,p)=>s+p[0],0)/a.puntos.length;
    const cy = a.puntos.reduce((s,p)=>s+p[1],0)/a.puntos.length;
    const oscuro = (a.nombre==="Crimen organizado" || a.nombre==="Terrorismo");
    return { x:cx, y:cy, text:a.nombre.replace(" ","<br>"), showarrow:false,
             font:{size:11, color: oscuro ? "#ffffff":"#1F3864"} };
  });
  const layout = {
    margin:{l:10,r:10,t:10,b:40}, plot_bgcolor:"#fff", paper_bgcolor:"#fff",
    showlegend:false,
    xaxis:{ tickvals: PAYLOAD.chart3.ticks, range:[1978, 2027],
            showgrid:true, gridcolor:"#eef1f5", zeroline:false,
            linecolor:"#b9c0cc", tickfont:{size:11,color:"#1F3864"} },
    yaxis:{ visible:false, range:[0,4.6] },
    annotations
  };
  Plotly.newPlot("c3_plot", traces, layout, CFG);
}

