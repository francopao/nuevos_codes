def spiral_offset(k, spacing=0.28):
    """Desplazamiento en espiral (ángulo dorado) para separar burbujas
    dentro de un mismo grupo, evitando solapes fuertes."""
    if k == 0:
        return 0.0, 0.0
    ang = k * 137.508 * math.pi / 180.0
    r = spacing * math.sqrt(k)
    return r * math.cos(ang), r * math.sin(ang) * 0.9


def extraer_anio_inicio(valor):
    """Extrae el año de inicio desde 'Inicio / Fin de Ejecución' (col. A),
    p.ej. '2026 / 2031' -> 2026. Devuelve None si no hay fecha definida."""
    if valor is None:
        return None
    primero = str(valor).split("/")[0].strip()
    return int(primero) if primero.isdigit() else None


def clasificar_categoria(nombre):
    n = nombre.strip().lower()
    if n.startswith("reposición") or n.startswith("reposicion"):
        return "Extensión de Vida Útil"
    return "Nuevas Minas o Ampliaciones"


def clasificar_etapa_grupo(etapa):
    e = (etapa or "").strip().lower()
    if e.startswith("ejecuci"):
        return "En Construcción"
    return "En Planificación"


# ------------------------------------------------------------------ CHART 1
def construir_chart1(df):
    """'Proyectos mineros': bubble timeline por año de inicio de construcción,
    con un bloque agregado 'Por Definir' para proyectos sin fecha de inicio."""
    con_fecha, sin_fecha = [], []
    for _, r in df.iterrows():
        proyecto = str(r["proyecto"]).strip()
        if not proyecto or proyecto.lower() == "nan":
            continue
        anio = extraer_anio_inicio(r["inicio_fin"])
        capex = float(r["capex"]) if r["capex"] is not None and str(r["capex"]) != "nan" else 0.0
        item = dict(
            proyecto=proyecto,
            operador=str(r["operador"]) if r["operador"] is not None else "",
            departamento=str(r["departamento"]) if r["departamento"] is not None else "",
            producto=str(r["producto"]) if r["producto"] is not None else "",
            etapa=str(r["etapa"]) if r["etapa"] is not None else "",
            capex=round(capex, 1),
        )
        if anio is not None:
            item["anio"] = anio
            con_fecha.append(item)
        else:
            sin_fecha.append(item)

    anios = sorted({it["anio"] for it in con_fecha})
    columnas = [str(a) for a in anios]
    if sin_fecha:
        columnas.append("Por Definir")

    max_dated = max([it["capex"] for it in con_fecha] + [0.1])
    agregado_capex = sum(it["capex"] for it in sin_fecha)
    max_global = max(max_dated, agregado_capex, 0.1)

    def size_px(capex_val):
        capex_val = max(capex_val, 0.1)
        return 20 + 62 * math.sqrt(capex_val / max_global)

    puntos = []
    for idx_col, col in enumerate(columnas):
        if col == "Por Definir":
            n = len(sin_fecha)
            puntos.append(dict(
                x=idx_col, y=0.0, size=size_px(agregado_capex),
                proyecto=f"{n} proyectos", operador="", departamento="",
                producto="", etapa="Por Definir",
                capex=round(agregado_capex, 1), agregado=True, n=n,
                color=COLOR_COMPS,
            ))
            continue
        items = [it for it in con_fecha if it["anio"] == int(col)]
        items.sort(key=lambda it: it["capex"], reverse=True)
        for k, it in enumerate(items):
            dx, dy = spiral_offset(k)
            puntos.append(dict(
                x=idx_col + dx, y=dy, size=size_px(it["capex"]),
                proyecto=it["proyecto"], operador=it["operador"],
                departamento=it["departamento"], producto=it["producto"],
                etapa=it["etapa"], capex=it["capex"], agregado=False,
                color=COLOR_INDIV[k % len(COLOR_INDIV)],
            ))

    log(f"Chart1 'Proyectos mineros': {len(puntos)} burbujas en "
        f"{len(columnas)} columnas ({', '.join(columnas)}).")
    return dict(columnas=columnas, puntos=puntos)


# ------------------------------------------------------------------ CHART 2
def construir_chart2(df):
    """'Ubicación de los principales proyectos mineros': mapa de Perú con
    los proyectos ubicados por departamento, coloreados por categoría
    (Extensión de Vida Útil / Nuevas Minas o Ampliaciones) y etapa."""
    registros = []
    conteo_coord = {}
    omitidos = []
    for _, r in df.iterrows():
        proyecto = str(r["proyecto"]).strip()
        if not proyecto or proyecto.lower() == "nan":
            continue
        dpto = str(r["departamento"]).strip() if r["departamento"] is not None else ""
        coords = DEPTO_COORDS.get(dpto)
        if not coords:
            omitidos.append(f"{proyecto} ({dpto})")
            continue
        categoria = clasificar_categoria(proyecto)
        etapa_grp = clasificar_etapa_grupo(str(r["etapa"]) if r["etapa"] is not None else "")
        k = conteo_coord.get(dpto, 0)
        conteo_coord[dpto] = k + 1
        jdx, jdy = spiral_offset(k, spacing=0.35)
        capex = float(r["capex"]) if r["capex"] is not None and str(r["capex"]) != "nan" else 0.0
        registros.append(dict(
            proyecto=proyecto,
            operador=str(r["operador"]) if r["operador"] is not None else "",
            departamento=dpto,
            producto=str(r["producto"]) if r["producto"] is not None else "",
            etapa=str(r["etapa"]) if r["etapa"] is not None else "",
            capex=round(capex, 1), categoria=categoria, etapa_grupo=etapa_grp,
            color=GRUPO_COLOR[(categoria, etapa_grp)],
            lat=round(coords[0] + jdy * 0.05, 4),
            lon=round(coords[1] + jdx * 0.05, 4),
        ))
    if omitidos:
        warn(f"Chart2: {len(omitidos)} proyecto(s) sin coordenadas (departamento "
             f"no mapeado): {', '.join(omitidos[:5])}"
             + (" ..." if len(omitidos) > 5 else ""))
    log(f"Chart2 'Ubicación de proyectos mineros': {len(registros)} proyectos ubicados.")
    return registros


# ------------------------------------------------------------------ EXTRACT
def construir_dataset(xlsx_path):
    import pandas as pd

    log(f"Leyendo hoja '{SHEET_NAME}' (columnas A:H) de {os.path.basename(xlsx_path)}...")
    df = pd.read_excel(xlsx_path, sheet_name=SHEET_NAME, header=0, usecols="A:H")
    df.columns = ["inicio_fin", "puesta_marcha", "proyecto", "operador",
                  "departamento", "producto", "etapa", "capex"]
    df = df[df["proyecto"].notna()].reset_index(drop=True)
    df = df.where(df.notna(), None)
    log(f"Proyectos leídos: {len(df)}")

    chart1 = construir_chart1(df)
    chart2 = construir_chart2(df)
    return chart1, chart2


