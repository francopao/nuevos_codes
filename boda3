// --- Datos auxiliares: Comparables (Intensidad) — Integra vs otras AFPs vs Benchmarks ---
function serieCategoriaAfp(objeto, metrica, corte, afp){
  const met = metricaDisponible(objeto, metrica, corte);
  const m = new Map();
  for(const r of HIST){
    if(r.OBJETO!==objeto || r.METRICA!==met) continue;
    if(String(r.FECHA_CORTE)!==String(corte)) continue;
    if((r.AFP||'Integra')!==afp) continue;
    const k = r.DIM_1 + (r.DIM_2==='Proxies' ? ' (Proxies)' : '');
    if(!k) continue;
    m.set(k, (m.get(k)||0) + (+r.VALOR||0));
  }
  return m;
}

function serieEmisorGOB(corte){
  const met = metricaDisponible('Soberanos', 'Intensidad', corte);
  const m = new Map();
  for(const r of HIST){
    if(r.OBJETO!=='Soberanos' || r.METRICA!==met) continue;
    if(String(r.FECHA_CORTE)!==String(corte)) continue;
    if((r.AFP||'Integra')!=='Integra') continue;
    const k = r.DIM_1;
    if(!k) continue;
    m.set(k, (m.get(k)||0) + (+r.VALOR||0));
  }
  return m;
}

function valorComparableAfp(alias, metrica, corte){
  const met = metricaDisponible('Comparables', metrica, corte);
  let v = 0;
  for(const r of HIST){
    if(r.OBJETO==='Comparables' && r.METRICA===met &&
       String(r.FECHA_CORTE)===String(corte) &&
       (r.AFP||'Integra')==='Integra' && r.DIM_1===alias){ v += +r.VALOR||0; }
  }
  return v;
}

function _sumaMapa(m){ let t=0; m.forEach(v=>t+=v); return t; }
```

