#%%
def renombrar_columnas_por_posicion(df, mapping):
    cols = list(df.columns)
    for pos, nombre in mapping.items():
        if pos < len(cols):
            cols[pos] = nombre
    df.columns = cols
    return df
#%%
def convertir_a_numerico_seguro(df, desde_col=1):
    """
    Reemplaza el patrón 'DF.iloc[:, 1:] = DF.iloc[:, 1:].apply(pd.to_numeric, errors="coerce")'.
    Motivo del fix: con pandas moderno, pd.read_excel puede devolver columnas con dtype
    'string'/Arrow (p. ej. una columna vacía como "Fondos Interbancarios" que solo trae NaN).
    Al asignar con .iloc[:, 1:] = ..., pandas intenta escribir el resultado IN-PLACE sobre
    ese bloque 'string', y si el valor nuevo es float (producto de to_numeric) y la columna
    original no es 'object', pandas lanza TypeError en vez de reemplazar el bloque.
    Asignando columna por columna vía DF[col] = ... (en vez de .iloc) se reemplaza el bloque
    completo por uno nuevo con el dtype correcto, evitando el intento de escritura in-place
    y por lo tanto el error, sin alterar ningún valor resultante ni la estructura del DF.
    """
    cols = df.columns[desde_col:]
    df[cols] = df[cols].apply(pd.to_numeric, errors="coerce")
    return df
