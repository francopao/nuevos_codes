# SubCat de un instrumento FFMM/ETF: Mercado para RV (DM/EM/Commodities),
# AC_Dir para RF (HY/IG/EM/DM/Senior Loans). Función única y compartida:
# la usan tanto el top 5 de cada AFP como el peer group cross-AFP del
# benchmark "Intensidad Promedio - Comparables", para que ambos agrupen
# exactamente igual.
def _subcat_activo(row, bloque: str) -> str:
    if bloque == "Equities":
        m = str(row.get("GyP_MERCADO", "") or "").strip()
        return m if m else str(row.get("GyP_CAT", "") or "").strip() or "Otros"
    else:
        raw = str(row.get("GyP_AC_DIR", "") or "").strip()
        if "HY" in raw: return "HY"
        if "IG" in raw: return "IG"
        if "EM" in raw: return "EM"
        if "DM" in raw: return "DM"
        if "SL" in raw: return "Senior Loans"
        cat = str(row.get("GyP_CAT", "") or "").strip()
        return cat if cat else raw or "Otros"


def _peer_group_co2h(vals_ctx: dict) -> Dict[str, float]:
    """Promedio de CO2-H (intensidad intrínseca del instrumento, SIN el
    Weight de ningún fondo) por (Bloque, SubCat), usando el universo
    FFMM/ETF no-proxy de TODAS las AFPs juntas (F1+F2+F3 de cada una) —
    el peer group ampliado del benchmark 'Intensidad Promedio - Comparables'
    de Chart 3. Puramente informativo para ese benchmark: NO modifica
    ningún Weight real de ninguna cartera."""
    piezas = []
    for afp, par in vals_ctx.items():
        val = par[0]
        if val is None or val.empty:
            continue
        d = _base(val)
        d = _sin_huella_cero(d)
        if "GyP_UNIVERSO_VALIDO" not in d.columns:
            continue
        d = d[d["GyP_UNIVERSO_VALIDO"] == True]
        if COL["plus"] in d.columns:
            d = d[d[COL["plus"]] != "Proxies"]
        if not d.empty:
            piezas.append(d)
    if not piezas:
        return {}
    universo = pd.concat(piezas, ignore_index=True)

    ac_map = {"Renta Variable": "Equities", "Renta Fija": "Fixed Income"}
    out: Dict[str, float] = {}
    for ac_orig, bloque in ac_map.items():
        sub = universo[universo["GyP_ASSET_CLASS"] == ac_orig]
        if sub.empty:
            continue
        sub = sub.copy()
        sub["__subcat"] = sub.apply(lambda r: _subcat_activo(r, bloque), axis=1)
        sub["CO2-H"] = pd.to_numeric(sub["CO2-H"], errors="coerce").fillna(0.0)
        prom = sub.groupby("__subcat")["CO2-H"].mean()
        for sc, v in prom.items():
            out[bloque + "|" + str(sc)] = float(v)
    return out


