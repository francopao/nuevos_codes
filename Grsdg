# ============================================================
# EQUIVALENCIAS DE DETALLADA (cuando SBS usa un texto distinto
# para el mismo indicador entre entregas o entre instituciones).
# La key es lo que produce limpiar_etiqueta_sbs(); el value es
# el nombre canónico que queremos en la base.
# ============================================================
CANONICAL_DETALLADA = {
    "Gastos de Administración Anualizado / Activo Productivo Promedio":
        "Gastos de Administración Anualizados / Activo Productivo Promedio",
    "Utilidad Anualizada / Patrimonio Promedio":
        "Utilidad Neta Anualizada / Patrimonio Promedio",
    "Utilidad Anualizada / Activo Promedio":
        "Utilidad Neta Anualizada / Activo Promedio",
}

def normalizar_detallada(texto):
    return CANONICAL_DETALLADA.get(texto, texto)

```

