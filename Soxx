# Guarda con reintentos: cubre locks transitorios de red/antivirus en Z:, no solo "archivo abierto en Excel"
def guardar_csv_con_reintentos(df, ruta, index=False, intentos=5, espera_seg=3):
    for i in range(1, intentos+1):
        try:
            df.to_csv(ruta, index=index)
            return
        except PermissionError:
            if i < intentos:
                print(f"AVISO: '{ruta}' bloqueado (intento {i}/{intentos}). Reintentando en {espera_seg}s...")
                time.sleep(espera_seg)
            else:
                print(f"ERROR: '{ruta}' sigue bloqueado tras {intentos} intentos. Verifica que nadie lo tenga abierto (Excel, OneDrive, antivirus) y vuelve a ejecutar.")
                raise

