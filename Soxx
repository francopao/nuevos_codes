def formateando_fechas(fechas):
    year = fechas[:4]
    month = fechas[5:7]
    day = fechas[8:10]
    return f"{year}-{month}-{day}"

def DQ_IN(df1):

    ListaIN = ["Fondo","Dato","Fecha", 'VALFON']

    #Se eliminan las primeras filas del documento que no serán usadas
    df1 = df1.drop(df1.index[list(range(0, 10))])
    df1 = df1.transpose()
    df1 =df1.rename(columns={10:"Isins"})
    filtrada=df1[df1["Isins"].isin(ListaIN)]
    filtrada = filtrada.transpose()
    filtrada1 = filtrada
    filtrada1.columns=filtrada.iloc[0].to_list()
    filtrada = filtrada1[1:]

    Qest_DQ_IN_Fechas = filtrada["Fecha"].values.tolist()
        
    Nuevos_DQ_IN=filtrada
    Nuevos_DQ_IN=Nuevos_DQ_IN.reset_index()
    Nuevos_DQ_IN =Nuevos_DQ_IN.drop("index",axis=1)
    Nuevos_DQ_IN = Nuevos_DQ_IN.loc[Nuevos_DQ_IN['Dato'].str.contains(r'PxQ')]
    Nuevos_DQ_IN=Nuevos_DQ_IN.drop("Dato",axis=1)
    
    Nuevos_DQ_IN["Fecha"]= Nuevos_DQ_IN["Fecha"].apply(formateando_fechas)
    
    _val = pd.to_datetime(Nuevos_DQ_IN["Fecha"], format="%Y-%m-%d", errors="coerce")
    if _val.isna().any():
        print(f"ALERTA DQ_IN: {_val.isna().sum()} fila(s) con Fecha invalida descartada(s): {Nuevos_DQ_IN.loc[_val.isna(),'Fecha'].unique().tolist()}")
    Nuevos_DQ_IN = Nuevos_DQ_IN[_val.notna()]

    Nuevos_DQ_IN.set_index("Fecha",inplace=True)
    Nuevos_DQ_IN=Nuevos_DQ_IN[Nuevos_DQ_IN.index>="2020-01-02"]
    Nuevos_DQ_IN=Nuevos_DQ_IN.reset_index().drop_duplicates(subset=["Fecha","Fondo"], keep="last").set_index("Fecha")
    Nuevos_DQ_IN_T= Nuevos_DQ_IN.pivot(columns="Fondo", values="VALFON")
        
    return Nuevos_DQ_IN_T

