    def sector_msci_vs_proxies(self) -> pd.DataFrame:
        """BU y TD se clasifican igual sean MSCI-directo o Proxy (mismo
        criterio: sector por SBS/Nombre para BU, TIPO_RENTA para TD) — ya
        no hay un bloque 'Proxies' separado. Lo no identificado cae en
        'Otros BU' / 'Otros TD'. Alts se mantiene aparte (100% proxy)."""
        d = _sin_huella_cero(self.df)
        met = [COL["huella"], COL["intensidad"], COL["intensidad_m"], COL["inv"]]
        met = [m for m in met if m in d.columns]

        def suma(sub) -> dict:
            return {m: float(sub[m].sum()) for m in met}

        bu = d[d[COL["estrategia"]].eq("BU")].copy()
        if not bu.empty:
            bu["__sector"] = self._mapear_sector(bu)
        else:
            bu["__sector"] = pd.Series(dtype=object)

        td = d[d[COL["estrategia"]].eq("TD")
               & ~d[COL["plus_1"]].isin(["BU", "Alts"])]
        alt = d[d[COL["estrategia"]].eq("ALT")
                & d[COL["plus"]].eq("Proxies")
                & d[COL["plus_1"]].eq("Alts")]

        filas = []

        def agrega(bloque, categoria, sub):
            filas.append({"Bloque": bloque, "Categoria": categoria, **suma(sub)})

        for cat in ("Materials", "Utilities"):
            agrega("MSCI", cat, bu[bu["__sector"].eq(cat)])
        usados = bu["__sector"].isin(["Materials", "Utilities"])
        agrega("MSCI", "Otros BU", bu[~usados])

        agrega("MSCI", "RF", td[td[COL["tipo_renta"]].eq("RENTA FIJA")])
        agrega("MSCI", "RV", td[td[COL["tipo_renta"]].eq("RENTA VARIABLE")])
        sin_tipo_renta = td[~td[COL["tipo_renta"]].isin(["RENTA FIJA", "RENTA VARIABLE"])]
        agrega("MSCI", "Otros TD", sin_tipo_renta)

        agrega("Proxies", "Alts", alt)

        out = pd.DataFrame(filas)
        out = out[["Categoria", "Bloque"] + met]
        out["__ord"] = out["Categoria"].map(
            {c: i for i, c in enumerate(CATEGORIAS_SECTOR)}).fillna(99)
        return (out.sort_values(["__ord", "Bloque"])
                   .drop(columns="__ord").reset_index(drop=True))
