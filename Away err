**Pegar ANTES (arriba) de esa línea:**

```python
def _filtrar_y_renumerar(puntos):
    """Quita puntos sin decisión y renumera principales y sub-puntos."""
    import copy
    vivos = [copy.copy(p) for p in puntos if (p.get("decision") or "").strip()]
    if not vivos:
        return vivos
    # principales únicos en orden de aparición
    vistos = []
    for p in vivos:
        pto_str = str(p["punto"])
        main = pto_str.split(".")[0] if "." in pto_str else pto_str
        if main not in vistos:
            vistos.append(main)
    mapa = {m: f"{i:02d}" for i, m in enumerate(vistos, 1)}
    sub_cnt = defaultdict(int)
    for p in vivos:
        pto_str = str(p["punto"])
        if "." in pto_str:
            main_v = pto_str.split(".")[0]
            main_n = mapa[main_v]
            sub_cnt[main_n] += 1
            p["punto"] = f"{main_n}.{sub_cnt[main_n]:02d}"
        else:
            p["punto"] = mapa[pto_str]
    return vivos


```

