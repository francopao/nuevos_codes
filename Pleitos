    print(f"[QEST %Fondo] +{len(filas_nuevas)} posiciones CAJ/DPZ/CPC/CPP/CDBCR agregadas "
          f"(aparecerán en Descartes como 'Asset Class no admitido' — esperado, no es error).")

    # ========================================================================
    #  COMPARATIVO G&P vs QEST (crudo) vs QEST (post-renormalización)
    #  Solo diagnóstico/auditoría -> Excel aparte. No altera el pipeline ni
    #  ningún otro output. Objetivo: ver, por instrumento y por fondo, qué tan
    #  distinto es el posicionamiento que decía G&P del que dice QEST, y qué
    #  tan poco (o mucho) mueve la renormalización al valor crudo de QEST.
    # ========================================================================
    try:
        _dic_gyp = {n: dict(zip(b.df_gyp_orig['SBS'].astype(str).str.strip(),
                                 b.df_gyp_orig[n])) for n in ['INF1', 'INF2', 'INF3']}
        _dic_nombre_gyp = dict(zip(b.df_gyp_orig['SBS'].astype(str).str.strip(),
                                    b.df_gyp_orig['Nombre']))
        _dic_ac_gyp = dict(zip(b.df_gyp_orig['SBS'].astype(str).str.strip(),
                                b.df_gyp_orig['Asset Class']))

        _filas_cmp = []
        for nombre_inf, fondo_key in _FONDO_KEYS.items():
            _crudo = dic_pct[fondo_key]                  # tal cual QEST, sin ajustar
            _renorm = b.qest_pct_universo[nombre_inf]    # con CPP restado, FUT fuera, /suma
            _gyp = _dic_gyp[nombre_inf]
            _todos = set(_gyp) | set(_renorm) | {k for k, v in _crudo.items()
                                                  if isinstance(v, (int, float))}
            for sbs in _todos:
                if sbs in _META_QEST:
                    continue
                v_gyp = _gyp.get(sbs)
                v_crudo = _crudo.get(sbs)
                v_crudo = v_crudo if isinstance(v_crudo, (int, float)) else None
                v_renorm = _renorm.get(sbs)
                if not (v_gyp or 0) and not (v_crudo or 0) and not (v_renorm or 0):
                    continue   # sin peso en ninguna de las 3 vistas: no aporta al comparativo
                _clasif = _clasificar_qest_col(sbs)
                _filas_cmp.append({
                    'Fondo': 'F' + nombre_inf[-1],
                    'SBS': sbs,
                    'Nombre': _dic_nombre_gyp.get(sbs) or (_clasif[1] if _clasif else None),
                    'Asset Class': _dic_ac_gyp.get(sbs) or (_clasif[0] if _clasif else None),
                    'Sinónimo QEST': dic_sinonimo.get(sbs),
                    'INF_G&P (original)': v_gyp,
                    'INF_QEST (crudo)': v_crudo,
                    'INF_QEST (post-renormalización)': v_renorm,
                    'Dif. G&P vs QEST crudo (pp)': (None if v_gyp is None or v_crudo is None
                                                     else round((v_crudo - v_gyp) * 100, 4)),
                    'Dif. QEST crudo vs renorm. (pp)': (None if v_crudo is None or v_renorm is None
                                                         else round((v_renorm - v_crudo) * 100, 4)),
                })
        df_cmp = pd.DataFrame(_filas_cmp).sort_values(['Fondo', 'SBS']).reset_index(drop=True)
        arch_cmp = D_INTERMEDIO + f'{b.anio}{b.mes} Comparativo GyP vs QEST.xlsx'
        with pd.ExcelWriter(arch_cmp, engine='openpyxl') as _w:
            df_cmp.to_excel(_w, sheet_name='Detalle', index=False)
        print(f"[COMPARATIVO G&P vs QEST] -> {arch_cmp}  ({len(df_cmp)} filas)")
    except Exception as e:
        print(f"[AVISO] No se pudo generar el comparativo G&P vs QEST (no crítico): {e}")
