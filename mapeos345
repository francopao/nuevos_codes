// --- Chart 3: "Asset Performance por AFP" — barras verticales agrupadas
//     en 3 bloques (Equities / Fixed Income / Market Exposure). 1 barra por
//     subcategoría = instrumento con mayor Intensidad. Color = Active / Passive.
const MGMT_COLOR = {A: '#0B3C5D', P: '#C0392B'};
const MGMT_LABEL = {A: 'Active', P: 'Passive'};

function assetPerformanceAfp(div, corte){
  const filas = [];
  for(const r of HIST){
    if(r.OBJETO!=='TopSubCat_Asset' || String(r.FECHA_CORTE)!==String(corte) ||
       r.METRICA!=='Intensidad') continue;
    const parts = (r.DIM_3||'').split('|');
    const mgmt = parts[0] || 'A';
    const nombre = parts.slice(1).join('|') || '';
    filas.push({bloque:r.DIM_1, subcat:r.DIM_2, mgmt, nombre, val:+r.VALOR||0, afp:r.AFP||''});
  }
  if(!filas.length){ document.getElementById(div).innerHTML=''; return; }
  const best = new Map();
  for(const f of filas){
    const k = f.bloque+'||'+f.subcat;
    if(!best.has(k) || f.val > best.get(k).val) best.set(k, f);
  }
  const bloqueOrden = ['Equities','Fixed Income','Market Exposure'];
  const sub = [...best.values()].sort((a,b) => {
    const ia = bloqueOrden.indexOf(a.bloque), ib = bloqueOrden.indexOf(b.bloque);
    return ia !== ib ? ia - ib : b.val - a.val;
  });
  const esc = _escalaEje(sub.map(s=>s.val));
  const xLabels = sub.map(s=>s.subcat);
  const yVals = sub.map(s=>s.val / esc.div);
  const colores = sub.map(s => MGMT_COLOR[s.mgmt] || '#666');
  const customdata = sub.map(s=>s.nombre);
  const bloques = [];
  let cursor = 0;
  bloqueOrden.forEach(bNombre => {
    const items = sub.filter(s=>s.bloque===bNombre);
    if(!items.length) return;
    const start = cursor; cursor += items.length;
    bloques.push({nombre:bNombre, start, end:cursor-1, centro:(start+cursor-1)/2});
  });
  const traces = [
    {type:'bar', x:xLabels, y:yVals, showlegend:false,
     marker:{color:colores},
     text:yVals.map(v=>v.toFixed(1)), textposition:'outside', cliponaxis:false,
     textfont:{size:10,color:CFG.color_texto},
     customdata, hovertemplate:'%{customdata}<br>%{y:.1f}<extra></extra>'}
  ];
  const mgmtPresentes = [...new Set(sub.map(s=>s.mgmt))].sort();
  mgmtPresentes.forEach(m => {
    traces.push({type:'scatter', mode:'markers', x:[null], y:[null],
      name: MGMT_LABEL[m]||m, marker:{color:MGMT_COLOR[m]||'#666', size:10}});
  });
  const lay = LAYOUT();
  lay.xaxis = {type:'category', tickangle:0, showgrid:false,
               showline:true, linecolor:CFG.color_grid, ticks:''};
  lay.yaxis.title = 'Intensidad' + (esc.suf ? ' — ' + esc.suf : '');
  lay.legend = {orientation:'h', yanchor:'top', y:-0.22, x:0.5, xanchor:'center',
                bgcolor:'rgba(0,0,0,0)'};
  lay.margin = {l:60, r:30, t:55, b:80};
  lay.shapes = bloques.slice(1).map(b => ({
    type:'line', xref:'x', yref:'y domain',
    x0:b.start-0.5, x1:b.start-0.5, y0:0, y1:1,
    line:{color:'#B8C2CC', width:1, dash:'dot'}
  }));
  lay.annotations = bloques.map(b => ({
    x:b.centro, xref:'x', y:1, yref:'y domain', yshift:14,
    text:'<b>'+b.nombre+'</b>', showarrow:false,
    font:{size:12, color:CFG.color_texto}, xanchor:'center', yanchor:'bottom'
  }));
  Plotly.react(div, traces, lay, OPTS);
}



