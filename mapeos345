    def top_por_subcat_asset(self) -> pd.DataFrame:
        """Para cada subcategoría de GYP_ASSET_PERF_MAP, devuelve el instrumento
        con mayor Intensidad. Incluye Bloque, SubCat, Nombre, Intensidad,
        Mgmt (Active/Passive)."""
        d = self.df.copy()
        if "GyP_UNIVERSO_VALIDO" not in d.columns:
            return pd.DataFrame()
        d = d[d["GyP_UNIVERSO_VALIDO"] == True]
        d = _sin_huella_cero(d)
        d[COL["intensidad"]] = pd.to_numeric(d[COL["intensidad"]], errors="coerce").fillna(0.0)
        filas = []
        for bloque, subcats in GYP_ASSET_PERF_MAP:
            for nombre_sub, tipo_filtro, valores in subcats:
                if tipo_filtro == "CAT":
                    sub = d[d["GyP_CAT"].isin(valores)]
                elif tipo_filtro == "AC_DIR_contains":
                    kw = list(valores)[0]
                    sub = d[d["GyP_AC_DIR"].astype(str).str.contains(kw, na=False)]
                elif tipo_filtro == "MERCADO":
                    sub = d[d["GyP_MERCADO"].isin(valores)]
                else:
                    continue
                if sub.empty:
                    continue
                agg = _agg(sub, [COL["nombre"]], [COL["intensidad"]])
                if agg.empty:
                    continue
                top = agg.iloc[0]
                top_rows = sub[sub[COL["nombre"]] == top[COL["nombre"]]]
                mgmt = "A"
                if not top_rows.empty and "GyP_A_P" in top_rows.columns:
                    raw = str(top_rows["GyP_A_P"].iloc[0]).strip()
                    mgmt = raw if raw in ("A", "P") else "A"
                filas.append({
                    "Bloque": bloque,
                    "SubCat": nombre_sub,
                    COL["nombre"]: top[COL["nombre"]],
                    COL["intensidad"]: float(top[COL["intensidad"]]),
                    "Mgmt": mgmt,
                })
        out = pd.DataFrame(filas)
        if out.empty:
            return out
        out["Mgmt_Nombre"] = out["Mgmt"] + "|" + out[COL["nombre"]]
        return out[["Bloque", "SubCat", "Mgmt_Nombre", COL["intensidad"]]]
