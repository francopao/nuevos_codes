def _exportar_universo_ffmm_debug(vals_ctx: dict, output_dir: str,
                                   verbose: bool = True) -> Optional[str]:
    """Excel de diagnóstico: TODO el universo FFMM/ETF (GyP_UNIVERSO_VALIDO),
    F1+F2+F3 de TODAS las AFPs, SIN aplicar huella!=0, SIN excluir Proxy,
    SIN exigir Intensidad!=0 — el universo exacto 'antes de filtros' que
    usan _peer_group_co2h / _peer_group_intensidad antes de filtrar, para
    poder replicar y auditar esos filtros a mano en Excel."""
    ac_map = {"Renta Variable": "Equities", "Renta Fija": "Fixed Income"}
    filas = []
    for afp, par in vals_ctx.items():
        val = par[0]
        if val is None or val.empty:
            continue
        d = _base(val)  # ya filtra a IN-FONDO1/2/3
        if "GyP_UNIVERSO_VALIDO" not in d.columns:
            continue
        d = d[d["GyP_UNIVERSO_VALIDO"] == True]
        if d.empty:
            continue
        d = d.copy()
        for c in [COL["huella"], COL["intensidad"], "CO2-H", "Weight"]:
            if c in d.columns:
                d[c] = pd.to_numeric(d[c], errors="coerce").fillna(0.0)
        d["Bloque"] = d["GyP_ASSET_CLASS"].map(ac_map)
        d = d[d["Bloque"].notna()]
        if d.empty:
            continue
        d["SubCat"] = d.apply(lambda r: _subcat_activo(r, r["Bloque"]), axis=1)
        d["Es_Proxy"] = np.where(d[COL["plus"]] == "Proxies", "Sí", "No") \
            if COL["plus"] in d.columns else "?"
        filas.append(pd.DataFrame({
            "AFP": afp,
            "Portafolio": d[COL["portafolio"]] if COL["portafolio"] in d.columns else "",
            "Nombre": d[COL["nombre"]] if COL["nombre"] in d.columns else "",
            "Bloque": d["Bloque"],
            "SubCat": d["SubCat"],
            "Weight": d["Weight"] if "Weight" in d.columns else 0.0,
            "Huella": d[COL["huella"]] if COL["huella"] in d.columns else 0.0,
            "Intensidad": d[COL["intensidad"]] if COL["intensidad"] in d.columns else 0.0,
            "CO2-H": d["CO2-H"] if "CO2-H" in d.columns else 0.0,
            "Es_Proxy": d["Es_Proxy"],
        }))
    if not filas:
        if verbose:
            print("  [Debug] Universo FFMM/ETF vacío, no se generó el Excel.")
        return None
    universo = pd.concat(filas, ignore_index=True)
    ruta = str(FsPath(output_dir) / "Universo_FFMM_ETF_Debug.xlsx")
    universo.to_excel(ruta, index=False, sheet_name="Universo")
    if verbose:
        print(f"  [Debug] Universo FFMM/ETF ({len(universo)} filas) -> {ruta}")
    return ruta


