## Fix 3 — Reparar lo que ya quedó fragmentado en tu base actual

Los dos fixes de arriba evitan que el problema *siga pasando*, pero no mueven los datos que **ya** quedaron en filas huérfanas (Feb–Jul 2026 de "Total Empresas Financieras", etc.). Para eso corre este script **aparte, una sola vez**, con el Excel cerrado y después de sacar un backup manual:

```python
import pandas as pd

RUTA_ARCHIVO_BASE = r"Z:\Mesa de Inversiones\Bottom-Up\2 Proceso de Inversión Renta Fija\Corporates - Emisiones\Crédito - BU\1. Emisores\1. One pagers\Complementos\Historicos\3.Indicadores Financieros.xlsx"

# (Institución, Nombre que sobra, Nombre correcto que debe quedarse)
EQUIVALENCIAS = [
    ("Financieras",   "Total Empresas Financieras",   "Total Financieras"),
    ("Financieras",   "Total Empresas Financieras1/", "Total Financieras"),
    ("Financieras",   "Financiera Surgir**",          "Financiera Surgir"),
    ("Cajas Rurales", "CRAC\nIncasur",                "CRAC Incasur"),
    ("Cajas Rurales", "CRAC\nIncasur ",               "CRAC Incasur"),
    ("Cajas",         "CMAC Sullana1/",                "CMAC Sullana"),
]

df = pd.read_excel(RUTA_ARCHIVO_BASE, sheet_name="Indicadores")
cols_fecha = [c for c in df.columns if c not in
              ["key", "Institución", "Estructura", "Moneda", "Nombre", "Tipo", "Detallada"]]

for institucion, nombre_sobrante, nombre_correcto in EQUIVALENCIAS:
    filas_sobrantes = df[(df["Institución"] == institucion) & (df["Nombre"] == nombre_sobrante)]

    for _, fila in filas_sobrantes.iterrows():
        match = (
            (df["Institución"] == institucion) &
            (df["Nombre"] == nombre_correcto) &
            (df["Estructura"] == fila["Estructura"]) &
            (df["Moneda"] == fila["Moneda"]) &
            (df["Tipo"] == fila["Tipo"]) &
            (df["Detallada"] == fila["Detallada"])
        )
        if match.any():
            idx_correcto = df.index[match][0]
            for c in cols_fecha:
                if pd.isna(df.at[idx_correcto, c]) and not pd.isna(fila[c]):
                    df.at[idx_correcto, c] = fila[c]
        else:
            df.loc[fila.name, "Nombre"] = nombre_correcto

    df = df[~((df["Institución"] == institucion) & (df["Nombre"] == nombre_sobrante))]

df["key"] = (
    df["Institución"].astype(str) + df["Estructura"].astype(str) +
    df["Moneda"].astype(str) + df["Nombre"].astype(str) +
    df["Tipo"].astype(str) + df["Detallada"].astype(str)
)

with pd.ExcelWriter(RUTA_ARCHIVO_BASE, mode="a", engine="openpyxl", if_sheet_exists="replace") as writer:
    df.to_excel(writer, sheet_name="Indicadores", index=False)

print("Consolidacion completa.")
```

