```python
def normalizar_variables_vulnerability(financieros: dict, produccion: dict, mitigante, sector: str) -> dict:
    net_debt_ebitda = financieros["net_debt_ebitda_x"] or 0
    current_ratio = financieros["current_ratio_x"] or 0
    ebitda_margin = financieros["ebitda_margin"] or 0
    net_ppe = financieros["net_ppe_usd"] or 0
    total_assets = financieros["total_assets_usd"] or 1

    if sector == "Utilities":
        anio = financieros["anio_base"]
        hidro = produccion.get("Hidro", {}).get(anio, 0) or 0
        total_gen = produccion.get("Total generación", {}).get(anio, 0) or 1
        dependencia_hidrica = hidro / total_gen if total_gen else 0
    else:
        # Para Minería (y cualquier sector sin data de generación propia)
        # todavía no tenemos cómo medir esto, así que usamos un valor
        # neutro. Queda marcado como limitación, no como cálculo real.
        dependencia_hidrica = 0.5

    leverage_v = _clip(net_debt_ebitda / NORMALIZACION["leverage_cap_x"])
    liquidez_v = _clip(
        (NORMALIZACION["liquidez_buena_x"] - current_ratio)
        / (NORMALIZACION["liquidez_buena_x"] - NORMALIZACION["liquidez_mala_x"])
    )
    margen_v = _clip(
        (NORMALIZACION["margen_bueno_pct"] - ebitda_margin)
        / (NORMALIZACION["margen_bueno_pct"] - NORMALIZACION["margen_malo_pct"])
    )
    activos_fijos_v = _clip(net_ppe / total_assets)
    adaptacion_v = MAPA_MITIGANTE_A_VULNERABILIDAD.get(mitigante, 1.0)

    return {
        "leverage": leverage_v,
        "liquidez": liquidez_v,
        "margen_operativo": margen_v,
        "intensidad_activos_fijos": activos_fijos_v,
        "dependencia_hidrica": _clip(dependencia_hidrica),
        "capacidad_adaptacion": adaptacion_v,
    }
```

