Reemplaza toda la función por:

```python
def ajustar_dcf(financieros: dict, delta_ebitda_pct: float) -> dict:
    """
    Escalamos directo el Valor de la Firma que ya trae el modelo, por el
    mismo % de impacto que calculamos sobre el EBITDA. La Deuda Neta la
    dejamos fija (un golpe operativo no cambia la deuda de un día para
    otro), y de ahí sacamos el Patrimonio y el Valor Fundamental ajustados.
    """
    valor_firma_base = financieros["valor_firma"]
    valor_firma_ajustado = valor_firma_base * (1 + delta_ebitda_pct) if valor_firma_base else None

    deuda_neta = financieros["deuda_neta_dcf"]
    patrimonio_ajustado = (
        valor_firma_ajustado - deuda_neta if valor_firma_ajustado is not None and deuda_neta is not None else None
    )
    valor_x_accion_ajustado = (
        patrimonio_ajustado / financieros["n_acciones_mn"]
        if patrimonio_ajustado is not None and financieros["n_acciones_mn"]
        else None
    )

    return {
        "valor_firma_base": valor_firma_base,
        "valor_firma_ajustado": valor_firma_ajustado,
        "valor_fundamental_base": financieros["valor_fundamental_x_accion"],
        "valor_fundamental_ajustado": valor_x_accion_ajustado,
    }
```

