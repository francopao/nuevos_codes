def cargar_financieros(ruta_valorizacion: str, empresa: str, anio_base: int = 2025) -> dict:
    config = CONFIG_EMPRESAS[empresa]
    wb = openpyxl.load_workbook(ruta_valorizacion, data_only=True)
    ws = wb[config["hoja_ratios"]]

    headers = [ws.cell(2, c).value for c in range(1, ws.max_column + 1)]
    col_anio = None
    for c, h in enumerate(headers, start=1):
        if h == anio_base:
            col_anio = c
            break
    if col_anio is None:
        raise ValueError(f"No encontramos la columna del año {anio_base} en '{config['hoja_ratios']}'.")

    def valor(etiqueta):
        fila = _buscar_fila(ws, 1, etiqueta)
        if fila is None:
            return None
        return ws.cell(fila, col_anio).value

    financieros = {
        "anio_base": anio_base,
        "revenue_usd": valor("Revenue"),
        "ebitda_usd": valor("EBITDA"),
        "ebitda_margin": valor("EBITDA Margin (%)"),
        "net_debt_ebitda_x": valor("Net debt / EBITDA (x)"),
        "current_ratio_x": valor("Current ratio (x)"),
        "net_ppe_usd": valor("Net PPE"),
        "total_assets_usd": valor("Total assets"),
    }

    # Ya no reconstruimos el DCF año por año: nos quedamos con los totales
    # que el propio modelo ya calculó (Valor de la Firma, etc.) y el ajuste
    # climático se aplica directo sobre esos totales. Así evitamos tener
    # que adivinar cómo cada modelo arma su valor terminal por dentro.
    ws_dcf = wb[config["hoja_dcf"]]
    col = config["columna_valor"]
    financieros["valor_firma"] = ws_dcf.cell(config["fila_valor_firma"], col).value
    financieros["deuda_neta_dcf"] = ws_dcf.cell(config["fila_deuda_neta"], col).value
    financieros["patrimonio_dcf"] = ws_dcf.cell(config["fila_patrimonio"], col).value
    financieros["n_acciones_mn"] = ws_dcf.cell(config["fila_n_acciones"], col).value
    financieros["valor_fundamental_x_accion"] = ws_dcf.cell(config["fila_valor_fundamental"], col).value
    financieros["ultimo_precio"] = ws_dcf.cell(config["fila_ultimo_precio"], col).value

    return financieros
