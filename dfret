```python
def _etiqueta_corte(corte: str) -> str:
    """'202606' -> 'Jun26' (mismo formato que el eje X del dashboard)."""
    c = str(corte)
    meses = {"06": "Jun", "12": "Dic"}
    mes = meses.get(c[4:6], c[4:6]) if len(c) >= 6 else c
    return mes + (c[2:4] if len(c) >= 4 else "")


def _color_pais(pais: str, idx: int) -> str:
    hexc = COLORES_PAIS.get(pais) or COLORES_PAIS_FALLBACK[idx % len(COLORES_PAIS_FALLBACK)]
    return hexc.lstrip("#")


def _agregar_chart_soberanos(ws, tabla: pd.DataFrame, corte_actual: str,
                              corte_comparacion: str, titulo: str) -> None:
    """Agrega, en la misma hoja, una tabla-resumen (fórmulas SUMIFS sobre la
    tabla tidy A:G) + un gráfico de barras apiladas por país — escenario
    AFP=Integra, cortes Actual/Comparación (el default del dashboard).
    Si se edita un Valor en la tabla tidy, todo se recalcula solo."""
    if tabla.empty:
        return
    ultima_fila = len(tabla) + 1  # header en fila 1, datos 2..ultima_fila

    d = tabla[(tabla["AFP"] == "Integra") & (tabla["Corte"].isin([corte_actual, corte_comparacion]))]
    tot_por_pais = d.groupby("Pais")["Valor"].sum()
    paises = [p for p in tot_por_pais.index if abs(tot_por_pais[p]) > 1e-9]

    def _clave_orden(p):
        try:
            i = ORDEN_PAISES.index(p)
        except ValueError:
            i = 999
        return (i, -tot_por_pais.get(p, 0.0))
    paises = sorted(paises, key=_clave_orden)
    if not paises:
        return

    col_label = ws.max_column + 2   # deja 1 columna de separación
    fila_r = 1

    ws.cell(row=fila_r, column=col_label, value="Corte")
    for j, pais in enumerate(paises):
        ws.cell(row=fila_r, column=col_label + 1 + j, value=pais)

    for i, (corte_val) in enumerate([corte_comparacion, corte_actual]):
        fr = fila_r + 1 + i
        ws.cell(row=fr, column=col_label, value=_etiqueta_corte(corte_val))
        for j, pais in enumerate(paises):
            col_l = get_column_letter(col_label + 1 + j)
            f = (f'=SUMIFS($G$2:$G${ultima_fila},$C$2:$C${ultima_fila},"Integra",'
                 f'$D$2:$D${ultima_fila},{col_l}${fila_r},$A$2:$A${ultima_fila},"{corte_val}")')
            ws.cell(row=fr, column=col_label + 1 + j, value=f)

    rango_cmp = (f"{get_column_letter(col_label+1)}{fila_r+1}:"
                 f"{get_column_letter(col_label+len(paises))}{fila_r+1}")
    rango_act = (f"{get_column_letter(col_label+1)}{fila_r+2}:"
                 f"{get_column_letter(col_label+len(paises))}{fila_r+2}")
    ws.cell(row=fila_r + 4, column=col_label, value="Total Comparación")
    ws.cell(row=fila_r + 4, column=col_label + 1, value=f"=SUM({rango_cmp})")
    ws.cell(row=fila_r + 5, column=col_label, value="Total Actual")
    ws.cell(row=fila_r + 5, column=col_label + 1, value=f"=SUM({rango_act})")
    ws.cell(row=fila_r + 6, column=col_label, value="Variación %")
    ws.cell(row=fila_r + 6, column=col_label + 1,
            value=f'=IFERROR({get_column_letter(col_label+1)}{fila_r+5}/'
                  f'{get_column_letter(col_label+1)}{fila_r+4}-1,"s/d")')

    chart = BarChart()
    chart.type = "col"
    chart.grouping = "stacked"
    chart.overlap = 100
    chart.gapWidth = 60
    chart.title = titulo
    chart.y_axis.delete = True
    chart.legend.position = "b"
    chart.height = 7.5
    chart.width = 15

    data_ref = Reference(ws, min_col=col_label + 1, max_col=col_label + len(paises),
                          min_row=fila_r, max_row=fila_r + 2)
    chart.add_data(data_ref, titles_from_data=True)
    cats_ref = Reference(ws, min_col=col_label, max_col=col_label,
                          min_row=fila_r + 1, max_row=fila_r + 2)
    chart.set_categories(cats_ref)
    for i, serie in enumerate(chart.series):
        serie.graphicalProperties = GraphicalProperties(solidFill=_color_pais(paises[i], i))

    ws.add_chart(chart, f"{get_column_letter(col_label)}{fila_r + 8}")

```
*Por qué:* `_agregar_chart_soberanos` es reutilizable para las dos hojas (Huella e Intensidad Soberanos) porque ambas comparten exactamente la misma estructura (Pais/Emisor); solo cambia qué hoja le pasas.

