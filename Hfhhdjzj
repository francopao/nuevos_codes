AFPS_PEORES = ["Integra", "Habitat", "Profuturo", "Prima"]
# en Peores_Contribuyentes el "SPP-IN" es cualquier AFP != Integra;
# para el PPT solo necesitamos Integra y "SPP-IN" como consolidado de las otras
def peores_spp_ex_integra(fecha, fondo):
    sub = peores[(peores["Fecha"] == fecha) & (peores["Fondo"] == fondo) &
                 (peores["Afp"] != "Integra")].copy()
    if sub.empty:
        return go.Figure().to_dict()
    sub["Score_Weight"] = sub["Score"].astype(float) * sub["Weight"].astype(float)
    # agrupar por Nombre (si una misma empresa aparece en varias AFPs del sistema)
    agg = sub.groupby("Nombre", as_index=False).agg(
        Score=("Score", "mean"), Weight=("Weight", "sum"))
    agg["Score_Weight"] = agg["Score"] * agg["Weight"]
    top = agg.nsmallest(12, "Score").sort_values("Score_Weight")
    nombres = top["Nombre"].astype(str).str[:28].tolist()

    fig = go.Figure()
    fig.add_bar(name="Score*Weight", x=nombres, y=top["Score_Weight"].tolist(),
                 marker_color=NAVY, yaxis="y")
    fig.add_bar(name="Weight", x=nombres, y=top["Weight"].tolist(),
                 marker_color=CYAN, yaxis="y2")
    lay = layout_base(f"Menores contribuyentes ESG -- SPP-IN {FONDO_LABEL.get(fondo, fondo)}",
                       altura=360, bar_mode="group")
    lay["yaxis"] = dict(title="Score × Weight (izq)")
    lay["yaxis2"] = dict(title="Weight (der)", overlaying="y", side="right", tickformat=".2%")
    lay["xaxis"] = dict(tickangle=-35)
    fig.update_layout(**lay)
    return fig.to_dict()


