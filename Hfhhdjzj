def pie_controversias(fecha):
    # % con/sin controversias, calculado desde Peores_Contribuyentes a nivel
    # Multifondos (es la foto del portafolio consolidado que muestra el PPT)
    sub = peores[(peores["Fecha"] == fecha) & (peores["Fondo"] == "Multifondos") &
                 (peores["Afp"] == "Integra")]
    if sub.empty:
        return go.Figure().to_dict()
    con_contr = sub.loc[sub["Controversies"].fillna(0) > 0, "Weight"].sum()
    total = sub["Weight"].sum()
    sin_contr = max(total - con_contr, 0)
    fig = go.Figure(go.Pie(
        labels=["Portafolio Sin Controversias", "Portafolio Con Controversias"],
        values=[sin_contr, con_contr],
        marker=dict(colors=[NAVY, ROJO]),
        hole=0.35, textinfo="label+percent",
    ))
    fig.update_layout(**layout_base("Controversias ASG -- Portafolio Directo MSCI", altura=340))
    return fig.to_dict()


def pie_tematica(fecha):
    tr = tematica_resumen[tematica_resumen["Fecha"] == fecha]
    if tr.empty:
        return go.Figure().to_dict()
    fig = go.Figure(go.Pie(
        labels=tr["Categoria"].tolist(),
        values=tr["Inv_MMUSD"].tolist(),
        marker=dict(colors=[CYAN, YELLOW, "#8893C4"]),
        hole=0.35, textinfo="label+percent",
    ))
    fig.update_layout(**layout_base("Inversión Temática -- composición del mes", altura=340))
    return fig.to_dict()


def esg_rating_score_comparativo(fecha):
    # ESG Quality Score por fondo, comparando dos cortes: diciembre del año
    # anterior vs fecha seleccionada. INTEGRA (Base) y EX_IN (Sobs) apiladas.
    fecha_ref = pd.Timestamp(year=pd.Timestamp(fecha).year - 1, month=12, day=1)
    disp = sorted(set(scorecard["Fecha"]))
    anterior = max([f for f in disp if f <= fecha_ref], default=min(disp))
    sub = scorecard[(scorecard["Fecha"].isin([anterior, fecha])) &
                    (scorecard["Metrica"] == "ESG Quality Score (0-10)")]

    def val(variante, fondo, f):
        s = sub[(sub["Variante"] == variante) & (sub["Fondo"] == fondo) & (sub["Fecha"] == f)]
        return float(s["Portfolio"].iloc[0]) if len(s) else None

    categorias, x_labels = [], []
    for f in [anterior, fecha]:
        lab = etiqueta_mes(f)
        for fondo in FONDOS_ORDEN:
            categorias.append((f, fondo))
            x_labels.append(f"{FONDO_LABEL[fondo]}<br>{lab}")

    y_in = [val("Base", fondo, f) for f, fondo in categorias]
    y_ex = [val("Sobs", fondo, f) for f, fondo in categorias]

    fig = go.Figure()
    fig.add_bar(name="INTEGRA (IN)", x=x_labels, y=y_in, marker_color=NAVY)
    fig.add_bar(name="SISTEMA EX (EX)", x=x_labels, y=y_ex, marker_color=CYAN)
    fig.update_layout(**layout_base(
        "ESG Rating Score -- Portfolio por fondo", altura=360, bar_mode="group",
        y_titulo="Score MSCI (0-10)"))
    return fig.to_dict()


def distribucion_rating_apilada(fecha):
    # Distribución del portafolio por categoría (Leader/Average/Laggard/No Cob),
    # agrupada por fondo con dos barras por fondo (IN/EX)
    sub = rating_summary[rating_summary["Fecha"] == fecha]
    if sub.empty:
        return go.Figure().to_dict()

    orden_cat = ["Leader", "Average", "Laggard", "Not Covered"]
    colores = {"Leader": VERDE, "Average": YELLOW, "Laggard": ROJO, "Not Covered": GRIS}
    etiquetas_es = {"Leader": "Líder", "Average": "Promedio",
                     "Laggard": "Rezagado", "Not Covered": "No coberturado"}

    x_labels, keys = [], []
    for fondo in FONDOS_ORDEN:
        for var_etq, var in [("IN", "Base"), ("EX", "Sobs")]:
            x_labels.append(f"{FONDO_LABEL[fondo]}<br>{var_etq}")
            keys.append((fondo, var))

    fig = go.Figure()
    for cat in orden_cat:
        ys = []
        for fondo, var in keys:
            r = sub[(sub["Fondo"] == fondo) & (sub["Variante"] == var) & (sub["Categoria"] == cat)]
            ys.append(float(r["Portfolio_Total"].iloc[0]) if len(r) else 0)
        fig.add_bar(name=etiquetas_es[cat], x=x_labels, y=ys, marker_color=colores[cat])
    fig.update_layout(**layout_base(
        "Distribución del Portafolio por categoría ASG", altura=380,
        bar_mode="stack", y_pct=True))
    return fig.to_dict()


