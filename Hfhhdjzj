def governance_risk_barras(fecha):
    # Leaders / Average (resto) / Laggards por fondo, INTEGRA vs EX apilados
    sub = risk_metrics[risk_metrics["Fecha"] == fecha]
    if sub.empty:
        return go.Figure().to_dict()

    def val(variante, fondo, metrica):
        r = sub[(sub["Variante"] == variante) & (sub["Fondo"] == fondo) &
                (sub["Metrica"] == metrica)]
        return float(r["Portfolio"].iloc[0]) if len(r) else 0

    x_labels, keys = [], []
    for fondo in FONDOS_ORDEN:
        for var_etq, var in [("IN", "Base"), ("EX", "Sobs")]:
            x_labels.append(f"{FONDO_LABEL[fondo]}<br>{var_etq}")
            keys.append((fondo, var))

    lea = [val(var, fondo, "Governance Leaders (%)") for fondo, var in keys]
    lag = [val(var, fondo, "Governance Laggards (%)") for fondo, var in keys]
    ave = [max(1 - l - g, 0) for l, g in zip(lea, lag)]

    fig = go.Figure()
    fig.add_bar(name="Leaders", x=x_labels, y=lea, marker_color=VERDE)
    fig.add_bar(name="Average", x=x_labels, y=ave, marker_color=YELLOW)
    fig.add_bar(name="Laggards", x=x_labels, y=lag, marker_color=ROJO)
    fig.update_layout(**layout_base(
        "Governance Risk -- composición del portafolio", altura=360,
        bar_mode="stack", y_pct=True))
    return fig.to_dict()


def peores_contribuyentes_chart(fecha, afp, fondo):
    # Top 12 por menor Score dentro de (Afp, Fondo); barras con Score*Weight
    # (izq) y Weight (der) como en el PPT.
    sub = peores[(peores["Fecha"] == fecha) & (peores["Fondo"] == fondo) &
                 (peores["Afp"] == afp)].copy()
    if sub.empty:
        return go.Figure().to_dict()

    sub["Score_Weight"] = sub["Score"].astype(float) * sub["Weight"].astype(float)
    top = sub.nsmallest(12, "Score").sort_values("Score_Weight")

    nombres = top["Nombre"].astype(str).str[:28].tolist()

    fig = go.Figure()
    fig.add_bar(name="Score*Weight", x=nombres, y=top["Score_Weight"].tolist(),
                 marker_color=NAVY, yaxis="y")
    fig.add_bar(name="Weight", x=nombres, y=top["Weight"].tolist(),
                 marker_color=CYAN, yaxis="y2")
    lay = layout_base(f"Menores contribuyentes ESG -- {afp} {FONDO_LABEL.get(fondo, fondo)}",
                       altura=360, bar_mode="group")
    lay["yaxis"] = dict(title="Score × Weight (izq)")
    lay["yaxis2"] = dict(title="Weight (der)", overlaying="y", side="right", tickformat=".2%")
    lay["xaxis"] = dict(tickangle=-35)
    fig.update_layout(**lay)
    return fig.to_dict()


def tabla_tematica(fecha):
    td = tematica_detalle[tematica_detalle["Fecha"] == fecha].copy()
    if td.empty:
        return "<p class='nota'>Sin datos de Inversión Temática para este mes.</p>"
    td["AUM_MMUSD"] = td["AUM_MMUSD"].round(2)
    td["Pct_Clase_Activo"] = td["Pct_Clase_Activo"].apply(
        lambda x: f"{x:.1%}" if pd.notna(x) else "")
    td = td[["Clase", "Emisor", "Etiqueta", "AUM_MMUSD", "Pct_Clase_Activo"]]
    td.columns = ["Clase", "Emisor", "Etiqueta / Artículo", "AUM ($MM)", "% Clase Activo"]
    return td.to_html(index=False, classes="tabla", border=0, na_rep="")


def tabla_controversias(fecha):
    c = controversias[controversias["Fecha"] == fecha].copy()
    if c.empty:
        return "<p class='nota'>Sin controversias registradas para este mes.</p>"
    c = c[["Empresa", "Factor", "Tipo", "Estado", "Resumen"]]
    return c.to_html(index=False, classes="tabla", border=0, na_rep="")


def tabla_cobertura(fecha):
    c = cobertura[cobertura["Fecha"] == fecha].copy()
    if c.empty:
        return ""
    c["Cobertura_pct"] = (c["Cobertura_pct"] * 100).round(1).astype(str) + "%"
    pivot = c.pivot(index="Fondo", columns="AfpGrupo", values="Cobertura_pct").reset_index()
    pivot.columns.name = None
    pivot = pivot.rename(columns={"Integra": "IN", "Ex_Integra": "EX"})
    pivot["Fondo"] = pivot["Fondo"].map(FONDO_LABEL).fillna(pivot["Fondo"])
    return pivot.to_html(index=False, classes="tabla", border=0, na_rep="")


