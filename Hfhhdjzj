def layout_base(titulo, altura=340, bar_mode=None, y_pct=False, y_titulo=None):
    lay = dict(
        title=dict(text=titulo, font=dict(size=14, color=NAVY), x=0.02, y=0.96),
        template="plotly_white",
        height=altura,
        font=dict(family="Arial", size=11, color="#333"),
        margin=dict(t=55, b=50, l=55, r=20),
        legend=dict(orientation="h", y=-0.18, x=0.5, xanchor="center"),
        showlegend=True,
    )
    if bar_mode:
        lay["barmode"] = bar_mode
    if y_pct or y_titulo:
        lay["yaxis"] = dict(tickformat=".0%" if y_pct else None, title=y_titulo)
    return lay


