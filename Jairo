def _clasificar_qest_col(col):
    """Clasifica una columna de DQ_IN sin código SBS real (CAJ/DPZ/CPC/CPP/CDBCR)."""
    col = str(col)
    if col in _QEST_SINONIMO_COL:
        return _QEST_SINONIMO_COL[col]
    if col.startswith('CAJ'):
        return ('CAJ', col)
    if col.startswith('DPZ'):
        return ('DPZ', col)
    return None
