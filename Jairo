def _registrar_descarte(df_antes, df_despues, etapa, motivo, col_valor=None):
    # NO resetear índices: df_despues es subconjunto de df_antes con las mismas
    # etiquetas de índice. El reset previo hacía que .difference() marcara la
    # COLA del dataframe en vez de las filas realmente eliminadas (confirmado
    # con SBS2=30/33/34/40 apareciendo como "sin clasificar" sin sentido).
    idx_perdidos = df_antes.index.difference(df_despues.index)
    for i in idx_perdidos:
        fila = df_antes.loc[i]
        sbs = fila.get('SBS', None)
        isin = fila.get('ISIN', None)
        nombre = fila.get('Nombre', None)
        valor = fila.get(col_valor, None) if col_valor else None
        _DESCARTES.append({'SBS': sbs, 'ISIN': isin, 'Nombre': nombre,
                            'Etapa': etapa, 'Motivo': motivo, 'Valor': valor})
```

Reemplaza por:
```python
def _registrar_descarte(df_antes, df_despues, etapa, motivo, col_valor=None,
                         cols_exposicion=None, agrupar_por_sbs=False):
    # NO resetear índices: df_despues es subconjunto de df_antes con las mismas
    # etiquetas de índice. El reset previo hacía que .difference() marcara la
    # COLA del dataframe en vez de las filas realmente eliminadas (confirmado
    # con SBS2=30/33/34/40 apareciendo como "sin clasificar" sin sentido).
    #
    # cols_exposicion: columnas de peso por AFP/Fondo (tabla ancha, 1 fila=SBS).
    #   Si |peso| suma 0 en TODAS, el SBS no existe en el portafolio de nadie
    #   del sistema -> no se registra como "descartado" (no hay nada que perder).
    # agrupar_por_sbs: para tablas donde el SBS se repite en varias filas
    #   (p.ej. EPU/ETF: una fila por AFP x Fondo). Mismo criterio, sumando
    #   col_valor de TODAS las filas de ese SBS en df_antes (no solo las perdidas).
    idx_perdidos = df_antes.index.difference(df_despues.index)
    _expo_total = None
    if cols_exposicion:
        _presentes = [c for c in cols_exposicion if c in df_antes.columns]
        if _presentes:
            _expo_total = (df_antes[_presentes].apply(pd.to_numeric, errors='coerce')
                           .abs().sum(axis=1))
    elif agrupar_por_sbs and col_valor and 'SBS' in df_antes.columns:
        _v = pd.to_numeric(df_antes[col_valor], errors='coerce').abs().fillna(0)
        _expo_total = _v.groupby(df_antes['SBS']).transform('sum')

    for i in idx_perdidos:
        if _expo_total is not None and _expo_total.loc[i] < 1e-12:
            continue   # sin exposición en ninguna AFP/Fondo: no existe en el portafolio de nadie
        fila = df_antes.loc[i]
        sbs = fila.get('SBS', None)
        isin = fila.get('ISIN', None)
        nombre = fila.get('Nombre', None)
        valor = fila.get(col_valor, None) if col_valor else None
        _DESCARTES.append({'SBS': sbs, 'ISIN': isin, 'Nombre': nombre,
                            'Etapa': etapa, 'Motivo': motivo, 'Valor': valor})
```

