'------------------------------------------------------------------------------
' Rating, Clasif, OAS, Repetidos, Check Screening, Check S_ValuationP para toda
' la hoja. Se llama despues de resueltas las altas y bajas, asi que recorre
' exactamente los bonos que sobreviven esta corrida.
'   Rating         <- RF!8, misma columna de ISIN que RF!6 (mismo archivo BD_RF)
'   Rating Clasif. <- ClasificarRating(Rating)
'   OAS            <- SpreadsRF (BD_RF.xlsm, ver addendum 23 oct), fila 6 =
'                      ISIN, fila mas reciente de la serie de fechas (desde
'                      fila 12) = valor
'   Emisores Repetidos <- replica COUNTIFS($F:$F,$F,$D:$D,D) real (ver addendum)
'   Check Screening        <- COUNTIF del ISIN contra Screening!B del Modelo
'   Check S_ValuationP     <- COUNTIF del ISIN contra S_ValuationP!B del Modelo
Private Sub RecalcularDerivadas(wsI As Worksheet, ByVal ult As Long, wsRF As Worksheet, wsSpreadsRF As Worksheet, avisos As Collection)
    Dim dRating As Object, dOAS As Object, dScr As Object, dVal As Object
    Dim dCuentaISIN As Object, dCuentaTickerIsin As Object
    Dim r As Long, isin As String, rating As String, ticker As String, claveTI As String
    Dim filaOAS As Long, cTI As Long

    Set dRating = DiccionarioPorFila(wsRF, RF_FILA_ISIN, RF_FILA_RATING)

    If Not wsSpreadsRF Is Nothing Then
        filaOAS = FilaOASMasReciente(wsSpreadsRF)
        If filaOAS > 0 Then
            Set dOAS = DiccionarioPorFila(wsSpreadsRF, SPR_FILA_ISIN, filaOAS)
        Else
            avisos.Add "SpreadsRF (BD_RF.xlsm) no tiene una fila de fecha reconocible desde la fila " & SPR_FILA_FECHAS_INI & "; la columna OAS queda en blanco."
            Set dOAS = CreateObject("Scripting.Dictionary")
            dOAS.CompareMode = vbTextCompare
        End If
    Else
        Set dOAS = CreateObject("Scripting.Dictionary")
        dOAS.CompareMode = vbTextCompare
    End If

    Set dScr = ConteoPorHoja(ThisWorkbook, "Screening", 2)
    If dScr.Count = 0 Then avisos.Add "No encontre (o esta vacia) la hoja 'Screening' en Modelo Latam RF.xlsx; la columna Check Screening queda en 0 para todos."
    Set dVal = ConteoPorHoja(ThisWorkbook, "S_ValuationP", 2, "S_Valuation")
    If dVal.Count = 0 Then avisos.Add "No encontre (o esta vacia) la hoja 'S_ValuationP' (ni 'S_Valuation') en Modelo Latam RF.xlsx; la columna Check S_ValuationP queda en 0 para todos."

    ' Emisores Repetidos: una sola pasada para contar por ISIN y por Ticker|ISIN,
    ' en vez de un COUNTIFS fila a fila (seria O(n^2) sobre toda la hoja).
    Set dCuentaISIN = CreateObject("Scripting.Dictionary")
    dCuentaISIN.CompareMode = vbTextCompare
    Set dCuentaTickerIsin = CreateObject("Scripting.Dictionary")
    dCuentaTickerIsin.CompareMode = vbTextCompare
    For r = I_FILA_INI To ult
        isin = Trim$(Texto(wsI.Cells(r, I_ISIN).Value2))
        ticker = Trim$(Texto(wsI.Cells(r, I_TICKER).Value2))
        If Len(isin) > 0 Then
            If dCuentaISIN.Exists(isin) Then dCuentaISIN(isin) = dCuentaISIN(isin) + 1 Else dCuentaISIN(isin) = 1
            claveTI = ticker & "|" & isin
            If dCuentaTickerIsin.Exists(claveTI) Then dCuentaTickerIsin(claveTI) = dCuentaTickerIsin(claveTI) + 1 Else dCuentaTickerIsin(claveTI) = 1
        End If
    Next r

    For r = I_FILA_INI To ult
        isin = Trim$(Texto(wsI.Cells(r, I_ISIN).Value2))
        If Len(isin) > 0 Then
            If dRating.Exists(isin) Then rating = Texto(dRating(isin)) Else rating = ""
            wsI.Cells(r, I_RATING).Value2 = rating
            wsI.Cells(r, I_CLASIF).Value2 = ClasificarRating(rating)

            If dOAS.Exists(isin) Then
                wsI.Cells(r, I_OAS).Value2 = dOAS(isin)
            Else
                wsI.Cells(r, I_OAS).ClearContents
            End If

            ticker = Trim$(Texto(wsI.Cells(r, I_TICKER).Value2))
            claveTI = ticker & "|" & isin
            cTI = 0
            If dCuentaTickerIsin.Exists(claveTI) Then cTI = dCuentaTickerIsin(claveTI)
            If cTI = 0 Then
                wsI.Cells(r, I_REPETIDOS).Value2 = dCuentaISIN(isin)
            Else
                wsI.Cells(r, I_REPETIDOS).Value2 = cTI
            End If

            If dScr.Exists(isin) Then wsI.Cells(r, I_CHECKSCR).Value2 = dScr(isin) Else wsI.Cells(r, I_CHECKSCR).Value2 = 0
            If dVal.Exists(isin) Then wsI.Cells(r, I_CHECKVAL).Value2 = dVal(isin) Else wsI.Cells(r, I_CHECKVAL).Value2 = 0
        End If
    Next r
End Sub

' Busca, dentro de la serie historica de SpreadsRF (columna A, fechas desde
' SPR_FILA_FECHAS_INI hacia abajo mientras haya fecha), la fila de la fecha mas
' reciente. No asume que la serie este ordenada ni que la fila mas nueva sea
' siempre la primera: recorre el bloque contiguo de fechas y se queda con la
' maxima. Devuelve 0 si no encuentra ninguna fecha valida.
Private Function FilaOASMasReciente(wsSpreads As Worksheet) As Long
    Dim r As Long, v As Variant, mejorFecha As Date, mejorFila As Long

    mejorFila = 0
    For r = SPR_FILA_FECHAS_INI To SPR_FILA_FECHAS_INI + SPR_FILA_FECHAS_MAX
        v = wsSpreads.Cells(r, 1).Value2
        If Not IsDate(v) Then Exit For
        If mejorFila = 0 Then
            mejorFecha = CDate(v)
            mejorFila = r
        ElseIf CDate(v) > mejorFecha Then
            mejorFecha = CDate(v)
            mejorFila = r
        End If
    Next r

    FilaOASMasReciente = mejorFila
End Function

' Lee dos filas de un mismo rango de columnas (una de ISIN, otra del valor que
' interesa) y devuelve ISIN -> valor. Escanea desde la columna 1 hasta la
' ultima con datos en filaISIN, asi que no asume en que columna empiezan los
' bonos (RF empieza en GH; SpreadsRF empieza en B).
Private Function DiccionarioPorFila(ws As Worksheet, ByVal filaISIN As Long, ByVal filaValor As Long) As Object
    Dim d As Object, vIsin As Variant, vVal As Variant, j As Long, isin As String, cFin As Long
    Set d = CreateObject("Scripting.Dictionary")
    d.CompareMode = vbTextCompare
    cFin = ws.Cells(filaISIN, ws.Columns.Count).End(xlToLeft).Column
    If cFin < 1 Then Set DiccionarioPorFila = d: Exit Function
    vIsin = ws.Range(ws.Cells(filaISIN, 1), ws.Cells(filaISIN, cFin)).Value2
    vVal = ws.Range(ws.Cells(filaValor, 1), ws.Cells(filaValor, cFin)).Value2
    For j = 1 To cFin
        isin = Trim$(Texto(vIsin(1, j)))
        If Len(isin) > 0 Then d(isin) = vVal(1, j)
    Next j
    Set DiccionarioPorFila = d
End Function

' Cuenta apariciones de cada ISIN en una columna de una hoja de wb (equivalente
' a COUNTIF). Si no encuentra "nombre", prueba "nombreAlterno". Si no encuentra
' ninguna, devuelve un diccionario vacio (el que llama decide si eso es aviso).
Private Function ConteoPorHoja(wb As Workbook, ByVal nombre As String, ByVal col As Long, Optional ByVal nombreAlterno As String = "") As Object
    Dim d As Object, ws As Worksheet, v As Variant, i As Long, ult As Long, isin As String
    Set d = CreateObject("Scripting.Dictionary")
    d.CompareMode = vbTextCompare
    On Error Resume Next
    Set ws = wb.Worksheets(nombre)
    If ws Is Nothing And Len(nombreAlterno) > 0 Then Set ws = wb.Worksheets(nombreAlterno)
    On Error GoTo 0
    If ws Is Nothing Then Set ConteoPorHoja = d: Exit Function

    ult = ws.Cells(ws.Rows.Count, col).End(xlUp).Row
    If ult >= 2 Then
        v = ws.Range(ws.Cells(2, col), ws.Cells(ult, col)).Value2
        If IsArray(v) Then
            For i = 1 To UBound(v, 1)
                isin = Trim$(Texto(v(i, 1)))
                If Len(isin) > 0 Then
                    If d.Exists(isin) Then d(isin) = d(isin) + 1 Else d(isin) = 1
                End If
            Next i
        Else
            isin = Trim$(Texto(v))
            If Len(isin) > 0 Then d(isin) = 1
        End If
    End If
    Set ConteoPorHoja = d
End Function

'==============================================================================
' Excepciones / Ingresos: bitacora de bajas y altas (ver addendum 23 oct)
'==============================================================================
' Orden canonico de columnas de Instrumentos para mirror en Excepciones/
' Ingresos. Es fijo (no depende de como esten ordenadas las columnas reales en
' Instrumentos): siempre #, Name, ISIN, Ticker, IQ, Emisor, Sector
' Fundamentales, Pais (Riesgo), Rating, Rating Clasif., OAS, Called Bonds,
' Defaulted Bonds, Matured Bonds, Emisores Repetidos, Check Screening,
' Check S_ValuationP. BITACORA_COL_ISIN (=3) asume que ISIN se queda en la
' tercera posicion de este array; si se reordena este Array, hay que mover
' tambien esa constante.
Private Function OrdenColumnasInstrumentos() As Variant
    OrdenColumnasInstrumentos = Array(I_IDX, I_NOMBRE, I_ISIN, I_TICKER, I_IQ, I_EMISOR, I_SECTOR, _
        I_PAIS, I_RATING, I_CLASIF, I_OAS, I_CALLED, I_DEFAULT, I_VENCE, I_REPETIDOS, I_CHECKSCR, I_CHECKVAL)
End Function

Private Function EtiquetasInstrumentos() As Variant
    EtiquetasInstrumentos = Array("#", "Name", "ISIN", "Ticker", "IQ", "Emisor", "Sector Fundamentales", _
        "País (Riesgo)", "Rating", "Rating Clasif.", "OAS", "Called Bonds", "Defaulted Bonds", _
        "Matured Bonds", "Emisores Repetidos", "Check Screening", "Check S_ValuationP")
End Function

' Copia la fila r de Instrumentos en el orden canonico (17 valores).
Private Function LeerFilaInstrumentos(wsI As Worksheet, ByVal r As Long) As Variant
    Dim ord As Variant, i As Long, res() As Variant
    ord = OrdenColumnasInstrumentos()
    ReDim res(1 To BITACORA_N_COLS_CANONICO)
    For i = LBound(ord) To UBound(ord)
        res(i - LBound(ord) + 1) = wsI.Cells(r, ord(i)).Value2
    Next i
    LeerFilaInstrumentos = res
End Function

' Escribe un array de 17 valores (orden canonico) en filaDestino de wsDestino,
' seguido opcionalmente de Motivo y siempre de Fecha (como fecha real, con
' .Value y no .Value2, para que Excel la muestre formateada y no como numero
' serial crudo).
Private Sub EscribirFilaBitacora(wsDestino As Worksheet, ByVal filaDestino As Long, datos As Variant, _
                                  ByVal hoy As Date, Optional ByVal motivo As String = vbNullString, _
                                  Optional ByVal incluirMotivo As Boolean = False)
    Dim i As Long, col As Long
    col = 1
    For i = LBound(datos) To UBound(datos)
        wsDestino.Cells(filaDestino, col).Value2 = datos(i)
        col = col + 1
    Next i
    If incluirMotivo Then
        wsDestino.Cells(filaDestino, col).Value2 = motivo
        col = col + 1
    End If
    wsDestino.Cells(filaDestino, col).Value = hoy
End Sub

' Hoja "Excepciones": se crea si no existe, con encabezado = columnas
' canonicas de Instrumentos + Motivo + Fecha.
Private Function HojaExcepciones(wb As Workbook) As Worksheet
    Dim ws As Worksheet, etiquetas As Variant, i As Long, esNueva As Boolean
    Set ws = CrearOReusarHoja(wb, "Excepciones", esNueva)
    If esNueva Then
        etiquetas = EtiquetasInstrumentos()
        For i = LBound(etiquetas) To UBound(etiquetas)
            ws.Cells(1, i - LBound(etiquetas) + 1).Value2 = etiquetas(i)
        Next i
        ws.Cells(1, EXC_COL_MOTIVO).Value2 = "Motivo"
        ws.Cells(1, EXC_COL_FECHA).Value2 = "Fecha salida de Instrumentos"
        ws.Rows(1).Font.Bold = True
    End If
    Set HojaExcepciones = ws
End Function

' Hoja "Ingresos": se crea si no existe, con encabezado = columnas canonicas
' de Instrumentos + Fecha (sin Motivo: toda fila de Ingresos entro por la
' misma razon, ser alta nueva).
Private Function HojaIngresos(wb As Workbook) As Worksheet
    Dim ws As Worksheet, etiquetas As Variant, i As Long, esNueva As Boolean
    Set ws = CrearOReusarHoja(wb, "Ingresos", esNueva)
    If esNueva Then
        etiquetas = EtiquetasInstrumentos()
        For i = LBound(etiquetas) To UBound(etiquetas)
            ws.Cells(1, i - LBound(etiquetas) + 1).Value2 = etiquetas(i)
        Next i
        ws.Cells(1, ING_COL_FECHA).Value2 = "Fecha ingreso a Instrumentos"
        ws.Rows(1).Font.Bold = True
    End If
    Set HojaIngresos = ws
End Function

' Diccionario de claves ya existentes en una hoja de bitacora (Excepciones o
' Ingresos), para no duplicar. Si colMotivo > 0 la clave es ISIN|MOTIVO (caso
' Excepciones); si no, la clave es solo el ISIN (caso Ingresos). Lee desde la
' fila 2 (la 1 es encabezado).
Private Function DiccionarioBitacora(ws As Worksheet, ByVal colISIN As Long, Optional ByVal colMotivo As Long = 0) As Object
    Dim d As Object, ult As Long, r As Long, isin As String, motivo As String, clave As String
    Set d = CreateObject("Scripting.Dictionary")
    d.CompareMode = vbTextCompare
    ult = ws.Cells(ws.Rows.Count, colISIN).End(xlUp).Row
    If ult < 2 Then Set DiccionarioBitacora = d: Exit Function
    For r = 2 To ult
        isin = Trim$(Texto(ws.Cells(r, colISIN).Value2))
        If Len(isin) > 0 Then
            If colMotivo > 0 Then
                motivo = Trim$(Texto(ws.Cells(r, colMotivo).Value2))
                clave = UCase$(isin) & "|" & UCase$(motivo)
            Else
                clave = UCase$(isin)
            End If
            If Not d.Exists(clave) Then d.Add clave, True
        End If
    Next r
    Set DiccionarioBitacora = d
End Function

' Registra en "Excepciones" cada baja de esta corrida, ANTES de que BorrarFilas
' elimine las filas de Instrumentos (si se llamara despues, ya no habria de
' donde copiar los datos). bajas es la Collection que devuelve LeerBajas:
' Array(fila, ISIN, Name, Motivo). Evita duplicados por ISIN+Motivo (ver
' addendum 23 oct, punto 3).
Private Sub RegistrarExcepciones(wb As Workbook, wsI As Worksheet, bajas As Collection, ByVal hoy As Date)
    Dim wsExc As Worksheet, dExist As Object, destino As Long
    Dim i As Long, isin As String, motivo As String, clave As String, datos As Variant

    If bajas.Count = 0 Then Exit Sub

    Set wsExc = HojaExcepciones(wb)
    Set dExist = DiccionarioBitacora(wsExc, BITACORA_COL_ISIN, EXC_COL_MOTIVO)

    destino = wsExc.Cells(wsExc.Rows.Count, 1).End(xlUp).Row + 1
    If destino < 2 Then destino = 2

    For i = 1 To bajas.Count
        isin = Texto(bajas(i)(1))
        motivo = Texto(bajas(i)(3))
        clave = UCase$(isin) & "|" & UCase$(motivo)
        If Not dExist.Exists(clave) Then
            datos = LeerFilaInstrumentos(wsI, bajas(i)(0))
            EscribirFilaBitacora wsExc, destino, datos, hoy, motivo, True
            dExist.Add clave, True
            destino = destino + 1
        End If
    Next i
End Sub

' Registra en "Ingresos" cada alta que sobrevivio hasta el final de la corrida
' (ya con Rating, OAS, Repetidos, Check Screening y Check S_ValuationP
' calculados: por eso se llama DESPUES de RecalcularDerivadas, no al momento
' de escribir la alta). altas es la Collection que devuelve
' LeerAltasDesdePortBloomberg: Array(Name, ISIN, CodigoPais, Mty).
' dInstFinal es el diccionario ISIN -> fila reconstruido DESPUES de bajas y
' recalculo (las filas se movieron si hubo bajas antes en la hoja). Si un ISIN
' de altas ya no esta en dInstFinal, significa que se agrego y se dio de baja
' en la misma corrida (ver addendum 23 oct, punto 4): queda en Excepciones,
' no se registra en Ingresos porque no hay fila final de donde copiar. Evita
' duplicados por ISIN (un ISIN solo deberia ingresar una vez en toda la vida
' de la hoja).
Private Sub RegistrarIngresos(wb As Workbook, wsI As Worksheet, altas As Collection, dInstFinal As Object, ByVal hoy As Date)
    Dim wsIng As Worksheet, dExist As Object, destino As Long
    Dim i As Long, isin As String, datos As Variant

    If altas.Count = 0 Then Exit Sub

    Set wsIng = HojaIngresos(wb)
    Set dExist = DiccionarioBitacora(wsIng, BITACORA_COL_ISIN)

    destino = wsIng.Cells(wsIng.Rows.Count, 1).End(xlUp).Row + 1
    If destino < 2 Then destino = 2

    For i = 1 To altas.Count
        isin = Texto(altas(i)(1))
        If Not dExist.Exists(UCase$(isin)) Then
            If dInstFinal.Exists(isin) Then
                datos = LeerFilaInstrumentos(wsI, dInstFinal(isin))
                EscribirFilaBitacora wsIng, destino, datos, hoy
                dExist.Add UCase$(isin), True
                destino = destino + 1
            End If
        End If
    Next i
End Sub

'------------------------------------------------------------------------------
' Hoja "Historico": si no existe la crea con encabezado. Copia de Instrumentos
' el Name, IQ, Emisor y Sector Fundamentales de cada bono cuyo Name todavia no
' este en Historico (comparacion exacta de texto). Solo agrega al final, nunca
' borra ni reescribe lo que ya habia.
Private Sub ActualizarHistorico(wsI As Worksheet, ByVal ult As Long, wsHist As Worksheet)
    Dim dYaEsta As Object, ultHist As Long, destino As Long, i As Long, nombre As String
    Dim v As Variant

    Set dYaEsta = CreateObject("Scripting.Dictionary")
    dYaEsta.CompareMode = vbTextCompare
    ultHist = wsHist.Cells(wsHist.Rows.Count, H_NOMBRE).End(xlUp).Row
    If ultHist >= 2 Then
        v = wsHist.Range(wsHist.Cells(2, H_NOMBRE), wsHist.Cells(ultHist, H_NOMBRE)).Value2
        If IsArray(v) Then
            For i = 1 To UBound(v, 1)
                If Len(Texto(v(i, 1))) > 0 Then dYaEsta(Texto(v(i, 1))) = 1
            Next i
        ElseIf Len(Texto(v)) > 0 Then
            dYaEsta(Texto(v)) = 1
        End If
    End If

    destino = IIf(ultHist >= 2, ultHist + 1, 2)
    For i = I_FILA_INI To ult
        nombre = Trim$(Texto(wsI.Cells(i, I_NOMBRE).Value2))
        If Len(nombre) > 0 Then
            If Not dYaEsta.Exists(nombre) Then
                wsHist.Cells(destino, H_NOMBRE).Value2 = nombre
                wsHist.Cells(destino, H_TICKER).Value2 = Texto(wsI.Cells(i, I_TICKER).Value2)
                wsHist.Cells(destino, H_IQ).Value2 = Texto(wsI.Cells(i, I_IQ).Value2)
                wsHist.Cells(destino, H_EMISOR).Value2 = Texto(wsI.Cells(i, I_EMISOR).Value2)
                wsHist.Cells(destino, H_SECTOR).Value2 = Texto(wsI.Cells(i, I_SECTOR).Value2)
                dYaEsta(nombre) = 1
                destino = destino + 1
            End If
        End If
    Next i
End Sub

Private Function HojaHistorico(wb As Workbook) As Worksheet
    Dim ws As Worksheet, esNueva As Boolean
    Set ws = CrearOReusarHoja(wb, "Historico", esNueva)
    If esNueva Then
        ws.Range("A1").Value2 = "Name": ws.Range("B1").Value2 = "Ticker"
        ws.Range("C1").Value2 = "IQ": ws.Range("D1").Value2 = "Emisor"
        ws.Range("E1").Value2 = "Sector Fundamentales"
        ws.Range("A1:E1").Font.Bold = True
    End If
    Set HojaHistorico = ws
End Function

' Crea la hoja "nombre" en wb si no existe. Antes de agregar una hoja nueva de
' cero, busca si ya quedo una hoja vacia con nombre por defecto de Excel
' (Hoja1, Hoja2, Sheet1, Sheet2...) -- el rastro tipico de una corrida anterior
' interrumpida justo despues de Worksheets.Add y antes de renombrarla (ver
' addendum 23 oct, segunda correccion: esto es exactamente lo que le paso a
' Franco con "Historico" y una Interrupcion de usuario de Excel, Esc o
' Ctrl+Break, que no pasa por el manejador de errores Falla y no muestra
' ningun MsgBox) -- y la reutiliza en vez de dejar que se acumulen hojas en
' blanco sueltas cada vez que algo interrumpe la macro a medio camino.
' esNueva sale en True si la hoja se creo o reutilizo vacia ahora mismo (el
' llamador debe escribir los encabezados); sale en False si la hoja ya existia
' con ese nombre de antes (no tocar encabezados que ya estan ahi).
Private Function CrearOReusarHoja(wb As Workbook, ByVal nombre As String, ByRef esNueva As Boolean) As Worksheet
    Dim ws As Worksheet, candidato As Worksheet
    esNueva = False
    On Error Resume Next
    Set ws = wb.Worksheets(nombre)
    On Error GoTo 0
    If Not ws Is Nothing Then
        Set CrearOReusarHoja = ws
        Exit Function
    End If

    Set candidato = HojaPorDefectoVacia(wb)
    If Not candidato Is Nothing Then
        Set ws = candidato
    Else
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
    End If

    ws.Name = nombre
    If ws.Name <> nombre Then
        Err.Raise vbObjectError + 340, , "No pude renombrar la hoja nueva a '" & nombre & "' (quedo como '" & ws.Name & "'). " & _
            "Revisa si ya existe otra hoja con ese nombre o un nombre muy parecido en " & wb.Name & "."
    End If
    esNueva = True
    Set CrearOReusarHoja = ws
End Function

' Busca una hoja con el nombre por defecto que le pone Excel a una hoja nueva
' sin nombre asignado (Hoja1, Hoja2... en Excel en espanol; Sheet1, Sheet2...
' en Excel en ingles, segun el idioma con el que se creo) que ademas este
' completamente vacia (ni un solo dato). Devuelve Nothing si no encuentra
' ninguna; nunca toca una hoja que tenga aunque sea una celda con contenido,
' para no confundir una hoja real del usuario con un rastro de corrida
' interrumpida.
Private Function HojaPorDefectoVacia(wb As Workbook) As Worksheet
    Dim ws As Worksheet, nombre As String
    For Each ws In wb.Worksheets
        nombre = ws.Name
        If (Left$(nombre, 4) = "Hoja" And EsSufijoNumerico(Mid$(nombre, 5))) _
            Or (Left$(nombre, 5) = "Sheet" And EsSufijoNumerico(Mid$(nombre, 6))) Then
            If HojaCompletamenteVacia(ws) Then
                Set HojaPorDefectoVacia = ws
                Exit Function
            End If
        End If
    Next ws
End Function

Private Function EsSufijoNumerico(ByVal s As String) As Boolean
    EsSufijoNumerico = (Len(s) > 0) And IsNumeric(s)
End Function

Private Function HojaCompletamenteVacia(ws As Worksheet) As Boolean
    Dim ur As Range
    Set ur = ws.UsedRange
    HojaCompletamenteVacia = (ur.Cells.Count = 1) And (Len(Texto(ur.Cells(1, 1).Value2)) = 0)
End Function

' primerToken(Name) -> Array(Ticker, IQ, Emisor, Sector). Respaldo de
' DiccionarioInstrumentosPorToken: solo se usa cuando un emisor ya no tiene
' ningun bono vivo en Instrumentos. Recorre Historico de arriba hacia abajo y
' se queda con la ultima coincidencia, porque Historico solo crece agregando
' filas al final: la ultima es la mas reciente.
Private Function DiccionarioHistorico(wsHist As Worksheet) As Object
    Dim d As Object, v As Variant, i As Long, ult As Long, tk As String
    Set d = CreateObject("Scripting.Dictionary")
    d.CompareMode = vbTextCompare
    ult = wsHist.Cells(wsHist.Rows.Count, H_NOMBRE).End(xlUp).Row
    If ult >= 2 Then
        v = wsHist.Range(wsHist.Cells(2, H_NOMBRE), wsHist.Cells(ult, H_SECTOR)).Value2
        For i = 1 To UBound(v, 1)
            tk = PrimerToken(Texto(v(i, 1)))
            If Len(tk) > 0 Then d(tk) = Array(Texto(v(i, 2)), Texto(v(i, 3)), Texto(v(i, 4)), Texto(v(i, 5)))
        Next i
    End If
    Set DiccionarioHistorico = d
End Function

' primerToken(Name) -> Array(Ticker, IQ, Emisor, Sector), leido de los datos
' YA EXISTENTES en Instrumentos (no de Historico: esta es la tabla de
' equivalencia principal, segun lo que confirmaste). Recorre Instrumentos de
' arriba hacia abajo y se queda con la ultima coincidencia si un emisor tiene
' mas de un bono. "ult" es el ultimo bono ANTES de agregar las altas de esta
' corrida (no tiene sentido que una alta se busque equivalencia a si misma).
Private Function DiccionarioInstrumentosPorToken(wsI As Worksheet, ByVal ult As Long) As Object
    Dim d As Object, i As Long, tk As String
    Set d = CreateObject("Scripting.Dictionary")
    d.CompareMode = vbTextCompare
    If ult < I_FILA_INI Then Set DiccionarioInstrumentosPorToken = d: Exit Function
    For i = I_FILA_INI To ult
        tk = PrimerToken(Texto(wsI.Cells(i, I_NOMBRE).Value2))
        If Len(tk) > 0 Then
            d(tk) = Array(Texto(wsI.Cells(i, I_TICKER).Value2), Texto(wsI.Cells(i, I_IQ).Value2), _
                           Texto(wsI.Cells(i, I_EMISOR).Value2), Texto(wsI.Cells(i, I_SECTOR).Value2))
        End If
    Next i
    Set DiccionarioInstrumentosPorToken = d
End Function

Private Function PrimerToken(ByVal nombre As String) As String
    Dim p As Long
    nombre = Trim$(nombre)
    p = InStr(nombre, " ")
    If p = 0 Then PrimerToken = nombre Else PrimerToken = Left$(nombre, p - 1)
End Function

'------------------------------------------------------------------------------
' Emisiones del portafolio de hoy que hay que agregar, leidas de "Port
' Bloomberg" (A:U). Una emision entra si, a la vez:
'   - su ISIN (columna E de Port Bloomberg) no esta en Instrumentos,
'   - su ISIN no esta en "Lista de excepciones" DEL PORTAFOLIO (sin mirar el
'     Comentario: si el ISIN esta ahi, por cualquier razon, se queda fuera;
'     el Comentario es nota humana de por que, el VBA no lo lee),
'   - no vence en menos de MESES_MIN_VENCIMIENTO meses,
'   - no se repite dentro del propio Port Bloomberg de hoy (dVistos): un ISIN
'     que aparece dos veces en el mismo portafolio solo entra una vez.
' Cada alta es un Array: (0)=Name (1)=ISIN (2)=codigo de pais (3)=Mty (Date o Empty)
Private Function LeerAltasDesdePortBloomberg(wbP As Workbook, dInst As Object, ByVal hoy As Date, ByRef saltadas As Collection) As Collection
    Dim wsPB As Worksheet, wsEx As Worksheet
    Dim colIsin As Long, ultEx As Long, ultPB As Long
    Dim vEx As Variant, vPB As Variant, i As Long
    Dim dExcl As Object, dVistos As Object
    Dim isin As String, d As Date, corte As Date
    Dim res As New Collection

    Set saltadas = New Collection
    Set wsPB = Hoja(wbP, "Port Bloomberg")
    Set wsEx = Hoja(wbP, "Lista de excepciones")

    colIsin = ColPorEncabezado(wsEx, "ISIN")
    If colIsin = 0 Then Err.Raise vbObjectError + 110, , "En 'Lista de excepciones' no encuentro el encabezado ISIN."

    Set dExcl = CreateObject("Scripting.Dictionary")
    dExcl.CompareMode = vbTextCompare
    ultEx = wsEx.Cells(wsEx.Rows.Count, colIsin).End(xlUp).Row
    If ultEx >= 2 Then
        vEx = wsEx.Range(wsEx.Cells(2, colIsin), wsEx.Cells(ultEx, colIsin)).Value2
        If IsArray(vEx) Then
            For i = 1 To UBound(vEx, 1)
                isin = Trim$(Texto(vEx(i, 1)))
                If Len(isin) > 0 Then dExcl(isin) = 1
            Next i
        ElseIf Len(Texto(vEx)) > 0 Then
            dExcl(Trim$(Texto(vEx))) = 1
        End If
    End If

    corte = DateAdd("m", MESES_MIN_VENCIMIENTO, hoy)
    Set dVistos = CreateObject("Scripting.Dictionary")
    dVistos.CompareMode = vbTextCompare
    ultPB = wsPB.Cells(wsPB.Rows.Count, PF_ISIN).End(xlUp).Row
    If ultPB < 2 Then Set LeerAltasDesdePortBloomberg = res: Exit Function
    vPB = wsPB.Range(wsPB.Cells(2, 1), wsPB.Cells(ultPB, PF_MTY)).Value2

    For i = 1 To UBound(vPB, 1)
        isin = Trim$(Texto(vPB(i, PF_ISIN)))
        If Len(isin) > 0 Then
            If Not dInst.Exists(isin) And Not dExcl.Exists(isin) And Not dVistos.Exists(isin) Then
                dVistos.Add isin, 1
                If FechaDeTexto(vPB(i, PF_MTY), d) And d < corte Then
                    saltadas.Add isin & " vence " & TextoFecha(d)
                ElseIf FechaDeTexto(vPB(i, PF_MTY), d) Then
                    res.Add Array(Texto(vPB(i, PF_NOMBRE)), isin, UCase$(Trim$(Texto(vPB(i, PF_CNTRY_RISK)))), d)
                Else
                    res.Add Array(Texto(vPB(i, PF_NOMBRE)), isin, UCase$(Trim$(Texto(vPB(i, PF_CNTRY_RISK)))), Empty)
                End If
            End If
        End If
    Next i
    Set LeerAltasDesdePortBloomberg = res
End Function

' Agrega las altas debajo del ultimo bono. Name, ISIN van con el valor que
' trae el portafolio (mismos headers en Port Bloomberg e Instrumentos). Pais
' (Riesgo) es el nombre completo que corresponde al codigo de Cntry (Risk).
' Ticker, IQ, Emisor y Sector Fundamentales se buscan por la primera palabra
' del Name, primero contra los datos YA EXISTENTES en Instrumentos (la tabla
' de equivalencia principal); si ningun bono vivo de ese emisor queda hoy en
' Instrumentos, se prueba Historico como respaldo. Si ninguna de las dos
' tiene match, el campo queda en blanco y resaltado para completarlo a mano.
' Matured Bonds (vencimiento) se calcula de una vez (no cambia en el tiempo,
' no hace falta recalcularlo). El resto de columnas derivadas de las filas
' nuevas las deja RecalcularDerivadas despues de resueltas las bajas, junto
' con las del resto de la hoja. Called/Defaulted quedan con la formula de
' Bloomberg copiada de la ultima fila, para refrescarla y congelarla despues.
Private Sub EscribirAltas(wsI As Worksheet, altas As Collection, dHist As Object, ByVal ult As Long, ByVal filaTot As Long)
    Dim n As Long, i As Long, r As Long, pais As String, falta As Long
    Dim amarillo As Long, datos As Variant, dInstTok As Object, tk As String

    n = altas.Count
    amarillo = RGB(255, 242, 204)
    Set dInstTok = DiccionarioInstrumentosPorToken(wsI, ult)   ' tabla de equivalencia principal: Instrumentos tal como esta ANTES de agregar estas altas

    ' si no hay hueco antes de la fila de totales, se insertan filas encima
    If filaTot > 0 Then
        falta = ult + n - (filaTot - 2)
        If falta > 0 Then wsI.Rows(filaTot - 1 & ":" & (filaTot - 2 + falta)).Insert
    End If

    ' formato de toda la fila, y la formula de Called/Defaulted (lo unico que
    ' de verdad necesita Bloomberg)
    wsI.Range(wsI.Cells(ult, I_IDX), wsI.Cells(ult, I_CHECKVAL)).Copy
    wsI.Range(wsI.Cells(ult + 1, I_IDX), wsI.Cells(ult + n, I_CHECKVAL)).PasteSpecial xlPasteFormats
    Application.CutCopyMode = False
    wsI.Range(wsI.Cells(ult, I_CALLED), wsI.Cells(ult, I_DEFAULT)).Copy wsI.Range(wsI.Cells(ult + 1, I_CALLED), wsI.Cells(ult + n, I_DEFAULT))
    Application.CutCopyMode = False
    wsI.Range(wsI.Cells(ult + 1, I_TICKER), wsI.Cells(ult + n, I_SECTOR)).ClearContents
    wsI.Range(wsI.Cells(ult + 1, I_TICKER), wsI.Cells(ult + n, I_SECTOR)).Interior.Pattern = xlNone

    For i = 1 To n
        r = ult + i
        wsI.Cells(r, I_NOMBRE).Value2 = altas(i)(0)
        wsI.Cells(r, I_ISIN).Value2 = altas(i)(1)

        tk = PrimerToken(altas(i)(0))
        If dInstTok.Exists(tk) Then
            datos = dInstTok(tk)
        ElseIf dHist.Exists(tk) Then
            datos = dHist(tk)
        Else
            datos = Empty
        End If

        If IsArray(datos) Then
            If Len(Texto(datos(0))) > 0 Then wsI.Cells(r, I_TICKER).Value2 = datos(0) Else wsI.Cells(r, I_TICKER).Interior.Color = amarillo
            If Len(Texto(datos(1))) > 0 Then wsI.Cells(r, I_IQ).Value2 = datos(1) Else wsI.Cells(r, I_IQ).Interior.Color = amarillo
            If Len(Texto(datos(2))) > 0 Then wsI.Cells(r, I_EMISOR).Value2 = datos(2) Else wsI.Cells(r, I_EMISOR).Interior.Color = amarillo
            If Len(Texto(datos(3))) > 0 Then wsI.Cells(r, I_SECTOR).Value2 = datos(3) Else wsI.Cells(r, I_SECTOR).Interior.Color = amarillo
        Else
            wsI.Range(wsI.Cells(r, I_TICKER), wsI.Cells(r, I_SECTOR)).Interior.Color = amarillo
        End If

        pais = PaisDeCodigo(altas(i)(2))
        If Len(pais) > 0 Then wsI.Cells(r, I_PAIS).Value2 = pais Else wsI.Cells(r, I_PAIS).Interior.Color = amarillo

        If Not IsEmpty(altas(i)(3)) Then wsI.Cells(r, I_VENCE).Value2 = CDate(altas(i)(3)) Else wsI.Cells(r, I_VENCE).Value2 = "NA"
    Next i
End Sub

' Codigo de Cntry (Risk) -> nombre que usa Instrumentos.
Private Function PaisDeCodigo(ByVal cod As String) As String
    Select Case cod
        Case "MX": PaisDeCodigo = "Mexico"
        Case "BR": PaisDeCodigo = "Brazil"
        Case "CL": PaisDeCodigo = "Chile"
        Case "CO": PaisDeCodigo = "Colombia"
        Case "PE": PaisDeCodigo = "Peru"
    End Select
End Function

' Convierte Called/Defaulted de las filas nuevas de formula a valor (Bloomberg
' ya respondio).
Private Sub CongelarFilasNuevas(wsI As Worksheet, ByVal desde As Long, ByVal hasta As Long)
    Dim r As Long
    For r = desde To hasta
        wsI.Cells(r, I_CALLED).Value2 = wsI.Cells(r, I_CALLED).Value2
        wsI.Cells(r, I_DEFAULT).Value2 = wsI.Cells(r, I_DEFAULT).Value2
    Next r
End Sub

' Misma regla que la formula original de Rating Clasif.: sin rating o en el
' tramo CCC+ para abajo es HY, lo demas es IG.
Private Function ClasificarRating(ByVal rating As String) As String
    Select Case UCase$(Trim$(rating))
        Case "", "CCC", "CCC+", "B-", "B", "B+", "BB-", "BB", "BB+", "#N/A", "NR"
            ClasificarRating = "HY"
        Case Else
            ClasificarRating = "IG"
    End Select
End Function

' Bajas: llamadas (Called = Y), en default (Defaulted = Y) o que vencen antes
' de hoy + 12 meses (Matured Bonds es fecha; "NA" = perpetuo, se queda).
' pendientes cuenta Called/Defaulted vacios o con error: no se sabe todavia si
' estan llamados.
Private Function LeerBajas(wsI As Worksheet, ByVal ult As Long, ByVal hoy As Date, ByRef pendientes As Long) As Collection
    Dim v As Variant, i As Long, r As Long, corte As Date, d As Date
    Dim mot As String, res As New Collection

    pendientes = 0
    corte = DateAdd("m", MESES_MIN_VENCIMIENTO, hoy)
    v = wsI.Range(wsI.Cells(I_FILA_INI, 1), wsI.Cells(ult, I_VENCE)).Value2

    For i = 1 To UBound(v, 1)
        r = I_FILA_INI + i - 1
        mot = ""
        If IsError(v(i, I_CALLED)) Then
            pendientes = pendientes + 1
        ElseIf Len(Trim$(Texto(v(i, I_CALLED)))) = 0 Then
            pendientes = pendientes + 1
        ElseIf UCase$(Trim$(Texto(v(i, I_CALLED)))) = "Y" Then
            mot = "llamado"
        End If

        If IsError(v(i, I_DEFAULT)) Then
            pendientes = pendientes + 1
        ElseIf Len(Trim$(Texto(v(i, I_DEFAULT)))) = 0 Then
            pendientes = pendientes + 1
        ElseIf UCase$(Trim$(Texto(v(i, I_DEFAULT)))) = "Y" Then
            If Len(mot) > 0 Then mot = mot & " + "
            mot = mot & "default"
        End If

        If VarType(v(i, I_VENCE)) = vbDouble Then
            d = CDate(v(i, I_VENCE))
            If d < corte Then
                If Len(mot) > 0 Then mot = mot & " + "
                mot = mot & "vence " & TextoFecha(d)
            End If
        End If

        If Len(mot) > 0 Then res.Add Array(r, Texto(v(i, I_ISIN)), Texto(v(i, I_NOMBRE)), mot)
    Next i
    Set LeerBajas = res
End Function

Private Sub BorrarFilas(wsI As Worksheet, bajas As Collection)
    Dim i As Long
    For i = bajas.Count To 1 Step -1
        wsI.Rows(bajas(i)(0)).Delete
    Next i
End Sub

' Ya no es formula: cada fila de bono se numera 1, 2, 3... como valor.
Private Sub ReindexarB(wsI As Worksheet, ByVal ult As Long)
    Dim n As Long, i As Long, v() As Variant
    n = ult - I_FILA_INI + 1
    If n <= 0 Then Exit Sub
    ReDim v(1 To n, 1 To 1)
    For i = 1 To n: v(i, 1) = i: Next i
    wsI.Range(wsI.Cells(I_FILA_INI, I_IDX), wsI.Cells(ult, I_IDX)).Value2 = v
End Sub

Private Function ListaAltas(altas As Collection, ByVal maxN As Long) As String
    Dim i As Long, s As String
    For i = 1 To altas.Count
        If i > maxN Then s = s & "... y " & (altas.Count - maxN) & " mas" & vbCrLf: Exit For
        s = s & altas(i)(1) & "  " & altas(i)(0) & vbCrLf
    Next i
    ListaAltas = s
End Function

'==============================================================================
' Bloomberg
'==============================================================================
Private Function RefrescarBBG(ws As Worksheet) As Boolean
    Dim nombres As Variant, i As Long
    nombres = Array("RefreshCurrentWorksheet", "RefreshAllWorksheets", "RefreshEntireWorkbook")
    ws.Activate
    For i = LBound(nombres) To UBound(nombres)
        On Error Resume Next
        Err.Clear
        Application.Run nombres(i)
        If Err.Number = 0 Then
            On Error GoTo 0
            RefrescarBBG = True
            Exit Function
        End If
        On Error GoTo 0
    Next i
End Function

Private Function EsperarBBG(rng As Range) As Boolean
    Dim t0 As Date
    t0 = Now
    Do
        If PendientesBBG(rng) = 0 Then EsperarBBG = True: Exit Function
        If (Now - t0) * 86400 > ESPERA_BBG_SEG Then Exit Function
        Application.StatusBar = "Esperando a Bloomberg... (" & Int((Now - t0) * 86400) & " s)"
        DoEvents
        Application.Wait Now + TimeSerial(0, 0, 3)
    Loop
End Function

Private Function PendientesBBG(rng As Range) As Long
    Dim c As Range, n As Long
    For Each c In rng.Cells
        If IsError(c.Value2) Then
            If InStr(1, c.Text, "Requesting", vbTextCompare) > 0 Then n = n + 1
        End If
    Next c
    PendientesBBG = n
End Function

' #NAME? es un error DISTINTO a "Requesting Data...": significa que Excel no
' reconoce la funcion BDP/@BDP, es decir, el Add-in de Bloomberg no esta
' cargado o no hay sesion activa en esta PC. No es un "todavia no responde",
' es un "nunca va a responder asi"; por eso se revisa ANTES de entrar al loop
' de espera, no como parte de el.
Private Function HayErrorNombre(rng As Range) As Boolean
    Dim c As Range
    For Each c In rng.Cells
        If IsError(c.Value2) Then
            If InStr(1, c.Text, "#NAME", vbTextCompare) > 0 Then HayErrorNombre = True: Exit Function
        End If
    Next c
End Function

'==============================================================================
' Apertura de archivos y vinculos
'==============================================================================
' Si BD_RF.xlsm ya esta abierto en esta misma sesion de Excel, reutiliza esa
' instancia en vez de abrir una copia nueva o detenerse (correccion 22 oct,
' punto 5). yaAbierto sale en True cuando se reutilizo: Fase1_Instrumentos usa
' eso para no cerrar una ventana que el usuario ya tenia abierta.
Private Function AbrirBD_RF(ByVal ruta As String, ByRef yaAbierto As Boolean) As Workbook
    Dim wb As Workbook
    yaAbierto = EstaAbierto(ARCHIVO_BD_RF)
    If yaAbierto Then
        Set AbrirBD_RF = Application.Workbooks(ARCHIVO_BD_RF)
        Exit Function
    End If

    If Len(Dir(ruta)) = 0 Then Err.Raise vbObjectError + 300, , "No encuentro " & ruta
    Application.AutomationSecurity = msoAutomationSecurityForceDisable
    Set wb = Workbooks.Open(ruta, UpdateLinks:=0, ReadOnly:=False, IgnoreReadOnlyRecommended:=True, Notify:=False)
    Application.AutomationSecurity = mSeguridad
    If wb.ReadOnly Then
        wb.Close SaveChanges:=False
        Err.Raise vbObjectError + 301, , ARCHIVO_BD_RF & " se abrio en solo lectura: alguien mas lo tiene abierto con bloqueo real (otra PC)."
    End If
    Set AbrirBD_RF = wb
End Function

' Igual que AbrirBD_RF pero generico (para el Portafolio Screening, que se abre
' solo lectura). Reutiliza la instancia si ya esta abierta por nombre de archivo.
Private Function AbrirOReusar(ByVal ruta As String, ByVal soloLectura As Boolean, ByRef yaAbierto As Boolean) As Workbook
    Dim nombre As String, wb As Workbook
    nombre = NombreArchivo(ruta)
    yaAbierto = EstaAbierto(nombre)
    If yaAbierto Then
        Set AbrirOReusar = Application.Workbooks(nombre)
        Exit Function
    End If
    Application.AutomationSecurity = msoAutomationSecurityForceDisable
    Set wb = Workbooks.Open(ruta, UpdateLinks:=0, ReadOnly:=soloLectura, IgnoreReadOnlyRecommended:=True, Notify:=False)
    Application.AutomationSecurity = mSeguridad
    Set AbrirOReusar = wb
End Function

Private Sub AbrirOrigenesDeVinculos(wb As Workbook)
    Dim v As Variant, i As Long, ruta As String, nombre As String
    Set mOrigenes = New Collection
    v = wb.LinkSources(xlExcelLinks)
    If IsEmpty(v) Then Exit Sub
    For i = LBound(v) To UBound(v)
        ruta = CStr(v(i))
        nombre = NombreArchivo(ruta)
        If Not EstaAbierto(nombre) Then
            If Len(Dir(ruta)) > 0 Then
                Application.AutomationSecurity = msoAutomationSecurityForceDisable
                On Error Resume Next
                mOrigenes.Add Workbooks.Open(ruta, UpdateLinks:=0, ReadOnly:=True, IgnoreReadOnlyRecommended:=True, Notify:=False), nombre
                On Error GoTo 0
                Application.AutomationSecurity = mSeguridad
            End If
        End If
    Next i
    wb.Activate
End Sub

Private Sub CerrarOrigenes()
    Dim w As Variant
    If mOrigenes Is Nothing Then Exit Sub
    On Error Resume Next
    For Each w In mOrigenes
        w.Close SaveChanges:=False
    Next w
    Set mOrigenes = Nothing
End Sub

Private Function Respaldar(wb As Workbook, ByVal hoy As Date, ByVal fase As String) As String
    Dim carpeta As String, ruta As String
    carpeta = wb.Path & "\Respaldo"
    If Len(Dir(carpeta, vbDirectory)) = 0 Then MkDir carpeta
    ruta = carpeta & "\BD_RF (respaldo " & fase & " " & TextoFecha(hoy) & " " & Right$("0" & Hour(Now), 2) & Right$("0" & Minute(Now), 2) & ")"
    wb.SaveCopyAs ruta & ".xlsm"
    Respaldar = ruta
End Function

Private Sub EscribirLog(ByVal ruta As String, lineas As Collection)
    Dim f As Integer, i As Long
    f = FreeFile
    Open ruta For Output As #f
    For i = 1 To lineas.Count
        Print #f, lineas(i)
    Next i
    Close #f
End Sub

'==============================================================================
' Instrumentos: ubicar datos
'==============================================================================
Private Function UltimaFilaInstrumentos(wsI As Worksheet, ByRef filaTot As Long) As Long
    Dim r As Long, tope As Long
    r = I_FILA_INI
    Do While Len(Texto(wsI.Cells(r + 1, I_ISIN).Value2)) > 0
        r = r + 1
        If r > 5000 Then Exit Do
    Loop
    UltimaFilaInstrumentos = r

    ' Correccion 23 oct: ESTO antes escaneaba hasta End(xlUp) de la columna
    ' I_IDX ("#"), pero esa columna viene VACIA en la fila "Numero sin
    ' Repetir" (confirmado contra el archivo real: ahi el texto vive en la
    ' columna Name/I_NOMBRE, no en "#"). Con I_IDX, tope quedaba en la misma
    ' fila que r (la del ultimo bono real) y el For de abajo nunca llegaba a
    ' ejecutarse ni una vez, asi que filaTot se quedaba siempre en 0 y
    ' EscribirAltas jamas insertaba espacio para conservar la fila de cierre:
    ' las altas nuevas se agregaban pegadas justo debajo del ultimo bono, sin
    ' respetar el hueco que deberia quedar antes de "Numero sin Repetir". Con
    ' suficientes altas acumuladas, eso termina escribiendo encima de esa fila
    ' de cierre. Se escanea por I_NOMBRE en su lugar, que si tiene el texto.
    filaTot = 0
    tope = wsI.Cells(wsI.Rows.Count, I_NOMBRE).End(xlUp).Row
    Dim k As Long
    For k = r + 1 To tope
        If InStr(1, Texto(wsI.Cells(k, I_IDX).Value2) & Texto(wsI.Cells(k, I_NOMBRE).Value2), "sin Repetir", vbTextCompare) > 0 Then filaTot = k: Exit For
    Next k
    If filaTot > 0 Then
        For k = r + 2 To filaTot - 1
            If Len(Texto(wsI.Cells(k, I_ISIN).Value2)) > 0 Then
                Err.Raise vbObjectError + 310, , "Hay un ISIN suelto en la fila " & k & " de Instrumentos, separado del bloque de bonos. Revisa la hoja."
            End If
        Next k
    End If
End Function

Private Function DiccionarioISIN(wsI As Worksheet, ByVal ult As Long) As Object
    Dim d As Object, v As Variant, i As Long
    Set d = CreateObject("Scripting.Dictionary")
    d.CompareMode = vbTextCompare
    v = wsI.Range(wsI.Cells(I_FILA_INI, I_ISIN), wsI.Cells(ult, I_ISIN)).Value2
    For i = 1 To UBound(v, 1)
        If Len(Trim$(Texto(v(i, 1)))) > 0 Then d(Trim$(Texto(v(i, 1)))) = I_FILA_INI + i - 1
    Next i
    If d.Count < 50 Then Err.Raise vbObjectError + 311, , "Solo lei " & d.Count & " ISIN en Instrumentos; no me parece correcto."
    Set DiccionarioISIN = d
End Function

'==============================================================================
' Auxiliares
'==============================================================================
' fila: fila donde buscar el encabezado (por defecto la 1, como "Lista de
' excepciones" o "Port Filtrado"). Instrumentos la pasa explicitamente porque
' sus encabezados reales estan en la fila 2, no en la 1.
Private Function ColPorEncabezado(ws As Worksheet, ByVal texto_ As String, Optional ByVal fila As Long = 1) As Long
    Dim c As Long
    For c = 1 To 40
        If UCase$(Trim$(Texto(ws.Cells(fila, c).Value2))) = UCase$(texto_) Then ColPorEncabezado = c: Exit Function
    Next c
End Function

' Mty llega como texto mm/dd/aaaa (o como fecha real).
Private Function FechaDeTexto(ByVal v As Variant, ByRef d As Date) As Boolean
    Dim p() As String, y As Long
    If IsError(v) Or IsEmpty(v) Then Exit Function
    If VarType(v) = vbString Then
        p = Split(Trim$(CStr(v)), "/")
        If UBound(p) <> 2 Then Exit Function
        If Not (IsNumeric(p(0)) And IsNumeric(p(1)) And IsNumeric(p(2))) Then Exit Function
        y = CLng(p(2))
        If y < 100 Then y = 2000 + y
        If CLng(p(0)) < 1 Or CLng(p(0)) > 12 Or CLng(p(1)) < 1 Or CLng(p(1)) > 31 Then Exit Function
        d = DateSerial(y, CLng(p(0)), CLng(p(1)))
        FechaDeTexto = True
    ElseIf IsNumeric(v) Then
        If CDbl(v) > 0 Then d = CDate(v): FechaDeTexto = True
    End If
End Function

Private Function EstaAbierto(ByVal nombre As String) As Boolean
    Dim w As Workbook
    For Each w In Workbooks
        If StrComp(w.Name, nombre, vbTextCompare) = 0 Then EstaAbierto = True: Exit Function
    Next w
End Function

Private Function TextoFecha(ByVal d As Date) As String
    TextoFecha = Year(d) & "." & Right$("0" & Month(d), 2) & "." & Right$("0" & Day(d), 2)
End Function

Private Function NombreArchivo(ByVal ruta As String) As String
    NombreArchivo = Mid$(ruta, InStrRev(ruta, "\") + 1)
End Function

Private Function Texto(ByVal v As Variant) As String
    If IsError(v) Then Exit Function
    If IsNull(v) Then Exit Function
    Texto = CStr(v)
End Function

Private Function Hoja(wb As Workbook, ByVal nombre As String) As Worksheet
    Dim r As Worksheet
    On Error Resume Next
    Set r = wb.Worksheets(nombre)
    On Error GoTo 0
    If r Is Nothing Then Err.Raise vbObjectError + 320, , "No encuentro la hoja '" & nombre & "' en " & wb.Name
    Set Hoja = r
End Function

' Igual que Hoja, pero sin error si no existe (para SpreadsRF: si falta, OAS
' queda en blanco con aviso en vez de tumbar toda la Fase1).
Private Function HojaOpcional(wb As Workbook, ByVal nombre As String) As Worksheet
    Dim r As Worksheet
    On Error Resume Next
    Set r = wb.Worksheets(nombre)
    On Error GoTo 0
    Set HojaOpcional = r
End Function

Private Sub GuardarEstadoExcel()
    mScreen = Application.ScreenUpdating
    mEvents = Application.EnableEvents
    mAlerts = Application.DisplayAlerts
    mCalc = Application.Calculation
    mSeguridad = Application.AutomationSecurity
    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False
    Application.Calculation = xlCalculationManual
    ' Ver addendum 23 oct (segunda correccion): un Esc/Ctrl+Break accidental
    ' durante la corrida detiene la macro a medias SIN mostrar ningun MsgBox de
    ' error (es un "User Interrupt", no pasa por Falla), dejando cosas como una
    ' hoja recien agregada sin terminar de renombrar. Se deshabilita mientras
    ' corre; se restaura siempre en RestaurarEstadoExcel.
    Application.EnableCancelKey = xlDisabled
End Sub

Private Sub RestaurarEstadoExcel()
    On Error Resume Next
    Application.StatusBar = False
    Application.CutCopyMode = False
    Application.EnableCancelKey = xlInterrupt
    Application.AutomationSecurity = mSeguridad
    Application.Calculation = mCalc
    Application.DisplayAlerts = mAlerts
    Application.EnableEvents = mEvents
    Application.ScreenUpdating = mScreen
End Sub
