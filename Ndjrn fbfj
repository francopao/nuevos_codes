# -*- coding: utf-8 -*-
"""
Descarga automática de dos reportes MINEM (gob.pe):
1) Producción Minera -> "Producción metálica{AÑO}.xlsx"
2) Boletín Estadístico Minero (mes más reciente, Excel de Anexos) -> "MMYYYY.xlsx"

Requiere: pip install selenium
Chromedriver debe coincidir con la versión de Chrome instalada (o usar webdriver-manager).

NOTA: las URLs no llegaron completas en el mensaje original (href="" vacíos);
se usó la página real de "Producción Minera" y, para el BEM, un listado
cronológico de publicaciones de minería del propio MINEM, ya que el ID de la
publicación mensual del BEM cambia cada mes y no puede fijarse de antemano.
Si el listado real que usas es otro (por ejemplo una colección/compendio
específico), reemplaza URL_LISTADO_MINERIA.
"""

import os
import re
import time
import shutil
import unicodedata
from datetime import datetime

from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.chrome.options import Options
from selenium.common.exceptions import TimeoutException, NoSuchElementException

# ------------------------------------------------------------------
# CONFIGURACIÓN
# ------------------------------------------------------------------
URL_PRODUCCION_MINERA = "https://www.gob.pe/institucion/minem/informes-publicaciones/5472883-produccion-minera"
URL_LISTADO_MINERIA = "https://www.gob.pe/institucion/minem/tema/mineria"  # listado cronológico; ajustar si usas otra colección

RUTA_PRODUCCION_MINERA = r"Z:\Mesa de Inversiones\Bottom-Up\1 Proceso de Inversión Renta Variable\Proyecto Inputs Macro\Complementos BD\Minería\BD\Producción Minera"
RUTA_BOLETINES_MENSUALES = r"\\sppeapp00023\Inversiones\Mesa de Inversiones\Bottom-Up\1 Proceso de Inversión Renta Variable\Proyecto Inputs Macro\Complementos BD\Minería\BD\Boletines Mensuales"

CARPETA_DESCARGAS_TEMP = os.path.join(os.environ.get("TEMP", r"C:\Temp"), "descargas_minem")

MESES_ES = {
    1: "enero", 2: "febrero", 3: "marzo", 4: "abril", 5: "mayo", 6: "junio",
    7: "julio", 8: "agosto", 9: "setiembre", 10: "octubre", 11: "noviembre", 12: "diciembre",
}
MESES_ES_ALT = {9: "septiembre"}  # algunas publicaciones usan "septiembre"

TIMEOUT = 30

# ------------------------------------------------------------------
# UTILIDADES
# ------------------------------------------------------------------

def quitar_tildes(texto):
    return "".join(
        c for c in unicodedata.normalize("NFD", texto)
        if unicodedata.category(c) != "Mn"
    )


def crear_driver(carpeta_descarga):
    os.makedirs(carpeta_descarga, exist_ok=True)
    opciones = Options()
    prefs = {
        "download.default_directory": carpeta_descarga,
        "download.prompt_for_download": False,
        "download.directory_upgrade": True,
        "safebrowsing.enabled": True,
        "plugins.always_open_pdf_externally": True,
    }
    opciones.add_experimental_option("prefs", prefs)
    opciones.add_argument("--start-maximized")
    return webdriver.Chrome(options=opciones)


def esperar_descarga_completa(carpeta, archivos_previos, timeout=TIMEOUT):
    """Espera a que aparezca un archivo nuevo (ya sin .crdownload) en la carpeta de descargas."""
    t0 = time.time()
    while time.time() - t0 < timeout:
        actuales = set(os.listdir(carpeta))
        nuevos = actuales - archivos_previos
        nuevos_finales = [f for f in nuevos if not f.endswith(".crdownload") and not f.endswith(".tmp")]
        if nuevos_finales and not any(f.endswith(".crdownload") for f in actuales):
            return os.path.join(carpeta, nuevos_finales[0])
        time.sleep(0.5)
    raise TimeoutException(f"La descarga no finalizó en {timeout} segundos en {carpeta}")


def mover_y_renombrar(ruta_origen, carpeta_destino, nombre_destino):
    os.makedirs(carpeta_destino, exist_ok=True)
    destino = os.path.join(carpeta_destino, nombre_destino)
    if os.path.exists(destino):
        os.remove(destino)
    shutil.move(ruta_origen, destino)
    print(f"Guardado: {destino}")
    return destino


# ------------------------------------------------------------------
# 1) PRODUCCIÓN MINERA -> "Producción metálica{AÑO}.xlsx"
# ------------------------------------------------------------------

def descargar_produccion_minera(driver, carpeta_descarga):
    print("Descargando Producción Minera...")
    driver.get(URL_PRODUCCION_MINERA)

    boton = WebDriverWait(driver, TIMEOUT).until(
        EC.element_to_be_clickable((By.CSS_SELECTOR, "a.btn.btn--secondary.download"))
    )

    archivos_previos = set(os.listdir(carpeta_descarga))
    driver.execute_script("arguments[0].click();", boton)

    archivo_descargado = esperar_descarga_completa(carpeta_descarga, archivos_previos)

    anio_actual = datetime.now().year
    extension = os.path.splitext(archivo_descargado)[1]
    nombre_final = f"Producción metálica{anio_actual}{extension}"

    mover_y_renombrar(archivo_descargado, RUTA_PRODUCCION_MINERA, nombre_final)


# ------------------------------------------------------------------
# 2) BOLETÍN ESTADÍSTICO MINERO (mes más reciente) -> "MMYYYY.xlsx"
# ------------------------------------------------------------------

def encontrar_link_bem_mas_reciente(driver):
    """Recorre el listado de publicaciones de minería y devuelve el href de la tarjeta
    'Boletín Estadístico Minero <mes> <año>' más reciente (primera coincidencia,
    ya que el listado está ordenado por fecha de publicación descendente)."""
    driver.get(URL_LISTADO_MINERIA)

    enlaces = WebDriverWait(driver, TIMEOUT).until(
        EC.presence_of_all_elements_located((By.XPATH, "//a[contains(@href, '/informes-publicaciones/')]"))
    )

    for enlace in enlaces:
        texto = quitar_tildes(enlace.text or "").lower()
        if "boletin estadistico minero" in texto:
            href = enlace.get_attribute("href")
            if href:
                return href, enlace.text.strip()

    raise NoSuchElementException("No se encontró ninguna tarjeta de 'Boletín Estadístico Minero' en el listado.")


def descargar_boletin_mensual(driver, carpeta_descarga):
    print("Buscando el Boletín Estadístico Minero más reciente...")
    url_boletin, titulo = encontrar_link_bem_mas_reciente(driver)
    print(f"Boletín encontrado: {titulo} -> {url_boletin}")

    driver.get(url_boletin)

    boton_excel = WebDriverWait(driver, TIMEOUT).until(
        EC.element_to_be_clickable((
            By.XPATH,
            "//a[contains(@data-origin, 'excel-de-anexos') or "
            "(contains(@class,'download') and ancestor::div[contains(., 'Excel de Anexos')])]"
        ))
    )

    archivos_previos = set(os.listdir(carpeta_descarga))
    driver.execute_script("arguments[0].click();", boton_excel)

    archivo_descargado = esperar_descarga_completa(carpeta_descarga, archivos_previos)

    match = re.search(r"(\w+)\s+(\d{4})", quitar_tildes(titulo))
    if not match:
        raise ValueError(f"No se pudo interpretar mes/año desde el título: {titulo}")
    nombre_mes, anio = match.group(1).lower(), match.group(2)

    meses_normalizados = {quitar_tildes(v): f"{k:02d}" for k, v in MESES_ES.items()}
    meses_normalizados.update({quitar_tildes(v): f"{k:02d}" for k, v in MESES_ES_ALT.items()})

    mes_numero = meses_normalizados.get(nombre_mes)
    if mes_numero is None:
        raise ValueError(f"Mes no reconocido: {nombre_mes}")

    extension = os.path.splitext(archivo_descargado)[1]
    nombre_final = f"{mes_numero}{anio}{extension}"

    mover_y_renombrar(archivo_descargado, RUTA_BOLETINES_MENSUALES, nombre_final)


# ------------------------------------------------------------------
# MAIN
# ------------------------------------------------------------------

def main():
    driver = crear_driver(CARPETA_DESCARGAS_TEMP)
    try:
        descargar_produccion_minera(driver, CARPETA_DESCARGAS_TEMP)
        descargar_boletin_mensual(driver, CARPETA_DESCARGAS_TEMP)
    finally:
        driver.quit()


if __name__ == "__main__":
    main()
