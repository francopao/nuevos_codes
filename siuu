                font=dict(size=11, color=_INST_COLORS["BCRP"]))

    # Para 2026 anoto el consenso como referencia
    if proy_2026:
        vals_26 = [v for v in proy_2026.values() if v is not None]
        fig.add_annotation(
            x="2026*", y=max(vals_26) + 0.08, yanchor="bottom", showarrow=False,
            text="Consenso: ~ {:.1f} pp".format(np.mean(vals_26)).replace(".", ","),
            font=dict(size=10, color=COL_TXT_SOFT))

    all_vals = [v for v in list(hist_vals.values()) + list(proy_2026.values()) if v is not None]
    ymax = max(all_vals) * 1.35
    fig.update_layout(
