    wb = openpyxl.load_workbook(FILE_BCRP, data_only=True)
    ws_proy = wb["Proyeccion 2026-2027"]
    rows_proy = list(ws_proy.iter_rows(values_only=True))
    instituciones = ["BCRP", "Larrain", "Macrocapitales", "Apoyo"]
    proy_2026 = {}
    for r in rows_proy[1:]:
        yr = r[0]
        mag = str(r[1]).strip().lower() if r[1] else ""
        inst = str(r[2]).strip() if r[2] else ""
        val = _to_float(r[3])
        if yr == 2026 and "fuerte" in mag and inst in instituciones:
            proy_2026[inst] = abs(val) if val is not None else None  # siempre positivo

    fig = go.Figure()

    # --- Barras historicas: una barra BCRP por anio ---
    hist_x = [str(y) for y in hist_years]
    hist_y = [hist_vals.get(y) for y in hist_years]
    fig.add_trace(go.Bar(
        x=hist_x, y=hist_y, name="BCRP",
        marker_color=_INST_COLORS["BCRP"], width=0.45,
        legendgroup="BCRP",
        hovertemplate="<b>%{x}</b><br>Costo PBI: %{y:.1f} pp<extra>BCRP (observado)</extra>"))

    # --- Barras 2026: una barra por institucion ---
    for inst in instituciones:
        v = proy_2026.get(inst)
        if v is None:
            continue
        fig.add_trace(go.Bar(
            x=["2026*"], y=[v], name=inst,
            marker_color=_INST_COLORS[inst], width=0.45,
            showlegend=(inst != "BCRP"),
            legendgroup=inst,
            hovertemplate=f"<b>2026* (Fuerte)</b><br>Costo PBI: {{y:.1f}} pp<extra>{inst}</extra>"))

    # --- Annotations sobre cada barra historica ---
    for y in hist_years:
        v = hist_vals.get(y)
        if v is not None:
            fig.add_annotation(
