def _resolver_mes_num(mes):
    """Convierte CORTE_MES (número 1-12 o abreviatura 'Dic'/'dic'/'DIC') a su
    número de mes (1-12). Se usa para atar SEMESTRE_REF (más abajo en CONFIG)
    al mismo corte."""
    if isinstance(mes, str):
        m = mes.strip()
        if m.isdigit():
            return int(m)
        for num, abrev in _MESES_ABREV_ES.items():
            if abrev.lower() == m.lower():
                return num
        raise SystemExit(f"[CONFIG] CORTE_MES={mes!r} no reconocido como abreviatura de mes.")
    return int(mes)


# Año en 4 dígitos y mes numérico del corte (para SEMESTRE_REF más abajo).
