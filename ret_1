    # ---- Rescate por PROXY: completar ISIN faltantes (identidad, NO ESG) -----
    # Reglas: solo se completan ISIN vacíos; NUNCA se sobrescribe un ISIN de VP;
    # no se toca SBS ni Nombre; si no hay proxy, el ISIN queda NaN (no se inventa).
    dfg['ISIN_Origen'] = pd.Series(np.nan, index=dfg.index, dtype=object)
    dfg.loc[dfg['ISIN'].notna(), 'ISIN_Origen'] = 'VP'
    _mask_sin = dfg['ISIN'].isna()
    _n_reales = int((~_mask_sin).sum())
    _mapa_proxy = cargar_mapa_proxies()
    if _mapa_proxy and _mask_sin.any():
        _isin_proxy = (dfg.loc[_mask_sin, 'SBS']
                          .astype(str).str.strip().map(_mapa_proxy))
        dfg.loc[_mask_sin, 'ISIN'] = _isin_proxy
        _recien = _mask_sin & dfg['ISIN'].notna()
        dfg.loc[_recien, 'ISIN_Origen'] = 'PROXY'
    _n_proxy = int((dfg['ISIN_Origen'] == 'PROXY').sum())
    _n_sin   = int(dfg['ISIN'].isna().sum())
    # Colisiones: mismo ISIN proxy asignado a >1 SBS distinto (visibilidad EPU/ETF)
    _dfp_asig = dfg[dfg['ISIN_Origen'] == 'PROXY']
    _col = _dfp_asig.groupby('ISIN')['SBS'].nunique()
    _col = _col[_col > 1].sort_values(ascending=False).to_dict()
    _PROXY_STATS.clear()
    _PROXY_STATS.update({'reales': _n_reales, 'proxy': _n_proxy,
                         'sin_isin': _n_sin, 'colisiones': _col})
    # Diccionario de trazabilidad SBS -> origen ('VP'/'PROXY') para etiquetar salidas.
    b.isin_origen = (dfg.dropna(subset=['ISIN_Origen'])
                        .drop_duplicates(subset=['SBS'])
                        .set_index('SBS')['ISIN_Origen'].to_dict())
    # La columna auxiliar NO se arrastra por el pipeline (se re-deriva por SBS en
    # los outputs); se elimina para no alterar columnas intermedias existentes.
    dfg = dfg.drop(columns=['ISIN_Origen'])
