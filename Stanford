    # --- Filas duplicadas (misma empresa + tipo_junta + fecha + punto)
    _visto = {}
    _dup = []
    for r in registros:
        fch = r["fecha"].strftime("%Y-%m-%d") if isinstance(r["fecha"], (datetime, date)) else str(r["fecha"])
        clave = (r["empresa"], r["tipo_junta"], fch, r["punto"])
        if clave in _visto:
            _dup.append(f"  Fila {r['_fila']} duplica fila {_visto[clave]}: "
                        f"{r['empresa']} | {r['tipo_junta']} | {fch} | pto {r['punto']}")
        else:
            _visto[clave] = r["_fila"]
    if _dup:
        print(f"\n[AVISO] {len(_dup)} fila(s) duplicada(s) en Registro:")
        for d in _dup[:25]:
            print(d)
        if len(_dup) > 25:
            print(f"  ... y {len(_dup)-25} más")

    # --- Puntos faltantes / saltados por junta
    _juntas_pts = defaultdict(list)
    for r in registros:
        fch = r["fecha"].strftime("%Y-%m-%d") if isinstance(r["fecha"], (datetime, date)) else str(r["fecha"])
        _juntas_pts[(r["empresa"], r["tipo_junta"], fch)].append(r["punto"])

    _av_pts = []
    for (emp, tj, fch), pts in _juntas_pts.items():
        etiq = f"{emp} | {tj} | {fch}"
        unicos = sorted(set(pts))
        principales, subs_por_padre = [], defaultdict(list)
        for p in unicos:
            if "." in str(p):
                padre = str(p).rsplit(".", 1)[0]
                subs_por_padre[padre].append(p)
            else:
                principales.append(str(p))
        # padre faltante
        for padre, hijos in subs_por_padre.items():
            if padre not in principales:
                _av_pts.append(f"  {etiq} -> falta punto padre '{padre}' "
                               f"(existen {', '.join(hijos)})")
        # saltos en puntos principales
        nums = []
        for p in principales:
            try:
                nums.append(int(p))
            except ValueError:
                pass
        if nums:
            nums.sort()
            for i in range(len(nums) - 1):
                if nums[i + 1] != nums[i] + 1:
                    falt = [f"{x:02d}" for x in range(nums[i] + 1, nums[i + 1])]
                    _av_pts.append(f"  {etiq} -> falta(n): {', '.join(falt)}")
    if _av_pts:
        print(f"\n[AVISO] {len(_av_pts)} inconsistencia(s) en puntos de agenda:")
        for a in _av_pts[:30]:
            print(a)
        if len(_av_pts) > 30:
            print(f"  ... y {len(_av_pts)-30} más")
    elif not _dup:
        print("[OK] Sin duplicados ni saltos en puntos de agenda.")
```

