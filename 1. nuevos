def log(msg):
    print("[{}] {}".format(datetime.datetime.now().strftime("%H:%M:%S"), msg))


def _leer_sbs(archivo, sheet_name, institucion):
    """Lee el Excel SBS validando existencia y reportando la institución si falla."""
    if not os.path.isfile(archivo):
        raise ArchivoSBSFaltante(
            "[{}] No existe el archivo SBS esperado:\n{}".format(institucion, archivo)
        )
    try:
        _df = pd.read_excel(archivo, sheet_name=sheet_name)
    except Exception as e:
        raise RuntimeError(
            "[{}] Error leyendo '{}' (hoja='{}'): {}: {}".format(
                institucion, archivo, sheet_name, type(e).__name__, e
            )
        ) from e
    # Blindaje: normaliza los encabezados a 'Unnamed: N' por posición. Evita el
    # 'Length mismatch' cuando una celda-título (p. ej. 'Estado de Ganancias y
    # Pérdidas por Empresa Financiera') hace que la columna NO se llame 'Unnamed: N'
    # y el bloque de renombre termine creando una columna extra.
    _df.columns = ['Unnamed: ' + str(_k) for _k in range(len(_df.columns))]
    return _df


def _indices_tipos(DF, tipos, institucion):
    """
    Equivalente a: for i in tipos: index_.append(DF.loc[DF['Detallada'].isin([i])].index[0])
    pero informando con claridad qué etiquetas faltan en lugar de un IndexError opaco.
    """
    index_ = []
    faltantes = []
    for etiqueta in tipos:
        coincidencias = DF.loc[DF['Detallada'].isin([etiqueta])].index
        if len(coincidencias) == 0:
            faltantes.append(etiqueta)
            continue
        index_.append(coincidencias[0])
    if faltantes:
        raise RuntimeError(
            "[{}] No se encontraron en la columna 'Detallada' las etiquetas: {}. "
            "Revisa el formato/plantilla del archivo SBS.".format(institucion, faltantes)
        )
    return index_


def _drop_col_nan(DF, institucion):
    """Elimina la columna cuyo encabezado es NaN. Avisa si no existe (no rompe)."""
    _mask_nan = DF.columns.isna()
    if _mask_nan.any():
        DF = DF.loc[:, ~_mask_nan]
    else:
        log("[{}] Aviso: no se halló columna NaN para eliminar (se continúa).".format(institucion))
    return DF

