# 2. MARKET CAP  (pandas, sin COM)
# ============================================================================
def leer_market_cap(mes: str, anio: str) -> Dict[str, float]:
    """Devuelve {benchmark: AUM} para el 01/mm/aaaa, leyendo la hoja 'MKT'."""
    if not os.path.exists(RUTA_MARKET_CAP):
        raise FileNotFoundError(f"No existe Market Cap: {RUTA_MARKET_CAP}")

    raw = pd.read_excel(RUTA_MARKET_CAP, sheet_name="MKT", header=None)

    # Localiza la fila de encabezados reales (la que contiene 'FECHA').
    hdr_idx = None
    for i in range(min(5, len(raw))):
        if raw.iloc[i].astype(str).str.strip().eq("FECHA").any():
            hdr_idx = i
            break
    if hdr_idx is None:
        raise ValueError("No se encontró la fila de encabezados ('FECHA') en 'MKT'.")

    df = raw.iloc[hdr_idx + 1:].copy()
    df.columns = raw.iloc[hdr_idx]
    df.columns = df.columns.astype(str).str.replace(" Equity", "", regex=False)

    fecha_col = _dt.datetime.strptime(f"01/{mes}/{anio}", "%d/%m/%Y")
    df["FECHA"] = pd.to_datetime(df["FECHA"], errors="coerce")
    fila = df.loc[df["FECHA"] == fecha_col]
    if len(fila) != 1:
        raise ValueError(
            f"Se esperaba 1 fila en Market Cap para {fecha_col:%d/%m/%Y}, "
            f"se encontraron {len(fila)}."
        )

    aum = {}
    for bench, col in MKT_COL_POR_BENCHMARK.items():
        if col not in fila.columns:
            raise KeyError(f"Falta la columna '{col}' en la hoja 'MKT'.")
        aum[bench] = float(fila[col].iloc[0])
    return aum


