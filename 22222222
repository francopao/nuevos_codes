# ============================================================================
# 1. TIPO DE CAMBIO  (único punto que requiere Excel vivo / xlwings COM)
# ============================================================================
def obtener_tipo_cambio(dia: str, mes: str, anio: str) -> float:
    """Escribe la fecha de corte en 'Tipo de Cambio'!B1, espera el recálculo
    de forma activa (sin sleep fijo) y devuelve el TC (col idx4 == '2' -> idx3),
    replicando la lógica del original."""
    import xlwings as xw

    fecha = re.sub("-", "", f"{anio}-{mes}-{dia}")   # AAAAMMDD
    app = None
    wb = None
    try:
        # update_links=False para no colgarse con vínculos externos.
        app = xw.App(visible=False, add_book=False)
        app.display_alerts = False
        app.screen_updating = False
        wb = app.books.open(RUTA_RIESGO, update_links=False)
        sheet = wb.sheets["Tipo de Cambio"]
        sheet.range("B1").value = fecha

        # Espera activa del cálculo (reemplaza time.sleep(5)).
        import time as _t
        app.calculate()
        t0 = _t.time()
        while app.api.CalculationState != 0 and (_t.time() - t0) < 30:  # 0 = xlDone
            _t.sleep(0.2)

        data = sheet.used_range.value
        df = pd.DataFrame(data)

        valor = None
        for i, j in zip(df[4], df[3]):   # col idx4 == '2' -> valor en col idx3
            if i == "2":
                valor = j
        if valor is None:
            raise ValueError(
                "No se encontró el tipo de cambio (fila con col índice 4 == '2') "
                f"para la fecha {fecha} en RIESGO - Consulta General.xlsm."
            )
        return float(valor)
    finally:
        try:
            if wb is not None:
                wb.close()
        finally:
            if app is not None:
                app.quit()


