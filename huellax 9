```python
    def contribuyentes_fondos(self, top_n: int = 15) -> pd.DataFrame:
        """Intensidad por emisor desglosada en columnas F1/F2/F3 (aporte de
        cada fondo a la Intensidad total del emisor) + Weight (%) del emisor
        agregado en toda la cartera (multifondos). Alimenta el chart
        'Contribuyentes' del dashboard (barras apiladas + marcador Weight).
        """
        _map = {"IN-FONDO1": "F1", "IN-FONDO2": "F2", "IN-FONDO3": "F3"}
        d = self.df[~self.df[COL["plus"]].isin(["Cash", "Cuestionario Integra"])].copy()
        d["_Fondo"] = d[COL["portafolio"]].map(_map)
        d = d[d["_Fondo"].notna()]

        piv = (d.groupby([COL["nombre"], "_Fondo"])[COL["intensidad"]]
                 .sum().unstack("_Fondo", fill_value=0.0))
        piv.columns.name = None
        for f in ["F1", "F2", "F3"]:
            if f not in piv.columns:
                piv[f] = 0.0
        piv = piv[["F1", "F2", "F3"]]
        piv["_Intensidad_Total"] = piv.sum(axis=1)

        # Weight (%) = Inv MM$ del emisor (todos sus fondos) / AUM total del universo d
        inv_emisor = d.groupby(COL["nombre"])[COL["inv"]].sum()
        aum_total = d[COL["inv"]].sum()
        piv["Weight"] = np.where(
            aum_total, inv_emisor.reindex(piv.index).fillna(0.0) / aum_total, 0.0)

        out = (piv.sort_values("_Intensidad_Total", ascending=False)
                  .head(top_n)
                  .drop(columns="_Intensidad_Total")
                  .reset_index()
                  .rename(columns={COL["nombre"]: "Nombre"}))
        return out
```

