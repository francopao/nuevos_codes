```javascript
// --- Chart Contribuyentes: Intensidad por Fondo (F1/F2/F3) apilada +
// Weight (%) del emisor en eje secundario (marcador oscuro sobre cada barra) --
const COLOR_FONDOS = {F1:'#00AECB', F2:'#516FED', F3:'#ACD7CA'};
const COLOR_WEIGHT_MARKER = '#0B3C5D';

function contribuyentesFondos(div, corte, topN){
  topN = topN || 15;
  const f1 = agg('Contrib_Fondos','F1',corte), f2 = agg('Contrib_Fondos','F2',corte),
        f3 = agg('Contrib_Fondos','F3',corte), w  = agg('Contrib_Fondos','Weight',corte);
  let keys = [...new Set([...f1.keys(), ...f2.keys(), ...f3.keys()])].filter(k=>k);
  keys.sort((a,b)=> ((f1.get(b)||0)+(f2.get(b)||0)+(f3.get(b)||0))
                   - ((f1.get(a)||0)+(f2.get(a)||0)+(f3.get(a)||0)));
  keys = keys.slice(0, topN);

  const traces = [
    {type:'bar', name:'F1', x:keys, y:keys.map(k=>f1.get(k)||0), marker:{color:COLOR_FONDOS.F1}},
    {type:'bar', name:'F2', x:keys, y:keys.map(k=>f2.get(k)||0), marker:{color:COLOR_FONDOS.F2}},
    {type:'bar', name:'F3', x:keys, y:keys.map(k=>f3.get(k)||0), marker:{color:COLOR_FONDOS.F3}},
    {type:'scatter', mode:'markers', name:'Weight (%)', yaxis:'y2', showlegend:false,
     x:keys, y:keys.map(k=>(w.get(k)||0)*100),
     marker:{color:COLOR_WEIGHT_MARKER, size:10, line:{color:'white',width:1}}}
  ];
  const lay = LAYOUT();
  lay.barmode = 'stack';
  lay.yaxis.title = 'Intensidad';
  lay.yaxis2 = {overlaying:'y', side:'right', showgrid:false, zeroline:false, title:'Weight (%)'};
  lay.xaxis.type = 'category';
  lay.xaxis.tickangle = -90;
  lay.margin = {l:60,r:60,t:20,b:130};
  Plotly.react(div, traces, lay, OPTS);
}
```

