```python
    # --------------------------------------------------------------------------
    # AUM por Rank_rt x Tipo de cobertura (Cobertura MSCI vs Proxies)
    #   -> chart sunburst gAUM ("Composición de cobertura por asset class")
    # Regla: Plus == 'Proxies' -> "Proxies"; cualquier otro Plus -> "Cobertura".
    # --------------------------------------------------------------------------
    def aum_rank_x_cobertura(self) -> pd.DataFrame:
        d = self.df.copy()
        # d = d[d[COL["rank_rt"]] != "Cash"]   # descomentar para excluir Cash del círculo
        if COL["plus"] in d.columns:
            es_proxy = d[COL["plus"]] == "Proxies"
        else:
            es_proxy = pd.Series(False, index=d.index)
        d["Tipo_Cobertura"] = np.where(es_proxy, "Proxies", "Cobertura")
        out = _agg(d, [COL["rank_rt"], "Tipo_Cobertura"], [COL["inv"]])
        total = out[COL["inv"]].sum()
        out["% AUM"] = np.where(total, out[COL["inv"]] / total, 0.0)
        return out
