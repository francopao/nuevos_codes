```python
# ============================================================================
#  TRACKING DE INSTRUMENTOS DESCARTADOS (SBS que se pierden en cada filtro)
# ============================================================================
_DESCARTES = []  # lista de dicts: {SBS, ISIN, Etapa, Motivo, Valor}

def _registrar_descarte(df_antes, df_despues, etapa, motivo, col_valor=None):
    idx_perdidos = df_antes.index.difference(df_despues.index)
    for i in idx_perdidos:
        fila = df_antes.loc[i]
        sbs = fila.get('SBS', None)
        isin = fila.get('ISIN', None)
        valor = fila.get(col_valor, None) if col_valor else None
        _DESCARTES.append({'SBS': sbs, 'ISIN': isin, 'Etapa': etapa,
                            'Motivo': motivo, 'Valor': valor})

def imprimir_descartes():
    if not _DESCARTES:
        print("[DESCARTES] No se descartó ningún instrumento.")
        return
    df_desc = pd.DataFrame(_DESCARTES)
    print("\n================  INSTRUMENTOS DESCARTADOS  ================")
    print(df_desc.to_string(index=False))
    print("\n--- Weight/valor diluido por SBS (suma en todas las etapas) ---")
    resumen = df_desc.groupby('SBS')['Valor'].apply(
        lambda s: pd.to_numeric(s, errors='coerce').sum())
    print(resumen.to_string())
```

