```

Selecciona desde ahí hasta el `return fig` de esa función (el que está justo **antes** de `# 4) Chart`). Reemplaza todo por:

```python
def chart_fen_cost():
    # --- Historico: p44 de la Memoria 2023 ---
    wb_mem = openpyxl.load_workbook(FILE_MEMORIA, data_only=True)
    ws44 = wb_mem["p44"]
    rows44 = list(ws44.iter_rows(values_only=True))
    header44 = rows44[0]
    pbi_row = next(r for r in rows44[1:] if r[0] and "PBI total" in str(r[0]))

    hist_years = [1998, 2017, 2023]
    hist_vals = {}
    for y in hist_years:
        ci = next(i for i, h in enumerate(header44) if isinstance(h, (int, float)) and int(h) == y)
        v = _to_float(pbi_row[ci])
        hist_vals[y] = abs(v) if v is not None else None

    # --- Proyecciones 2026: hoja "Proyeccion 2026-2027", filtro Fuerte ---
    wb = openpyxl.load_workbook(FILE_BCRP, data_only=True)
    ws_proy = wb["Proyeccion 2026-2027"]
    rows_proy = list(ws_proy.iter_rows(values_only=True))
    instituciones = ["BCRP", "Larrain", "Macrocapitales", "Apoyo"]
    proy_2026 = {}
    for r in rows_proy[1:]:
        yr = r[0]
        mag = str(r[1]).strip().lower() if r[1] else ""
        inst = str(r[2]).strip() if r[2] else ""
        val = _to_float(r[3])
        if yr == 2026 and "fuerte" in mag and inst in instituciones:
            proy_2026[inst] = abs(val) if val is not None else None

    # Todos los traces deben compartir las mismas 4 categorias X para que
    # barmode="group" funcione bien. Donde no hay dato, pongo None.
    all_x = ["1998", "2017", "2023", "2026*"]

    fig = go.Figure()

    # Trace BCRP: tiene dato en los 4 periodos
    fig.add_trace(go.Bar(
        x=all_x,
        y=[hist_vals.get(1998), hist_vals.get(2017), hist_vals.get(2023), proy_2026.get("BCRP")],
        name="BCRP", marker_color=_INST_COLORS["BCRP"],
        hovertemplate="<b>%{x}</b><br>Costo PBI: %{y:.1f} pp<extra>BCRP</extra>"))

    # Traces Larrain, Macrocapitales, Apoyo: solo tienen dato en 2026*
    for inst in ["Larrain", "Macrocapitales", "Apoyo"]:
        fig.add_trace(go.Bar(
            x=all_x,
            y=[None, None, None, proy_2026.get(inst)],
            name=inst, marker_color=_INST_COLORS[inst],
            hovertemplate=f"<b>2026* (Fuerte)</b><br>Costo PBI: %{{y:.1f}} pp<extra>{inst}</extra>"))

    # --- Annotations sobre cada barra historica ---
    for y in hist_years:
        v = hist_vals.get(y)
        if v is not None:
            fig.add_annotation(
                x=str(y), y=v + 0.06, yanchor="bottom", showarrow=False,
                text="<b>{:.1f}</b>".format(v).replace(".", ","),
                font=dict(size=11, color=_INST_COLORS["BCRP"]))

    # Consenso 2026
    if proy_2026:
        vals_26 = [v for v in proy_2026.values() if v is not None]
        fig.add_annotation(
            x="2026*", y=max(vals_26) + 0.06, yanchor="bottom", showarrow=False,
            text="Consenso: ~ {:.1f} pp".format(np.mean(vals_26)).replace(".", ","),
            font=dict(size=10, color=COL_TXT_SOFT))

    all_vals = [v for v in list(hist_vals.values()) + list(proy_2026.values()) if v is not None]
    ymax = max(all_vals) * 1.35
    fig.update_layout(
        barmode="group",
        height=340, margin=dict(l=40, r=16, t=6, b=52),
        plot_bgcolor="#fff", paper_bgcolor="#fff",
        font=dict(family=FONT, size=11, color=COL_TXT),
        hovermode="x unified",
        legend=dict(orientation="h", x=0, xanchor="left", y=-0.16, yanchor="top",
                    font=dict(size=10.5), bgcolor="rgba(0,0,0,0)"),
        xaxis=dict(showgrid=False, linecolor="#C9CED6", tickcolor="#C9CED6",
                   tickfont=dict(size=11),
                   categoryorder="array", categoryarray=all_x),
        yaxis=dict(range=[0, ymax],
                   title=dict(text="Puntos porcentuales del PBI", font=dict(size=10)),
                   showgrid=False, tickfont=dict(size=10), zeroline=False,
                   linecolor="#ffffff", tickcolor="#ffffff"),
    )
    return fig
```

El fix clave: los 4 traces comparten `x=["1998","2017","2023","2026*"]` y usan `None` donde no hay dato. Así Plotly asigna correctamente el espacio de cada barra en cada categoría.
