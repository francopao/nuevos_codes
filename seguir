    def sector_msci_vs_proxies_detalle(self) -> pd.DataFrame:
        """Igual clasificación Categoria/Bloque que sector_msci_vs_proxies(),
        pero SIN agregar: una fila por instrumento (Emisor + SBS), para
        poder auditar qué instrumentos caen en cada categoría."""
        d = _sin_huella_cero(self.df)
        met = [COL["huella"], COL["intensidad"], COL["intensidad_m"], COL["inv"]]
        met = [m for m in met if m in d.columns]

        bu = d[d[COL["estrategia"]].eq("BU")]
        bu_msci = bu[bu[COL["plus"]].eq("Portafolio")].copy()
        bu_prox = bu[bu[COL["plus"]].eq("Proxies")].copy()
        if not bu_msci.empty:
            bu_msci["__sector"] = self._mapear_sector(bu_msci)
        else:
            bu_msci["__sector"] = pd.Series(dtype=object)

        td = d[d[COL["estrategia"]].eq("TD")
               & ~d[COL["plus_1"]].isin(["BU", "Alts"])]
        td_msci = td[td[COL["plus"]].isin(["ETF", "Portafolio"])]
        td_prox = td[td[COL["plus"]].eq("Proxies")]
        alt = d[d[COL["estrategia"]].eq("ALT")
                & d[COL["plus"]].eq("Proxies")
                & d[COL["plus_1"]].eq("Alts")]

        piezas = []

        def _marcar(sub, bloque, categoria):
            if sub.empty:
                return
            t = sub.copy()
            t["Bloque"] = bloque
            t["Categoria"] = categoria
            piezas.append(t)

        for cat in ("Materials", "Utilities"):
            _marcar(bu_msci[bu_msci["__sector"].eq(cat)], "MSCI", cat)
        usados = bu_msci["__sector"].isin(["Materials", "Utilities"])
        _marcar(bu_msci[~usados], "MSCI", "Otros")

        _marcar(td_msci[td_msci[COL["tipo_renta"]].eq("RENTA FIJA")], "MSCI", "RF")
        _marcar(td_msci[td_msci[COL["tipo_renta"]].eq("RENTA VARIABLE")], "MSCI", "RV")

        _marcar(alt, "Proxies", "Alts")
        _marcar(pd.concat([bu_prox, td_prox], ignore_index=True), "Proxies", "Proxies")

        if not piezas:
            return pd.DataFrame()

        out = pd.concat(piezas, ignore_index=True)
        out["__SBS"] = out[COL["sbs"]].astype(str) if COL["sbs"] in out.columns else ""
        out["__CatTipo"] = out["Categoria"] + "|" + out["Bloque"]
        result = out[[COL["nombre"], "__SBS", "__CatTipo"] + met].copy()
        result = result.rename(columns={COL["nombre"]: "Nombre", "__SBS": "SBS",
                                         "__CatTipo": "Categoria_Tipo"})
        return result.reset_index(drop=True)
```
