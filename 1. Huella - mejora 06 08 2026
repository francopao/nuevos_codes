    def cobertura(self) -> pd.DataFrame:
        """Réplica exacta de Final!G5:G7. AUM Cubierto = Inv MM$ de
        Plus∈{Portafolio,ETF,SOV,Proxies} (sin filtrar Huella) + caja neta
        multifondos (D18). Denominador = AUM total (K10)."""
        buckets = ["Portafolio", "ETF", "SOV", "Proxies"]
        m = self.df[COL["plus"]].isin(buckets)
        aum_cubierto = float(pd.to_numeric(self.df.loc[m, COL["inv"]],
                                           errors="coerce").fillna(0.0).sum())
        aum_cubierto += float(self.caja_neta_mm)
        aum_total = self.aum_total_mm
        pct = (aum_cubierto / aum_total) if aum_total else 0.0
        return pd.DataFrame([{
            "Indicador": "TOTAL",
            "Cobertura": pct,
            "AUM Cubierto": aum_cubierto,
            "AUM Total": float(aum_total or 0.0),
        }])

```

