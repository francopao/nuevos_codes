# --- Búsqueda flexible de la fila-ancla (nombre de objeto: río/embalse) ---
FILAS_BUSQUEDA = 6


def normalizar(s):
    """minúsculas, sin tildes, sin espacios sobrantes — para comparar texto de forma robusta."""
    s = str(s)
    s = unicodedata.normalize('NFKD', s).encode('ascii', 'ignore').decode('utf-8')
    return s.strip().lower()


def encontrar_fila_ancla(df, objeto_name, keywords=None, max_filas=FILAS_BUSQUEDA):
    """Busca en qué fila (0..max_filas-1) y columna aparece objeto_name.
    Intenta, en orden: (1) match exacto, (2) nombre completo contenido en una
    celda más larga, (3) match por palabras clave (si se proveen).
    Retorna (fila, columna) o (None, None) si no se encuentra."""
    limite = min(max_filas, df.shape[0])
    obj_norm = normalizar(objeto_name)

    for r in range(limite):
        fila_norm = df.iloc[r].astype(str).map(normalizar)
        matches = df.columns[fila_norm == obj_norm]
        if len(matches) > 0:
            return r, df.columns.get_loc(matches[0])

    for r in range(limite):
        fila_norm = df.iloc[r].astype(str).map(normalizar)
        matches = df.columns[fila_norm.str.contains(re.escape(obj_norm), na=False)]
        if len(matches) > 0:
            return r, df.columns.get_loc(matches[0])

    if keywords:
        kw_norm = [normalizar(k) for k in keywords]
        for r in range(limite):
            fila_norm = df.iloc[r].astype(str).map(normalizar)
            mask = fila_norm.apply(lambda x: all(k in x for k in kw_norm))
            matches = df.columns[mask]
            if len(matches) > 0:
                return r, df.columns.get_loc(matches[0])

    return None, None


def process_river_data(df, river_name, anio, keywords=None):
    fila_nombre, filacol = encontrar_fila_ancla(df, river_name, keywords=keywords)

    if fila_nombre is None:
        print(f"[WARN] Objeto no encontrado en hoja (revisadas primeras {FILAS_BUSQUEDA} filas): {river_name}")
        return None

    fila_anios = fila_nombre + 1
    fila_inicio_datos = fila_nombre + 2

    if fila_inicio_datos >= df.shape[0]:
        print(f"[ERROR] Estructura inesperada para '{river_name}': no hay suficientes filas debajo del encabezado.")
        return None

    df_ = df.iloc[:, filacol:filacol + 5]

    anios_fila = df_.iloc[fila_anios, :].astype(str).str.strip()
    if anio not in list(anios_fila):
        print(
            f"[WARN] Año '{anio}' no encontrado en el bloque de '{river_name}'. Años disponibles: {list(anios_fila.dropna())}")
        return None

    df_.columns = df_.iloc[fila_anios, :]
    df_ = df_.iloc[fila_anios:, 1:]
    df_ = df_.reset_index(drop=True)

    df_.insert(0, "Semana", df_.index)

    if anio not in df_.columns:
        print(f"[ERROR] No se pudo aislar la columna del año '{anio}' para '{river_name}' tras el recorte.")
        return None

    df_ = df_[['Semana', anio]]
    df_ = df_.iloc[1:, :]
    df_ = df_.set_axis(['Semana', river_name], axis=1)
    return df_


def merge_river_data(df, anio, rivers, keywords_map=None):
    Total = None

    for idx, river in enumerate(rivers):
        kw = keywords_map.get(river) if keywords_map else None
        df_river = process_river_data(df, river, anio, keywords=kw)

        if df_river is None:
            continue

        if Total is None:
            Total = df_river.copy()
        else:
            Total = pd.merge(Total, df_river, how='left', on='Semana')

    return Total


