# --- Histórico acumulativo ---

def cargar_historico(ruta):
    """Devuelve (df_historico, existe_archivo).
    df_historico es None si el archivo no existe, o si existe pero no se
    pudo leer (en ese caso existe_archivo=True, para poder frenar la
    escritura y no arriesgar el histórico ya acumulado)."""
    if not os.path.isfile(ruta):
        return None, False
    try:
        hist = pd.read_excel(ruta, index_col=0)
        return hist, True
    except Exception as e:
        print(f"[ERROR HISTORICO] No se pudo leer el histórico existente ({ruta}): {e}")
        return None, True


def combinar_con_historico(hist, nuevo, anio):
    nuevo = nuevo.copy()
    nuevo["Año"] = nuevo["Año"].astype(str)
    anio_str = str(anio)

    if hist is None or hist.empty or "Año" not in hist.columns:
        combinado = nuevo.copy()
    else:
        hist = hist.copy()
        hist["Año"] = hist["Año"].astype(str)

        for col in nuevo.columns:
            if col not in hist.columns:
                hist[col] = np.nan
        for col in hist.columns:
            if col not in nuevo.columns:
                nuevo[col] = np.nan
        hist = hist[nuevo.columns]

        # Se descartan las filas del año que se acaba de procesar: el
        # archivo mensual trae la serie semanal acumulada de todo ese año,
        # así que el bloque nuevo siempre reemplaza por completo al anterior
        # para ese mismo año. Los demás años quedan intactos.
        hist_otros_anios = hist[hist["Año"] != anio_str]
        combinado = pd.concat([hist_otros_anios, nuevo], ignore_index=True)

    combinado["_Semana_orden"] = pd.to_numeric(combinado["Semana"], errors="coerce")
    combinado = combinado.sort_values(["Año", "_Semana_orden"], kind="mergesort").drop(columns="_Semana_orden")
    combinado = combinado.reset_index(drop=True)
    return combinado


