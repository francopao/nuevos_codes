# ======================================================================
# 4. DICCIONARIO DE RENOMBRAMIENTO (una sola lectura, reutilizado)
# ======================================================================
def cargar_diccionario(ruta):
    try:
        df_ren = pd.read_excel(ruta, sheet_name="IS y BS", engine="openpyxl")
        df_ren = df_ren.set_index("Nombre_Antiguo")
        dic = df_ren.to_dict()["Nombre_Nuevo"]
        print("[DICCIONARIO] OK -> %d entradas" % len(dic))
        return dic
    except Exception as e:
        print("[DICCIONARIO] AVISO: no se pudo cargar (%s). Se usarán nombres originales." % e)
        return {}


def renombrar(valor, dic):
    return dic.get(valor, valor)


# ======================================================================
# 5. BÚSQUEDA DE ARCHIVO CON FALLBACK REAL A MESES ANTERIORES
# ======================================================================
def resolver_archivo(carpeta, codigo, mes_, anio, etiqueta):
    """Busca el archivo del mes; si no está, retrocede hasta MAX_FALLBACK_MESES."""
    m_idx = meses_.index(mes_)          # 0..11
    y = int(anio)
    for retro in range(0, MAX_FALLBACK_MESES + 1):
        idx = m_idx - retro
        yy = y
        while idx < 0:
            idx += 12
            yy -= 1
        mm_ = meses_[idx]
        ruta = os.path.join(RUTA_DESCARGAS, carpeta,
                            "%s-%s%d.XLS" % (codigo, mm_, yy))
        if os.path.isfile(ruta):
            if retro > 0:
                print("   [%s] AVISO: sin archivo del mes; usando fallback %s%d (%d mes(es) atrás)"
                      % (etiqueta, mm_, yy, retro))
            return ruta
    print("   [%s] ERROR: no se encontró archivo en %d meses de búsqueda." % (etiqueta, MAX_FALLBACK_MESES))
    return None


# ======================================================================
# 6. PARSER UNIFICADO: crudo SBS -> DataFrame ancho limpio
# ======================================================================
def leer_bloque(archivo, sheet, etiqueta):
    DF = pd.read_excel(archivo, sheet_name=sheet, engine="openpyxl")
    DF = DF.iloc[4:]

    # normaliza el nombre de la primera columna (algunos archivos difieren)
    if DF.columns[0] != "Unnamed: 0":
        DF.rename(columns={DF.columns[0]: "Unnamed: 0"}, inplace=True)

    c = DF.iloc[0:1].copy()
    c["Unnamed: 0"] = "Activo_"

    # Detección dinámica de columnas de entidad (fila de nombres = primera fila)
    fila_nombres = DF.iloc[0]
    entidades = [pos for col, pos in zip(DF.columns, range(len(DF.columns)))
                 if str(fila_nombres[col]) not in ("nan", "Activo")]

    for i in entidades:
        base = c["Unnamed: " + str(i)]
        c["Unnamed: " + str(i)] = base + " MN"
        if i + 1 < len(DF.columns):
            c["Unnamed: " + str(i + 1)] = base + " ME"
        if i + 2 < len(DF.columns):
            c["Unnamed: " + str(i + 2)] = base + " TOTAL"

    DF.columns = c.iloc[0, :]
    DF = DF.iloc[3:]

    # --- Limpieza robusta de columnas basura (reemplaza del DF[np.nan]/['Activo']) ---
    mask = []
    for col in DF.columns:
        s = str(col)
        es_basura = ((isinstance(col, float) and pd.isna(col)) or s == "nan"
                     or s in ("Activo", "Eliminar") or s.startswith("Unnamed:"))
        mask.append(not es_basura)
    DF = DF.loc[:, mask]
    DF = DF.dropna(axis=1, how="all")

    n_ent = max((len(DF.columns) - 1) // 3, 0)
    print("   [%s] parseado -> %d filas x %d cols | entidades detectadas: %d"
          % (etiqueta, DF.shape[0], DF.shape[1], n_ent))
    return DF


# ======================================================================
# 7. TRANSFORMACIÓN: ancho -> largo (formato de la base BS)
# ======================================================================
def transformar_largo(DF, institucion, mes_, anio, etiqueta, dic):
    DF = DF.copy()

    # Renombrar detallada (Activo_) con el diccionario
    DF["Activo_"] = DF["Activo_"].apply(lambda v: renombrar(v, dic))

    # Separar Activo / Pasivo
    idx_pasivo = DF.loc[DF["Activo_"].isin(["Pasivo"])].index
    if len(idx_pasivo) == 0:
        print("   [%s] ERROR: no se encontró fila 'Pasivo'. Se omite esta fuente." % etiqueta)
        return None
    n = idx_pasivo[0]

    DF_A = DF.loc[:n - 1].copy()
    DF_P = DF.loc[n + 3:].copy()

    DF_A.rename(columns={"Activo_": "Detallada"}, inplace=True)
    DF_P.rename(columns={"Activo_": "Detallada"}, inplace=True)

    DF_A = DF_A.dropna(subset=[DF_A.columns[1]])
    DF_P = DF_P.dropna(subset=[DF_P.columns[1]])

    DF_A.insert(0, "Tipo", "Activo")
    DF_P.insert(0, "Tipo", "Pasivo")

    DF_IS = pd.concat([DF_A, DF_P]).sort_index(ignore_index=True)

    # Relabels universales (ignora los que no apliquen)
    det = DF_IS["Detallada"].astype(str).str.strip()
    for tipo, lbl in RELABELS:
        idx = DF_IS.index[(DF_IS["Tipo"] == tipo) & (det == lbl)]
        if len(idx) > 0:
            DF_IS.loc[idx[0], "Detallada"] = lbl + "_"

    # Fecha del periodo
    fecha_col = datetime.datetime.strptime(
        "01/" + meses_n[meses_.index(mes_)] + "/" + anio, "%d/%m/%Y")

    # Pivotar cada entidad (MN/ME/TOTAL) a formato largo
    base = pd.DataFrame()
    n_cols = len(DF_IS.columns)
    for i in range(0, n_cols - 2, 3):
        nombre_ent = DF_IS.columns[2:][i][:-3]   # quita ' MN'
        for moneda in ("MN", "ME", "TOTAL"):
            col_ent = nombre_ent + " " + moneda
            if col_ent not in DF_IS.columns:
                continue
            temp = DF_IS.get(["Tipo", "Detallada"]).copy()
            temp.insert(0, "Nombre", nombre_ent)
            temp.insert(0, "Moneda", moneda)
            temp.insert(4, fecha_col, DF_IS[col_ent])
            base = pd.concat([base, temp])

    if base.empty:
        print("   [%s] ERROR: no se generaron filas en formato largo." % etiqueta)
        return None

    base.insert(0, "Estructura", "BS")
    base.insert(0, "Institución", institucion)
    print("   [%s] largo OK -> %d filas | fecha col: %s"
          % (etiqueta, base.shape[0], fecha_col.date()))
    return base


