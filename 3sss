def generar_periodos(inicio, final):
    """Devuelve lista de 'MMAAAA' entre inicio y final (inclusive)."""
    a1, a2 = int(inicio[2:]), int(final[2:])
    m1, m2 = int(inicio[0:2]), int(final[0:2])
    rutas = []
    for anio in range(a1, a2 + 1):
        mes_ini = m1 if anio == a1 else 1
        mes_fin = m2 if anio == a2 else 12
        for mes in range(mes_ini, mes_fin + 1):
            rutas.append("%02d%d" % (mes, anio))
    return rutas


