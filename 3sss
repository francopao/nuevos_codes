# 8. PROCESO PRINCIPAL POR PERIODO
# ======================================================================
def construir_key(row):
    return (str(row["Institución"]) + str(row["Estructura"]) + str(row["Moneda"])
            + str(row["Nombre"]) + str(row["Tipo"]) + re.sub(" ", "", str(row["Detallada"])))


def main1(mes, mes_, anio, dic):
    print("-" * 70)
    print("PROCESANDO: %s %s" % (mes, anio))
    print("-" * 70)

    bloques = []
    for etiqueta, carpeta, codigo, sheet, institucion in CONFIG_FUENTES:
        try:
            archivo = resolver_archivo(carpeta, codigo, mes_, anio, etiqueta)
            if archivo is None:
                continue
            DF = leer_bloque(archivo, sheet, etiqueta)
            base = transformar_largo(DF, institucion, mes_, anio, etiqueta, dic)
            if base is not None:
                bloques.append(base)
        except Exception as e:
            print("   [%s] ERROR inesperado: %s" % (etiqueta, e))

    if not bloques:
        print("[%s %s] ERROR: ninguna fuente pudo procesarse. Se omite el periodo." % (mes, anio))
        return

    DF_BS = pd.concat(bloques)
    print("[CONSOLIDADO] filas totales: %d" % DF_BS.shape[0])

    # Renombrar 'Nombre' con el diccionario
    DF_BS["Nombre"] = DF_BS["Nombre"].apply(lambda v: renombrar(v, dic))

    # Key
    DF_BS.insert(0, "key", DF_BS.apply(construir_key, axis=1))

    # ------------------------------------------------------------------
    # Merge contra la base histórica
    # ------------------------------------------------------------------
    if not os.path.exists(RUTA_BASE):
        print("[BASE] ERROR: no existe la base histórica -> %s" % RUTA_BASE)
        return

    with pd.ExcelFile(RUTA_BASE, engine="openpyxl") as xls:
        BD_Total = xls.parse(sheet_name="BS")
    print("[BASE] histórica cargada -> %d filas x %d cols" % (BD_Total.shape[0], BD_Total.shape[1]))

    fecha_col = datetime.datetime.strptime(
        "01/" + meses_n[meses_.index(mes_)] + "/" + anio, "%d/%m/%Y")

    if fecha_col in BD_Total.columns:
        print("[BASE] AVISO: la columna %s ya existe; se sobrescribirá." % fecha_col.date())

    # 1) Agregar filas nuevas (keys que no existían)
    keys_existentes = set(BD_Total["key"].astype(str))
    DF_nuevos = DF_BS[~DF_BS["key"].astype(str).isin(keys_existentes)].copy()
    if not DF_nuevos.empty:
        DF_nuevos = DF_nuevos.reset_index(drop=True)
        BD_Total = pd.concat([BD_Total, DF_nuevos], ignore_index=True)
        print("[BASE] filas NUEVAS agregadas: %d" % DF_nuevos.shape[0])
        # Muestra hasta 10 keys nuevas para auditar
        for k in DF_nuevos["key"].head(10).tolist():
            print("        + %s" % k)
    else:
        print("[BASE] sin keys nuevas.")

    # 2) Mapear valores del mes por key
    dic_valores = DF_BS.set_index("key")[fecha_col].to_dict()
    BD_Total[fecha_col] = BD_Total["key"].map(dic_valores)
    mapeados = BD_Total[fecha_col].notna().sum()
    print("[BASE] valores mapeados en %s: %d / %d filas"
          % (fecha_col.date(), mapeados, BD_Total.shape[0]))

    # 3) Escribir (reemplazando solo la hoja BS)
    try:
        with pd.ExcelWriter(RUTA_BASE, mode="a", engine="openpyxl",
                            if_sheet_exists="replace") as writer:
            BD_Total.to_excel(writer, sheet_name="BS", index=False)
        print("[BASE] GUARDADO OK -> %s (%d cols)" % (RUTA_BASE, BD_Total.shape[1]))
    except Exception as e:
        print("[BASE] ERROR al guardar: %s" % e)


