def _peer_group_intensidad(vals_ctx: dict) -> Dict[str, float]:
    """Promedio de Intensidad TAL COMO VIENE por instrumento (con el Weight
    propio de cada comparable ya incluido, SIN homogeneizar), por
    (Bloque, SubCat) — mismo peer group cross-AFP que _peer_group_co2h
    (F1+F2+F3 de todas las AFPs, no-proxy), más un tercer filtro: el
    comparable debe tener un valor de Intensidad (!= 0). Es el benchmark
    'sin ajustar Weight' de Chart 3: un solo valor por SubCat, igual para
    toda barra de ese grupo (no se multiplica por el Weight del eje X)."""
    piezas = []
    for afp, par in vals_ctx.items():
        val = par[0]
        if val is None or val.empty:
            continue
        d = _base(val)
        d = _sin_huella_cero(d)
        if "GyP_UNIVERSO_VALIDO" not in d.columns:
            continue
        d = d[d["GyP_UNIVERSO_VALIDO"] == True]
        if COL["plus"] in d.columns:
            d = d[d[COL["plus"]] != "Proxies"]
        d = d.copy()
        d[COL["intensidad"]] = pd.to_numeric(d[COL["intensidad"]], errors="coerce").fillna(0.0)
        d = d[d[COL["intensidad"]] != 0]  # tercer filtro: debe tener Intensidad
        if not d.empty:
            piezas.append(d)
    if not piezas:
        return {}
    universo = pd.concat(piezas, ignore_index=True)

    ac_map = {"Renta Variable": "Equities", "Renta Fija": "Fixed Income"}
    out: Dict[str, float] = {}
    for ac_orig, bloque in ac_map.items():
        sub = universo[universo["GyP_ASSET_CLASS"] == ac_orig]
        if sub.empty:
            continue
        sub = sub.copy()
        sub["__subcat"] = sub.apply(lambda r: _subcat_activo(r, bloque), axis=1)
        prom = sub.groupby("__subcat")[COL["intensidad"]].mean()
        for sc, v in prom.items():
            out[bloque + "|" + str(sc)] = float(v)
    return out
