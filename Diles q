def build_dashboard_html():
    # Renderizo los charts Plotly.
    cards = []
    for chart_id, title, sub, builder in CHARTS:
        fig = builder()
        cfg = dict(CFG)
        cfg["toImageButtonOptions"] = {**CFG["toImageButtonOptions"], "filename": chart_id}
        frag = pio.to_html(fig, full_html=False, include_plotlyjs=False,
                           config=cfg, div_id=chart_id)
        cards.append(f"""
      <figure class="card">
        <h3>{title}</h3>
        <p class="sub">{sub}</p>
        {frag}
        <figcaption>Fuente: BCRP y Memoria Anual 2023 BCRP. Elaboracion propia.</figcaption>
      </figure>""")

    # Agrego la tabla comparativa (chart #2).
    cards.append(_build_table_card())

    stamp = dt.datetime.now().strftime("%d/%m/%Y %H:%M")
    logo = _logo_uri()
    logo_html = f'<img src="{logo}" alt="AFP Integra">' if logo else ""

    html = f"""<!DOCTYPE html><html lang="es"><head><meta charset="utf-8">
<title>Dashboard de Inversiones - AFP Integra</title>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>
<style>
  :root{{ --navy:#002060; --line:#E3F2ED; --soft:#686868; }}
  *{{ box-sizing:border-box; }}
  body{{ margin:0; font-family:{FONT}; color:#2B2B2B; background:#F6F9FB; }}
  header{{ display:flex; align-items:center; justify-content:space-between;
           background:#fff; padding:16px 26px; border-bottom:3px solid #00AECB; }}
  header h1{{ margin:0; font-size:18px; color:var(--navy); }}
  header p{{ margin:3px 0 0; font-size:12px; color:var(--soft); }}
  header img{{ height:38px; width:auto; }}
  .grid{{ display:grid; grid-template-columns:repeat(2,minmax(520px,1fr));
          gap:18px; padding:20px 24px; }}
  @media(max-width:1120px){{ .grid{{ grid-template-columns:1fr; }} }}
  .card{{ margin:0; background:#fff; border:1px solid var(--line); border-radius:10px;
          padding:14px 16px 10px; box-shadow:0 1px 3px rgba(0,0,0,.05); }}
  .card h3{{ margin:0 0 2px; font-size:15px; color:var(--navy);
             font-weight:700; line-height:1.25; }}
  .card .sub{{ margin:0 0 6px; font-size:11.5px; color:var(--soft); line-height:1.3; }}
  .card figcaption{{ margin-top:4px; font-size:10px; color:#9AA3AF; }}
</style></head><body>
<header>
  <div><h1>Dashboard de Inversiones - Sectores Primarios &amp; FEN</h1>
  <p>Mesa de Inversiones &middot; Actualizado {stamp}</p></div>
  {logo_html}
</header>
<main class="grid">{''.join(cards)}</main>
</body></html>"""

    out = os.path.join(OUTPUT_DIR, "dashboard.html")
    with open(out, "w", encoding="utf-8") as f:
        f.write(html)
    return out


