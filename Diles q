def _to_float(x):
    """Convierto celdas tipo '3,2' (formato ES) o numeros a float; None si no puedo."""
    if x is None:
        return None
    if isinstance(x, (int, float)):
        return float(x)
    s = str(x).strip().replace(" ", "").replace(",", ".")
    try:
        return float(s)
    except ValueError:
        return None


def _load_monthly_buckets():
    """
    Leo la hoja mensual del BCRP y devuelvo un dict {year: {col_index: [valores]}}.
    Ademas devuelvo el nombre de cada columna para poder mapear sectores.
    """
    wb = openpyxl.load_workbook(FILE_BCRP, data_only=True)
    ws = wb["Mensuales"]
    rows = list(ws.iter_rows(values_only=True))
    names = rows[1]
    buckets = {}
    for r in rows[2:]:
        lab = r[0]
        if not lab:
            continue
        lab = str(lab)
        mes = _MESES.get(lab[:3].lower())
        if mes is None:
            continue
        yy = int(lab[3:])
        year = 1900 + yy if yy >= 90 else 2000 + yy
        for ci in range(1, len(r)):
            val = _to_float(r[ci])
            if val is not None:
                buckets.setdefault(year, {}).setdefault(ci, []).append(val)
    return buckets, names


def load_primary_annual():
    """
    Construyo la serie ANUAL del PBI primario (var. % interanual) a partir de la
    hoja mensual del BCRP. La hoja 'anual' del archivo solo llega a 1952 para este
    agregado, asi que uso el promedio de las 12 variaciones interanuales del anio
    como proxy del crecimiento anual. Devuelvo solo anios completos (12 meses).
    """
    buckets, names = _load_monthly_buckets()
    col_prim = next(i for i, n in enumerate(names) if n and "Sectores Primarios" in str(n))
    years, vals = [], []
    for y in sorted(buckets):
        if col_prim in buckets[y] and len(buckets[y][col_prim]) >= 12:
            years.append(y)
            vals.append(float(np.mean(buckets[y][col_prim])))
    return np.array(years), np.array(vals)


def load_forecast():
    """
    Tomo la proyeccion del PBI primario del Reporte de Inflacion mas reciente
    (hoja 'Reporte de Inflacion 2026'). Uso una sola cosecha (RI Jun.26) para
    2026 y 2027, de modo que el forecast sea metodologicamente consistente.
    """
    wb = openpyxl.load_workbook(FILE_BCRP, data_only=True)
    ws = wb["Reporte de Inflacion 2026"]
    rows = list(ws.iter_rows(values_only=True))
    header = [str(c) if c is not None else "" for c in rows[0]]

    def col_like(*keys):
        for i, h in enumerate(header):
            if all(k.lower() in h.lower() for k in keys):
                return i
        return None

    c_2026 = col_like("2026", "RI Jun")
    c_2027 = col_like("2027", "RI Jun")
    row_prim = next(r for r in rows[1:] if r and str(r[0]).strip().lower() == "pbi primario")
    f2026 = _to_float(row_prim[c_2026])
    f2027 = _to_float(row_prim[c_2027])
    return {2026: f2026, 2027: f2027}


def load_fen_episodes(min_magnitudes=("Fuerte", "Extraordinario")):
    """
    Leo el catalogo fechado de FEN de la Memoria 2023 (hoja 'p41') y me quedo
    con los episodios de mayor magnitud, que son los relevantes para el PBI.
    """
    wb = openpyxl.load_workbook(FILE_MEMORIA, data_only=True)
    ws = wb["p41"]
    rows = list(ws.iter_rows(values_only=True))
    eps = []
    for r in rows[1:]:
        if r[0] is None:
            continue
        y0, m0, y1, m1, dur, mag = r[0], r[1], r[2], r[3], r[4], r[5]
        if mag not in min_magnitudes:
            continue
        start = y0 + (m0 - 1) / 12.0
        end = y1 + m1 / 12.0
        eps.append((start, end, str(mag)))
    return eps


