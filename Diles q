# 3) Chart #1 en Plotly. Devuelvo un go.Figure interactivo, compacto y limpio.
#    El titulo/subtitulo van en el HTML (Seccion 6), no dentro del plot, para
#    evitar superposiciones y mantener el area del grafico despejada.
# ----------------------------------------------------------------------------
def chart_primary_fen():
    years, vals = load_primary_annual()
    fcst = load_forecast()
    episodes = load_fen_episodes()

    x0 = 1995
    mask = years >= x0
    yrs, vls = years[mask], vals[mask]
    last_y, last_v = int(yrs[-1]), float(vls[-1])
    fx = [last_y, 2026, 2027]
    fv = [last_v, fcst[2026], fcst[2027]]

    fig = go.Figure()

    # Bandas FEN de mayor magnitud (contexto, al fondo)
    for s, e, mag in episodes:
        if e < x0:
            continue
        fig.add_vrect(x0=s, x1=e, fillcolor=COL_FEN,
                      opacity=0.50 if mag == "Extraordinario" else 0.32,
                      line_width=0, layer="below")

    # Linea de 0% como unica referencia horizontal
    fig.add_hline(y=0, line_color=COL_ZERO, line_width=1)

    # Serie observada
    fig.add_trace(go.Scatter(
        x=yrs, y=vls, mode="lines", name="Observado",
        line=dict(color=COL_OBS, width=2.6),
        hovertemplate="<b>%{x}</b>   %{y:.1f}%<extra>Observado</extra>"))

    # Proyeccion BCRP (discontinua + marcadores, color distinto)
    fig.add_trace(go.Scatter(
        x=fx, y=fv, mode="lines+markers", name="Proyeccion BCRP (RI Jun.26)",
        line=dict(color=COL_FCST, width=2.6, dash="dot"),
        marker=dict(size=7, color=COL_FCST),
        hovertemplate="<b>%{x}</b>   %{y:.1f}%<extra>Proyeccion BCRP</extra>"))

    # Annotations (posicionadas para no superponerse)
    def yat(y):
        return float(vls[np.where(yrs == y)[0][0]])

    fig.add_annotation(x=1998, y=yat(1998) + 2.2, text="FEN 97-98",
                       showarrow=False, font=dict(size=11, color=COL_TXT_SOFT))
    fig.add_annotation(x=2020, y=yat(2020) - 2.4, text="COVID-19",
                       showarrow=False, font=dict(size=11, color=COL_TXT_SOFT))
    fig.add_annotation(x=2023.5, y=13.2, text="<b>FEN 2023-24</b>",
                       showarrow=False, font=dict(size=11, color="#5B6E9E"))
    fig.add_annotation(x=2026, y=fcst[2026], ay=34, ax=0,
                       text="<b>{:+.1f}%<br>2026</b>".format(fcst[2026]).replace(".", ","),
                       showarrow=True, arrowhead=0, arrowwidth=1.1,
                       arrowcolor=COL_FCST, yanchor="top",
                       font=dict(size=11.5, color=COL_FCST))
    fig.add_annotation(x=2027, y=fcst[2027] + 2.6,
                       text="<b>{:+.1f}%<br>2027</b>".format(fcst[2027]).replace(".", ","),
                       showarrow=False, font=dict(size=11, color=COL_FCST))

    ymin = min(vls.min(), min(fv)) - 3
    ymax = max(vls.max(), max(fv)) + 3
    fig.update_layout(
        height=340, margin=dict(l=40, r=16, t=6, b=52),
        plot_bgcolor="#fff", paper_bgcolor="#fff",
        font=dict(family=FONT, size=11, color=COL_TXT),
        hovermode="x unified",
        legend=dict(orientation="h", x=0, xanchor="left", y=-0.16, yanchor="top",
                    font=dict(size=10.5), bgcolor="rgba(0,0,0,0)"),
        xaxis=dict(range=[x0 - 0.5, 2027.9], dtick=5, ticks="outside",
                   tickfont=dict(size=10), showgrid=False,
                   linecolor="#C9CED6", tickcolor="#C9CED6"),
        yaxis=dict(range=[ymin, ymax], ticksuffix="%", dtick=5, ticks="outside",
                   tickfont=dict(size=10), showgrid=False, zeroline=False,
                   linecolor="#ffffff", tickcolor="#ffffff"))
    return fig


