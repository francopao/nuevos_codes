# 4) Chart #2: Tabla comparativa de precision del BCRP durante FEN.
#    La tabla es JS puro en el HTML; aqui solo preparo el payload JSON con los
#    datos de todos los sectores para que el slicer funcione sin recalcular.
# ----------------------------------------------------------------------------
def build_all_sectors_payload():
    """
    Preparo un dict {sector: {cols, proy, pbi, diff, mag}} para todos los sectores
    del slicer. Lo serializo a JSON y lo incrusto en el HTML.
    """
    sectors = get_slicer_sectors()
    payload = {}
    for sec in sectors:
        cols, proy, pbi, diff, mag = build_table_data(sec)
        payload[sec] = {
            "cols": cols,
            "proy": [v if v is not None else None for v in proy],
            "pbi":  [v if v is not None else None for v in pbi],
            "diff": [v if v is not None else None for v in diff],
            "mag":  [v if v is not None else "—" for v in mag],
        }
    return payload, sectors


