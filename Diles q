        // Boton de descarga PNG usando html2canvas (inyecto el script si no existe).
        function addDownloadBtn(){{
          if(document.getElementById("dl_tabla")) return;
          const card = document.getElementById("card_tabla_fen");
          const btn = document.createElement("button");
          btn.id = "dl_tabla";
          btn.textContent = "\\u2B07 PNG";
          btn.title = "Descargar como imagen";
          btn.style.cssText = "position:absolute;top:10px;right:12px;font-size:11px;"+
            "padding:3px 9px;border:1px solid #C9CED6;border-radius:4px;background:#fff;"+
            "color:#002060;cursor:pointer;z-index:2;";
          card.style.position = "relative";
          card.appendChild(btn);
          btn.addEventListener("click", function(){{
            if(typeof html2canvas==="undefined"){{
              const sc = document.createElement("script");
              sc.src = "https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js";
              sc.onload = function(){{ capture(); }};
              document.head.appendChild(sc);
            }} else {{ capture(); }}
          }});
          function capture(){{
            btn.style.display = "none";
            html2canvas(card, {{scale:3, backgroundColor:"#fff"}}).then(function(canvas){{
              btn.style.display = "";
              const a = document.createElement("a");
              a.download = "tabla_precision_fen.png";
