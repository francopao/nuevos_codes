    {"sheet": "Reporte de Inflacion 2017", "fen_year": 2017, "extra_year": 2018},
    {"sheet": "Reporte de Inflacion 2023", "fen_year": 2023, "extra_year": 2024},
    {"sheet": "Reporte de Inflacion 2026", "fen_year": 2026, "extra_year": 2027},
]


def load_ri_forecasts():
    """
    De cada hoja RI extraigo, para cada sector, la proyeccion del ultimo RI disponible
    para el ano FEN. Para la hoja 2026 tambien tomo el ano siguiente (2027).
    Devuelvo {sector: {year: forecast_value}}.
    """
    wb = openpyxl.load_workbook(FILE_BCRP, data_only=True)
    result = {}

    for spec in _RI_SHEETS:
        ws = wb[spec["sheet"]]
        rows = list(ws.iter_rows(values_only=True))
        header = [str(c) if c is not None else "" for c in rows[0]]

        # Localizo la columna del ultimo RI para el ano FEN.
        # Patron: "{fen_year} RI {mes}.{yy}" — tomo la ultima columna que matchee.
        fen_yr = spec["fen_year"]
        last_ri_col = None
        extra_col = None
        for ci, h in enumerate(header):
            if str(fen_yr) in h and "RI" in h:
                last_ri_col = ci  # me quedo con la ultima que aparece
        # Para la hoja 2026 tambien tomo la columna del ano siguiente.
        if spec["sheet"] == "Reporte de Inflacion 2026":
            for ci, h in enumerate(header):
                if str(spec["extra_year"]) in h and "RI" in h:
                    extra_col = ci

        for r in rows[1:]:
            sector = str(r[0]).strip() if r[0] else None
            if not sector:
                continue
            result.setdefault(sector, {})
            if last_ri_col is not None:
                v = _to_float(r[last_ri_col])
                if v is not None:
                    result[sector][fen_yr] = v
            if extra_col is not None:
                v = _to_float(r[extra_col])
                if v is not None:
                    result[sector][spec["extra_year"]] = v

    return result


def load_actual_pbi_by_sector():
    """
    Devuelvo {sector_ri_name: {year: promedio_anual}} usando la serie mensual.
    Solo para anos con 12 meses completos.
    """
    buckets, names = _load_monthly_buckets()
    actual = {}
    for sector_ri, col_key in _SECTOR_TO_MONTHLY_COL.items():
        # Busco la columna mensual cuyo nombre contiene col_key.
        col_idx = None
        for i, n in enumerate(names):
            if n and col_key in str(n):
                col_idx = i
                break
        if col_idx is None:
            continue
        actual[sector_ri] = {}
        for y in sorted(buckets):
            if col_idx in buckets[y] and len(buckets[y][col_idx]) >= 12:
                actual[sector_ri][y] = round(float(np.mean(buckets[y][col_idx])), 1)
    return actual


def load_enfen_magnitudes():
    """
    Leo la hoja 'Comunicados ENFEN' y para cada ano FEN devuelvo la magnitud pico.
    Normalizo todo lo que no sea fuerte/moderada/debil/neutra/extraordinario a 'No Activo'.
    Para 1998 no hay datos ENFEN: lo marco como 'Extraordinario' (excepcion conocida).
    """
    ACTIVAS = {"fuerte", "débil", "moderada", "neutra", "extraordinario"}
    MAG_RANK = {"extraordinario": 5, "fuerte": 4, "moderada": 3, "débil": 2, "neutra": 1}

    wb = openpyxl.load_workbook(FILE_ENFEN, data_only=True)
    ws = wb["Comunicados ENFEN"]
    rows = list(ws.iter_rows(values_only=True))
    header = rows[0]

    # Localizo la columna de magnitud de forma dinamica.
    mag_col = next(i for i, h in enumerate(header) if h and "Magnitud El" in str(h))

    # Calculo la magnitud pico por ano.
    peaks = {}
    for r in rows[1:]:
        y = r[1]
        if y is None:
            continue
        raw = str(r[mag_col]).strip().lower() if r[mag_col] else ""
        if raw not in ACTIVAS:
            continue
        rank = MAG_RANK.get(raw, 0)
        if y not in peaks or rank > MAG_RANK.get(peaks[y], 0):
            peaks[y] = raw

    # Capitalizo.
    result = {}
    for y, mag in peaks.items():
        result[y] = mag.capitalize()

    # Excepcion: 1998 no tiene datos ENFEN pero fue Extraordinario.
    result[1998] = "Extraordinario"
    return result


def build_table_data(sector="PBI primario"):
    """
    Armo los datos de la tabla comparativa para un sector dado.
    Columnas: 1998, 2017, 2023, 2026, 2027.
    Filas: Proyeccion BCRP, PBI %, Diferencia, Magnitud FEN.
    """
    forecasts = load_ri_forecasts()
    actuals = load_actual_pbi_by_sector()
    magnitudes = load_enfen_magnitudes()

    cols = [1998, 2017, 2023, 2026, 2027]
    fc = forecasts.get(sector, {})
    ac = actuals.get(sector, {})

    proy = []
    pbi = []
    diff = []
    mag = []
    for y in cols:
        f_val = fc.get(y)
        a_val = ac.get(y)
        proy.append(f_val)
        pbi.append(a_val)
        if f_val is not None and a_val is not None:
            diff.append(round(f_val - a_val, 1))
        else:
            diff.append(None)
        mag.append(magnitudes.get(y))

    return cols, proy, pbi, diff, mag


def get_slicer_sectors():
    """
    Devuelvo la lista de sectores disponibles para el slicer.
    Son los que existen en las 3 hojas RI (interseccion comun).
    """
    wb = openpyxl.load_workbook(FILE_BCRP, data_only=True)
    sets = []
    for spec in _RI_SHEETS:
        ws = wb[spec["sheet"]]
        rows = list(ws.iter_rows(values_only=True))
        sectors = set(str(r[0]).strip() for r in rows[1:] if r[0] is not None)
        sets.append(sectors)
    common = sets[0]
    for s in sets[1:]:
        common = common & s
    # Ordeno con PBI primario al inicio.
    ordered = ["PBI primario"] + sorted(s for s in common if s != "PBI primario")
    return ordered


