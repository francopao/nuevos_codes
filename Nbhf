```javascript
// --- Chart nuevo: variación de Intensidad por emisor (BU+TD, sin Proxy) —
// descompuesto en efecto Weight (decisión propia: compramos/vendimos) vs
// efecto CO2-H (dato externo que cambió). Intensidad = CO2-H x Weight; la
// descomposición usa el PROMEDIO de ambos períodos para cada factor, así
// los dos efectos suman EXACTO la variación total, sin residuo.
function _mapaContribVar(corte, afp){
  const met = ['Huella', 'Intensidad', 'Inv MM$', 'PERDIO_HUELLA'];
  const out = new Map();
  for(const r of HIST){
    if(r.OBJETO!=='Contrib_Variacion_Intensidad') continue;
    if(String(r.FECHA_CORTE)!==String(corte)) continue;
    if((r.AFP||'Integra')!==afp) continue;
    if(!met.includes(r.METRICA)) continue;
    const k = r.DIM_1;
    if(!k) continue;
    if(!out.has(k)) out.set(k, {huella:0, intensidad:0, inv:0, perdio:false});
    const o = out.get(k);
    if(r.METRICA==='Huella') o.huella += +r.VALOR||0;
    if(r.METRICA==='Intensidad') o.intensidad += +r.VALOR||0;
    if(r.METRICA==='Inv MM$') o.inv += +r.VALOR||0;
    if(r.METRICA==='PERDIO_HUELLA') o.perdio = o.perdio || (+r.VALOR>0);
  }
  return out;
}

function contribVariacionIntensidad(div, cAct, cCmp, afp, topN){
  topN = topN || 12;
  const mCmp = _mapaContribVar(cCmp, afp);
  const mAct = _mapaContribVar(cAct, afp);
  const nombres = new Set([...mCmp.keys(), ...mAct.keys()]);
  const co2h = o => o.inv ? o.huella / o.inv : null;

  const filas = [];
  nombres.forEach(nombre => {
    const c = mCmp.get(nombre) || {huella:0, intensidad:0, inv:0, perdio:false};
    const a = mAct.get(nombre) || {huella:0, intensidad:0, inv:0, perdio:false};
    let cC = co2h(c), cA = co2h(a);
    if(cC===null && cA===null) return;
    if(cC===null) cC = cA;
    if(cA===null) cA = cC;
    const wC = cC ? c.intensidad / cC : 0;
    const wA = cA ? a.intensidad / cA : 0;
    const deltaInt = a.intensidad - c.intensidad;
    if(Math.abs(deltaInt) < 1e-9) return;
    const co2Avg = (cC + cA) / 2, wAvg = (wC + wA) / 2;
    filas.push({
      nombre, deltaInt,
      efectoWeight: (wA - wC) * co2Avg,
      efectoCO2H: (cA - cC) * wAvg,
      perdio: c.perdio || a.perdio
    });
  });

  if(!filas.length){ document.getElementById(div).innerHTML=''; return; }

  const totalAbs = filas.reduce((s,f)=>s+Math.abs(f.deltaInt), 0);
  filas.sort((x,y)=>Math.abs(y.deltaInt)-Math.abs(x.deltaInt));
  const top = filas.slice(0, topN).reverse();

  const y = top.map(f => (f.perdio ? '◇ ' : '') + f.nombre);
  const patron = top.map(f => f.perdio ? '/' : '');

  const traces = [
    {type:'bar', orientation:'h', name:'Efecto Weight', y, x: top.map(f=>f.efectoWeight),
     marker:{color:'#3494BA',
             pattern:{shape:patron, fgcolor:'#3494BA', bgcolor:'#FFFFFF', size:6, solidity:0.35}},
     showlegend:false},
    {type:'bar', orientation:'h', name:'Efecto CO2-H', y, x: top.map(f=>f.efectoCO2H),
     marker:{color:'#ACD7CA',
             pattern:{shape:patron, fgcolor:'#ACD7CA', bgcolor:'#FFFFFF', size:6, solidity:0.35}},
     showlegend:false}
  ];

  const annotations = top.map((f,i) => ({
    x: f.deltaInt, y: y[i], xref:'x', yref:'y',
    xanchor: f.deltaInt>=0 ? 'left' : 'right', xshift: f.deltaInt>=0 ? 6 : -6,
    showarrow:false,
    text: '<b>'+(100*Math.abs(f.deltaInt)/(totalAbs||1)).toFixed(0)+'%</b>',
    font:{size:9.5, color: f.deltaInt>=0 ? '#C0392B' : '#1B8F5A'}
  }));
  annotations.push({
    x:0, y:1.10, xref:'paper', yref:'paper', xanchor:'left', showarrow:false,
    text:'<span style="color:#3494BA">■</span> Efecto Weight &nbsp;&nbsp;'
       + '<span style="color:#ACD7CA">■</span> Efecto CO2-H',
    font:{size:10, color: CFG.color_texto}
  });
  if(top.some(f=>f.perdio)){
    annotations.push({
      x:0, y:-0.10, xref:'paper', yref:'paper', xanchor:'left', showarrow:false,
      text:'◇ = emisor con dato de "Perdieron Huella" (sin cobertura ESG actualizada)',
      font:{size:9, color:'#8A99A8'}
    });
  }

  const lay = LAYOUT();
  lay.barmode = 'relative';
  lay.showlegend = false;
  lay.xaxis.title = 'Variación de Intensidad';
  lay.xaxis.zeroline = true;
  lay.xaxis.zerolinecolor = '#B9C2CC';
  lay.xaxis.zerolinewidth = 1.5;
  lay.margin = {l: 190, r: 60, t: 40, b: 55};
  lay.height = Math.max(CFG.alto, 26*top.length + 130);
  lay.annotations = annotations;
  Plotly.react(div, traces, lay, OPTS);
}

