// --- Chart 3: "Asset Performance" — 2 bloques (Equities / Fixed Income).
//     Top 5 FFMM/ETFs por Intensidad. SubCat bajo nombres. Slicer de benchmark.
const MGMT_COLOR = {A: '#00AECB', P: '#002060'};
const MGMT_LABEL = {A: 'Active', P: 'Passive'};
const BENCH_FFMM = __BENCHMARKS_FFMM__;

function _wrapName(txt, maxChars){
  if(!txt || txt.length <= maxChars) return txt||'';
  const words = txt.split(/\s+/);
  const lines = []; let cur = '';
  for(const w of words){
    if(cur && (cur.length + 1 + w.length) > maxChars){ lines.push(cur); cur = w; }
    else { cur = cur ? cur + ' ' + w : w; }
  }
  if(cur) lines.push(cur);
  return lines.join('<br>');
}

function _parseAssetPerf(corte){
  const benchmarks = {};
  const filas = [];
  for(const r of HIST){
    if(r.OBJETO!=='TopSubCat_Asset' || String(r.FECHA_CORTE)!==String(corte)) continue;
    if(r.METRICA==='Intensidad'){
      if(r.DIM_1==='_BENCH_'){
        benchmarks[r.DIM_2] = +r.VALOR||0; continue;
      }
      const parts = (r.DIM_2||'').split('|');
      const mgmt = parts[0]||'A', nombre = parts.slice(1).join('|')||'';
      filas.push({bloque:r.DIM_1, mgmt, nombre, val:+r.VALOR||0, afp:r.AFP||'',
                  subcat:r.DIM_3||''});
    }
    if(r.METRICA==='Weight' && r.DIM_1!=='_BENCH_'){
      const parts2 = (r.DIM_2||'').split('|');
      const n2 = parts2.slice(1).join('|')||'';
      const match = filas.find(f=>f.nombre===n2 && f.bloque===r.DIM_1 && f.afp===(r.AFP||''));
      if(match) match.weight = +r.VALOR||0;
    }
  }
  return {filas, benchmarks};
}

function assetPerformanceAfp(div, corte, benchKey){
  const {filas, benchmarks} = _parseAssetPerf(corte);
  if(!filas.length){ document.getElementById(div).innerHTML=''; return; }
  const integra = filas.filter(f => f.afp==='Integra' || f.afp==='');
  if(!integra.length){ document.getElementById(div).innerHTML=''; return; }
  const bloqueOrden = ['Equities','Fixed Income'];
  const sorted = [];
  bloqueOrden.forEach(b => {
    sorted.push(...integra.filter(f=>f.bloque===b).sort((a,c)=>c.val-a.val).slice(0,5));
  });
  const xLabels = sorted.map(s => _wrapName(s.nombre, 14));
  const esc = _escalaEje(sorted.map(s=>s.val));
  const yVals = sorted.map(s=>s.val / esc.div);
  const colores = sorted.map(s => MGMT_COLOR[s.mgmt] || '#666');
  const bloques = [];
  let cursor = 0;
  bloqueOrden.forEach(bNombre => {
    const items = sorted.filter(s=>s.bloque===bNombre);
    if(!items.length) return;
    const start = cursor; cursor += items.length;
    bloques.push({nombre:bNombre, start, end:cursor-1, centro:(start+cursor-1)/2});
  });
  const traces = [
    {type:'bar', x:xLabels, y:yVals, showlegend:false,
     marker:{color:colores},
     text:yVals.map(v=>v.toFixed(1)), textposition:'outside', cliponaxis:false,
     textfont:{size:10,color:CFG.color_texto},
     customdata:sorted.map(s=>s.nombre),
     hovertemplate:'%{customdata}<br>Intensidad: %{y:.2f}<extra></extra>'}
  ];
  const bk = benchKey || 'Total_Integra';
  let benchLabel = 'Intensidad promedio cartera Integra';
  let benchYvals;
  if(bk.startsWith('FFMM:')){
    const fundName = bk.substring(5);
    const fce = BENCH_FFMM[fundName] || 0;
    benchLabel = fundName;
    benchYvals = sorted.map(s => (fce * (s.weight||0)) / esc.div);
  } else {
    const bVal = benchmarks[bk] || 0;
    if(bk==='F1_Integra') benchLabel='Intensidad F1 Integra';
    else if(bk==='F2_Integra') benchLabel='Intensidad F2 Integra';
    else if(bk==='F3_Integra') benchLabel='Intensidad F3 Integra';
    benchYvals = xLabels.map(() => bVal / esc.div);
  }
  if(benchYvals.some(v=>v>0)){
    traces.push({type:'scatter', mode:'markers',
      name: benchLabel,
      x: xLabels, y: benchYvals,
      marker:{size:10, color:'#0B3C5D', symbol:'circle'}});
  }
  [...new Set(sorted.map(s=>s.mgmt))].sort().forEach(m => {
    traces.push({type:'scatter', mode:'markers', x:[null], y:[null],
      name: MGMT_LABEL[m]||m, marker:{color:MGMT_COLOR[m]||'#666', size:10}});
  });
  const lay = LAYOUT();
  lay.xaxis = {type:'category', tickangle:0, showgrid:false,
               showline:true, linecolor:CFG.color_grid, ticks:'',
               tickfont:{size:10}};
  lay.yaxis.title = 'Intensidad' + (esc.suf ? ' — ' + esc.suf : '');
  lay.legend = {orientation:'h', yanchor:'top', y:-0.38, x:0.5, xanchor:'center',
                bgcolor:'rgba(0,0,0,0)'};
  lay.margin = {l:60, r:30, t:55, b:160};
  lay.shapes = bloques.slice(1).map(b => ({
    type:'line', xref:'x', yref:'y domain',
    x0:b.start-0.5, x1:b.start-0.5, y0:0, y1:1,
    line:{color:'#B8C2CC', width:1, dash:'dot'}
  }));
  const annots = bloques.map(b => ({
    x:b.centro, xref:'x', y:1, yref:'y domain', yshift:14,
    text:'<b>'+b.nombre+'</b>', showarrow:false,
    font:{size:12, color:CFG.color_texto}, xanchor:'center', yanchor:'bottom'
  }));
  sorted.forEach((s, i) => {
    if(s.subcat){
      annots.push({
        x:i, xref:'x', y:0, yref:'paper', yshift:-95,
        text:'<i>'+s.subcat+'</i>', showarrow:false,
        font:{size:9, color:'#8A99A8'}, xanchor:'center', yanchor:'top'
      });
    }
  });
  lay.annotations = annots;
  Plotly.react(div, traces, lay, OPTS);
