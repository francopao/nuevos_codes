def _cargar_benchmarks_ffmm(anio: str, mes: str) -> dict:
    """Lee FUND_NAME y FUND_FINANCED_CARBON_EMISSIONS de la hoja YYYYMM
    de 'Lista Proxies - Huella y Comite mensual ASG.xlsx'. Devuelve
    {fund_name: huella_carbono}."""
    ruta = RUTA_BENCHMARKS_FFMM
    hoja = f"{anio}{mes}"
    if not FsPath(ruta).exists():
        print(f"  [Benchmarks FFMM] No encontrado: {ruta}")
        return {}
    try:
        wb = openpyxl.load_workbook(ruta, read_only=True, data_only=True)
        if hoja not in wb.sheetnames:
            print(f"  [Benchmarks FFMM] Hoja '{hoja}' no encontrada en {ruta}")
            wb.close()
            return {}
        ws = wb[hoja]
        hdr = list(ws.iter_rows(min_row=1, max_row=1, values_only=True))[0]
        idx_name = None
        idx_fce = None
        for i, v in enumerate(hdr):
            if v == "FUND_NAME": idx_name = i
            if v == "FUND_FINANCED_CARBON_EMISSIONS": idx_fce = i
        if idx_name is None or idx_fce is None:
            print(f"  [Benchmarks FFMM] Columnas no encontradas en hoja {hoja}")
            wb.close()
            return {}
        result = {}
        for row in ws.iter_rows(min_row=2, values_only=True):
            name = row[idx_name] if idx_name < len(row) else None
            fce = row[idx_fce] if idx_fce < len(row) else None
            if name and fce is not None:
                try:
                    result[str(name)] = float(fce)
                except (ValueError, TypeError):
                    pass
        wb.close()
        print(f"  [Benchmarks FFMM] {len(result)} benchmarks cargados de hoja {hoja}")
        return result
    except Exception as e:
        print(f"  [Benchmarks FFMM] Error: {e}")
        return {}


