    def top_por_subcat_asset(self) -> pd.DataFrame:
        """Top 5 FFMM/ETFs por Intensidad para Equities (RV) y Fixed Income (RF).
        Incluye SubCat (Mercado para RV, AC_Dir para RF), Mgmt, y benchmarks:
        Intensidad promedio cartera, F1, F2, F3."""
        d = self.df.copy()
        if "GyP_UNIVERSO_VALIDO" not in d.columns:
            return pd.DataFrame()
        d = d[d["GyP_UNIVERSO_VALIDO"] == True]
        d = _sin_huella_cero(d)
        for c in [COL["intensidad"], COL["huella"], COL["inv"]]:
            d[c] = pd.to_numeric(d[c], errors="coerce").fillna(0.0)
        # Intensidad promedio por fondo (F1/F2/F3) y total
        total_inv = d[COL["inv"]].sum()
        intens_total = d[COL["huella"]].sum() / total_inv if total_inv else 0.0
        intens_por_fondo = {}
        if COL["portafolio"] in d.columns:
            for pf in ["IN-FONDO1", "IN-FONDO2", "IN-FONDO3"]:
                sf = d[d[COL["portafolio"]] == pf]
                inv_f = sf[COL["inv"]].sum()
                intens_por_fondo[pf] = sf[COL["huella"]].sum() / inv_f if inv_f else 0.0
        AC_MAP = {"Renta Variable": "Equities", "Renta Fija": "Fixed Income"}
        # SubCat: Mercado para RV (DM/EM/Commodities), AC_Dir para RF (HY/IG/...)
        def _subcat(row, bloque):
            if bloque == "Equities":
                return str(row.get("GyP_MERCADO", "") or "")
            else:
                raw = str(row.get("GyP_AC_DIR", "") or "")
                if "HY" in raw: return "HY"
                if "IG" in raw: return "IG"
                if "EM" in raw: return "EM"
                return raw
        filas = []
        for ac_orig, bloque in AC_MAP.items():
            sub = d[d["GyP_ASSET_CLASS"] == ac_orig]
            if sub.empty:
                continue
            agg_df = _agg(sub, [COL["nombre"]], [COL["intensidad"], COL["inv"]])
            if agg_df.empty:
                continue
            for _, row in agg_df.head(5).iterrows():
                nombre = row[COL["nombre"]]
                top_rows = sub[sub[COL["nombre"]] == nombre]
                mgmt = "A"
                sc = ""
                if not top_rows.empty:
                    if "GyP_A_P" in top_rows.columns:
                        raw = str(top_rows["GyP_A_P"].iloc[0]).strip()
                        mgmt = raw if raw in ("A", "P") else "A"
                    sc = _subcat(top_rows.iloc[0], bloque)
                # Weight del emisor (para calcular intensidad del benchmark)
                wt = (row[COL["inv"]] / self.aum_total_mm) if self.aum_total_mm else 0.0 if COL["inv"] in row.index else 0.0
                filas.append({
                    "Bloque": bloque, "SubCat": sc, "Mgmt": mgmt,
                    COL["nombre"]: nombre,
                    COL["intensidad"]: float(row[COL["intensidad"]]),
                    "Weight": float(wt),
                })
        out = pd.DataFrame(filas)
        if out.empty:
            return out
        # Codificar en DIM_2 = Mgmt|Nombre, DIM_3 = SubCat
        out["Mgmt_Nombre"] = out["Mgmt"] + "|" + out[COL["nombre"]]
        result = out[["Bloque", "Mgmt_Nombre", "SubCat", COL["intensidad"], "Weight"]].copy()
        # Filas especiales de benchmark
        benchmarks = [
            ("_BENCH_", "Total_Integra", intens_total),
            ("_BENCH_", "F1_Integra", intens_por_fondo.get("IN-FONDO1", 0.0)),
            ("_BENCH_", "F2_Integra", intens_por_fondo.get("IN-FONDO2", 0.0)),
            ("_BENCH_", "F3_Integra", intens_por_fondo.get("IN-FONDO3", 0.0)),
        ]
        bench_df = pd.DataFrame([{
            "Bloque": b, "Mgmt_Nombre": mn, "SubCat": "",
            COL["intensidad"]: v, "Weight": 0.0
        } for b, mn, v in benchmarks])
        return pd.concat([result, bench_df], ignore_index=True)
