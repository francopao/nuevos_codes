                            f"{h.get('pais','extranjero')} (factor {h['factor']:.2f}) "
                            f"queda informativo; no se mapea (activos fuera de Perú).")
                        continue
                    aum = exp_fin.get(emisor, 0.0) * h["factor"]
                    if aum <= 0:
