        listas.append(d_s)
        for e in universo_s:
            emp_sector[e] = sector_s
        exp_comb.update(exp_s)
        df_assign_all = pd.concat([df_assign_all, da_s], ignore_index=True)
        um_all.update(um_s)
        detalle_all.update(det_s)
