def _semestre_anio_tcfd(fecha_valorizacion):
    """
    fecha_valorizacion: valor de la celda B1 (ej. '20260630' o 20260630 -> YYYYMMDD).
    Devuelve (semestre, anio) ej. ('1S', 2026).
    Ventana de gracia de TCFD_GRACIA_DIAS días: una fecha poco después del cierre
    de un semestre (ej. 20260715) se sigue asignando al semestre que cerró.
    """
    from datetime import datetime, timedelta
    fecha = datetime.strptime(str(fecha_valorizacion).strip()[:8], "%Y%m%d")
    anio = fecha.year
    fin_2s_anterior = datetime(anio - 1, 12, 31)
    fin_1s_actual = datetime(anio, 6, 30)
    if fecha <= fin_2s_anterior + timedelta(days=TCFD_GRACIA_DIAS):
        return "2S", anio - 1
    elif fecha <= fin_1s_actual + timedelta(days=TCFD_GRACIA_DIAS):
        return "1S", anio
    else:
        return "2S", anio


def _exportar_copia_tcfd(src_html_path, dest_dir, nombre_base, tag):
    """Copia un dashboard HTML ya generado a dest_dir como '<nombre_base> - <tag>.html',
    agregando ' - <tag>' al final del <title> y del primer <h1>. Sobrescribe si existe."""
    import re as _re
    os.makedirs(dest_dir, exist_ok=True)
    with open(src_html_path, "r", encoding="utf-8") as fh:
        html = fh.read()
    sufijo = f" - {tag}"
    html = _re.sub(r"(<title>.*?)(</title>)", lambda m: m.group(1) + sufijo + m.group(2),
                    html, count=1, flags=_re.S)
    html = _re.sub(r"(<h1[^>]*>.*?)(</h1>)", lambda m: m.group(1) + sufijo + m.group(2),
                    html, count=1, flags=_re.S)
    dest_path = os.path.join(dest_dir, f"{nombre_base} - {tag}.html")
    with open(dest_path, "w", encoding="utf-8") as fh:
        fh.write(html)
    log(f"[TCFD] Copia generada: {dest_path}")
    return dest_path

