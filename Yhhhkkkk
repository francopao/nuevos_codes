def _resolver_corte(mes, anio):
    """A partir de CORTE_MES/CORTE_ANIO arma la etiqueta del corte (p.ej.
    'Dic25'). 'mes' acepta número (1-12) o texto (cualquier combinación de
    mayúsculas/minúsculas: 'Dic', 'dic', 'DIC'). No depende de fatal()/log()
    porque corre antes de que esas funciones existan en el archivo."""
    if isinstance(mes, str):
        m = mes.strip()
        abrev = _MESES_ABREV_ES[int(m)] if m.isdigit() else m
    elif mes in _MESES_ABREV_ES:
        abrev = _MESES_ABREV_ES[mes]
    else:
        raise SystemExit(
            f"[CONFIG] CORTE_MES={mes!r} inválido: usa 1-12 o una abreviatura "
            f"de mes (p.ej. 'Dic')."
        )
    anio2 = f"{int(anio) % 100:02d}"   # 2025 -> '25' ; 25 -> '25'
    return f"{abrev}{anio2}"


