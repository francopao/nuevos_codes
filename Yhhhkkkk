def _load_poblacion_distrital(pob_path):
    import openpyxl
    wb = openpyxl.load_workbook(pob_path, data_only=True, read_only=True)
    ws = wb[wb.sheetnames[0]]
    ubi2info, dep2dists = {}, {}
    cur_dep = cur_prov = None
    for r in ws.iter_rows(values_only=True):
        if not r or r[0] is None:
            continue
        try:
            cod = int(float(r[0]))
        except (TypeError, ValueError):
            continue
        s = str(cod).zfill(6)
        nombre = r[1]
        if nombre is None or s == "000000":
            continue
        pob = None
        for v in reversed(r):
            if isinstance(v, (int, float)):
                pob = float(v); break
        if s[2:] == "0000":
            cur_dep = str(nombre).strip(); cur_prov = None; continue
        if s[4:] == "00":
            cur_prov = str(nombre).strip(); continue
        ubi2info[s] = (cur_dep, cur_prov, str(nombre).strip(), pob or 0.0)
        dep2dists.setdefault(norm(cur_dep), []).append((s, pob or 0.0))
    wb.close()
    return ubi2info, dep2dists


def _leer_ancla_departamental(risk_path, hoja, filtro):
    import openpyxl
    wb = openpyxl.load_workbook(risk_path, data_only=True)
    hoja_real = _buscar_hoja(wb.sheetnames, hoja) or hoja
    if hoja_real not in wb.sheetnames:
        wb.close()
        log(f"   [departamental] hoja de anclaje '{hoja}' no encontrada; se omite.", "WARN")
        return []
    ws = wb[hoja_real]
    head = [norm(ws.cell(1, c).value) for c in range(1, ws.max_column + 1)]

    def col(*nombres):
        for nm in nombres:
            t = norm(nm)
            if t in head:
                return head.index(t) + 1
        return None
    cDep = col("Departamento"); cProv = col("Provincia"); cDist = col("Distrito")
    cFil = col("Empresa", "Marca", "Formato", "Business Line", "Activo")
    usar_filtro = not (isinstance(filtro, str) and filtro.strip() == "*")
    claves = {norm(x) for x in filtro} if usar_filtro else set()
    locs = []
    for r in range(2, ws.max_row + 1):
        dep = ws.cell(r, cDep).value if cDep else None
        dist = ws.cell(r, cDist).value if cDist else None
        if dep is None or dist is None:
            continue
        marca_val = ws.cell(r, cFil).value if cFil else None
        if usar_filtro and norm(marca_val) not in claves:
            continue
        prov = ws.cell(r, cProv).value if cProv else None
        marca = str(marca_val).strip() if marca_val else None
        locs.append((str(dep).strip(),
                     str(prov).strip() if prov else None,
                     str(dist).strip(), marca))
    wb.close()
    return locs


def _reparto_mayor_resto(total, fracciones):
    total = int(round(total))
    if total <= 0 or not fracciones:
        return [0] * len(fracciones)
    crudos = [f * total for f in fracciones]
    base = [int(x) for x in crudos]
    resto = total - sum(base)
    orden = sorted(range(len(crudos)), key=lambda i: crudos[i] - base[i], reverse=True)
    for i in orden[:max(0, resto)]:
        base[i] += 1
    return base


def _construir_reparto_departamental(risk_path, pob_path, emisor):
    """Devuelve una lista de dicts, uno por (distrito × business line), con
       campos de auditoría de la metodología:
         depto, prov, dist, business_line, conteo, share,
         metodo, bl_pond, depto_asig, n_depto, pob_dist, pob_depto,
         peso_pond, total_pond"""
    import openpyxl
    from collections import defaultdict
    wb = openpyxl.load_workbook(risk_path, data_only=True)

    hoja_p = _buscar_hoja(wb.sheetnames, DEP_SHEET_PONDERA)
    if not hoja_p:
        wb.close()
        log(f"   [{emisor}] no se halló la hoja '{DEP_SHEET_PONDERA}'; se omite.", "WARN")
        return []
    wp = wb[hoja_p]
    head = [norm(wp.cell(1, c).value) for c in range(1, wp.max_column + 1)]

    def cidx(*nombres):
        for nm in nombres:
            t = norm(nm)
            for i, h in enumerate(head):
                if t and t in h:
                    return i + 1
        return None
    iEm = cidx("Emisor"); iBL = cidx("Business Line"); iPe = cidx("Peso")
    iMe = cidx("Metodo"); iHo = cidx("Hoja_Anclaje", "Hoja Anclaje"); iFi = cidx("Filtro_BL", "Filtro")
    ponder = []
    for r in range(2, wp.max_row + 1):
        em = wp.cell(r, iEm).value if iEm else None
        if em is None or norm(em) != norm(emisor):
            continue
        peso = _peso_a_decimal(wp.cell(r, iPe).value) if iPe else None
        if peso is None:
            continue
        ponder.append({
            "bl": str(wp.cell(r, iBL).value).strip() if iBL and wp.cell(r, iBL).value else "",
            "peso": float(peso),
            "metodo": norm(wp.cell(r, iMe).value) if iMe else "POBLACION",
            "hoja": (str(wp.cell(r, iHo).value).strip() if iHo and wp.cell(r, iHo).value else ""),
            "filtro": (str(wp.cell(r, iFi).value).strip() if iFi and wp.cell(r, iFi).value else "*"),
        })
    if not ponder:
        wb.close()
        log(f"   [{emisor}] sin filas en '{DEP_SHEET_PONDERA}'; se omite.", "WARN")
        return []

    hoja_a = _buscar_hoja(wb.sheetnames, DEP_SHEET_ACTIVOS)
    dep_counts = defaultdict(dict)
    if hoja_a:
        wa = wb[hoja_a]
        h2 = [norm(wa.cell(1, c).value) for c in range(1, wa.max_column + 1)]

        def a2(*nombres):
            for nm in nombres:
                t = norm(nm)
                for i, h in enumerate(h2):
                    if t and t in h:
                        return i + 1
            return None

        jEm = a2("Emisor"); jDe = a2("Departamento"); jBL = a2("Business Line"); jN = a2("N_Activos", "N Activos", "Activos")
        emisor_cuentas = DEP_COUNT_SOURCE.get(emisor, emisor)   # comparten conteos 'InRetail'
        for r in range(2, wa.max_row + 1):
            em = wa.cell(r, jEm).value if jEm else None
            if em is None or norm(em) != norm(emisor_cuentas):
                continue

            dep = wa.cell(r, jDe).value; bl = wa.cell(r, jBL).value; n = wa.cell(r, jN).value
            try:
                n = float(n)
            except (TypeError, ValueError):
                n = 0.0
            if dep and bl and n > 0:
                dep_counts[str(bl).strip()][str(dep).strip()] = n
    wb.close()

    ubi2info, dep2dists = _load_poblacion_distrital(pob_path)

    def pool_departamento(depto):
        dn = norm(depto)
        pool = list(dep2dists.get(dn, []))
        if dn == "LIMA":
            for k, v in dep2dists.items():
                if "CALLAO" in k:
                    pool += v
        return pool

    share = defaultdict(float)
    conteo = defaultdict(float)
    meta = {}

    for p in ponder:
        bl_pond, peso, metodo = p["bl"], p["peso"], p["metodo"]
        if peso <= 0:
            continue
        if metodo.startswith("ANCLA"):
            filtro = [x.strip() for x in p["filtro"].split(";")] if p["filtro"] != "*" else "*"
            locs = _leer_ancla_departamental(risk_path, p["hoja"], filtro)
            M = len(locs)
            if M == 0:
                log(f"   [{emisor}] anclaje '{bl_pond}' sin ubicaciones; peso {peso:.4f} no mapeado.", "WARN")
                continue
            w = peso / M
            for (dep, prov, dist, marca) in locs:
                etiqueta = marca or bl_pond
                key = (dep, prov, dist, etiqueta)
                share[key] += w
                conteo[key] += 1
                meta[key] = {"metodo": "anclaje", "bl_pond": bl_pond, "depto_asig": dep,
                             "n_depto": None, "pob_dist": None, "pob_depto": None,
                             "peso_pond": peso, "total_pond": M}
        else:
            counts_dep = dep_counts.get(bl_pond, {})
            Ntot = sum(counts_dep.values())
            if Ntot <= 0:
                log(f"   [{emisor}] '{bl_pond}' (poblacion) sin conteos; peso {peso:.4f} no mapeado.", "WARN")
                continue
            for depto, N in counts_dep.items():
                pool = pool_departamento(depto)
                tot_pob = sum(pb for _, pb in pool)
                if tot_pob <= 0:
                    log(f"   [{emisor}] sin población para '{depto}' ({bl_pond}); se omite.", "WARN")
                    continue
                for (u, pb) in pool:
                    dep2, prov2, dist2, _ = ubi2info[u]
                    frac = pb / tot_pob
                    key = (dep2, prov2, dist2, bl_pond)
                    share[key] += peso * (N / Ntot) * frac
                    conteo[key] += N * frac
                    meta[key] = {"metodo": "poblacion", "bl_pond": bl_pond, "depto_asig": depto,
                                 "n_depto": N, "pob_dist": pb, "pob_depto": tot_pob,
                                 "peso_pond": peso, "total_pond": Ntot}

    # ---- Hamilton/Hare: enteros por (departamento × business line) en método
    #      'poblacion'. Los distritos con cuota redondeada a 0 se eliminan y su
    #      peso de exposición se redistribuye entre los que conservan >=1 activo
    #      (se conservan el total físico por depto y el peso del grupo). ----
    grupos_pob = defaultdict(list)
    for k, mm in meta.items():
        if mm["metodo"] == "poblacion":
            grupos_pob[(mm["depto_asig"], mm["bl_pond"])].append(k)
    a_borrar = []
    stats = {}   # (depto, bl_pond) -> cobertura para la hoja de metodología
    for (dep_a, blp), claves in grupos_pob.items():
        N = int(round(meta[claves[0]]["n_depto"]))
        suma_c = sum(conteo[k] for k in claves) or 1.0
        enteros = _reparto_mayor_resto(N, [conteo[k] / suma_c for k in claves])
        n_eval = len(claves); n_cero = 0; pob_cero = 0.0
        pob_dep = meta[claves[0]]["pob_depto"]
        for k, e in zip(claves, enteros):
            meta[k]["cuota_exacta"] = conteo[k]      # cuota fraccional (auditoría)
            conteo[k] = e
            if e > 0:
                # L homogéneo: cada activo del BL vale lo mismo en AUM, sin importar el
                # distrito. peso_pond = peso del BL ; total_pond = N nacional del BL.
                share[k] = e * meta[k]["peso_pond"] / meta[k]["total_pond"]
            else:
                a_borrar.append(k); n_cero += 1; pob_cero += meta[k]["pob_dist"]
        stats[(dep_a, blp)] = {"n_depto": N, "evaluados": n_eval, "con": n_eval - n_cero,
                               "cero": n_cero, "pob_cero": pob_cero, "pob_dep": pob_dep}
    for k in a_borrar:
        share.pop(k, None); conteo.pop(k, None); meta.pop(k, None)
    for k, mm in meta.items():                       # anclaje: cuota = su entero
        mm.setdefault("cuota_exacta", conteo[k])

    filas = []
    for k, sh in share.items():
        dep, prov, dist, bl = k
        m = meta[k]
        filas.append({"depto": dep, "prov": prov, "dist": dist, "business_line": bl,
                      "conteo": conteo[k], "share": sh, **m})
    return filas, stats


def load_empresa_departamental(risk_path, pob_path, emisor):
    filas, _ = _construir_reparto_departamental(risk_path, pob_path, emisor)
    if not filas:
        return _df_actividad([])
    out = []
    for f in filas:
        out.append({
            "mineral": f["business_line"], "unidad": "activos", "titular": emisor,
            "unidad_minera": f'{emisor} - {f["dist"]} ({f["business_line"]})',
            "depto": f["depto"], "prov": f["prov"], "dist": f["dist"],
            "acum": round(f["conteo"], 2), "unidad_norm": "activos",
            "factor": 1.0, "tmf": f["share"], "empresa": emisor,
        })
    df = _df_actividad(out)
    n_bl = len({f["business_line"] for f in filas})
    n_dist = len({(f["depto"], f["prov"], f["dist"]) for f in filas})
    log(f"   [{emisor}] departamental: {n_dist} distrito(s) x {n_bl} business line | "
        f"activos≈{sum(f['conteo'] for f in filas):.0f} | suma peso={sum(f['share'] for f in filas):.4f}")
    return df



# Mapa business-line físico -> emisores cuyo footprint la contiene (conteos se
# solapan). Consumer NO incluye Shopping Malls; Peru Corp incluye todo. Intercorp
# NO se arma aquí: su conteo sale del footprint distrital (Interbank + Peru Corp).
FEN_EMISOR_POR_BL = {
    "Makro":             ["InRetail Consumer", "Inretail Peru Corp", "Intercorp Perú"],
    "Plaza Vea/Vivanda": ["InRetail Consumer", "Inretail Peru Corp", "Intercorp Perú"],
    "Mass":              ["InRetail Consumer", "Inretail Peru Corp", "Intercorp Perú"],
    "Pharmacies":        ["InRetail Consumer", "Inretail Peru Corp", "Intercorp Perú"],
    "Shopping Malls":    ["InRetail Shopping Malls", "Inretail Peru Corp", "Intercorp Perú"],
}


def _activos_fisicos_por_region_fen(risk_path):
    """{emisor: {'Región - Categoría': conteo}} desde 'Activos Departamentales' +
       'FEN_Apoyo'. Cada business line física suma su conteo a TODOS los emisores
       cuyo footprint la contiene (ver FEN_EMISOR_POR_BL); por eso los conteos se
       solapan (un Makro cuenta en Consumer y en Peru Corp). Intercorp no se arma
       aquí: su conteo sale del footprint distrital (Interbank + Peru Corp)."""
    import openpyxl
    from collections import defaultdict
    wb = openpyxl.load_workbook(risk_path, data_only=True)
    hoja_fen = _buscar_hoja(wb.sheetnames, "FEN_Apoyo") or ("FEN_Apoyo" if "FEN_Apoyo" in wb.sheetnames else None)
    dep2label = {}
    if hoja_fen and hoja_fen in wb.sheetnames:
        wf = wb[hoja_fen]
        hf = [norm(wf.cell(1, c).value) for c in range(1, wf.max_column + 1)]
        def f2(*nombres):
            for nm in nombres:
                t = norm(nm)
                if t in hf:
                    return hf.index(t) + 1
            return None
        cD = f2("Departamento") or 1; cC = f2("Categoria") or 2; cR = f2("Region") or 3
        for r in range(2, wf.max_row + 1):
            dep = wf.cell(r, cD).value
            if not dep:
                continue
            cat = wf.cell(r, cC).value; reg = wf.cell(r, cR).value
            if reg and cat:
                dep2label[norm(dep)] = f"{str(reg).strip()} - {str(cat).strip()}"
            elif reg:
                dep2label[norm(dep)] = str(reg).strip()
    bl_map = {norm(k): v for k, v in FEN_EMISOR_POR_BL.items()}
    hoja_a = _buscar_hoja(wb.sheetnames, DEP_SHEET_ACTIVOS)
    out = defaultdict(lambda: defaultdict(float))
    if hoja_a:
        wa = wb[hoja_a]
        h2 = [norm(wa.cell(1, c).value) for c in range(1, wa.max_column + 1)]
        def a2(*nombres):
            for nm in nombres:
                t = norm(nm)
                for i, h in enumerate(h2):
                    if t and t in h:
                        return i + 1
            return None
        jDe = a2("Departamento"); jBL = a2("Business Line"); jN = a2("N_Activos", "N Activos", "Activos")
        for r in range(2, wa.max_row + 1):
            bl = wa.cell(r, jBL).value if jBL else None
            if not bl:
                continue
            emisores = bl_map.get(norm(bl))
            if not emisores:
                continue
            dep = wa.cell(r, jDe).value; n = wa.cell(r, jN).value
            try:
                n = float(n)
            except (TypeError, ValueError):
                continue
            if n <= 0:
                continue
            label = dep2label.get(norm(dep))
            if not label:
                continue
            for emi in emisores:
                out[emi][label] += n
    wb.close()
    return {e: {lbl: int(round(v)) for lbl, v in d.items()} for e, d in out.items()}



def _agregar_hoja_metodologia_dep(wb, risk_path, pob_path, emisor):
    """Hoja auditable del proxy poblacional, re-derivable con fórmulas visibles:
       población -> cuota -> piso -> resto -> sobrantes -> tienda extra -> K.
       Incluye bloque de cobertura por departamento (evaluados = con>=1 + en 0)."""
    from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
    from collections import OrderedDict
    filas, stats = _construir_reparto_departamental(risk_path, pob_path, emisor)
    if not filas:
        log(f"   [{emisor}] sin datos para la hoja de metodología.", "WARN")
        return
    AZUL = "1E2E6E"
    HDR = Font(name="Calibri", size=10, bold=True, color="FFFFFF")
    TIT = Font(name="Calibri", size=13, bold=True, color=AZUL)
    SUB = Font(name="Calibri", size=9, italic=True, color="595959")
    BOLD = Font(name="Calibri", size=10, bold=True)
    BODY = Font(name="Calibri", size=10)
    fH = PatternFill("solid", fgColor=AZUL); fIn = PatternFill("solid", fgColor="FFF3B0")
    fCalc = PatternFill("solid", fgColor="EAF3E8")
    thin = Side(style="thin", color="D9D9D9"); box = Border(left=thin, right=thin, top=thin, bottom=thin)
    AC = Alignment(horizontal="center")

    nombre = f"Metodología {emisor}"[:31]
    if nombre in wb.sheetnames:
        del wb[nombre]
    ws = wb.create_sheet(nombre); ws.sheet_view.showGridLines = False

    ws["A1"] = f"Metodología de distribución distrital — {emisor}"; ws["A1"].font = TIT
    ws["A2"] = ("Cada distrito recibe tiendas en proporción a su población dentro del departamento. Como no existen "
                "fracciones de tienda, primero se da a cada uno su parte entera (Piso); las tiendas que sobran se "
                "entregan una por una a los distritos con mayor Resto (los más cerca de la siguiente tienda completa).")
    ws["A2"].font = SUB
    ws["A3"] = ("Los distritos con muy poca población quedan en 0 tiendas y no se listan aquí, pero SÍ se evaluaron "
                "(ver bloque 'Cobertura por departamento'). Makro/Plaza Vea/Vivanda/Shopping Malls se anclan a su "
                "ubicación real. Amarillo = dato de entrada; verde = celda formulada (recalculable). Callao se agrupa en 'Lima'.")
    ws["A3"].font = SUB

    # ---------- Parámetros por línea ----------
    par = OrderedDict()
    for f in filas:
        par.setdefault(f["bl_pond"], (f["metodo"], f["peso_pond"], f["total_pond"]))
    ws["A5"] = "Parámetros por línea de negocio (ponderación)"; ws["A5"].font = BOLD
    for c, h in enumerate(["Línea (ponderación)", "Método", "Peso (revenue)", "Total activos (nacional)"], 1):
        cc = ws.cell(6, c, h); cc.font = HDR; cc.fill = fH; cc.border = box; cc.alignment = AC
    pr0 = 7
    for i, (blp, (met, peso, tot)) in enumerate(par.items()):
        r = pr0 + i
        ws.cell(r, 1, blp).font = BODY; ws.cell(r, 2, met).font = BODY
        cc = ws.cell(r, 3, peso); cc.number_format = "0.000000"; cc.fill = fIn
        cc = ws.cell(r, 4, int(round(tot))); cc.number_format = "#,##0"; cc.fill = fIn
        for c in range(1, 5):
            ws.cell(r, c).border = box

    # ---------- Orden del detalle (grupos contiguos por BL x depto) ----------
    orden = {"Makro": 0, "Plaza Vea": 1, "Vivanda": 2, "Mass": 3, "Pharmacies": 4, "Shopping Malls": 5}
    fo = sorted(filas, key=lambda f: (orden.get(f["business_line"], 9), f["business_line"],
                                      f["depto_asig"] or "", -f["share"]))
    # Posiciones (para que la auditoría referencie el detalle con fórmulas)
    audit_title = pr0 + len(par) + 2
    audit_hdr = audit_title + 1
    audit_first = audit_hdr + 1
    audit_last = audit_hdr + len(stats)
    hrow = audit_last + 3
    det_first = hrow + 1
    det_last = hrow + len(fo)

    spans = {}
    i = 0
    while i < len(fo):
        if fo[i]["metodo"] == "poblacion":
            key = (fo[i]["business_line"], fo[i]["depto_asig"])
            j = i
            while j < len(fo) and fo[j]["metodo"] == "poblacion" and \
                  (fo[j]["business_line"], fo[j]["depto_asig"]) == key:
                j += 1
            ef, el = det_first + i, det_first + (j - 1)
            for t in range(i, j):
                spans[t] = (ef, el)
            i = j
        else:
            i += 1

    # ---------- Bloque de cobertura por departamento ----------
    ws.cell(audit_title, 1, "Cobertura por departamento (prueba de que se evaluó TODO el universo INEI)").font = BOLD
    ah = ["Departamento", "Línea", "Tiendas a repartir (N)", "Distritos evaluados",
          "Con ≥1 tienda", "En 0 (omitidos)", "% pob. omitida", "Σ tiendas asignadas", "Verif. (=N)"]
    for c, h in enumerate(ah, 1):
        cc = ws.cell(audit_hdr, c, h); cc.font = HDR; cc.fill = fH; cc.border = box; cc.alignment = AC
    ar = audit_first
    for (dep_a, blp), s in sorted(stats.items(), key=lambda kv: (orden.get(kv[0][1], 9), kv[0][0])):
        ws.cell(ar, 1, dep_a).font = BODY; ws.cell(ar, 2, blp).font = BODY
        cc = ws.cell(ar, 3, int(s["n_depto"])); cc.number_format = "#,##0"; cc.fill = fIn
        cc = ws.cell(ar, 4, int(s["evaluados"])); cc.number_format = "#,##0"; cc.fill = fIn
        cc = ws.cell(ar, 5, int(s["con"])); cc.number_format = "#,##0"; cc.fill = fIn
        cc = ws.cell(ar, 6, int(s["cero"])); cc.number_format = "#,##0"; cc.fill = fIn
        pob_pct = (s["pob_cero"] / s["pob_dep"]) if s["pob_dep"] else 0.0
        cc = ws.cell(ar, 7, pob_pct); cc.number_format = "0.00%"; cc.fill = fIn
        f = (f'=SUMIFS($Q${det_first}:$Q${det_last},$D${det_first}:$D${det_last},$A{ar},'
             f'$A${det_first}:$A${det_last},$B{ar})')
        cc = ws.cell(ar, 8, f); cc.number_format = "#,##0"; cc.fill = fCalc
        cc = ws.cell(ar, 9, f'=IF(H{ar}=C{ar},"✓","≠")'); cc.fill = fCalc
        for c in range(1, 10):
            ws.cell(ar, c).border = box
        ar += 1

    # ---------- Detalle por distrito ----------
    ws.cell(hrow - 1, 1, "Detalle por distrito × business line").font = BOLD
    dh = ["Business Line", "Línea (ponderación)", "Método", "Departamento", "Provincia", "Distrito",
          "N activos depto", "Pob. distrito", "Pob. departamento", "% pob. distrito",
          "Cuota exacta", "Piso (parte entera)", "Resto", "Ranking del resto",
          "Sobrantes del depto", "¿Recibió tienda extra?", "Tiendas asignadas (K)",
          "Verificación", "% Distribución (exposición)"]
    for c, h in enumerate(dh, 1):
        cc = ws.cell(hrow, c, h); cc.font = HDR; cc.fill = fH; cc.border = box; cc.alignment = AC

    r = det_first
    for idx, f in enumerate(fo):
        pob = (f["metodo"] == "poblacion")
        ws.cell(r, 1, f["business_line"]).font = BODY
        ws.cell(r, 2, f["bl_pond"]).font = BODY
        ws.cell(r, 3, f["metodo"]).font = BODY
        ws.cell(r, 4, f["depto_asig"]).font = BODY
        ws.cell(r, 5, f["prov"]).font = BODY
        ws.cell(r, 6, f["dist"]).font = BODY
        if pob:
            ef, el = spans[idx]
            cc = ws.cell(r, 7, int(round(f["n_depto"]))); cc.number_format = "#,##0"; cc.fill = fIn
            cc = ws.cell(r, 8, round(f["pob_dist"])); cc.number_format = "#,##0"; cc.fill = fIn
            cc = ws.cell(r, 9, round(f["pob_depto"])); cc.number_format = "#,##0"; cc.fill = fIn
            ws.cell(r, 10, f"=IF(I{r}=0,0,H{r}/I{r})").number_format = "0.0000%"
            ws.cell(r, 11, f"=G{r}*J{r}").number_format = "#,##0.0000"
