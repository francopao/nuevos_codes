 table.piv thead th, table.fen thead th:not([style]), table.regtbl th{
   background:#4D93D9 !important;color:#fff !important;}
 table.fen thead th.idx-h{background:#eef3ff !important;color:var(--azul) !important;}





</style></head>
<body>
<div class="topbar">
  <div style="min-width:80px"></div>
  <div class="center">
    <h1>Impacto FEN por Departamento</h1>
    <div class="sub">Mesa de Inversiones · Bottom-Up · Impacto del FEN (1997-98 / 2016-17 / 2023-24) medido por Apoyo Consultoría</div>
  </div>
  <div class="right">Generado<br><b id="gen">—</b></div>
</div>

<div class="tabbar">
  <button class="tab active" data-tab="resumen">Resumen</button>
  <button class="tab" data-tab="rv">Renta Variable</button>
  <button class="tab" data-tab="rf">Renta Fija</button>
