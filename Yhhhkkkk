    _factor_peru_all = {}
    for _h in _holdings_all:
        if _h.get("es_peru", True):
            _factor_peru_all[_h["emisor"]] = _factor_peru_all.get(_h["emisor"], 0.0) + _h["factor"]

    def _aplicar_factor_peru(exp_dict, etiqueta_sector):
        """Multiplica el AUM de cada emisor por su factor Perú (si está en Holdings).
        Emisores sin fila en Holdings quedan intactos (factor 1)."""
        for _e, _f in _factor_peru_all.items():
            if _e in exp_dict and _f > 0 and abs(_f - 1.0) > 1e-9:
                _orig = exp_dict[_e]
                exp_dict[_e] = _orig * _f
                log(f"{etiqueta_sector}: '{_e}' AUM ajustado por factor Perú {_f:.2f} "
                    f"(S/ {_orig:,.0f} -> S/ {exp_dict[_e]:,.0f}); "
                    f"{(1-_f)*100:.0f}% extranjero fuera.")
        return exp_dict


    # ---------- SECTOR MINERÍA ----------
    df_prod, _ = load_produccion(prod_path, risk_path, geo_idx, scores)

    exp = load_exposicion(risk_path, sheet_val)
    exp = _aplicar_factor_peru(exp, SECTOR_MINERIA)          # NUEVO
    districts_min, df_assign, um, detalle, no_map, dfm = build_model(
        df_prod, exp, scores, geo_idx, EMPRESAS_CANONICAS, SECTOR_MINERIA)

    # mapa empresa -> sector y exposición combinada (arranca con minería)
    emp_sector = {e: SECTOR_MINERIA for e in EMPRESAS_CANONICAS}
