function buildTbl3(hz, filtroEmisor, filtroSector){
  const wrap=document.getElementById('tbl3_'+hz.key);
  if(!wrap) return;
  const col=hz.col;
  const niveles=[1,2,3,4,5];
  const desglosar=!!DESGLOSE_TBL3[hz.key];

  // NUEVO: mismos scores que la sección "Score por empresa" (ADICIÓN 4).
  // hz.key es 'mm' | 'inu' | 'seq' -> escenario correspondiente.
  const SC=calcScores();
  const sKey=hz.key;
  const scoreEmp=e=>(SC[e]&&typeof SC[e][sKey]==='number')?SC[e][sKey]:null;

  const portCat={}; niveles.forEach(L=>portCat[L]=0);
  const secCat={}, compCat={};
  D.forEach(d=>{
    const L=d[col];
    if(niveles.indexOf(L)<0) return;          // sin N/D
    (d.ap||[]).forEach(a=>{
      const m=a.m*classFrac(a.e); if(m<=0) return;
      const sec=EMP_SECTOR[a.e]||a.s||'(sin sector)';
      portCat[L]+=m;
      (secCat[sec]=secCat[sec]||{})[L]=(secCat[sec][L]||0)+m;
      const cc=(compCat[sec]=compCat[sec]||{});
      (cc[a.e]=cc[a.e]||{})[L]=(cc[a.e][L]||0)+m;
    });
  });

  const sectoresDisp = filtroSector ? [filtroSector]
    : [...new Set(Object.values(EMP_SECTOR).filter(Boolean))].sort();
  const pc=(num,den)=> den>0 ? (num/den*100).toLocaleString('es-PE',{maximumFractionDigits:1})+'%' : '—';

  // FIX: universo de TODOS los emisores de este peligro (todos los sectores
  // presentes en compCat, respetando filtroEmisor/filtroSector ya aplicados
  // arriba al construir D/compCat). Es el mismo criterio "de cartera completa"
  // que ya usa portCat[L] como denominador de las % de la fila "AUM Total":
  // por eso la fila "AUM Total" debe usar ESTE valor de Posición (constante
  // en todos los bloques de sector), y NO el de un sector puntual.
  const universoEmisoresPeligro = [...new Set(
    Object.values(compCat).flatMap(cc => Object.keys(cc))
  )];
  const posicionTotalPeligro = posicionEmisores(universoEmisoresPeligro);

  // NUEVO: score del sector = promedio de los scores de sus empresas ponderado
  // por la plata de cada empresa con score CENEPRED válido en este peligro.
  const scoreSector=sec=>{
    const comps=compCat[sec]||{}; let num=0, den=0;
    Object.keys(comps).forEach(emp=>{
      const s=scoreEmp(emp); if(s===null) return;
      const w=niveles.reduce((t,L)=>t+(comps[emp][L]||0),0);
      if(w>0){ num+=s*w; den+=w; }
    });
    return den>0 ? num/den : null;
  };


  // NUEVO: score de la fila "AUM Total" = promedio simple de los scores de
  // TODAS las empresas del sector.
  const scorePromedioSector=sec=>{
    const comps=compCat[sec]||{};
    const vals=Object.keys(comps).map(scoreEmp).filter(v=>v!==null);
    if(!vals.length) return null;
    return vals.reduce((a,b)=>a+b,0)/vals.length;
  };



  const celScore=v=> v===null
    ? '<td style="text-align:center">—</td>'
    : '<td class="sc-cell" style="background:'+scoreBg(v)+'">'+v.toFixed(2)+'</td>';
  const celMit=emp=> MOSTRAR_MITIG_TBL3 ? mitiCell(emp) : '';
  const celMitVacia=()=> MOSTRAR_MITIG_TBL3 ? '<td style="text-align:center">—</td>' : '';

  let html='<label class="tbl3-chk"><input type="checkbox" '+(desglosar?'checked':'')+
           ' onchange="toggleDesglose(\''+hz.key+'\',this.checked)"> Desglosar por empresa</label>'+
           '<button class="lyrbtn" style="margin-left:10px" onclick="toggleMitigTbl3()">'+
           (MOSTRAR_MITIG_TBL3?'Ocultar Mitigantes':'Mostrar Mitigantes')+'</button>';

  sectoresDisp.forEach(sec=>{
    const sc=secCat[sec]; if(!sc) return;
    const secTot=niveles.reduce((s,L)=>s+(sc[L]||0),0);
    if(secTot<=0) return;
    html+='<div class="tbl3-titulo">'+sec+'</div>';scoreSector
    html+='<table class="tbl3"><thead><tr><th class="idx">Riesgo</th>';
    niveles.forEach(L=>{ html+='<th>'+L+'</th>'; });
    html+='<th>Score</th>';                                   // NUEVO
    html+='<th>Posición</th>';                                // NUEVO: monto invertido
    if(MOSTRAR_MITIG_TBL3) html+='<th>Mitigantes</th>';       // NUEVO
    html+='</tr></thead><tbody>';
    if(!desglosar){
      html+='<tr><td class="idx">AUM '+sec+'</td>';
      niveles.forEach(L=>{ html+='<td>'+pc(sc[L]||0, secTot)+'</td>'; });
      html+=celScore(scoreSector(sec))+
            celPos(posicionEmisores(Object.keys(compCat[sec]||{})))+
            celMitVacia()+'</tr>';
    } else {
      const comps=compCat[sec]||{};
      Object.keys(comps).sort().forEach(emp=>{
        const cc=comps[emp];
        const compTot=niveles.reduce((s,L)=>s+(cc[L]||0),0);
        if(compTot<=0) return;
        html+='<tr><td class="idx">'+emp+'</td>';
        niveles.forEach(L=>{ html+='<td>'+pc(cc[L]||0, compTot)+'</td>'; });
        html+=celScore(scoreEmp(emp))+celPos(posicionEmisor(emp))+celMit(emp)+'</tr>';
      });
      html+='<tr class="tbl3-sector"><td class="idx">AUM '+sec+'</td>';
      niveles.forEach(L=>{ html+='<td>'+pc(sc[L]||0, secTot)+'</td>'; });
      html+=celScore(scoreSector(sec))+
            celPos(posicionEmisores(Object.keys(compCat[sec]||{})))+
            celMitVacia()+'</tr>';
    }
    html+='<tr class="tbl3-total"><td class="idx">AUM Total</td>';
    niveles.forEach(L=>{ html+='<td>'+pc(sc[L]||0, portCat[L]||0)+'</td>'; });
    const sp=scorePromedioSector(sec);
    html+='<td>'+(sp===null?'':sp.toFixed(2))+'</td>';
    html+=celPos(posicionTotalPeligro);   // FIX: antes repetía el Posición del sector
    if(MOSTRAR_MITIG_TBL3) html+='<td></td>';
    html+='</tr></tbody></table>';
  });

  wrap.innerHTML = html || '<p style="font-size:11px;color:var(--plomo)">Sin exposición para este filtro.</p>';
}

// ======================================================================
//  ADICIÓN 4 — Scores ponderados por empresa y por sector
// ======================================================================
// calcScores(): score CENEPRED por emisor y peligro, ponderado por la plata del
// emisor en cada distrito (clase activa via classFrac). NOTA: distritos sin score
// para un peligro (frecuente en Sequías) cuentan 0 en el numerador con denominador
// = plata total del emisor (fórmula literal solicitada); esto deprime el score
// cuando el emisor tiene plata en zonas sin dato. Compartida por ambas columnas.
function calcScores(){
  const tot={}, perDist={};
  D.forEach(d=>{
    const acc={};
    (d.ap||[]).forEach(a=>{ const m=a.m*classFrac(a.e); if(m>0) acc[a.e]=(acc[a.e]||0)+m; });
    Object.entries(acc).forEach(([e,m])=>{
      tot[e]=(tot[e]||0)+m;
      (perDist[e]=perDist[e]||[]).push({mm:d.smm,inu:d.sinu,seq:d.sseq,plata:m});
    });
  });
  const out={};
  Object.keys(tot).forEach(e=>{
    // NUEVO: renormaliza sobre la plata CON score CENEPRED. Sin cobertura -> null (s/d)
    const ac={mm:0,inu:0,seq:0}, den={mm:0,inu:0,seq:0};
    perDist[e].forEach(x=>{
      ['mm','inu','seq'].forEach(k=>{
        if(typeof x[k]==='number'){ ac[k]+=x[k]*x.plata; den[k]+=x.plata; }
      });
    });
    const v=k=> den[k]>0 ? ac[k]/den[k] : null;
    const mm=v('mm'), inu=v('inu'), seq=v('seq');
    const vv=[mm,inu,seq].filter(z=>z!==null);
    const g = vv.length ? vv.reduce((a,b)=>a+b,0)/vv.length : null;
    const r=z=> z===null ? null : +z.toFixed(2);
    out[e]={mm:r(mm), inu:r(inu), seq:r(seq), global:r(g)};
  });
  return out;
}
function scoreBg(v){
  if(v<2) return '#d4edda';
  if(v<3) return '#fff3cd';
  if(v<=4) return '#ffe0b2';
  return '#f8d7da';
}
function scCell(v){
  if(v===null||v===undefined) return '<td class="sc-cell" style="background:#f0f0f0">-</td>';
  return '<td class="sc-cell" style="background:'+scoreBg(v)+'">'+v.toFixed(2)+'</td>';
}

// CAMBIO 3: Mitigantes con lookup tolerante (sin acentos / sin mayúsculas) y color
function getMitigante(emisor){
  if(MITIGANTES[emisor]) return MITIGANTES[emisor];
  const norm = s => s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
  const ne = norm(emisor);
  const found = Object.keys(MITIGANTES).find(k => norm(k) === ne);
  return found ? MITIGANTES[found] : '—';
}
function mitiCell(emisor){
  const v = getMitigante(emisor);
  // NUEVO: lógica invertida — mitigante Alto es BUENO (verde); Bajo es MALO (rojo).
  const bg = v==='Alto'?'#d4edda' : v==='Medio'?'#fff3cd' : v==='Bajo'?'#f8d7da' : '';
  return '<td style="text-align:center'+(bg?(';background:'+bg):'')+'">'+v+'</td>';
}
function mitiCell(emisor){
  const v = getMitigante(emisor);
  // NUEVO: lógica invertida — mitigante Alto es BUENO (verde); Bajo es MALO (rojo).
  const bg = v==='Alto'?'#d4edda' : v==='Medio'?'#fff3cd' : v==='Bajo'?'#f8d7da' : '';
  return '<td style="text-align:center'+(bg?(';background:'+bg):'')+'">'+v+'</td>';
}
function getMitigantePrev(emisor){
  if(MITIGANTES_PREV[emisor]) return MITIGANTES_PREV[emisor];
  const norm = s => s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
  const ne = norm(emisor);
  const f = Object.keys(MITIGANTES_PREV).find(k => norm(k) === ne);
  return f ? MITIGANTES_PREV[f] : '\u2014';
}
function mitiCellPrev(emisor){
  const v = getMitigantePrev(emisor);
  const bg = v==='Alto'?'#d4edda' : v==='Medio'?'#fff3cd' : v==='Bajo'?'#f8d7da' : '';
  return '<td style="text-align:center'+(bg?(';background:'+bg):'')+'">'+v+'</td>';
}
