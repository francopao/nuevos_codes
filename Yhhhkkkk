                    hi["paises"].append((h.get("pais", "Perú"), h["factor"]))
                    if h.get("es_peru", True):
                        hi["pct_peru"] += h["factor"]

                geo_bancos = None
                if any(h["fuente"] == "Banca" for h in holdings):
