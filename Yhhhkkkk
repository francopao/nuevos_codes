HOLDINGS_SHEET_HINTS = ["Holdings", "Holding"]

def _peso_a_decimal(v):
    """Peso a float. Blindado para celdas con fórmula (con data_only ya viene el
    valor calculado). Acepta decimal (0.012), porcentaje ('8%') o texto ('0,12')."""
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return float(v)
    raw = str(v).strip()
    s = raw.replace("%", "").replace(",", ".")
    try:
        x = float(s)
    except ValueError:
        return None
    return x / 100.0 if "%" in raw else x


def load_holdings(risk_path):
    """Control declarativo del sector financiero. Hoja 'Holdings':
    Emisor | Fuente | Banco | Hoja_Activos | AUM_Factor | [Sector].
    Robusto a: dimensión mal grabada en modo read_only, fila de título sobre el
    encabezado, y variantes de nombre de columna (espacios/mayúsculas/acentos)."""
    import openpyxl
    def _abrir(ro):
        return openpyxl.load_workbook(risk_path, read_only=ro, data_only=True)
    wb = _abrir(True)
    hoja = None
    for h in HOLDINGS_SHEET_HINTS:
        for s in wb.sheetnames:
            if norm(h) in norm(s):
                hoja = s; break
        if hoja:
            break
    if hoja is None:
        log(f"Holdings: no se encontró ninguna hoja que contenga 'Holdings' en "
            f"{os.path.basename(risk_path)}. Hojas: {wb.sheetnames}", "WARN")
        wb.close(); return []
    ws = wb[hoja]
    try:
        ws.reset_dimensions()      # corrige dimensión mal grabada (read_only)
    except Exception:
        pass
    rows = [r for r in ws.iter_rows(values_only=True)]
    wb.close()
    # si read_only no devolvió datos utilizables, reintentar SIN read_only
    if sum(1 for r in rows if any(c is not None for c in r)) < 2:
        wb = _abrir(False); ws = wb[hoja]
        rows = [r for r in ws.iter_rows(values_only=True)]; wb.close()
    rows = [r for r in rows if any(c is not None for c in r)]
    if not rows:
        log(f"Holdings: la hoja '{hoja}' está vacía.", "WARN"); return []
    # localizar la fila de encabezados (la que contenga 'Emisor')
    hdr_i = None
    for i, r in enumerate(rows[:8]):
        if any("EMISOR" in norm(c) for c in r):
            hdr_i = i; break
    if hdr_i is None:
        log(f"Holdings: en '{hoja}' no se halló encabezado con 'Emisor'. "
            f"1ra fila: {rows[0]}", "WARN"); return []
    head = [norm(c) for c in rows[hdr_i]]
    def idx(*names):
        for nm in names:
            t = norm(nm)
            for i, h in enumerate(head):
                if t and t in h:       # subcadena (tolerante)
                    return i
        return None
    iE = idx("Emisor"); iF = idx("Fuente"); iB = idx("Banco", "Bancos")
    iHA = idx("Hoja_Activos", "Hoja Activos", "Hoja")
    iFac = idx("AUM_Factor", "AUM Factor", "Factor"); iS = idx("Sector")
    iPais = idx("Pais", "País", "Country")                         # NUEVO
    out = []
    for r in rows[hdr_i + 1:]:
        def cel(i):
            return r[i] if (i is not None and i < len(r)) else None
        if cel(iE) is None:
            continue
        # NUEVO: país de la fila (default Perú si no hay columna o celda vacía)
        pais = (str(cel(iPais)).strip() if cel(iPais) else "Perú")
        es_peru = norm(pais) in ("PERU", "PE", "")
        fac = _peso_a_decimal(cel(iFac)) if cel(iFac) is not None else 1.0
        if not es_peru:                                            # NUEVO
            # fila extranjera: solo informativa (cuenta para Σ factores), sin geografía
            out.append({"emisor": str(cel(iE)).strip(), "fuente": "Extranjero",
                        "bancos": [], "hojas": [],
                        "factor": (fac if fac is not None else 1.0),
                        "sector": (str(cel(iS)).strip() if cel(iS) else ""),
                        "pais": pais, "es_peru": False})
            continue
        fuente = (str(cel(iF)).strip() if cel(iF) else "Banca")
        bancos = [x.strip() for x in str(cel(iB)).split(";")] if cel(iB) else []
        hojas = [x.strip() for x in str(cel(iHA)).split(";")] if cel(iHA) else []
        out.append({"emisor": str(cel(iE)).strip(),
                    "fuente": ("Hoja" if norm(fuente).startswith("HOJA")
                               else "Departamental" if norm(fuente).startswith("DEPARTAMENTAL")
                               else "Banca"),
                    "bancos": bancos, "hojas": hojas,
                    "factor": (fac if fac is not None else 1.0),
                    "sector": (str(cel(iS)).strip() if cel(iS) else SECTOR_FINANCIERO),
                    "pais": pais, "es_peru": True})                # NUEVO
    log(f"Holdings: hoja '{hoja}', {len(out)} renglón(es) leído(s).")
    return out

def load_holding_activos(risk_path, hojas):
    """Lee la(s) hoja(s) de activos de un holding y devuelve un DataFrame con la
    forma que espera build_model (empresa se setea luego al nombre del holding).
    El 'Peso' es el peso de reparto; build_model lo normaliza por share."""
    import openpyxl, pandas as pd
    filas = []
    wb = openpyxl.load_workbook(risk_path, read_only=True, data_only=True)
    for nombre_hoja in hojas:
        hoja_real = _buscar_hoja(wb.sheetnames, nombre_hoja)
        if not hoja_real:
            log(f"Holdings: hoja de activos '{nombre_hoja}' no encontrada; se omite.", "WARN")
            continue
        rows = list(wb[hoja_real].iter_rows(min_row=1, values_only=True))
        if not rows:
            continue
        head = [norm(c) for c in rows[0]]
        def idx(*names):
            for nm in names:
                if norm(nm) in head:
                    return head.index(norm(nm))
            return None
        iEmp = idx("Empresa"); iBL = idx("Business Line", "Linea de Negocio")
        iAct = idx("Activo"); iDep = idx("Departamento", "Depto")
        iProv = idx("Provincia"); iDist = idx("Distrito")
        iPeso = idx("Peso", "Participacion", "Ponderacion")
        if iDist is None or iPeso is None:
            log(f"Holdings: hoja '{hoja_real}' sin columnas Distrito/Peso; se omite.", "WARN")
            continue
        for r in rows[1:]:
            peso = _peso_a_decimal(r[iPeso]) if iPeso is not None else None
            if peso is None or peso <= 0:
                continue
            filas.append({
                "empresa": None,
                "titular": (str(r[iEmp]).strip() if iEmp is not None and r[iEmp] else ""),
                "business_line": (str(r[iBL]).strip() if iBL is not None and r[iBL] else ""),
                "unidad_minera": (str(r[iAct]).strip() if iAct is not None and r[iAct] else None),
                "mineral": (str(r[iBL]).strip() if iBL is not None and r[iBL] else "Activo"),
                "unidad": "", "unidad_norm": "holding",
                "depto": (str(r[iDep]).strip() if iDep is not None and r[iDep] else None),
                "prov": (str(r[iProv]).strip() if iProv is not None and r[iProv] else None),
                "dist": (str(r[iDist]).strip() if iDist is not None and r[iDist] else None),
                "acum": peso, "factor": 1.0, "tmf": peso,
            })
    wb.close()
    return pd.DataFrame(filas)


def merge_sectores(listas_districts):
    """Fusiona varias listas de 'districts' (una por sector) en una sola por ubigeo.
    Suma exposición y plata-en-riesgo, combina empresas y concatena el desglose.
    Los scores CENEPRED son idénticos por ubigeo entre sectores."""
    out = {}
    for districts in listas_districts:
        for d in districts:
            u = d["ubigeo"]
            if u not in out:
                out[u] = {
                    "ubigeo": u, "dep": d["dep"], "prov": d["prov"], "dist": d["dist"],
                    "tmf": 0.0, "exposicion": 0.0, "exp_sec": {},
                    "has_exp": False, "has_score": d["has_score"],
                    "nivel": d.get("nivel"),
                    "score_mm": d["score_mm"], "score_inu": d["score_inu"],
                    "score_seq": d["score_seq"], "score_comb": d["score_comb"],
                    "mar_mm": 0.0, "mar_inu": 0.0, "mar_seq": 0.0,
                    "empresas": {}, "minerales": [], "aportes": [],
                }
            o = out[u]
            o["tmf"] += d.get("tmf", 0.0)
            o["exposicion"] = round(o["exposicion"] + d["exposicion"], 2)
            for s, v in d.get("exp_sec", {}).items():
                o["exp_sec"][s] = round(o["exp_sec"].get(s, 0.0) + v, 2)
            o["has_exp"] = o["has_exp"] or d["has_exp"]
            for hz in ("mar_mm", "mar_inu", "mar_seq"):
                o[hz] = round(o[hz] + d.get(hz, 0.0), 2)
            for k, v in d.get("empresas", {}).items():
                o["empresas"][k] = round(o["empresas"].get(k, 0.0) + v, 2)
            o["minerales"].extend(d.get("minerales", []))
            o["aportes"].extend(d.get("aportes", []))
    return list(out.values())


