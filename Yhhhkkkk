        universo_all += list(universo_s)


    # ===== Empresas "departamentales" (InRetail y futuros): distribución distrital =====
    #  Se calcula UNA sola vez y se reutiliza en empresas-hoja y en el holding.
    DEP_DISTS = {}
    try:
        _pob_path = find_file(POBLACION_DIR, POBLACION_PATTERNS, "Población distrital INEI")
        log(f"Población distrital : {_pob_path}")
        for _emi in EMPRESAS_DEPARTAMENTAL:
            _dfd = load_empresa_departamental(risk_path, _pob_path, _emi)
            if not _dfd.empty:
                DEP_DISTS[_emi] = _dfd

    except Exception as _e:
        log(f"Empresas departamentales: no se pudo construir la distribución: {_e}", "WARN")

    # ---------- SECTOR FINANCIERO (declarativo: hoja 'Holdings') ----------
    # Cada emisor toma SU PROPIO AUM y clase (Valorización) y se reparte sobre una o más
    # geografías: agencias de un banco del B-2358 (Fuente=Banca) y/o una hoja de activos
