def norm(s):
    """Normaliza texto: mayúsculas, sin acentos, solo [A-Z0-9 ], colapsa espacios."""
    if s is None:
        return ""
    s = str(s).strip().upper()
    s = "".join(c for c in unicodedata.normalize("NFKD", s) if not unicodedata.combining(c))
    s = re.sub(r"[^A-Z0-9 ]", " ", s)
    return re.sub(r"\s+", " ", s).strip()



