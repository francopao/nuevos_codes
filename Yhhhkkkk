.card{background:#fff;border:1px solid var(--linea);border-radius:10px;
  padding:14px 16px;margin-bottom:18px;}
.card h3{margin:0 0 4px;font-size:15px;color:var(--azul);}
.card .note{font-size:12px;color:var(--plomo);margin:0 0 10px;}
.controls{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;margin-bottom:10px;}
.controls label{display:block;font-size:11px;color:var(--plomo);margin-bottom:3px;}
.controls select{padding:6px 9px;border:1px solid var(--linea);border-radius:6px;
  font-size:13px;color:var(--txt);background:#fff;}
/* leyenda mapa */
.legend{display:flex;flex-wrap:wrap;gap:10px;margin:10px 0 4px;font-size:12px;}
.legend .sw{display:inline-flex;align-items:center;gap:6px;}
.legend i{width:16px;height:16px;border-radius:3px;display:inline-block;border:1px solid #ccc;}
/* tabla interactiva */
.tblwrap{overflow:auto;border:1px solid var(--linea);border-radius:8px;}
table.fen{border-collapse:collapse;width:100%;font-size:12.5px;}
table.fen thead th{position:sticky;top:0;background:background:#4D93D9;color:#fff;
  padding:9px 12px;text-align:center;white-space:nowrap;z-index:2;font-weight:700;}
table.fen thead th.idx-h{background:#eef3ff;color:var(--azul);text-align:left;}
table.fen td{padding:8px 12px;border:1px solid var(--linea);text-align:center;
  vertical-align:middle;}
table.fen td.riesgo-cell{font-weight:800;font-size:15px;color:#fff;
  text-align:center;width:50px;}
.r5{background:#c0392b;} .r4{background:#e67e22;}
.r3{background:#f1c40f;color:#5a4500!important;}
.r2{background:#27ae60;} .r1{background:#2ecc71;}
table.fen td.pct-cell{font-weight:700;color:var(--azul);font-size:14px;}
table.fen td.sub-cell{font-size:10px;color:var(--plomo);font-weight:400;}
table.fen tr.total-row td{background:#eef3ff;font-weight:700;color:var(--azul);}
table.fen tr.total-row td.riesgo-cell{background:var(--azul);color:#fff;font-size:12px;font-weight:700;}
table.fen tr:hover td:not(.riesgo-cell){background:#f7f9ff;}
body.ocultar-montos .sub-cell{display:none;}
/* mapa */
#mapFen{width:100%;height:580px;}
/* Sección Regiones FEN (dos columnas) */
.reg-2col{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
@media(max-width:900px){.reg-2col{grid-template-columns:1fr;}}
.reg-col .controls{margin-bottom:8px;}
.reg-col select[multiple]{min-width:170px;padding:4px;}
table.regtbl{border-collapse:collapse;width:100%;font-size:12px;margin:0 0 12px;}
table.regtbl th{background:background:#4D93D9;color:#fff;padding:6px 10px;text-align:right;
  white-space:nowrap;font-weight:600;}
table.regtbl th:first-child{text-align:left;}
table.regtbl td{padding:5px 10px;border:1px solid var(--linea);text-align:right;white-space:nowrap;}
table.regtbl td.idx{text-align:left;font-weight:600;color:var(--azul);}
table.regtbl tr:hover td{background:#f7f9ff;}
table.regtbl tr.reg-total td{background:#eef3ff;font-weight:700;color:var(--azul);}
table.regtbl tr.reg-total:hover td{background:#e6edff;}
.reg-tbl-title{font-size:12.5px;font-weight:700;color:var(--azul);text-align:left;margin:10px 0 4px;}
.reg-empty{font-size:11.5px;color:var(--plomo);padding:6px 0;}
footer{border-top:1px solid var(--linea);margin-top:10px;padding:14px 26px;
  color:var(--plomo);font-size:11.5px;background:var(--grisbg);}
footer b{color:var(--azul);}


 /* --- NUEVO: color único de headers de tablas (#4D93D9) --- */
 table.piv thead th,
 table.tbl3 th,
 table.fen thead th:not([style]),
 table.regtbl th{ background:#4D93D9 !important; color:#fff !important; }
 /* excepciones que NO deben pintarse: índices laterales */
 table.tbl3 th.idx{ background:var(--grisbg) !important; color:var(--azul) !important; }
 table.fen thead th.idx-h{ background:#eef3ff !important; color:var(--azul) !important; }




