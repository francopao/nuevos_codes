def _tabla_sector(detalle_sector: pd.DataFrame, metrica: str, rol_map: dict) -> pd.DataFrame:
    if detalle_sector is None or detalle_sector.empty or metrica not in detalle_sector.columns:
        return pd.DataFrame()
    df = detalle_sector.copy()
    cat_tipo = df["Categoria_Tipo"].str.split("|", n=1, expand=True)
    df["Categoria"] = cat_tipo[0]
    df["Tipo_Dato"] = cat_tipo[1]
    df = df.rename(columns={"FECHA_CORTE": "Corte", "Nombre": "Emisor"})
    df["Corte"] = df["Corte"].astype(str)
    df["Metrica"] = metrica
    df["Valor"] = pd.to_numeric(df[metrica], errors="coerce").fillna(0.0)
    df["Corte_Rol"] = df["Corte"].map(rol_map).fillna("")
    cols = ["Corte", "Corte_Rol", "AFP", "Categoria", "Tipo_Dato", "Emisor", "SBS", "Metrica", "Valor"]
    return df[cols].sort_values(["Corte", "AFP", "Categoria", "Emisor"], ignore_index=True)
```

