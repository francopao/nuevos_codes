def _tabla_sector(hist: pd.DataFrame, metrica: str, rol_map: dict) -> pd.DataFrame:
    df = hist[(hist["OBJETO"] == "Sector_MSCI_Proxies_Detalle") & (hist["METRICA"] == metrica)].copy()
    cat_tipo = df["DIM_3"].str.split("|", n=1, expand=True)
    df["Categoria"] = cat_tipo[0]
    df["Tipo_Dato"] = cat_tipo[1]
    df = df.rename(columns={"FECHA_CORTE": "Corte", "DIM_1": "Emisor",
                             "DIM_2": "SBS", "VALOR": "Valor"})
    df["Metrica"] = metrica
    df["Corte_Rol"] = df["Corte"].map(rol_map).fillna("")
    cols = ["Corte", "Corte_Rol", "AFP", "Categoria", "Tipo_Dato", "Emisor", "SBS", "Metrica", "Valor"]
    return df[cols].sort_values(["Corte", "AFP", "Categoria", "Emisor"], ignore_index=True)
```
