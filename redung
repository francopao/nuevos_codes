```

**Código actual completo:**
```javascript
function sectorMsciProxies(div, metrica, cAct, cCmp){
  const ordenSeries = [];
  CFG.categorias_sector.forEach(c=>{ ordenSeries.push(c, c + ' (Proxies)'); });
  apiladoPorCorte(div, 'Sector_MSCI_Proxies', metrica, cAct, cCmp, {
    orden: ordenSeries,
    clave: r => r.DIM_1 + (r.DIM_2==='Proxies' ? ' (Proxies)' : ''),
    marker: markerCategoria,
    y: metrica,
    compacto: true
  });
}
