REEMPLAZAR POR:
```js
function layout(panel, traces){
  const [s,e] = currentRange();
  const monthsVisible = e - s + 1;
  const xdtick = monthsVisible<=24 ? "M3" : monthsVisible<=60 ? "M6" : monthsVisible<=120 ? "M12" : "M24";
  const yr = computeYRange(traces) || panel.yrange;
  return {
    margin:{l:34,r:8,t:6,b:44},
    height:300, plot_bgcolor:"#fff", paper_bgcolor:"#fff",
    font:{ family:"Segoe UI, Arial", size:10.5, color:"#333" },
    showlegend:true,
    legend:{ orientation:"h", x:0.5, xanchor:"center", y:-0.16, yanchor:"top",
             font:{size:9.5}, tracegroupgap:2 },
    xaxis:{ type:"date", tickformat:"%m-%y", dtick:xdtick, ticks:"outside",
            tickfont:{size:9.5}, showgrid:false, linecolor:"#b9c0cc",
            tickangle:0 },
    yaxis:{ range:yr, tickformat:panel.tickfmt,
            ticks:"outside", tickfont:{size:9.5}, showgrid:false,
            zeroline:false, linecolor:"#b9c0cc" }
  };
}
```

