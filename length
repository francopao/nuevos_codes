```js
let BASIS = "trail";
let RANGE_START = null;
let RANGE_END   = null;

function fechaToIndex(yyyyMm, fallback){
  const i = FECHAS.indexOf(yyyyMm);
  return i === -1 ? fallback : i;
}
function currentRange(){
  const s = RANGE_START===null ? 0 : RANGE_START;
  const e = RANGE_END===null ? FECHAS.length-1 : RANGE_END;
  return [Math.min(s,e), Math.max(s,e)];
}
function slice(arr, s, e){ return arr.slice(s, e+1); }

function computeYRange(traces){
  let lo=Infinity, hi=-Infinity;
  traces.forEach(t=>(t.y||[]).forEach(v=>{
    if(v===null||v===undefined) return;
    if(v<lo) lo=v; if(v>hi) hi=v;
  }));
  if(!isFinite(lo)||!isFinite(hi)) return undefined;
  if(lo===hi){ lo-=1; hi+=1; }
  const pad=(hi-lo)*0.08;
  return [lo-pad, hi+pad];
}
```

