    # valores (normalizados) trae esa columna, para compararlos contra las 2
    # cadenas que el script espera encontrar (ERR_A_CLASE, 2 líneas más arriba).
    log(f"[DIAG Posición] Columna real usada para 'Clasificación ERR': '{cols['err']}'.")
    log(f"[DIAG Posición] Valores únicos normalizados en esa columna (conteo): "
        f"{df['_errn'].value_counts().to_dict()}")
    log(f"[DIAG Posición] El script busca EXACTAMENTE (normalizado): "
        f"{[norm(k) for k in ERR_A_CLASE]}")

