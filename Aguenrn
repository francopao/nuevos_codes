def renombrar_columnas_por_posicion(df, mapping):
    cols = list(df.columns)
    for pos, nombre in mapping.items():
        if pos < len(cols):
            cols[pos] = nombre
    df.columns = cols
    return df
#%%
def extraer_valores_columna(DF, a, institucion):
    """
    Devuelve DF[a] como Serie. Si el diccionario de renombre (Diccionario_SBS.xlsx)
    colapsa dos variantes de nombre SBS (notas "N/", asteriscos, espacios pegados a
    paréntesis) en el mismo Nombre_Nuevo, 'a' queda duplicado en DF.columns y DF[a]
    deja de ser una Serie para ser un DataFrame -> rompía el .insert(). Se consolida
    tomando, fila por fila, el primer valor no nulo entre las columnas duplicadas,
    y se avisa para poder auditar el diccionario si el caso no es el esperado.
    """
    valores = DF[a]
    if isinstance(valores, pd.DataFrame):
        print(f"Aviso: '{a}' aparece {valores.shape[1]} veces en {institucion} tras el mapeo del Diccionario_SBS (posible variante de nombre SBS). Se consolidaron los valores tomando el primero no nulo por fila.")
        valores = valores.bfill(axis=1).iloc[:, 0]
    return valores
