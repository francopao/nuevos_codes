def iniciar_driver():
    """Selenium Manager resuelve el chromedriver compatible solo.
    Se elimina CHROMEDRIVER_PATH: con Chrome autoactualizándose, la ruta fija
    siempre se va a desfasar."""
    options = webdriver.ChromeOptions()
    if HEADLESS:
        options.add_argument("--headless=new")
    options.add_argument("--ignore-certificate-errors")
    options.add_argument("--window-size=1366,900")

    carpeta_temp = os.path.join(os.environ.get("TEMP", r"C:\Temp"), "descargas_sbs_tmp")
    os.makedirs(carpeta_temp, exist_ok=True)
    options.add_experimental_option("prefs", {
        "download.default_directory": carpeta_temp,
        "download.prompt_for_download": False,
        "download.directory_upgrade": True,
        "safebrowsing.enabled": True,
    })

    driver = webdriver.Chrome(options=options)   # sin Service() -> Selenium Manager
    driver.set_page_load_timeout(60)
    return driver


def _esperar(driver, locators, descripcion, clickable=True, timeout=10):
    """Prueba varios locators en orden. Si ninguno funciona, lanza un error
    que SÍ dice qué elemento falló y en qué URL (el TimeoutException pelado
    de Selenium viene con mensaje vacío)."""
    for by, sel in locators:
        try:
            cond = (EC.element_to_be_clickable((by, sel)) if clickable
                    else EC.presence_of_element_located((by, sel)))
            return WebDriverWait(driver, timeout).until(cond)
        except TimeoutException:
            continue
    raise TimeoutException(
        f"[{descripcion}] no apareció en {timeout}s.\n"
        f"    URL actual: {driver.current_url}\n"
        f"    Locators probados: {locators}"
    )
```

