def fijar_carpeta_descarga(driver, carpeta):
    """Browser.setDownloadBehavior aplica a toda la sesión (incluidas pestañas
    nuevas que abre 'Exportar'); Page.setDownloadBehavior está deprecado y solo
    cubre el target actual."""
    os.makedirs(carpeta, exist_ok=True)
    try:
        driver.execute_cdp_cmd("Browser.setDownloadBehavior",
                               {"behavior": "allow", "downloadPath": carpeta})
    except Exception:
        driver.execute_cdp_cmd("Page.setDownloadBehavior",
                               {"behavior": "allow", "downloadPath": carpeta})
```

