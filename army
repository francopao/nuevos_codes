def recor(dato):
    if str(dato) != "None":
        dato = str(dato)
        dato = dato[0:2]
    return dato

def FM(dato):
    dato = str(dato)
    if re.findall('FM', dato) == ['FM']:
        dato = "borrar"
    return dato

def codEmisor(dato):
    return str(dato)[2:6]

def usd_f1(d): return 1 if d == "F1" else 0
def usd_f2(d): return 1 if d == "F2" else 0
def usd_f3(d): return 1 if d == "F3" else 0

def _resolver_columna(df, nombres, obligatoria=True):
    if isinstance(nombres, str):
        nombres = [nombres]
    cols = list(df.columns)
    cols_str = {str(c).strip(): c for c in cols}
    for nom in nombres:
        if nom in cols_str:
            return cols_str[nom]
    for nom in nombres:
        for c_str, c_real in cols_str.items():
            if c_str.startswith(nom) or nom.startswith(c_str):
                return c_real
    for nom in nombres:
        cerca = difflib.get_close_matches(nom, list(cols_str.keys()), n=1, cutoff=0.85)
        if cerca:
            print(f"[AVISO] Columna '{nom}' aproximada a '{cerca[0]}'.")
            return cols_str[cerca[0]]
    if obligatoria:
        raise ProcesoError(f"No se encontró ninguna de {nombres}. Columnas: {cols}")
    return None


