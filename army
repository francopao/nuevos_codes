class ProcesoError(Exception):
    """Error controlado del pipeline (archivo/hoja/columna/celda/red)."""


def _diag_ruta(ruta):
    d = os.path.dirname(ruta)
    if not os.path.exists(d):
        return f"(la carpeta '{d}' no responde: ¿unidad de red Z: caída/desconectada?)"
    return "(la carpeta existe pero el archivo no)"


# ============================================================================
#  LECTURA openpyxl (cacheada) -> DataFrame crudo alineado a A1 (como xlwings)
# ============================================================================
_CACHE_XLSX = {}   # (ruta, hoja) -> DataFrame

def leer_xlsx(ruta, hoja=0, obligatoria_hoja=True):
    """Lee una hoja completa (valores cacheados) y la cachea. Alinea a A1."""
    key = (ruta, hoja)
    if key in _CACHE_XLSX:
        return _CACHE_XLSX[key].copy()
    try:
        wb = openpyxl.load_workbook(ruta, read_only=True, data_only=True, keep_links=False)
    except FileNotFoundError:
        raise ProcesoError(f"No se encontró el archivo:\n  {ruta}\n  {_diag_ruta(ruta)}")
    except Exception as e:
        raise ProcesoError(f"No se pudo abrir:\n  {ruta}\n  Detalle: {e}")
    try:
        if isinstance(hoja, int):
            if hoja >= len(wb.sheetnames):
                raise ProcesoError(f"El archivo '{ruta}' no tiene la hoja índice {hoja}.")
            ws = wb[wb.sheetnames[hoja]]
        else:
            if hoja not in wb.sheetnames:
                if obligatoria_hoja:
                    raise ProcesoError(f"No existe la hoja '{hoja}' en '{ruta}'. "
                                       f"Hojas: {wb.sheetnames}")
                return None
            ws = wb[hoja]
        data = [row for row in ws.iter_rows(values_only=True)]
    finally:
        wb.close()
    df = pd.DataFrame(data)
    _CACHE_XLSX[key] = df.copy()
    return df


