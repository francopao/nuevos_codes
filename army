_FECHA_RE = re.compile(r'^\d{4}-\d{2}-\d{2}$')

def _fecha_desde_entorno():
    """Prioridad: FECHA_FORZADA (variable editable) > argumento CLI con formato
    YYYY-MM-DD. Ignora flags de Spyder/IPython (p.ej. '-f <kernel.json>')."""
    if FECHA_FORZADA:
        return FECHA_FORZADA
    for a in sys.argv[1:]:
        if _FECHA_RE.match(a):
            return a
    return None

def main():
    fecha_forzada = _fecha_desde_entorno()
    try:
        fecha_dt = detectar_fecha(fecha_forzada)
