def _get_app():
    global xw, _XW_APP
    if _XW_APP is None:
        import xlwings as _xw
        xw = _xw
        _XW_APP = xw.App(visible=False, add_book=False)
        _XW_APP.display_alerts = False
        _XW_APP.screen_updating = False
    return _XW_APP


def _abrir_xw(ruta, alterna=None):
    app = _get_app()
    try:
        return app.books.open(ruta, read_only=True, update_links=False)
    except Exception:
        if alterna is not None and os.path.exists(alterna):
            print(f"[AVISO] No se pudo abrir:\n  {ruta}\n-> usando alterna:\n  {alterna}")
            return app.books.open(alterna, read_only=True, update_links=False)
        if not os.path.exists(ruta):
            raise ProcesoError(f"No se encontró (COM):\n  {ruta}\n  {_diag_ruta(ruta)}")
        raise


def _espera_activa(sheet, celda, timeout=25, intervalo=0.3, minimo=0.8):
    """Reemplaza time.sleep fijo: espera hasta que 'celda' tenga valor (recálculo
    listo) o hasta timeout. 'minimo' asegura un pequeño margen inicial."""
    time.sleep(minimo)
    t0 = time.time()
    prev = object()
    while time.time() - t0 < timeout:
        try:
            val = sheet.range(celda).value
        except Exception:
            val = None
        if val is not None and val == prev:      # estable y no vacío
            return val
        prev = val
        time.sleep(intervalo)
    return sheet.range(celda).value


# --------------------------------------------------- G&P (escenario + recálculo)
def leer_gyp(escenario, mesanio):
    """Escribe el escenario en Abs!E3, fuerza recálculo y devuelve 'Detallado'."""
    ruta = R_GYP_TMPL.format(mesanio=mesanio)
    wb = _abrir_xw(ruta, alterna=R_GYP_ALT)
    try:
        try:
            sh_abs = wb.sheets['Abs']
            sh_det = wb.sheets['Detallado']
        except Exception:
            raise ProcesoError("G&P no tiene las hojas 'Abs' y/o 'Detallado'.")
        sh_abs.range('E3').value = escenario
        try:
            wb.app.calculate()
        except Exception:
            pass
        _espera_activa(sh_det, 'C5', timeout=30, minimo=1.0)  # antes: sleep(10) fijo
        print("G&P C5 =", sh_det.range('C5').value)
        valores = sh_det.used_range.value
    finally:
        wb.close()
    return pd.DataFrame(valores)


# --------------------------------------------------- RIESGO (Tipo de Cambio)
_CACHE_RIESGO = {}   # fecha_yyyymmdd -> DataFrame used_range

def leer_riesgo(fecha_yyyymmdd):
    """Escribe la fecha en B1 de 'Tipo de Cambio', recalcula y cachea el rango."""
    if fecha_yyyymmdd in _CACHE_RIESGO:
        return _CACHE_RIESGO[fecha_yyyymmdd].copy()
    wb = _abrir_xw(R_RIESGO)
    try:
        try:
            sheet = wb.sheets['Tipo de Cambio']
        except Exception:
            raise ProcesoError("RIESGO no tiene la hoja 'Tipo de Cambio'.")
        sheet.range('B1').value = fecha_yyyymmdd
        try:
            wb.app.calculate()
        except Exception:
            pass
        _espera_activa(sheet, 'B1', timeout=20, minimo=1.0)   # antes: sleep(5/6) fijo
        valores = sheet.used_range.value
    finally:
        wb.close()
    df = pd.DataFrame(valores)
    _CACHE_RIESGO[fecha_yyyymmdd] = df.copy()
    return df


