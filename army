# --- Q por AFP (QEST DQ_RV/RF) ----------------------------------------------
def _retorna(row, fondo, afp_only=None):
    if row['Fondo'] == fondo and (afp_only is None or row['Afp'] == afp_only):
        return row[fondo]
    return 0

def Q_AFP_integra(df, dic_sbs):
    p = df.copy(deep=True)
    p.insert(9, 'F1', p["SBS"].map(dic_sbs['IN-FONDO1']))
    p.insert(10, 'F2', p["SBS"].map(dic_sbs['IN-FONDO2']))
    p.insert(11, 'F3', p["SBS"].map(dic_sbs['IN-FONDO3']))
    p['F1'] = p.apply(lambda r: _retorna(r, 'F1', 'Integra'), axis=1)
    p['F2'] = p.apply(lambda r: _retorna(r, 'F2', 'Integra'), axis=1)
    p['F3'] = p.apply(lambda r: _retorna(r, 'F3', 'Integra'), axis=1)
    p["Q"] = p['F1'] + p['F2'] + p['F3']
    return p.drop(['F1', 'F2', 'F3'], axis=1)

def QM_AFP_integra(df, dic_sbs):
    p = df.copy(deep=True)
    p.insert(9, 'F1', p["SBS"].map(dic_sbs['IN-FONDO1']))
    p.insert(10, 'F2', p["SBS"].map(dic_sbs['IN-FONDO2']))
    p.insert(11, 'F3', p["SBS"].map(dic_sbs['IN-FONDO3']))
    p["Q"] = p['F1'] + p['F2'] + p['F3']
    return p.drop(['F1', 'F2', 'F3'], axis=1)

def _Q_X_OPE(df, fecha_nueva, AFP):
    df = df.copy(deep=True)
    df.columns = df.iloc[15, ::]
    df = df.drop([15], axis=0)
    f1, f2, f3 = (AFP + "-FONDO1_" + fecha_nueva, AFP + "-FONDO2_" + fecha_nueva,
                  AFP + "-FONDO3_" + fecha_nueva)
    df = df[(df['Fondo_Fecha'] == f1) | (df['Fondo_Fecha'] == f2) | (df['Fondo_Fecha'] == f3)]
    t = df.transpose(); t.columns = t.iloc[0, ::]
    return t

def _gen_dic(rv, rf, fecha_nueva, AFP):
    return pd.concat([_Q_X_OPE(rv, fecha_nueva, AFP),
                      _Q_X_OPE(rf, fecha_nueva, AFP)]).to_dict()

def _ret_f(row, f):
    if row['Fondo'] == f or row['Fondo'] == "Multifondos":
        return row[f]
    return 0
def _ret_multi(row):
    return (row['F1'] + row['F2'] + row['F3']) if row['Fondo'] == "Multifondos" else 0
def _corr(row, f):
    if row['Fondo'] == "Multifondos":
        return 0
    if row['Fondo'] == f:
        return row[f]

def Q_AFP(AFP, AFP_, f1, f2, f3, rv, rf, fecha_nueva, abrAFP):
    PM = pd.concat([AFP, AFP_])
    dic = _gen_dic(rv, rf, fecha_nueva, abrAFP)
    PM.insert(9, 'F1', PM["SBS"].map(dic[f1]))
    PM.insert(10, 'F2', PM["SBS"].map(dic[f2]))
    PM.insert(11, 'F3', PM["SBS"].map(dic[f3]))
    PM['F1'] = PM.apply(lambda r: _ret_f(r, 'F1'), axis=1)
    PM['F2'] = PM.apply(lambda r: _ret_f(r, 'F2'), axis=1)
    PM['F3'] = PM.apply(lambda r: _ret_f(r, 'F3'), axis=1)
    PM.insert(12, 'Multifondos', PM.apply(_ret_multi, axis=1))
    PM['F1'] = PM.apply(lambda r: _corr(r, 'F1'), axis=1)
    PM['F2'] = PM.apply(lambda r: _corr(r, 'F2'), axis=1)
    PM['F3'] = PM.apply(lambda r: _corr(r, 'F3'), axis=1)
    PM['F1'] = PM['F1'].replace(np.nan, 0)
    PM['F2'] = PM['F2'].replace(np.nan, 0)
    PM['F3'] = PM['F3'].replace(np.nan, 0)
    PM["Q"] = PM['F1'] + PM['F2'] + PM['F3'] + PM['Multifondos']
    return PM.drop(['F1', 'F2', 'F3', 'Multifondos'], axis=1)


def _renom_afp(row):
    return {'F1': 'Ex_INF1', 'F2': 'Ex_INF2', 'F3': 'Ex_INF3',
            'Multifondos': 'Ex_INFM'}.get(row['Fondo'])


def _if_BU(row):
    return row['Name_P'] if row['Strategy'] == "BU" else row['Nombre']

def dic_emisor(df1, valor, fecha_nueva, param_bu):
    df = param_bu.copy(deep=True)
    df.columns = df.iloc[0, ::]
    df = df.drop([0], axis=0).set_index("SBS")
    dic = df.to_dict()
    p = df1.copy(deep=True)
    p.insert(11, 'Name_P', p["SBS"].map(dic['Name']))
    p['Nombre'] = p.apply(_if_BU, axis=1)
    p = p.drop(['Name_P'], axis=1)
    p['Tipo'], p['Fecha'] = valor, fecha_nueva
    p = p.rename(columns={"Rank Rt": "assetclass"})
    return p.get(['SBS', 'ISIN', 'Weight', 'Fondo', 'assetclass', 'Strategy', 'Afp',
                  'AUM', 'Tipo', 'Q', 'Nombre', 'Fecha', 'codEmisor'])


def _operaciones_df_p_m(df):
    df = df.copy(deep=True)
    df.insert(1, 'SBS2', df["SBS"].apply(recor))
    df = df.loc[df['SBS2'].isin(['54', '50'])].sort_index(ignore_index=True)
    df['Strategy'] = 'BU'
    df["key1"] = df["SBS"] + df["Fondo"] + df["Afp"]
    return df


def _leer_bd1_local(ruta_bd1):
    """Re-lee el BD1 recién escrito (round-trip preservado como en el original)."""
    df = leer_xlsx(ruta_bd1, 'Sheet1')
    df.columns = df.iloc[0, ::]
    return df.drop([0], axis=0)


def plantilla_epu_etf(anio, mes):
    def _one(nombre, sbs_valor):
        dfx = leer_xlsx(D_COMPARABLES + nombre, hoja=0)
        dfx.columns = dfx.iloc[0, ::]
        dfx = dfx.drop([0], axis=0)
        col_isin = _resolver_columna(dfx, ['ISIN'])
        col_mv = _resolver_columna(dfx, ['Market Value (%) (P)', 'Market Value (%)'])
        dfx = dfx[dfx[col_isin].notna()]
        dfx = dfx[dfx[col_mv].notna()]
        dfx[col_mv] = dfx[col_mv] / 100
        dfx = dfx.get([col_isin, col_mv])
        dfx.columns = ['ISIN', 'Market Value (%) (P)']
        dfx['Market Value (%) (P)'] = dfx['Market Value (%) (P)'].fillna(0)
        out = pd.DataFrame()
        for i in ["Integra", "Habitat", "Prima", "Profuturo", "Ex_Integra"]:
            for j in ["F1", "F2", "F3", "Multifondos"]:
                d = dfx.copy(deep=True); d["Fondo"] = j; d["AFP"] = i
                out = pd.concat([out, d])
        out = out.reset_index(drop=True)
        out["SBS"] = sbs_valor
        out["key1"] = out["SBS"] + out["Fondo"] + out["AFP"]
        return out
    df_epu = _one(anio + mes + " EPU US.xlsx", '5460042E8427')
    df_etf = _one(anio + mes + " ETF Perú.xlsx", '5076822E0800')
    return df_epu, df_etf


def procesar_rama(base, soberanos):
    suf = "_S" if soberanos else ""
    etiqueta = "SOBERANOS" if soberanos else "NORMAL"
    print(f"\n================  RAMA {etiqueta}  ================")
    anio, mes, fecha_nueva = base.anio, base.mes, base.fecha_nueva
    valor = base.valor

    # ---- excel intermedio G&P (con/sin _S) ----------------------------------
    df_temporal = operaciones(base.df.copy(deep=True))
    # G&P intermedio: el original guarda el df BASE (con ISIN, pre-operaciones).
    # Nombres exactos: normal -> "{anio}{mes} G&P.xlsx"; soberanos -> "..._S.xlsx".
    try:
        base.df.to_excel(D_GYP_OUT + f'{anio}{mes} G&P{suf}.xlsx', index=False)
    except Exception as e:
        print(f"[AVISO] No se pudo escribir G&P{suf}.xlsx: {e}")

    df_BU = BU(df_temporal, soberanos)
    BUIN = X_AFP('INF1', 'INF2', 'INF3', df_BU, "Integra", "BU")
    BUHA = X_AFP('HAF1', 'HAF2', 'HAF3', df_BU, "Habitat", "BU")
    BUPF = X_AFP('PFF1', 'PFF2', 'PFF3', df_BU, "Profuturo", "BU")
    BURI = X_AFP('RIF1', 'RIF2', 'RIF3', df_BU, "Prima", "BU")
    BUSI = X_AFP('SIF1', 'SIF2', 'SIF3', df_BU, "Ex_Integra", "BU")

    df_TD = TD(df_temporal)
    TDIN = X_AFP('INF1', 'INF2', 'INF3', df_TD, "Integra", "TD")
    TDHA = X_AFP('HAF1', 'HAF2', 'HAF3', df_TD, "Habitat", "TD")
    TDPF = X_AFP('PFF1', 'PFF2', 'PFF3', df_TD, "Profuturo", "TD")
    TDRI = X_AFP('RIF1', 'RIF2', 'RIF3', df_TD, "Prima", "TD")
    TDSI = X_AFP('SIF1', 'SIF2', 'SIF3', df_TD, "Ex_Integra", "TD")

    if soberanos:
        df_SOB = SOB(df_temporal)
        SOBIN = X_AFP('INF1', 'INF2', 'INF3', df_SOB, "Integra", "SOB")
        SOBHA = X_AFP('HAF1', 'HAF2', 'HAF3', df_SOB, "Habitat", "SOB")
        SOBPF = X_AFP('PFF1', 'PFF2', 'PFF3', df_SOB, "Profuturo", "SOB")
        SOBRI = X_AFP('RIF1', 'RIF2', 'RIF3', df_SOB, "Prima", "SOB")
        SOBSI = X_AFP('SIF1', 'SIF2', 'SIF3', df_SOB, "Ex_Integra", "SOB")
        IN = BU_TD_AFP([BUIN, TDIN, SOBIN], base.auminf1, base.auminf2, base.auminf3)
        HA = BU_TD_AFP([BUHA, TDHA, SOBHA], base.aumhaf1, base.aumhaf2, base.aumhaf3)
        PF = BU_TD_AFP([BUPF, TDPF, SOBPF], base.aumpff1, base.aumpff2, base.aumpff3)
        RI = BU_TD_AFP([BURI, TDRI, SOBRI], base.aumrif1, base.aumrif2, base.aumrif3)
        SI = BU_TD_AFP([BUSI, TDSI, SOBSI], base.aumsif1, base.aumsif2, base.aumsif3)
    else:
        IN = BU_TD_AFP([BUIN, TDIN], base.auminf1, base.auminf2, base.auminf3)
        HA = BU_TD_AFP([BUHA, TDHA], base.aumhaf1, base.aumhaf2, base.aumhaf3)
        PF = BU_TD_AFP([BUPF, TDPF], base.aumpff1, base.aumpff2, base.aumpff3)
        RI = BU_TD_AFP([BURI, TDRI], base.aumrif1, base.aumrif2, base.aumrif3)
        SI = BU_TD_AFP([BUSI, TDSI], base.aumsif1, base.aumsif2, base.aumsif3)

    Portafolio = pd.concat([IN, HA, PF, RI, SI]).sort_index(ignore_index=True)
    IN_ = X_AFP_(IN, base.auminf1, base.auminf2, base.auminf3)
    HA_ = X_AFP_(HA, base.aumhaf1, base.aumhaf2, base.aumhaf3)
    PF_ = X_AFP_(PF, base.aumpff1, base.aumpff2, base.aumpff3)
    RI_ = X_AFP_(RI, base.aumrif1, base.aumrif2, base.aumrif3)
    SI_ = X_AFP_(SI, base.aumsif1, base.aumsif2, base.aumsif3)
    Multifondos = pd.concat([IN_, HA_, PF_, RI_, SI_]).sort_index(ignore_index=True)

    input1 = pd.concat([Portafolio, Multifondos]).sort_index(ignore_index=True)
    input1.insert(0, "Fecha", fecha_nueva)

    crear_txts(BUIN, TDIN, IN_, mes, anio)  # TXT Base Alerta (mismos nombres que original)

    # ---- Q por AFP (QEST) ----------------------------------------------------
    IN_PORT = Q_AFP_integra(Portafolio, base.dic_sbs)
    IN_M = QM_AFP_integra(IN_, base.dic_sbs)
    df_IN_PORT_M = pd.concat([IN_PORT, IN_M]).sort_index(ignore_index=True)
    df_IN_PORT_M_Integra = df_IN_PORT_M[df_IN_PORT_M["Afp"] == "Integra"]

    PORT_M_HA = Q_AFP(HA, HA_, 'HA-FONDO1', 'HA-FONDO2', 'HA-FONDO3', base.qest_rv, base.qest_rf, fecha_nueva, 'HA')
    PORT_M_PF = Q_AFP(PF, PF_, 'PF-FONDO1', 'PF-FONDO2', 'PF-FONDO3', base.qest_rv, base.qest_rf, fecha_nueva, 'PF')
    PORT_M_RI = Q_AFP(RI, RI_, 'RI-FONDO1', 'RI-FONDO2', 'RI-FONDO3', base.qest_rv, base.qest_rf, fecha_nueva, 'RI')

    PORT_M_TOTAL = pd.concat([df_IN_PORT_M_Integra, PORT_M_HA, PORT_M_PF, PORT_M_RI]).sort_index(ignore_index=True)

    PORT_M_EX_IN = pd.concat([PORT_M_HA, PORT_M_PF, PORT_M_RI]).sort_index(ignore_index=True)
    PORT_M_EX_IN = PORT_M_EX_IN.copy()
    PORT_M_EX_IN['Afp'] = PORT_M_EX_IN.apply(_renom_afp, axis=1)
    PORT_M_EX_IN['Key'] = (PORT_M_EX_IN['SBS'] + PORT_M_EX_IN['ISIN'] +
                           PORT_M_EX_IN['Fondo'] + PORT_M_EX_IN['Strategy'])
    dic_ex = PORT_M_EX_IN.get(['Key', 'Q'])
    dic_ex['Suma'] = dic_ex.groupby(["Key"])['Q'].transform('sum')
    dic_ex = dic_ex.set_index("Key").to_dict()
    EX_IN = input1.loc[input1['Afp'].isin(['Ex_Integra'])].sort_index(ignore_index=True)
    EX_IN['Key'] = EX_IN['SBS'] + EX_IN['ISIN'] + EX_IN['Fondo'] + EX_IN['Strategy']
    EX_IN['Q'] = EX_IN['Key'].map(dic_ex['Suma'])
    EX_IN = EX_IN.drop(['Key'], axis=1)

    PORT_M_TOTAL = pd.concat([PORT_M_TOTAL, EX_IN]).sort_index(ignore_index=True)
    PORT_M_TOTAL = PORT_M_TOTAL.drop(['Fecha'], axis=1)
    PORT_M_TOTAL['codEmisor'] = PORT_M_TOTAL['SBS'].apply(codEmisor)

    # ---- df_p_m + precios ----------------------------------------------------
    df_p_m = dic_emisor(PORT_M_TOTAL, valor, fecha_nueva, base.param_bu)
    df_p_m['Precio'] = df_p_m["SBS"].map(base.dic_precio['P'])
    fecha_time = datetime.strptime('01/' + mes + '/' + anio, '%d/%m/%Y')
    df_p_m['Fecha'] = fecha_time

    # ---- moneda + inversión (RIESGO cacheado) -------------------------------
    df_p_m = df_p_m.copy()
    cod_mon = df_p_m['SBS'].str.get(6)
    df_p_m['Tipo'] = cod_mon.map(base.dic_moneda['VALOR'])
    df_p_m['Inversión'] = df_p_m['Precio'] * df_p_m['Q'] * df_p_m['Tipo']

    # ---- escribir BD1 (deliverable) y re-leer (round-trip preservado) -------
    ruta_bd1 = D_INTERMEDIO + f'{anio}{mes} BD1{suf}.xlsx'
    try:
        df_p_m.to_excel(ruta_bd1, index=False)
    except Exception as e:
        raise ProcesoError(f"No se pudo escribir BD1{suf}.xlsx: {e}")

    # ---- EPU / ETF -----------------------------------------------------------
    plantilla_epu, plantilla_ETF = plantilla_epu_etf(anio, mes)
    df_epu_etf = pd.concat([plantilla_epu, plantilla_ETF])

    df_BD = _operaciones_df_p_m(_leer_bd1_local(ruta_bd1))

    # generar_relacion
    epu = df_epu_etf.copy(deep=True)
    dicBD = df_BD.copy(deep=True).set_index("key1").to_dict()
    for i in ['Weight', 'assetclass', 'Strategy', 'AUM', 'Tipo', 'Precio', 'Q',
              'Nombre', 'Fecha', 'codEmisor']:
        epu[i] = epu["key1"].map(dicBD[i])
    epu = epu.dropna(subset=['Weight'])
    epu['peso'] = epu["Market Value (%) (P)"] * epu['Weight']
    epu = epu.drop(['Market Value (%) (P)', 'key1', 'Weight'], axis=1)
    epu.rename(columns={'peso': 'Weight'}, inplace=True)

    # unir_port_epu
    dfp = _leer_bd1_local(ruta_bd1)
    dfp.insert(1, 'SBS2', dfp["SBS"].apply(recor))
    dfp = dfp.drop(dfp.loc[dfp['SBS2'].isin(["54", "50"])].index).drop(['SBS2'], axis=1)
    dfp["key1"] = dfp["ISIN"] + dfp["Fondo"] + dfp["Afp"] + dfp["assetclass"] + dfp["Strategy"]
    df_epu = epu.copy(deep=True)
    df_epu["key1"] = df_epu["ISIN"] + df_epu["Fondo"] + df_epu["AFP"] + df_epu["assetclass"] + df_epu["Strategy"]
    dic_epu = df_epu.set_index("key1").to_dict()
    dfp['Weight2'] = dfp["key1"].map(dic_epu["Weight"])
    dfp['Weight'] = dfp['Weight'].fillna(0)
    dfp['Weight2'] = dfp['Weight2'].fillna(0)
    dfp.insert(2, 'Weight_T', dfp['Weight'] + dfp['Weight2'])
    df_port_epu = dfp.drop(['Weight', 'Weight2'], axis=1)
    df_port_epu.rename(columns={'Weight_T': 'Weight', 'Afp': 'AFP'}, inplace=True)

    # unir_port_epu2 (solo EPU/ETF sin match)
    dfp2 = _leer_bd1_local(ruta_bd1)
    dfp2.insert(1, 'SBS2', dfp2["SBS"].apply(recor))
    dfp2 = dfp2.drop(dfp2.loc[dfp2['SBS2'].isin(["54", "50"])].index).drop(['SBS2'], axis=1)
    dfp2["key1"] = dfp2["ISIN"] + dfp2["Fondo"] + dfp2["Afp"] + dfp2["assetclass"] + dfp2["Strategy"]
    dic_df = dfp2.set_index("key1").to_dict()
    df_epu2 = epu.copy(deep=True)
    df_epu2["key1"] = df_epu2["ISIN"] + df_epu2["Fondo"] + df_epu2["AFP"] + df_epu2["assetclass"] + df_epu2["Strategy"]
    df_epu2["Eliminar"] = df_epu2["key1"].map(dic_df["SBS"])
    df_solo_epu = df_epu2[df_epu2['Eliminar'].isin([np.nan])].drop(['Eliminar'], axis=1)

    df_total = pd.concat([df_port_epu, df_solo_epu])

    # ---- nombres (Parametría + VP) ------------------------------------------
    pb = base.param_bu.copy(deep=True)
    pb.columns = pb.iloc[0, ::]
    pb = pb.drop([0], axis=0).set_index("ISIN")
    dic_par = pb.to_dict()
    dic_p1 = df_total.copy(deep=True)
    cond = dic_p1['Strategy'] == 'BU'
    dic_p1.loc[cond, 'Nombre'] = dic_p1[cond]['ISIN'].map(dic_par['Nombre'])
    dic_p1['Empresa'] = dic_p1['Nombre']

    vp = leer_xlsx(R_VP, 'CalcP')
    dv = vp.iloc[4:, [3, 4]].copy()
    dv.columns = dv.iloc[0, ::]
    dv = dv.drop([4], axis=0).set_index("ISIN")
    dic_vp = dv.to_dict()

    def _reemplazar_nombre(row):
        if str(row['Strategy']) == 'BU':
            try:
                return dic_vp['ID'][row["ISIN"]]
            except Exception:
                return row['Empresa']
        return row['Empresa']

    dic_p1['Empresa'] = dic_p1.apply(_reemplazar_nombre, axis=1)
    column_order = ['SBS', 'ISIN', 'Weight', 'Fondo', 'assetclass', 'Strategy', 'AFP',
                    'AUM', 'Tipo', 'Precio', 'Q', 'Inversión', 'Nombre', 'Empresa',
                    'Fecha', 'codEmisor', 'key1']
    dic_p1 = dic_p1[column_order]

    ruta_port = D_INTERMEDIO + f'{anio}{mes} Portafolio{suf}.xlsx'
    dic_p1.to_excel(ruta_port, index=False)
    print(f"[OK] Portafolio{suf} -> {ruta_port}")

    # ---- nuevos instrumentos (Para.xlsx / Para_S.xlsx) ----------------------
    try:
        _par_bu(base.param_bu, ruta_port, suf)
    except Exception as e:
        print(f"[AVISO] par_bu{suf} falló (no crítico): {e}")

    print(f"[OK] BD1{suf} -> {ruta_bd1}")
    return {'BD1': ruta_bd1, 'Portafolio': ruta_port}


def _par_bu(param_bu, ruta_port, suf):
    df = param_bu.copy(deep=True)
    df.columns = df.iloc[0, ::]
    df = df.drop([0], axis=0)
    df = df.drop(df.loc[df['ISIN'].isin([None])].index)

    df2 = df.copy(); df2['validador'] = "Existe"; df2 = df2.set_index("ISIN")
    dic = df2.to_dict()

    dpbu = _leer_bd1_local  # reutilizamos lector; el Portafolio tiene hoja 'Sheet1'
    df_pbu = leer_xlsx(ruta_port, 'Sheet1')
    df_pbu.columns = df_pbu.iloc[0, ::]
    df_pbu = df_pbu.drop([0], axis=0)
    df_pbu = df_pbu.loc[df_pbu['Strategy'].isin(['BU'])]
    df_pbu["validador"] = df_pbu["ISIN"].map(dic['validador'])
    df_pbu = df_pbu.loc[df_pbu["validador"].isin([np.nan])]
    df_pbu = df_pbu.get(['ISIN', 'SBS', 'codEmisor', 'Nombre'])
    df_pbu.columns = ['ISIN', 'SBS', 'Cod.Emisor', 'Nombre']

    df3 = param_bu.copy(deep=True)
    df3.columns = df3.iloc[0, ::]
    df3 = df3.drop([0], axis=0)
    df3 = df3.drop(df3.loc[df3['Cod.Emisor'].isin([None])].index).set_index('Cod.Emisor')
    dic3 = df3.to_dict()
    df_pbu.insert(4, 'Moneda', df_pbu['Cod.Emisor'].map(dic3['moneda']))
    df_pbu.insert(5, 'Sector', df_pbu['Cod.Emisor'].map(dic3['Sector']))
    df_pbu.insert(6, 'Pais', df_pbu['Cod.Emisor'].map(dic3['País']))
    df_pbu.insert(7, 'Region', df_pbu['Cod.Emisor'].map(dic3['Region']))
    df_pbu.insert(8, 'Mercado', df_pbu['Cod.Emisor'].map(dic3['mercado']))

    df_Total = pd.concat([df, df_pbu])
    # DECISIÓN: el original escribía 'Para.xlsx' en ambos scripts (se pisaban al correr
    # secuencialmente). Aquí soberanos usa 'Para_S.xlsx' para no destruir el normal en
    # una sola corrida. Si se requiere el nombre único original, quitar {suf}.
    df_Total.to_excel(R_PARA_OUT.format(suf=suf), index=False)


