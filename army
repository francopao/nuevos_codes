def operaciones(df):
    for a, b in zip(['HAF1', 'RIF1', 'PFF1', 'SIF1', 'HAF2', 'RIF2', 'PFF2', 'SIF2',
                     'HAF3', 'RIF3', 'PFF3', 'SIF3'],
                    ["INF1", "INF1", "INF1", "INF1", "INF2", "INF2", "INF2", "INF2",
                     "INF3", "INF3", "INF3", "INF3"]):
        df[a] = df[b] - df[a + "GAP"]
    df = df.loc[df['Asset Class'].isin(['Renta Fija', 'Renta Variable'])]
    return df


