def _clip(x, lo=0.0, hi=1.0):
    return max(lo, min(hi, x))


def cargar_score_riesgo(ruta_riesgos: str, empresa: str) -> dict:
    """Lee la hoja 'Score por Empresa' y devuelve los scores agregados."""
    wb = openpyxl.load_workbook(ruta_riesgos, data_only=True)
    ws = wb["Score por Empresa"]
    headers = [ws.cell(4, c).value for c in range(1, ws.max_column + 1)]
    idx = {h: i + 1 for i, h in enumerate(headers) if h}

    for r in range(5, ws.max_row + 1):
        if ws.cell(r, idx["Empresa"]).value == empresa:
            return {
                "empresa": empresa,
                "sector": ws.cell(r, idx["Sector"]).value,
                "aum_total_pen": ws.cell(r, idx["AUM Total (S/)"]).value,
                "score_mm": ws.cell(r, idx["Score MM"]).value,
                "score_inund": ws.cell(r, idx["Score Inund."]).value,
                "score_sequia": ws.cell(r, idx["Score Sequía"]).value,
                "score_global": ws.cell(r, idx["Score Global"]).value,
                "mitigante": ws.cell(r, idx["Mitigante (2S26)"]).value,
            }
    raise ValueError(f"Empresa '{empresa}' no encontrada en 'Score por Empresa'.")


def cargar_activos_empresa(ruta_riesgos: str, empresa: str) -> list:
    """Lee la hoja 'Activos por Empresa' filtrada a la empresa dada."""
    wb = openpyxl.load_workbook(ruta_riesgos, data_only=True)
    ws = wb["Activos por Empresa"]
    headers = [ws.cell(1, c).value for c in range(1, ws.max_column + 1)]
    idx = {h: i + 1 for i, h in enumerate(headers) if h}

    activos = []
    for r in range(2, ws.max_row + 1):
        if ws.cell(r, idx["Empresa"]).value == empresa:
            activos.append({
                "activo": ws.cell(r, idx["Activo Físico"]).value,
                "departamento": ws.cell(r, idx["Departamento"]).value,
                "score_mm": ws.cell(r, idx["Score MM"]).value,
                "score_inund": ws.cell(r, idx["Score Inund."]).value,
                "score_sequia": ws.cell(r, idx["Score Sequía"]).value,
                "monto_pen": ws.cell(r, idx["Plata del Activo (S/)"]).value,
            })
    return activos


def concentracion_geografica(activos: list) -> float:
    """
    % del AUM mapeado de la empresa concentrado en un solo departamento.
    Se usa directamente como sub-score de vulnerabilidad (ya en [0,1]).
    """
    if not activos:
        return None
    por_depto = {}
    total = 0.0
    for a in activos:
        monto = a["monto_pen"] or 0.0
        por_depto[a["departamento"]] = por_depto.get(a["departamento"], 0.0) + monto
        total += monto
    if total == 0:
        return None
    return max(por_depto.values()) / total


def _buscar_fila(ws, columna_etiqueta: int, etiqueta: str, fila_inicio=1, fila_fin=None):
    fila_fin = fila_fin or ws.max_row
    for r in range(fila_inicio, fila_fin + 1):
        if ws.cell(r, columna_etiqueta).value == etiqueta:
            return r
    return None


def cargar_financieros(ruta_valorizacion: str, anio_base: int = 2025) -> dict:
    """
    Lee la hoja 'Ratios_Engie' (ratios ya calculados) y la hoja 'DCF' para
    obtener las variables financieras necesarias para el vulnerability score
    y para el ajuste de estados financieros.
    """
    wb = openpyxl.load_workbook(ruta_valorizacion, data_only=True)
    ws = wb["Ratios_Engie"]

    headers = [ws.cell(2, c).value for c in range(1, ws.max_column + 1)]
    col_anio = None
    for c, h in enumerate(headers, start=1):
        if h == anio_base:
            col_anio = c
            break
    if col_anio is None:
        raise ValueError(f"No se encontró la columna del año {anio_base} en 'Ratios_Engie'.")

    def valor(etiqueta):
        fila = _buscar_fila(ws, 1, etiqueta)
        if fila is None:
            return None
        return ws.cell(fila, col_anio).value

    financieros = {
        "anio_base": anio_base,
        "revenue_usd": valor("Revenue"),
        "ebitda_usd": valor("EBITDA"),
        "ebitda_margin": valor("EBITDA Margin (%)"),
        "net_debt_ebitda_x": valor("Net debt / EBITDA (x)"),
        "current_ratio_x": valor("Current ratio (x)"),
        "net_ppe_usd": valor("Net PPE"),
        "total_assets_usd": valor("Total assets"),
        "net_debt_usd": None,  # se completa abajo desde DCF si aplica
    }

    ws_dcf = wb["DCF"]
    financieros["wacc"] = ws_dcf.cell(2, 5).value
    financieros["g_terminal"] = ws_dcf.cell(3, 5).value
    financieros["coe"] = ws_dcf.cell(4, 5).value

    # fila de años del DCF (fila 6) y datos anuales de FCL, capex, etc. (filas 7-14)
    fila_anios = 6
    anios_dcf = {}
    for c in range(1, ws_dcf.max_column + 1):
        v = ws_dcf.cell(fila_anios, c).value
        if isinstance(v, (int, float)) and v and v > 2000:
            anios_dcf[int(v)] = c

    etiquetas_dcf = {
        "revenue": "Ingresos Totales",
        "ebit": "Resultado Operativo*",
        "depreciacion": "(+) Depreciación",
        "ebitda": "EBITDA*",
        "impuestos": "(-) Impuestos",
        "delta_wc": "(-) ∆ Capital de Trabajo",
        "capex": "(-) Capex",
        "fcl": "Flujo de Caja Libre (FCL)",
    }
    filas_dcf = {}
    for clave, etiqueta in etiquetas_dcf.items():
        for r in range(1, ws_dcf.max_row + 1):
            if ws_dcf.cell(r, 2).value == etiqueta:
                filas_dcf[clave] = r
                break

    proyeccion = {}
    for anio, c in sorted(anios_dcf.items()):
        proyeccion[anio] = {clave: ws_dcf.cell(fila, c).value for clave, fila in filas_dcf.items()}

    # Las celdas de resultado (Valor de la Firma, Deuda Neta, Patrimonio, etc.)
    # están en la columna E (índice 5), igual que WACC/G/CoE más arriba.
    financieros["dcf_proyeccion"] = proyeccion
    financieros["valor_firma"] = ws_dcf.cell(19, 5).value
    financieros["deuda_neta_dcf"] = ws_dcf.cell(20, 5).value
    financieros["patrimonio_dcf"] = ws_dcf.cell(21, 5).value
    financieros["n_acciones_mn"] = ws_dcf.cell(24, 5).value
    financieros["valor_fundamental_x_accion"] = ws_dcf.cell(25, 5).value
    financieros["ultimo_precio"] = ws_dcf.cell(26, 5).value

    return financieros


def cargar_produccion(ruta_valorizacion: str) -> dict:
    """Lee la hoja 'Production' y devuelve generación Hidro/Termo anual."""
    wb = openpyxl.load_workbook(ruta_valorizacion, data_only=True)
    ws = wb["Production"]
    headers = [ws.cell(2, c).value for c in range(1, ws.max_column + 1)]

    filas = {}
    for r in range(1, 12):
        etiqueta = ws.cell(r, 2).value
        if etiqueta in ("Hidro", "Termo", "Total generación"):
            filas[etiqueta] = r

    resultado = {}
    for etiqueta, fila in filas.items():
        serie_anual = {}
        for c, h in enumerate(headers, start=1):
            if isinstance(h, int) and h > 2000:
                v = ws.cell(fila, c).value
                if v is not None:
                    serie_anual[h] = v
        resultado[etiqueta] = serie_anual

    return resultado


def cargar_caudal_rio_anual(ruta_bd_sectorial: str, rio: str) -> dict:
    """Lee 'BD_Utilities.xlsm' -> hoja '4. Caudales y Volumen', promedio anual (m3/s)."""
    wb = openpyxl.load_workbook(ruta_bd_sectorial, data_only=True, keep_vba=True)
    ws = wb["4. Caudales y Volumen"]

    fila_rio = None
    for r in range(8, ws.max_row + 1):
        if ws.cell(r, 6).value == rio:
            fila_rio = r
            break
    if fila_rio is None:
        raise ValueError(f"Río '{rio}' no encontrado en la hoja de caudales.")

    por_anio = {}
    for c in range(8, ws.max_column + 1):
        anio = ws.cell(6, c).value
        caudal = ws.cell(fila_rio, c).value
        if isinstance(anio, (int, float)) and isinstance(caudal, (int, float)):
            por_anio.setdefault(int(anio), []).append(caudal)

    return {anio: statistics.mean(vals) for anio, vals in sorted(por_anio.items())}


