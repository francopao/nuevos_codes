def _titulo_hoja(ws, texto, col_span=6):
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=col_span)
    celda = ws.cell(1, 1, texto)
    celda.font = _TITULO_FONT
    celda.fill = _TITULO_FILL
    celda.alignment = Alignment(vertical="center")
    ws.row_dimensions[1].height = 24


def _encabezados(ws, fila, etiquetas):
    for c, etiqueta in enumerate(etiquetas, start=1):
        celda = ws.cell(fila, c, etiqueta)
        celda.font = _HEADER_FONT
        celda.fill = _HEADER_FILL


def _autoancho(ws, min_ancho=12, max_ancho=55):
    for col_cells in ws.columns:
        longitud = max((len(str(c.value)) for c in col_cells if c.value is not None), default=0)
        letra = get_column_letter(col_cells[0].column)
        ws.column_dimensions[letra].width = min(max(longitud + 2, min_ancho), max_ancho)


