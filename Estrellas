def _archivo_valido(nombre_archivo: str) -> bool:
    return not nombre_archivo.startswith("~$")


def buscar_archivos_recursivo(carpeta_raiz: str, patron_regex: str,
                               extensiones=(".xlsx", ".xlsm")) -> list:
    if not os.path.isdir(carpeta_raiz):
        raise FileNotFoundError(
            f"La carpeta raíz no existe o no es accesible: {carpeta_raiz}\n"
            f"Verifica que la unidad de red (Z:) esté conectada."
        )
    regex = re.compile(patron_regex, re.IGNORECASE)
    encontrados = []
    for dirpath, _subdirs, filenames in os.walk(carpeta_raiz):
        for filename in filenames:
            if not _archivo_valido(filename):
                continue
            nombre_sin_ext, ext = os.path.splitext(filename)
            if ext.lower() not in extensiones:
                continue
            if regex.search(nombre_sin_ext):
                ruta_completa = os.path.join(dirpath, filename)
                try:
                    modificado = datetime.fromtimestamp(os.path.getmtime(ruta_completa))
                except OSError:
                    modificado = None
                encontrados.append({"ruta": ruta_completa, "nombre": filename, "modificado": modificado})
    return encontrados


def _reportar_resultado(descripcion: str, resultados: list) -> None:
    if not resultados:
        print(f"[NO ENCONTRADO] {descripcion}: no se halló ningún archivo que coincida.")
        return
    if len(resultados) == 1:
        print(f"[OK] {descripcion}: 1 archivo encontrado.")
        print(f"     -> {resultados[0]['ruta']}")
        return
    print(f"[MÚLTIPLES COINCIDENCIAS] {descripcion}: se hallaron {len(resultados)} archivos.")
    for i, r in enumerate(resultados, start=1):
        fecha = r["modificado"].strftime("%Y-%m-%d %H:%M") if r["modificado"] else "s/f"
        print(f"     [{i}] {r['ruta']}  (modificado: {fecha})")


def encontrar_modelo_valorizacion(nombre_archivo_exacto: str, carpeta_raiz: str = RUTA_VALORIZACIONES,
                                   preferir_mas_reciente_si_multiple: bool = True) -> dict:
    nombre_base = os.path.splitext(nombre_archivo_exacto)[0]
    patron = rf"^{re.escape(nombre_base)}$"
    candidatos = buscar_archivos_recursivo(carpeta_raiz, patron_regex=patron, extensiones=(".xlsx", ".xlsm"))
    _reportar_resultado(f"Modelo de valorización '{nombre_base}'", candidatos)
    if not candidatos:
        return {"encontrado": False, "ruta": None, "candidatos": []}
    if len(candidatos) == 1:
        return {"encontrado": True, "ruta": candidatos[0]["ruta"], "candidatos": candidatos}
    candidatos_ordenados = sorted(candidatos, key=lambda r: r["modificado"] or datetime.min, reverse=True)
    seleccionado = candidatos_ordenados[0] if preferir_mas_reciente_si_multiple else None
    if seleccionado:
        print(f"     -> Por defecto se selecciona la más reciente: {seleccionado['ruta']}")
    return {"encontrado": True, "ruta": seleccionado["ruta"] if seleccionado else None,
            "candidatos": candidatos_ordenados}


_PATRON_PERIODO = re.compile(r"riesgos\s*clim[aá]ticos\s*-\s*([12])S(\d{2})", re.IGNORECASE)


def _extraer_periodo(nombre_archivo: str):
    m = _PATRON_PERIODO.search(nombre_archivo.replace("_", " "))
    if not m:
        return None
    return (2000 + int(m.group(2)), int(m.group(1)))


def listar_archivos_riesgos_climaticos(carpeta_raiz: str = RUTA_RIESGOS_CLIMATICOS) -> list:
    candidatos = buscar_archivos_recursivo(carpeta_raiz, patron_regex=r"riesgos\s*clim[aá]ticos",
                                            extensiones=(".xlsx", ".xlsm"))
    con_periodo = []
    for c in candidatos:
        periodo = _extraer_periodo(c["nombre"])
        if periodo is None:
            continue
        c = dict(c)
        c["anio"], c["semestre"] = periodo
        con_periodo.append(c)
    con_periodo.sort(key=lambda r: (r["anio"], r["semestre"]), reverse=True)
    return con_periodo


def encontrar_archivo_riesgos_climaticos(periodo: str = None, carpeta_raiz: str = RUTA_RIESGOS_CLIMATICOS) -> dict:
    disponibles = listar_archivos_riesgos_climaticos(carpeta_raiz)
    if not disponibles:
        print(f"[NO ENCONTRADO] Ningún archivo 'Riesgos Climáticos - XSYY' en:\n     {carpeta_raiz}")
        return {"encontrado": False, "ruta": None, "periodo": None, "todos_los_periodos": []}
    etiquetas = [f"{d['semestre']}S{str(d['anio'])[-2:]}" for d in disponibles]
    if periodo is None:
        seleccionado = disponibles[0]
        etiqueta = etiquetas[0]
        print(f"[OK] Riesgos Climáticos: se usa el período más reciente disponible -> {etiqueta}")
        print(f"     -> {seleccionado['ruta']}")
        if len(disponibles) > 1:
            print(f"     Períodos disponibles: {', '.join(etiquetas)}")
        return {"encontrado": True, "ruta": seleccionado["ruta"], "periodo": etiqueta, "todos_los_periodos": etiquetas}
    periodo_norm = periodo.strip().upper()
    m = re.match(r"^([12])S(\d{2})$", periodo_norm)
    if not m:
        raise ValueError(f"Formato de período inválido: '{periodo}'. Usa 'XSYY', ej. '1S26'.")
    sem_buscado, anio_buscado = int(m.group(1)), 2000 + int(m.group(2))
    for d, etiqueta in zip(disponibles, etiquetas):
        if d["anio"] == anio_buscado and d["semestre"] == sem_buscado:
            print(f"[OK] Riesgos Climáticos: período solicitado '{periodo_norm}' encontrado.")
            print(f"     -> {d['ruta']}")
            return {"encontrado": True, "ruta": d["ruta"], "periodo": etiqueta, "todos_los_periodos": etiquetas}
    print(f"[NO ENCONTRADO] El período solicitado '{periodo_norm}' no existe entre los disponibles.")
    print(f"     Períodos disponibles: {', '.join(etiquetas)}")
    return {"encontrado": False, "ruta": None, "periodo": None, "todos_los_periodos": etiquetas}


def encontrar_bd_sectorial(sector: str, carpeta_raiz: str = RUTA_INPUTS_MACRO) -> dict:
    alias = SECTOR_BD_ALIAS.get(sector, [sector.lower()])
    candidatos_bd = buscar_archivos_recursivo(carpeta_raiz, patron_regex=r"^BD\s", extensiones=(".xlsx", ".xlsm"))
    coincidencias = [c for c in candidatos_bd if any(a in c["nombre"].lower() for a in alias)]
    _reportar_resultado(f"Base sectorial para sector '{sector}'", coincidencias)
    if not coincidencias:
        disponibles = [c["nombre"] for c in candidatos_bd] if candidatos_bd else "ninguno"
        print(f"     Archivos 'BD *' disponibles en la carpeta: {disponibles}")
        return {"encontrado": False, "ruta": None, "candidatos": []}
    return {"encontrado": True, "ruta": coincidencias[0]["ruta"], "candidatos": coincidencias}


