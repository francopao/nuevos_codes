    ]
    r = 3
    for titulo, texto in supuestos:
        ws.cell(r, 1, titulo).font = Font(name=_FUENTE, bold=True, size=10)
        ws.cell(r, 1).alignment = Alignment(vertical="top", wrap_text=True)
        celda_texto = ws.cell(r, 2, texto)
        celda_texto.font = _BASE_FONT
        celda_texto.alignment = Alignment(vertical="top", wrap_text=True)
        ws.row_dimensions[r].height = 60
        r += 1
    ws.column_dimensions["A"].width = 28
    ws.column_dimensions["B"].width = 90

    wb.save(ruta_salida)
    print(f"\nExcel guardado en: {ruta_salida}")


def main():
    recursos = resolver_recursos_empresa(NOMBRE_ARCHIVO_VALORIZACION, SECTOR, PERIODO_RIESGOS)

    if not all(recursos[k]["encontrado"] for k in ("modelo_valorizacion", "riesgos_climaticos", "bd_sectorial")):
        print("\nNo se pudo continuar: faltan uno o más archivos de insumo. Revisa los mensajes arriba.")
        return

    ruta_valorizacion = recursos["modelo_valorizacion"]["ruta"]
    ruta_riesgos = recursos["riesgos_climaticos"]["ruta"]
    ruta_bd_sectorial = recursos["bd_sectorial"]["ruta"]

    print(f"\nCorriendo framework para {EMPRESA} ({SECTOR})...\n")
    resultado = correr_framework_empresa(
        ruta_valorizacion, ruta_riesgos, ruta_bd_sectorial, EMPRESA, SECTOR, RIO_PROXY_HIDRO
    )

    print("\n=== RESUMEN ===")
    print("Scores:", resultado["scores"])
    print("Concentración geográfica:", resultado["geo_concentracion"])
    print("Vulnerability score:", resultado["vulnerability"]["vulnerability_score"])
    print("Detalle vulnerability:", resultado["vulnerability"]["detalle"])
    print("\nEscenario base -> ajuste EBITDA:", resultado["resultados_escenarios"]["base"]["ajuste_fin"])
    print("Escenario base -> ajuste DCF:", resultado["resultados_escenarios"]["base"]["ajuste_dcf"])
    print("\nSensibilidad alpha:", resultado["sensibilidad_alpha"])
    print("\nMonte Carlo:", resultado["monte_carlo"])
    print("\nCross-check:", resultado["cross_check"])

    escribir_excel_resultados(resultado, RUTA_SALIDA_EXCEL)


if __name__ == "__main__":
    main()
