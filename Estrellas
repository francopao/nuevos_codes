    vf_base_sin_ajuste = base["ajuste_dcf"]["valor_fundamental_base"]
    for nombre_escenario in ["conservador", "base", "severo"]:
        ad = resultado["resultados_escenarios"][nombre_escenario]["ajuste_dcf"]
        ws.cell(r, 1, nombre_escenario)
        ws.cell(r, 2, ad["valor_firma_ajustado"]).number_format = "#,##0.0"
        ws.cell(r, 3, ad["valor_fundamental_ajustado"]).number_format = "$#,##0.00"
        delta = (ad["valor_fundamental_ajustado"] / vf_base_sin_ajuste - 1) if vf_base_sin_ajuste else None
        ws.cell(r, 4, delta).number_format = "0.00%"
        r += 1
    ws.cell(r + 1, 1, f"Referencia - Valor Fundamental SIN ajuste climático: ${vf_base_sin_ajuste:,.2f}").font = _NOTA_FONT
    ws.cell(r + 2, 1, f"Referencia - Último precio de mercado: ${base['ajuste_dcf']['valor_fundamental_base']:,.2f} "
                       f"(tomar de fuente de mercado; el DCF no lo actualiza).").font = _NOTA_FONT
    _autoancho(ws)

    # ---------------- Hoja 6: Sensibilidad Alpha ----------------
    ws = wb.create_sheet("Sensibilidad Alpha")
    _titulo_hoja(ws, "Sensibilidad del Resultado al Parámetro de Convexidad (α)", col_span=4)
    _encabezados(ws, 3, ["Alpha", "Δ Revenue %", "Δ EBITDA %", "Valor Fundamental ajustado"])
    r = 4
    for fila in resultado["sensibilidad_alpha"]:
        ws.cell(r, 1, fila["alpha"]).number_format = "0.00"
        ws.cell(r, 2, fila["delta_revenue_pct"]).number_format = "0.00%"
        ws.cell(r, 3, fila["delta_ebitda_pct"]).number_format = "0.00%"
        ws.cell(r, 4, fila["valor_fundamental_ajustado"]).number_format = "$#,##0.00"
        r += 1
    ws.cell(r + 1, 1, "Lectura: si el ranking/orden de magnitud se mantiene estable a través de "
                       "los distintos alpha, el resultado es robusto a este supuesto.").font = _NOTA_FONT
    _autoancho(ws)

    # ---------------- Hoja 7: Monte Carlo ----------------
    ws = wb.create_sheet("Monte Carlo")
    _titulo_hoja(ws, f"Monte Carlo - {resultado['monte_carlo']['n_simulaciones']:,} simulaciones", col_span=3)
    _encabezados(ws, 3, ["Percentil", "Δ EBITDA %", "Valor Fundamental ajustado"])
    r = 4
    for p in ["p10", "p25", "p50", "p75", "p90"]:
        ws.cell(r, 1, p)
        ws.cell(r, 2, resultado["monte_carlo"]["delta_ebitda_pct"][p]).number_format = "0.00%"
        ws.cell(r, 3, resultado["monte_carlo"]["valor_fundamental_ajustado"][p]).number_format = "$#,##0.00"
        r += 1
    ws.cell(r + 1, 1, "Simula alpha ~ U(1.0,2.0), elasticidades ~ Triangular(min,moda,max) y "
                       "ruido ±10% en cada variable de vulnerabilidad.").font = _NOTA_FONT
    _autoancho(ws)

    # ---------------- Hoja 8: Cross-check Hidro vs Caudal ----------------
    ws = wb.create_sheet("Cross-check Hidro-Caudal")
    _titulo_hoja(ws, "Cross-check Empírico: Generación Hidro vs. Caudal Río Santa (proxy)", col_span=4)
    _encabezados(ws, 3, ["Año", "Generación Hidro (GWh)", "Caudal promedio Río Santa (m3/s)", "Nota"])
    r = 4
    for fila in resultado["cross_check"]:
        ws.cell(r, 1, fila["anio"])
        ws.cell(r, 2, fila["hidro_gwh"]).number_format = "#,##0"
        ws.cell(r, 3, fila["caudal_promedio_m3s"]).number_format = "#,##0.0"
        ws.cell(r, 4, fila["nota"])
        r += 1
    ws.cell(r + 1, 1, "No es una regresión formal (n insuficiente para inferencia estadística "
                       "robusta). Es evidencia de ingeniería/observación directa: se espera que "
                       "años de mayor caudal muestren mayor generación hidro. 2020 está marcado "
                       "como atípico por el shock de demanda del COVID-19.").font = _NOTA_FONT
    _autoancho(ws)

    # ---------------- Hoja 9: Supuestos y Limitaciones ----------------
    ws = wb.create_sheet("Supuestos y Limitaciones")
    _titulo_hoja(ws, "Supuestos, Calibraciones y Limitaciones de esta Corrida", col_span=2)
    supuestos = [
        ("Convexidad φ(S)", "α = 1.5. Si score ≤ 1, φ = 0 (piso de la escala)."),
        ("Sequía - Engie", "Score = 0.22 (por debajo del piso de escala) porque solo 1 de 9 "
                            "activos mapeados tiene score de sequía válido (C.H. Yuncán, "
                            "peso 7.4% del AUM mapeado). Los otros 8 activos son N/D en sequía. "
                            "Además, Quitaracsa (la hidro más grande de Engie) NO aparece en el "
                            "archivo de activos mapeados de Riesgos Climáticos: el score de "
                            "sequía de Engie NO refleja su exposición hídrica real."),
        ("Movimiento de Masa - Utilities", "Elasticidad de revenue [-10%,-6%,-2%] es una "
                            "calibración NUEVA propuesta por analogía con Infraestructura-MM. "
                            "No existía en la versión original del framework. Requiere escrutinio "
                            "adicional del comité."),
        ("Backtesting 2017 (El Niño Costero)", "Se descartó como test del pathway de Sequía: "
                            "el caudal del Río Santa fue 43% MÁS ALTO en 2017 que en 2016, y la "
                            "generación hidro de Engie subió 15.6% mientras sus compras de "
                            "energía en spot colapsaron. 2017 fue un año de abundancia hídrica, "
                            "no de sequía."),
        ("Backtesting 2020", "Año más seco disponible en la ventana 2016-2024, pero confundido "
                            "por el shock de demanda del COVID-19. No se usa como test aislado; "
                            "se reporta como referencia en la hoja de cross-check."),
        ("Cobertura de seguros", "Excluida del Vulnerability Score por falta de dato público. "
                            "Pesos redistribuidos proporcionalmente entre las 7 variables restantes."),
        ("Activos N/D (sin score)", "Tratados como dato faltante: se excluyen del cálculo "
                            "correspondiente, nunca se imputa un valor."),
        ("Concentración geográfica", "Calculada solo sobre el AUM mapeado en el archivo de "
                            "Riesgos Climáticos (S/ 220.3mm para Engie), que es una fracción del "
                            "balance total de la empresa, no su exposición total."),
        ("Año financiero base", f"{resultado['financieros']['anio_base']} (último año fiscal "
                            "completo disponible en el modelo de valorización)."),
        ("Ajuste de DCF", "Se ajustan los flujos (FCL) proporcionalmente al Δ EBITDA%, "
                            "manteniendo WACC y g sin cambio (método preferido del framework: "
                            "ajuste de flujos, no de tasa de descuento)."),
        ("Agregación entre hazards", "Se suman sin haircut (se tratan como independientes entre "
                            "sí). El haircut de 10-20% documentado en el framework aplica solo "
