def _zp_ciq_vigente(ciq: pd.DataFrame, col: str, idx_full: pd.Index) -> pd.Series:
    """
    Dato CIQ trimestral expandido a diario IGUAL que multiplos(): lookup por Period Q + ffill
    (cada día recibe el valor del trimestre que lo contiene). Se calcula sobre el índice
    completo para que el ffill sea idéntico al del script y luego se recorta.
    """
    s = ciq[col].copy()
    s.index = pd.DatetimeIndex(s.index).to_period("Q")
    vals = s.reindex(pd.DatetimeIndex(idx_full).to_period("Q")).ffill().values
    return pd.Series(vals, index=idx_full, name=col)


def _zp_calcular(t: str, es_fin: bool, basket_def: list, mbk: dict,
                 matriz_multiplos: dict, datos_bbg: dict,
                 act_mults: list, ventanas: list, dpa: int, n_diag: int) -> dict:
    """
    Calcula, para UNA empresa del portafolio, todo lo que alimenta las hojas del Excel.

    Retorna dict con:
      fechas      : DatetimeIndex de las últimas filas (largo ≤ ventana máx + n_diag − 1)
      mu, bk, ratio : múltiplos de la empresa, del basket y su cociente (solo act_mults)
      zA, zB      : {(múltiplo, ventana_idx): Serie de Z puro} para marco absoluto y vs basket
      w_m         : {múltiplo: peso del múltiplo según sector}
      comps, pesos, mult_comps, cob : composición del basket y cobertura por múltiplo

    Supuestos: Z puro = Z() del script (ventana completa o NaN, desv. muestral n−1).
    Se calcula solo sobre la cola de la serie (el Z de un día depende solo de su ventana),
    por eso es muy barato. ratio = mult_empresa / mult_basket, igual que main().
    """
    max_w = max(int(round(a * dpa)) for a, _ in ventanas)
    L = max_w + n_diag - 1
    idx_full = matriz_multiplos[t].index
    fechas = idx_full[-L:] if len(idx_full) > L else idx_full

    mu = matriz_multiplos[t].reindex(fechas)[act_mults]
    bk = mbk[t].reindex(fechas)[act_mults]
    ratio = mu.div(bk)                                     # igual que main(): puede traer inf
    zA, zB = {}, {}
    for k, (a, _) in enumerate(ventanas):
        za = Z(mu.copy(), a, dpa)
        zb = Z(ratio.copy(), a, dpa)
        for m in act_mults:
            zA[(m, k)], zB[(m, k)] = za[m], zb[m]

    pm = PESOS_FINAN if es_fin else PESOS_EX_FINAN
    w_m = {m: pm[_XL_ORDEN.index(m)] for m in act_mults}

    # Composición del basket (pesos por Market Cap, igual que Creacion_DF_Basket)
    comps = [c for c in basket_def if c in matriz_multiplos]
    mc_cols = [c for c in comps if c in datos_bbg and "CUR_MKT_CAP" in datos_bbg[c].columns]
    if mc_cols:
        mc = pd.DataFrame({c: datos_bbg[c]["CUR_MKT_CAP"].reindex(fechas) for c in mc_cols})
        pesos = mc.div(mc.sum(axis=1), axis=0)
    else:
        pesos = pd.DataFrame(index=fechas)
    mult_comps = {m: pd.DataFrame({c: matriz_multiplos[c][m].reindex(fechas) for c in mc_cols})
                  for m in act_mults}
    cob = pd.DataFrame({m: (pesos * mult_comps[m].notna()).sum(axis=1) if mc_cols else 0.0
                        for m in act_mults}, index=fechas)   # peso del basket que SÍ tiene el múltiplo
    return {"fechas": fechas, "mu": mu, "bk": bk, "ratio": ratio, "zA": zA, "zB": zB, "w_m": w_m,
            "mc_cols": mc_cols, "pesos": pesos, "mult_comps": mult_comps, "cob": cob}


def _zp_alertas(d: dict, marco: str, i: int, ventanas: list, act_mults: list, umbral: float) -> tuple:
    """
    Calidad del dato en la posición i (fila) para un marco ('A' absoluto o 'B' vs basket).
    Retorna (ventanas_válidas, ventanas_aplicables, texto_alertas, cobertura_mín).
    Una celda 'aplicable' es un (múltiplo, ventana) con peso de múltiplo ≠ 0 para ese sector.
    """
    z = d["zA"] if marco == "A" else d["zB"]
    ap = [(m, k) for m in act_mults if d["w_m"][m] != 0 for k in range(len(ventanas))]
    muertas = [f"{_ZP_ETQ[m]}·{ventanas[k][0]}A" for (m, k) in ap if np.isnan(z[(m, k)].values[i])]
    alertas = []
    if muertas:
        alertas.append("Z sin dato (cuenta 0 en el compuesto): " + ", ".join(muertas[:4])
                       + (f" +{len(muertas) - 4}" if len(muertas) > 4 else ""))
    cov = np.nan
    if marco == "B":
        cm = [d["cob"][m].values[i] for m in act_mults if d["w_m"][m] != 0]
        cov = float(np.nanmin(cm)) if cm else np.nan
        if not np.isnan(cov) and cov < umbral - 1e-12:
            alertas.append(f"Cobertura basket {cov:.0%}")
    neg = [_ZP_ETQ[m] for m in act_mults if d["w_m"][m] != 0 and d["mu"][m].values[i] < 0]
    if neg:
        alertas.append("Múltiplo negativo: " + ", ".join(neg))
    return len(ap) - len(muertas), len(ap), " | ".join(alertas), cov


def exportar_z_puros_excel(matriz_multiplos: dict, datos_bbg: dict, datos_ciq: dict,
                           grupos: list, base_final_z: pd.DataFrame, ruta_salida: str,
                           empresas_foco=EMPRESAS_FOCO, dias_por_anio: int = 260,
                           n_diag: int = XL_Z_DIAS_DIAG,
                           umbral_cobertura: float = XL_Z_UMBRAL_COBERTURA) -> None:
    """
    Exporta el Excel de Z puros (foto del portafolio + diagnóstico de empresas en foco).

    Parámetros
    ----------
    grupos : lista de (nombre_grupo, empresas_portafolio, basket_def, matriz_baskets, es_finan).
    base_final_z : Base_Final_Z de main() (columnas 'Z_<t>' y 'Z_Basket_<t>'), usada solo para
        cuadrar la suma de aportes contra el compuesto que ya se guarda en BD.
    empresas_foco : None → 2 primeras de cada grupo; o lista de tickers del portafolio.
    dias_por_anio : 260 en producción (solo se cambia para pruebas con poca historia).
    n_diag : filas diarias del diagnóstico.
    Supuestos: solo muestra múltiplos/ventanas con peso ≠ 0 (hoy 4 Trail × 3 ventanas;
    EV/EBITDA no aplica a financieras). Un Z sin dato se muestra vacío y suma 0 en el
    compuesto (igual que Creacion_Z_Final) — la columna de alertas lo avisa.
    """
    print("  → Generando Excel de Z puros (foto + diagnóstico)...")
    try:
        ventanas = [(a, p) for a, p in zip(ANIOS_Z, PESOS_Z) if p != 0]
        if not ventanas:
            raise ValueError("PESOS_Z no tiene ninguna ventana con peso distinto de 0.")
        act_mults = [m for i, m in enumerate(_XL_ORDEN) if PESOS_FINAN[i] != 0 or PESOS_EX_FINAN[i] != 0]
        nm, nw = len(act_mults), len(ventanas)

        # ── 1) Portafolio = empresas con múltiplos y basket ───────────────────
        port = []                                         # (ticker, grupo, es_fin, basket_def, mbk)
        for nombre, lista, bdef, mbk, es_fin in grupos:
            for t in lista:
                if t in matriz_multiplos and t in mbk and t in bdef:
                    port.append((t, nombre, es_fin, bdef[t], mbk))
        if not port:
            raise ValueError("No hay empresas del portafolio con múltiplos y basket.")
        if empresas_foco is None:
            foco, vistos = [], {}
            for t, g, *_ in port:
                vistos[g] = vistos.get(g, 0) + 1
                if vistos[g] <= 2:
                    foco.append(t)
        else:
            foco = []
            for t in empresas_foco:
                if any(t == p[0] for p in port):
                    foco.append(t)
                else:
                    print(f"  ⚠ {t}: no es empresa del portafolio (con basket) → se omite del diagnóstico.")

        # ── 2) Cálculo por empresa ────────────────────────────────────────────
        calc = {}
        for t, g, es_fin, bdef, mbk in port:
            calc[t] = _zp_calcular(t, es_fin, bdef, mbk, matriz_multiplos, datos_bbg,
                                   act_mults, ventanas, dias_por_anio, n_diag)

        wb = Workbook()
        wsG = wb.active
        wsG.title = "Guia"
        wsP = wb.create_sheet("Pesos")
        wsF = wb.create_sheet("Foto_Z")
        wsA = wb.create_sheet("Foto_Aportes")

        # ── 3) Hoja Pesos (las fórmulas de aportes leen de aquí) ──────────────
        wsP.cell(row=1, column=1, value="PESOS DEL FRAMEWORK (copiados de ZODA 2026; editar aquí recalcula aportes)").font = _F_TIT
        for c, h in enumerate(["Ventana", "Años", "Peso"], start=1):
            _xl_hdr(wsP, 3, c, h)
        ref_wk = []
        for k, (a, p) in enumerate(ventanas):
            wsP.cell(row=4 + k, column=1, value=f"Ventana {k + 1}")
            wsP.cell(row=4 + k, column=2, value=a)
            wsP.cell(row=4 + k, column=3, value=p).font = _F_IN
            ref_wk.append(f"Pesos!$C${4 + k}")
        r_pm = 4 + nw + 1
        for c, h in enumerate(["Múltiplo", "Peso Financieras", "Peso No financieras"], start=1):
            _xl_hdr(wsP, r_pm, c, h)
        ref_wm = {}
        for j, m in enumerate(act_mults):
            ix = _XL_ORDEN.index(m)
            wsP.cell(row=r_pm + 1 + j, column=1, value=_ZP_ETQ[m])
            wsP.cell(row=r_pm + 1 + j, column=2, value=PESOS_FINAN[ix]).font = _F_IN
            wsP.cell(row=r_pm + 1 + j, column=3, value=PESOS_EX_FINAN[ix]).font = _F_IN
            ref_wm[m] = (f"Pesos!$B${r_pm + 1 + j}", f"Pesos!$C${r_pm + 1 + j}")
        wsP.cell(row=r_pm + nm + 3, column=1, value=f"Días hábiles por 'año' usados: {dias_por_anio}")
        for col, w in zip("ABC", [24, 18, 22]):
            wsP.column_dimensions[col].width = w

        # ── 4) Hojas Foto_Z y Foto_Aportes (una fila por empresa × marco) ──────
        for ws, ttl in ((wsF, "FOTO DEL ÚLTIMO DÍA — Z PUROS por múltiplo y ventana (portafolio)"),
                        (wsA, "FOTO DEL ÚLTIMO DÍA — APORTES al Z compuesto (peso múltiplo × peso ventana × Z puro)")):
            ws.cell(row=1, column=1, value=ttl).font = _F_TIT
        wsF.cell(row=2, column=1, value=("Z puro = (x − promedio ventana) / desv. muestral. Vacío = el múltiplo no aplica al sector "
                                         "o la ventana no tiene historia completa. 'A' = años de la ventana."))
        wsA.cell(row=2, column=1, value=("Aporte = peso del múltiplo × peso de la ventana × Z puro. Todos los aportes suman el Z compuesto "
                                         "(fórmulas vivas). 'Compuesto BD' es el valor que el script guardó en la hoja BD."))
        ids = ["Grupo", "Empresa", "Marco", "Fecha"]
        for ws in (wsF, wsA):
            for c, h in enumerate(ids, start=1):
                _xl_hdr(ws, 5, c, h)
        zcols = {}                                         # (m, k) → columna (1-based) en Foto_Z y en Foto_Aportes (misma)
        c = 5
        for m in act_mults:
            for k, (a, _) in enumerate(ventanas):
                zcols[(m, k)] = c
                _xl_hdr(wsF, 5, c, f"{_ZP_ETQ[m]} · {a}A")
                _xl_hdr(wsA, 5, c, f"{_ZP_ETQ[m]} · {a}A")
                c += 1
        c_q = c                                            # columnas de calidad en Foto_Z
        for j, h in enumerate(["Ventanas válidas", "Cobertura mín. basket", "Alertas"]):
            _xl_hdr(wsF, 5, c_q + j, h)
        c_sm = {m: c + j for j, m in enumerate(act_mults)}                 # subtotales por múltiplo (Aportes)
        for m, cc in c_sm.items():
            _xl_hdr(wsA, 5, cc, f"Subtotal {_ZP_ETQ[m]}")
        c_sw = {k: c + nm + k for k in range(nw)}                           # subtotales por ventana
        for k, cc in c_sw.items():
            _xl_hdr(wsA, 5, cc, f"Subtotal ventana {ventanas[k][0]}A")
        c_comp = c + nm + nw
        for j, h in enumerate(["Z compuesto (Σ aportes)", "Compuesto BD", "|Δ|", "Cuadre"]):
            _xl_hdr(wsA, 5, c_comp + j, h)

        r = 6
        marcos = (("A", "Absoluto", "Z_"), ("B", "vs Basket", "Z_Basket_"))
        for t, g, es_fin, bdef, mbk in port:
            d = calc[t]
            i = len(d["fechas"]) - 1
            fecha = d["fechas"][-1]
            for marco, etq, pref in marcos:
                z = d["zA"] if marco == "A" else d["zB"]
                for ws in (wsF, wsA):
                    ws.cell(row=r, column=1, value=g)
                    ws.cell(row=r, column=2, value=t)
                    ws.cell(row=r, column=3, value=etq)
                    ws.cell(row=r, column=4, value=_xl_val(pd.Timestamp(fecha))).number_format = "dd/mm/yyyy"
                for m in act_mults:
                    aplica = d["w_m"][m] != 0
                    for k in range(nw):
                        cc = zcols[(m, k)]
                        v = _xl_val(z[(m, k)].values[i]) if aplica else None
                        wsF.cell(row=r, column=cc, value=v).number_format = "0.000"
                        if aplica:
                            L = _L(cc)
                            wm = ref_wm[m][0 if es_fin else 1]
                            wsA.cell(row=r, column=cc,
                                     value=f'=IF(ISNUMBER(Foto_Z!{L}{r}),Foto_Z!{L}{r}*{wm}*{ref_wk[k]},"")').number_format = "0.000"
                nv, na, txt, cov = _zp_alertas(d, marco, i, ventanas, act_mults, umbral_cobertura)
                wsF.cell(row=r, column=c_q, value=f"{nv}/{na}")
                wsF.cell(row=r, column=c_q + 1, value=_xl_val(cov)).number_format = "0%"
                wsF.cell(row=r, column=c_q + 2, value=txt)
                for m in act_mults:
                    cs = [_L(zcols[(m, k)]) for k in range(nw)]
                    wsA.cell(row=r, column=c_sm[m],
                             value="=SUM(" + ",".join(f"{x}{r}" for x in cs) + ")").number_format = "0.000"
                for k in range(nw):
                    cs = [_L(zcols[(m, k)]) for m in act_mults]
                    wsA.cell(row=r, column=c_sw[k],
                             value="=SUM(" + ",".join(f"{x}{r}" for x in cs) + ")").number_format = "0.000"
                Lc = _L(c_comp)
                wsA.cell(row=r, column=c_comp,
                         value=f"=SUM({_L(c_sm[act_mults[0]])}{r}:{_L(c_sm[act_mults[-1]])}{r})").number_format = "0.000"
                col_bd = f"{pref}{t}"
                bd = np.nan
                if col_bd in base_final_z.columns:
                    bd = base_final_z[col_bd].reindex([fecha]).values[0]
                wsA.cell(row=r, column=c_comp + 1, value=_xl_val(bd)).number_format = "0.000"
                wsA.cell(row=r, column=c_comp + 2,
                         value=f'=IF(ISNUMBER({_L(c_comp + 1)}{r}),ABS({Lc}{r}-{_L(c_comp + 1)}{r}),"—")').number_format = "0.0E+00"
                wsA.cell(row=r, column=c_comp + 3,
                         value=f'=IF(ISNUMBER({_L(c_comp + 2)}{r}),IF({_L(c_comp + 2)}{r}<=0.000001,"✓","≠"),"—")')
                r += 1
        for ws, ncol in ((wsF, c_q + 2), (wsA, c_comp + 3)):
            for col in range(1, ncol + 1):
                ws.column_dimensions[_L(col)].width = 13
            ws.column_dimensions["A"].width = 16
            ws.column_dimensions["B"].width = 22
            ws.row_dimensions[5].height = 32
            ws.freeze_panes = "E6"
        wsF.column_dimensions[_L(c_q + 2)].width = 60

        # ── 5) Diagnóstico por empresa en foco ───────────────────────────────
        nombres_usados = set()
        hojas_diag = []
        for t in foco:
            d = calc[t]
            es_fin = next(p[2] for p in port if p[0] == t)
            g = next(p[1] for p in port if p[0] == t)
            base = "Diag_" + "".join(ch for ch in t.split()[0] if ch not in '[]:*?/\\')[:20]
            nom, n = base, 2
            while nom in nombres_usados:
                nom, n = f"{base}_{n}", n + 1
            nombres_usados.add(nom)
            hojas_diag.append((nom, t))
            ws = wb.create_sheet(nom)
            _zp_escribir_diag(ws, t, g, es_fin, d, ventanas, act_mults, ref_wk, ref_wm,
                              matriz_multiplos, datos_bbg, datos_ciq, base_final_z, n_diag, umbral_cobertura)

        # ── 6) Hoja Guia ──────────────────────────────────────────────────────
        wsG.cell(row=1, column=1, value="ZODA — Z PUROS Y DIAGNÓSTICO (empresas del portafolio)").font = _F_TIT
        lineas = [
            "QUÉ ES: lo que la hoja BD no muestra. BD guarda solo el Z COMPUESTO; aquí se ve de qué está hecho.",
            "",
            "Z puro = (múltiplo de hoy − promedio de su ventana) / desviación muestral (n−1). Una celda por múltiplo × ventana.",
            f"Ventanas: {', '.join(str(a) + 'A' for a, _ in ventanas)} (1A = {dias_por_anio} días hábiles). Múltiplos: {', '.join(_ZP_ETQ[m] for m in act_mults)}.",
            "Aporte = peso del múltiplo × peso de la ventana × Z puro.  Σ aportes = Z compuesto de BD (columna 'Cuadre').",
            "",
            "HOJAS",
            "  Foto_Z / Foto_Aportes : todas las empresas del portafolio, último día, marcos Absoluto y vs Basket.",
            "  Diag_<empresa>        : empresas en foco, ~12 meses diarios. Bloques: Niveles · Causa · Z vs Basket · Z Absoluto · Calidad.",
            "",
            "CÓMO LEER 'vs Basket'",
            "  Z vs Basket NO mide si la empresa está cara contra su basket: mide si el RATIO (empresa/basket) está alto",
            "  contra su propia historia. Mira siempre el ratio (bloque Niveles) junto al Z.",
            "  Para saber si sube la empresa o baja el basket: compara 'empresa' y 'basket' en el bloque Niveles.",
            "",
            "CALIDAD DEL DATO (lo que el compuesto de BD no avisa)",
            "  • Una ventana sin historia completa (o con un hueco de datos) queda VACÍA aquí y vale 0 en el compuesto.",
            "  • Cobertura del basket < 100 %: algún comparable tiene Market Cap pero no ese múltiplo; su peso se pierde",
            "    y el múltiplo del basket queda subestimado (el script no reparte ese peso).",
            "  • Múltiplo negativo: utilidad/patrimonio negativos entran al promedio sin filtro.",
            "",
            "El compuesto se lee como un PUNTAJE RELATIVO, no como 'desviaciones estándar' exactas (pesos suman 0.99 y",
            "los Z que se promedian están correlacionados). No mide si la prima está justificada (crecimiento, márgenes, riesgo).",
        ]
        for i, txt in enumerate(lineas):
            c = wsG.cell(row=3 + i, column=1, value=txt)
            if txt in ("HOJAS", "CÓMO LEER 'vs Basket'", "CALIDAD DEL DATO (lo que el compuesto de BD no avisa)", "QUÉ ES: lo que la hoja BD no muestra. BD guarda solo el Z COMPUESTO; aquí se ve de qué está hecho."):
                c.font = _F_BOLD
        r0 = 4 + len(lineas)
        wsG.cell(row=r0, column=1, value="Empresas en foco: " + ", ".join(f"{n} → {t}" for n, t in hojas_diag)).font = _F_BOLD
        wsG.column_dimensions["A"].width = 130

        wb.calculation = CalcProperties(fullCalcOnLoad=True)
        try:
            wb.save(ruta_salida)
        except PermissionError:
            raise PermissionError(f"No se pudo guardar '{os.path.basename(ruta_salida)}': "
                                  "está abierto en Excel. Ciérralo y vuelve a ejecutar.")
        print(f"  ✓ Excel de Z puros: {ruta_salida}")
        print(f"    → Foto: {len(port)} empresas del portafolio | Diagnóstico: {len(foco)} empresas en foco × "
              f"{min(n_diag, len(next(iter(calc.values()))['fechas']))} días")
    except Exception as e:
        import traceback
        print(f"  ✗ Error al generar el Excel de Z puros: {e}")
        traceback.print_exc()


def _zp_escribir_diag(ws, t, grupo, es_fin, d, ventanas, act_mults, ref_wk, ref_wm,
                      matriz_multiplos, datos_bbg, datos_ciq, base_final_z, n_diag, umbral):
    """
    Escribe la hoja de diagnóstico diario de UNA empresa en foco.

    Bloques (de izquierda a derecha):
      Niveles : múltiplo de la empresa, del basket y ratio (por múltiplo aplicable).
      Causa   : Market Cap/EV, denominadores vigentes (CIQ), peso y múltiplo de cada comparable,
                cobertura del basket por múltiplo.
      Z vs Basket / Z Absoluto : 12 Z puros (múltiplo × ventana) + subtotales por múltiplo y por
                ventana + compuesto (Σ aportes, fórmula) + compuesto de BD + |Δ|.
      Calidad : ventanas válidas, cobertura mínima y alertas por día.
    Los subtotales y el compuesto son fórmulas que leen la hoja Pesos.
    """
    F0 = 6
    fechas = d["fechas"][-n_diag:]
    n = len(fechas)
    off = len(d["fechas"]) - n                              # posición del primer día mostrado
    sl = slice(off, off + n)
    app = [m for m in act_mults if d["w_m"][m] != 0]        # múltiplos aplicables a este sector
    nw = len(ventanas)
    idx_full = matriz_multiplos[t].index
    cols = []                                               # cada col: dict(key, header, block, fmt, vals|formula)

    def add(key, header, block, fmt="0.000", vals=None, formula=None):
        cols.append({"key": key, "h": header, "b": block, "fmt": fmt, "vals": vals, "f": formula})

    # Niveles
    for m in app:
        add(f"mu|{m}", f"{_ZP_ETQ[m]} empresa", "niv", "0.00", d["mu"][m].values[sl])
        add(f"bk|{m}", f"{_ZP_ETQ[m]} basket", "niv", "0.00", d["bk"][m].values[sl])
        add(f"rt|{m}", f"{_ZP_ETQ[m]} ratio", "niv", "0.000", d["ratio"][m].values[sl])
    # Causa: empresa
    bbg = datos_bbg[t].reindex(fechas)
    add("mc", "Market Cap empresa", "cau", "#,##0", bbg["CUR_MKT_CAP"].values)
    if "Trail_EVEBITDA" in app:
        add("ev", "EV empresa", "cau", "#,##0", bbg["CURR_ENTP_VAL"].values)
    for m in app:
        if m in _ZP_DEN:
            nombre, col, _ = _ZP_DEN[m]
            den = _zp_ciq_vigente(datos_ciq[t], col, idx_full).reindex(fechas)
            add(f"den|{m}", f"{nombre} vigente", "cau", "#,##0", den.values)
    # Causa: basket
    for c in d["mc_cols"]:
        add(f"w|{c}", f"Peso {c.split()[0]}", "cau", "0.0%", d["pesos"][c].reindex(fechas).values)
    for m in app:
        for c in d["mc_cols"]:
