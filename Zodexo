def _xl_val(v):
    """Convierte valores pandas/numpy a algo que openpyxl acepte (NaN/inf → None)."""
    if v is None:
        return None
    if isinstance(v, pd.Timestamp):
        return v.to_pydatetime()
    if isinstance(v, (float, np.floating)):
        return None if (np.isnan(v) or np.isinf(v)) else float(v)
    if isinstance(v, np.integer):
        return int(v)
    return v


def _xl_hdr(ws, fila, col, texto):
    c = ws.cell(row=fila, column=col, value=texto)
    c.font, c.fill = _F_HDR, _FILL_HDR
    c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    return c


def _xl_diff(x: str, y: str) -> str:
    """Texto de fórmula Excel: |x−y|; 0 si ambos vacíos; 1 si solo uno tiene dato."""
    return (f'IF(AND(ISNUMBER({x}),ISNUMBER({y})),ABS({x}-{y}),'
            f'IF(OR(ISNUMBER({x}),ISNUMBER({y})),1,0))')


def _auditoria_xl_empresa(wb, cod, empresa, grupo, comps_def, mbk, es_fin,
                          matriz_multiplos, datos_bbg, datos_ciq,
                          n_filas, n_fechas, dpa, ventanas, refs) -> dict:
    """
    Construye las 3 hojas de UNA empresa: <cod>_Datos, <cod>_Mult, <cod>_Z.

    Parámetros
    ----------
    cod        : código corto de hoja ("E1", "E2", ...).
    empresa    : ticker BBG de la empresa del portafolio.
    comps_def  : lista de comparables del basket (tal como sale de leer_baskets).
    mbk        : dict {empresa: DataFrame basket 8 columnas} (Matriz_Baskets_*).
    es_fin     : True si usa PESOS_FINAN, False si PESOS_EX_FINAN.
    n_filas    : filas diarias a volcar (= ventana máx. en días + n_fechas − 1).
    refs       : referencias a la hoja Parametros (dpa, tolerancia, ventanas, pesos).
    Retorna dict con celdas clave para la hoja Resumen.

    Supuestos: se replica el framework TAL CUAL (incluida la alineación por tamaño
    de CIQ y la convención 0 = sin dato). Solo múltiplos Trail (los Fwd tienen peso 0).
    """
    comps = [c for c in comps_def if c in matriz_multiplos and c in datos_bbg]
    tickers = [empresa] + comps
    T, C = len(tickers), len(comps)

    idx_full = matriz_multiplos[empresa].index
    if len(idx_full) < n_filas:
        raise ValueError(
            f"{empresa}: solo {len(idx_full)} fechas diarias y el Excel necesita {n_filas}. "
            f"Reduce XL_DIAS_POR_ANIO o XL_N_FECHAS.")
    fechas = idx_full[-n_filas:]
    K = n_fechas
    fechas_eval = fechas[-K:]
    nm, nv = len(_XL_MULT), len(ventanas)

    # ── Foto de Python (solo para contraste) ────────────────────────────────
    py_mult = {j: matriz_multiplos[t].reindex(fechas) for j, t in enumerate(tickers)}
    bk_py = mbk[empresa].reindex(fechas)
    ratio_raw = py_mult[0].div(bk_py)                       # igual que main: mult / basket
    z_abs_py = Creacion_Z_Final(py_mult[0].copy(), es_fin, dias_por_anio=dpa).reindex(fechas_eval)
    z_bk_py = Creacion_Z_Final(ratio_raw.copy(), es_fin, dias_por_anio=dpa).reindex(fechas_eval)

    D, M, Zn = f"{cod}_Datos", f"{cod}_Mult", f"{cod}_Z"
    wsD, wsM, wsZ = wb.create_sheet(D), wb.create_sheet(M), wb.create_sheet(Zn)
    F0, N = _XL_FILA0, n_filas
    R1 = F0 + N - 1                                          # última fila de datos

    # ══════════════════════════════════════════════════════════════════════════
    # HOJA DATOS: (1) diario BBG, (2) trimestral CIQ por ticker, (3) foto Python
    # ══════════════════════════════════════════════════════════════════════════
    wsD.cell(row=1, column=1, value=f"{empresa} — INPUTS (azul = editable) y foto de Python (gris)").font = _F_TIT
    wsD.cell(row=2, column=1, value=("Convención del framework: 0 o vacío = 'sin dato'. "
                                     "Cambia cualquier celda azul y las hojas Mult y Z se recalculan."))
    _xl_hdr(wsD, 5, 1, "Fecha")
    for r, f in enumerate(fechas):
        c = wsD.cell(row=F0 + r, column=1, value=_xl_val(pd.Timestamp(f)))
        c.number_format = "dd/mm/yyyy"
    col_mc, col_ev = {}, {}
    for j, t in enumerate(tickers):
        col_mc[j], col_ev[j] = 2 + 2 * j, 3 + 2 * j
        wsD.cell(row=4, column=col_mc[j], value=f"{t}" + ("  (EMPRESA)" if j == 0 else "  (comparable)")).font = _F_BOLD
        _xl_hdr(wsD, 5, col_mc[j], "Market Cap")
        _xl_hdr(wsD, 5, col_ev[j], "EV")
        bbg = datos_bbg[t].reindex(fechas)
        for r, (mc, ev) in enumerate(zip(bbg["CUR_MKT_CAP"].values, bbg["CURR_ENTP_VAL"].values)):
            a = wsD.cell(row=F0 + r, column=col_mc[j], value=_xl_val(mc)); a.font = _F_IN
            b = wsD.cell(row=F0 + r, column=col_ev[j], value=_xl_val(ev)); b.font = _F_IN
            a.number_format = b.number_format = "#,##0.00"

    qa = 1 + 2 * T + 2                                       # inicio del bloque trimestral
    qinfo = {}                                               # j → (col_clave, [cols IQ], fila1, fila2)
    q_ini = pd.Period(fechas[0], "Q") - 4                    # 1 año extra hacia atrás (ffill)
    for j, t in enumerate(tickers):
        c0 = qa + 6 * j
        wsD.cell(row=4, column=c0, value=f"CIQ trimestral · {t}").font = _F_BOLD
        for k, h in enumerate(["Fecha trim.", "Clave"] + _XL_CIQ):
            _xl_hdr(wsD, 5, c0 + k, h)
        ciq = datos_ciq[t][_XL_CIQ]
        ciq = ciq[pd.DatetimeIndex(ciq.index).to_period("Q") >= q_ini]
        if not ciq.index.is_monotonic_increasing:
            raise ValueError(f"{t}: fechas trimestrales CIQ no están en orden ascendente.")
        for r, (f, fila) in enumerate(zip(ciq.index, ciq.values)):
            fr = F0 + r
            c = wsD.cell(row=fr, column=c0, value=_xl_val(pd.Timestamp(f))); c.number_format = "dd/mm/yyyy"
            wsD.cell(row=fr, column=c0 + 1,
                     value=f"=YEAR({_L(c0)}{fr})*10+ROUNDUP(MONTH({_L(c0)}{fr})/3,0)")
            for k, v in enumerate(fila):
                x = wsD.cell(row=fr, column=c0 + 2 + k, value=_xl_val(v)); x.font = _F_IN
                x.number_format = "#,##0.00"
        qinfo[j] = (c0 + 1, [c0 + 2 + k for k in range(4)], F0, F0 + max(len(ciq), 1) - 1)

    pa = qa + 6 * T + 1                                      # inicio foto Python
    wsD.cell(row=3, column=pa, value="FOTO DE PYTHON (solo contraste — no editar)").font = _F_BOLD
    for j, t in enumerate(tickers):
        wsD.cell(row=4, column=pa + 4 * j, value=f"Py múltiplos · {t}").font = _F_BOLD
        for k, (mk, lbl, _, _) in enumerate(_XL_MULT):
            _xl_hdr(wsD, 5, pa + 4 * j + k, lbl)
            for r, v in enumerate(py_mult[j][mk].values):
                x = wsD.cell(row=F0 + r, column=pa + 4 * j + k, value=_xl_val(v))
                x.font, x.number_format = _F_PY, "0.0000"
    pb, pr = pa + 4 * T, pa + 4 * T + 4
    ratio_show = ratio_raw.replace([np.inf, -np.inf], np.nan)
    wsD.cell(row=4, column=pb, value="Py basket (mult. ponderado por MC)").font = _F_BOLD
    wsD.cell(row=4, column=pr, value="Py ratio empresa/basket").font = _F_BOLD
    for k, (mk, lbl, _, _) in enumerate(_XL_MULT):
        _xl_hdr(wsD, 5, pb + k, lbl)
        _xl_hdr(wsD, 5, pr + k, lbl)
        for r, (vb, vr) in enumerate(zip(bk_py[mk].values, ratio_show[mk].values)):
            x = wsD.cell(row=F0 + r, column=pb + k, value=_xl_val(vb)); x.font, x.number_format = _F_PY, "0.0000"
            y = wsD.cell(row=F0 + r, column=pr + k, value=_xl_val(vr)); y.font, y.number_format = _F_PY, "0.0000"
    wsD.freeze_panes = wsD.cell(row=F0, column=2)

    # ══════════════════════════════════════════════════════════════════════════
    # HOJA MULT: múltiplos de cada ticker (fórmulas) + basket + ratio
    # ══════════════════════════════════════════════════════════════════════════
    wsM.cell(row=1, column=1, value=f"{empresa} — MÚLTIPLOS, BASKET Y RATIO (todo con fórmulas)").font = _F_TIT
    wsM.cell(row=2, column=1, value=("Múltiplo = numerador BBG / denominador CIQ vigente (último trimestre ≤ fecha, "
                                     "= reindex+ffill de pandas). Si cualquiera es 0/vacío → sin dato."))
    _xl_hdr(wsM, 5, 1, "Fecha"); _xl_hdr(wsM, 5, 2, "Clave trim.")
    cm = {j: 3 + _XL_BW * j for j in range(T)}               # col inicial de cada bloque
    mult_col = {}                                            # (j, k) → letra de la col del múltiplo
    delta_cols = []
    for j, t in enumerate(tickers):
        wsM.cell(row=4, column=cm[j], value=f"{t}" + ("  (EMPRESA)" if j == 0 else "  (comparable)")).font = _F_BOLD
        for k, h in enumerate(["Market Cap", "EV", "NI vig.", "Ventas vig.", "Patrim. vig.", "EBITDA vig."]
                              + [m[1] for m in _XL_MULT] + ["Máx |Δ| vs Py"]):
            _xl_hdr(wsM, 5, cm[j] + k, h)
        for k in range(4):
            mult_col[(j, k)] = _L(cm[j] + 6 + k)
        delta_cols.append(_L(cm[j] + 10))
    cb = 3 + _XL_BW * T                                      # bloque basket
    cw = {i: cb + i for i in range(C)}                       # pesos por comparable
    c_sum = cb + C
    c_bk = [c_sum + 1 + k for k in range(4)]
    c_rt = [c_sum + 5 + k for k in range(4)]
    c_dbk, c_drt = c_sum + 9, c_sum + 10
    wsM.cell(row=4, column=cb, value="BASKET ponderado por Market Cap y ratio empresa/basket").font = _F_BOLD
    for i, t in enumerate(comps):
        _xl_hdr(wsM, 5, cw[i], f"Peso {t}")
    _xl_hdr(wsM, 5, c_sum, "Σ pesos")
    for k, m in enumerate(_XL_MULT):
        _xl_hdr(wsM, 5, c_bk[k], f"Basket {m[1]}")
        _xl_hdr(wsM, 5, c_rt[k], f"Ratio {m[1]}")
    _xl_hdr(wsM, 5, c_dbk, "Máx |Δ| basket vs Py"); _xl_hdr(wsM, 5, c_drt, "Máx |Δ| ratio vs Py")

    for r in range(F0, R1 + 1):
        wsM.cell(row=r, column=1, value=f"='{D}'!A{r}").number_format = "dd/mm/yyyy"
        wsM.cell(row=r, column=2, value=f"=YEAR(A{r})*10+ROUNDUP(MONTH(A{r})/3,0)")
        for j in range(T):
            c0 = cm[j]
            mc, ev = f"{_L(c0)}{r}", f"{_L(c0 + 1)}{r}"
            wsM.cell(row=r, column=c0,     value=f"='{D}'!{_L(col_mc[j])}{r}").number_format = "#,##0.00"
            wsM.cell(row=r, column=c0 + 1, value=f"='{D}'!{_L(col_ev[j])}{r}").number_format = "#,##0.00"
            ck, cols_iq, q1, q2 = qinfo[j]
            for k in range(4):                                # NI, Ventas, Patrimonio, EBITDA vigentes
                rng_v = f"'{D}'!${_L(cols_iq[k])}${q1}:${_L(cols_iq[k])}${q2}"
                rng_k = f"'{D}'!${_L(ck)}${q1}:${_L(ck)}${q2}"
                wsM.cell(row=r, column=c0 + 2 + k,
                         value=f'=IFERROR(INDEX({rng_v},MATCH($B{r},{rng_k},1)),"")').number_format = "#,##0.00"
            difs = []
            for k, (mk, lbl, num, den) in enumerate(_XL_MULT):
                n_ref = mc if num == "CUR_MKT_CAP" else ev
                d_ref = f"{_L(c0 + 2 + _XL_CIQ.index(den))}{r}"
                wsM.cell(row=r, column=c0 + 6 + k,
                         value=(f'=IF(AND(ISNUMBER({n_ref}),ISNUMBER({d_ref})),'
                                f'IF(OR({n_ref}=0,{d_ref}=0),"",{n_ref}/{d_ref}),"")')).number_format = "0.0000"
                difs.append(_xl_diff(f"{mult_col[(j, k)]}{r}", f"'{D}'!{_L(pa + 4 * j + k)}{r}"))
            wsM.cell(row=r, column=c0 + 10, value="=MAX(" + ",".join(difs) + ")").number_format = "0.0E+00"

        # Basket: pesos = MC_i / Σ MC (de todos los comparables válidos), igual que Creacion_DF_Basket
        mcs = [f"{_L(cm[j + 1])}{r}" for j in range(C)]
        suma_mc = "SUM(" + ",".join(mcs) + ")" if mcs else "0"
        for i in range(C):
            wsM.cell(row=r, column=cw[i],
                     value=f'=IF({suma_mc}=0,"",{mcs[i]}/{suma_mc})').number_format = "0.0000"
        if C:
            wsM.cell(row=r, column=c_sum, value=f'=IF(COUNT({_L(cw[0])}{r}:{_L(cw[C-1])}{r})=0,"",'
                                                f'SUM({_L(cw[0])}{r}:{_L(cw[C-1])}{r}))').number_format = "0.0000"
        difs_b, difs_r = [], []
        for k in range(4):
            terms = [f"N({_L(cw[i])}{r})*N({mult_col[(i + 1, k)]}{r})" for i in range(C)]
            wsM.cell(row=r, column=c_bk[k], value="=" + ("+".join(terms) if terms else "0")).number_format = "0.0000"
            bk_ref, me_ref = f"{_L(c_bk[k])}{r}", f"{mult_col[(0, k)]}{r}"
            wsM.cell(row=r, column=c_rt[k],
                     value=(f'=IF(AND(ISNUMBER({me_ref}),ISNUMBER({bk_ref})),'
                            f'IF({bk_ref}=0,"",{me_ref}/{bk_ref}),"")')).number_format = "0.0000"
            difs_b.append(_xl_diff(bk_ref, f"'{D}'!{_L(pb + k)}{r}"))
            difs_r.append(_xl_diff(f"{_L(c_rt[k])}{r}", f"'{D}'!{_L(pr + k)}{r}"))
        wsM.cell(row=r, column=c_dbk, value="=MAX(" + ",".join(difs_b) + ")").number_format = "0.0E+00"
        wsM.cell(row=r, column=c_drt, value="=MAX(" + ",".join(difs_r) + ")").number_format = "0.0E+00"
    delta_cols += [_L(c_dbk), _L(c_drt)]
    wsM.freeze_panes = wsM.cell(row=F0, column=3)

    # ══════════════════════════════════════════════════════════════════════════
    # HOJA Z: resumen (A: Z absoluto, B: Z vs basket) + detalle por ventana
    # ══════════════════════════════════════════════════════════════════════════
    wsZ.cell(row=1, column=1, value=f"{empresa} — Z-SCORE: de múltiplos a Z compuesto").font = _F_TIT
    wsZ.cell(row=2, column=1, value=(
        "Z = (x − promedio ventana) / desv. muestral (n−1) · ventana de N días con N = años × días/año (Parametros) · "
        "exige ventana completa sin huecos (min_periods de pandas) · Z compuesto = Σ_múltiplos peso × Σ_ventanas peso × Z."))
    filas_det = K * nm * nv
    rA = 4
    rB = rA + K + 5
    rC = rB + K + 5
    rD = rC + filas_det + 4
    detC = (rC + 2, rC + 1 + filas_det)
    detD = (rD + 2, rD + 1 + filas_det)
    sumA0, sumB0 = rA + 3, rB + 3
    series_abs = [mult_col[(0, k)] for k in range(4)]
    series_rt = [_L(c) for c in c_rt]
    idx_peso = 0 if es_fin else 1

    def _resumen(r_t, titulo, det, z_py):
        wsZ.cell(row=r_t, column=1, value=titulo).font = _F_BOLD
        for cc in range(1, 11):
            wsZ.cell(row=r_t, column=cc).fill = _FILL_SEC
        wsZ.cell(row=r_t + 1, column=2, value="Peso del múltiplo →").alignment = Alignment(horizontal="right")
        for k, (mk, lbl, _, _) in enumerate(_XL_MULT):
            wsZ.cell(row=r_t + 1, column=3 + k, value=f"={refs['pm'][mk][idx_peso]}")
        for k, h in enumerate(["Fecha", f"Fila en {M}"] + [m[1] for m in _XL_MULT]
                              + ["Z final (Excel)", "Z final (Python)", "|Δ|", "Contraste"]):
            _xl_hdr(wsZ, r_t + 2, 1 + k, h)
        d1, d2 = det
        for i in range(K):
            r = r_t + 3 + i
            wsZ.cell(row=r, column=1, value=f"='{M}'!A{F0 + N - K + i}").number_format = "dd/mm/yyyy"
            wsZ.cell(row=r, column=2, value=f"=MATCH(A{r},'{M}'!$A:$A,0)")
            for k in range(nm):
                col = _L(3 + k)
                wsZ.cell(row=r, column=3 + k,
                         value=(f"=SUMIFS($M${d1}:$M${d2},$A${d1}:$A${d2},$A{r},"
                                f"$B${d1}:$B${d2},{col}${r_t + 2})")).number_format = "0.0000"
            wsZ.cell(row=r, column=7, value=f"=SUMPRODUCT(C{r}:F{r},$C${r_t + 1}:$F${r_t + 1})").number_format = "0.0000"
            wsZ.cell(row=r, column=7).font = _F_BOLD
            py = wsZ.cell(row=r, column=8, value=_xl_val(z_py.values[i])); py.font, py.number_format = _F_PY, "0.0000"
            wsZ.cell(row=r, column=9, value=f'=IF(ISNUMBER(H{r}),ABS(G{r}-H{r}),"—")').number_format = "0.0E+00"
            wsZ.cell(row=r, column=10, value=f'=IF(ISNUMBER(I{r}),IF(I{r}<={refs["tol"]},"✓","✗"),"—")')

    def _detalle(r_t, titulo, det, series, sum0):
        wsZ.cell(row=r_t, column=1, value=titulo).font = _F_BOLD
        for cc in range(1, 14):
            wsZ.cell(row=r_t, column=cc).fill = _FILL_SEC
        for k, h in enumerate(["Fecha", "Múltiplo", "Ventana (años)", "Días ventana (N)", f"Fila fin ({M})",
                               "Fila inicio", "x (valor hoy)", "Obs. válidas", "Promedio", "Desv. (n−1)",
                               "Z", "Peso ventana", "Z ponderado"]):
            _xl_hdr(wsZ, r_t + 1, 1 + k, h)
        r = det[0]
        for i in range(K):
            s = sum0 + i
            for k, (mk, lbl, _, _) in enumerate(_XL_MULT):
                sc = series[k]
                colref = f"'{M}'!${sc}:${sc}"
                for v in range(nv):
                    rng = f"INDEX({colref},$F{r}):INDEX({colref},$E{r})"
                    wsZ.cell(row=r, column=1, value=f"=$A${s}").number_format = "dd/mm/yyyy"
                    wsZ.cell(row=r, column=2, value=lbl)
                    wsZ.cell(row=r, column=3, value=f"={refs['vent'][v][0]}")
                    wsZ.cell(row=r, column=4, value=f"={refs['vent'][v][2]}")
                    wsZ.cell(row=r, column=5, value=f"=$B${s}")
                    wsZ.cell(row=r, column=6, value=f"=E{r}-D{r}+1")
                    wsZ.cell(row=r, column=7, value=f"=INDEX({colref},$E{r})").number_format = "0.0000"
                    wsZ.cell(row=r, column=8, value=f"=IF($F{r}<{F0},0,COUNT({rng}))")
                    wsZ.cell(row=r, column=9, value=f'=IF($H{r}<$D{r},"",AVERAGE({rng}))').number_format = "0.0000"
                    wsZ.cell(row=r, column=10, value=f'=IF($H{r}<$D{r},"",STDEV({rng}))').number_format = "0.0000"
                    wsZ.cell(row=r, column=11,
                             value=(f'=IF($H{r}<$D{r},"",IF(NOT(ISNUMBER($G{r})),"",'
                                    f'IF($J{r}=0,"",($G{r}-$I{r})/$J{r})))')).number_format = "0.0000"
                    wsZ.cell(row=r, column=12, value=f"={refs['vent'][v][1]}")
                    wsZ.cell(row=r, column=13, value=f'=IF(ISNUMBER($K{r}),$K{r}*$L{r},"")').number_format = "0.0000"
                    r += 1

    _resumen(rA, "A. Z ABSOLUTO — ¿está el múltiplo de la empresa caro/barato contra SU PROPIA historia?",
             detC, z_abs_py)
    _resumen(rB, "B. Z vs BASKET — Z del ratio (múltiplo empresa / múltiplo basket) contra la historia de ESE ratio",
             detD, z_bk_py)
    _detalle(rC, "C. DETALLE Z ABSOLUTO (una fila por fecha × múltiplo × ventana)", detC, series_abs, sumA0)
    _detalle(rD, "D. DETALLE Z vs BASKET (misma mecánica, sobre el ratio empresa/basket)", detD, series_rt, sumB0)
    wsZ.freeze_panes = "A4"

    for ws, anchos in ((wsD, 14), (wsM, 13), (wsZ, 15)):
        for col in range(1, ws.max_column + 1):
            ws.column_dimensions[_L(col)].width = anchos
        ws.row_dimensions[5].height = 30

    return {
        "cod": cod, "empresa": empresa, "grupo": grupo, "es_fin": es_fin, "n_comps": C,
        "fecha": f"'{Zn}'!A{sumA0 + K - 1}",
        "z_abs_xl": f"'{Zn}'!G{sumA0 + K - 1}", "z_abs_py": f"'{Zn}'!H{sumA0 + K - 1}",
        "z_bk_xl": f"'{Zn}'!G{sumB0 + K - 1}",  "z_bk_py": f"'{Zn}'!H{sumB0 + K - 1}",
        "d_mult": [f"'{M}'!${c}${F0}:${c}${R1}" for c in delta_cols],
        "d_z": [f"'{Zn}'!$I${sumA0}:$I${sumA0 + K - 1}", f"'{Zn}'!$I${sumB0}:$I${sumB0 + K - 1}"],
    }


def exportar_auditoria_excel(matriz_multiplos: dict,
                             datos_bbg: dict,
                             datos_ciq: dict,
                             grupos: list,
                             ruta_salida: str,
                             dias_por_anio: int = XL_DIAS_POR_ANIO,
                             n_fechas: int = XL_N_FECHAS,
                             empresas=XL_EMPRESAS_AUDITORIA) -> None:
    """
    Genera el Excel de auditoría con fórmulas vivas para pocas empresas y pocas fechas.

    Parámetros
    ----------
    grupos : lista de tuplas (nombre_grupo, empresas_del_portafolio, basket_def,
             matriz_baskets, es_finan).
    dias_por_anio : días hábiles que representan "1 año" (20 = demo rápida; 260 = réplica
             exacta de producción, necesita ≥ 5×260 + n_fechas filas de historia).
    empresas : None → 1ra empresa de cada grupo; o lista de tickers BBG del portafolio.
    Supuestos: el Z de Python se recalcula con Creacion_Z_Final(dias_por_anio=...) sobre
    el mismo tramo, así que Excel y Python usan exactamente la misma ventana.
    """
    print("  → Generando Excel de auditoría (múltiplos → Z → Z vs Basket)...")
    try:
        ventanas = [(a, p) for a, p in zip(ANIOS_Z, PESOS_Z) if p != 0]
        if not ventanas:
            raise ValueError("PESOS_Z no tiene ninguna ventana con peso distinto de 0.")
        for nom, pesos in (("PESOS_FINAN", PESOS_FINAN), ("PESOS_EX_FINAN", PESOS_EX_FINAN)):
            fwd = [m for m, p in zip(_XL_ORDEN, pesos) if m.startswith("Fwd_") and p != 0]
            if fwd:
                print(f"  ⚠ {nom} pondera {fwd}: el Excel de auditoría solo replica múltiplos Trail.")
        dias_vent = [int(round(a * dias_por_anio)) for a, _ in ventanas]
        n_filas = max(dias_vent) + n_fechas - 1

        elegidas = []
        if empresas is None:
            for nombre, lista, bdef, mbk, es_fin in grupos:
                for t in lista:
                    if t in matriz_multiplos and t in mbk and t in bdef:
                        elegidas.append((t, nombre, bdef[t], mbk, es_fin))
                        break
        else:
            for t in empresas:
                for nombre, lista, bdef, mbk, es_fin in grupos:
                    if t in lista and t in matriz_multiplos and t in mbk:
                        elegidas.append((t, nombre, bdef[t], mbk, es_fin))
                        break
                else:
                    print(f"  ⚠ {t}: no es empresa del portafolio o no tiene múltiplos → se omite.")
        if not elegidas:
            raise ValueError("No hay empresas del portafolio con múltiplos y basket para auditar.")

        wb = Workbook()
        wsR = wb.active
        wsR.title = "Resumen"
        wsP = wb.create_sheet("Parametros")

        # ── Hoja Parametros (todas las fórmulas leen de aquí) ────────────────
        wsP.cell(row=1, column=1, value="PARÁMETROS DEL FRAMEWORK (azul = editable)").font = _F_TIT
        wsP.cell(row=3, column=1, value="Días hábiles por 'año' (producción = 260)")
        wsP.cell(row=3, column=2, value=dias_por_anio).font = _F_IN
        wsP.cell(row=4, column=1, value="Tolerancia contraste Excel vs Python")
        wsP.cell(row=4, column=2, value=1e-6).font = _F_IN
        for k, h in enumerate(["Ventana", "Años", "Peso", "Días (= Años × días/año)"]):
            _xl_hdr(wsP, 7, 1 + k, h)
        refs = {"tol": "Parametros!$B$4", "vent": [], "pm": {}}
        for v, (a, p) in enumerate(ventanas):
            r = 8 + v
            wsP.cell(row=r, column=1, value=f"Ventana {v + 1}")
            wsP.cell(row=r, column=2, value=a).font = _F_IN
            wsP.cell(row=r, column=3, value=p).font = _F_IN
            wsP.cell(row=r, column=4, value=f"=B{r}*$B$3")
            refs["vent"].append((f"Parametros!$B${r}", f"Parametros!$C${r}", f"Parametros!$D${r}"))
        r_pm = 8 + len(ventanas) + 2
        for k, h in enumerate(["Múltiplo", "Peso Financieras", "Peso No financieras"]):
            _xl_hdr(wsP, r_pm, 1 + k, h)
        for k, (mk, lbl, _, _) in enumerate(_XL_MULT):
            r = r_pm + 1 + k
            ix = _XL_ORDEN.index(mk)
            wsP.cell(row=r, column=1, value=lbl)
            wsP.cell(row=r, column=2, value=PESOS_FINAN[ix]).font = _F_IN
            wsP.cell(row=r, column=3, value=PESOS_EX_FINAN[ix]).font = _F_IN
            refs["pm"][mk] = (f"Parametros!$B${r}", f"Parametros!$C${r}")
        wsP.column_dimensions["A"].width = 44
        for c in "BCD":
            wsP.column_dimensions[c].width = 22

        # ── Hojas por empresa ────────────────────────────────────────────────
        resultados = []
        for i, (t, nombre, comps_def, mbk, es_fin) in enumerate(elegidas, start=1):
            resultados.append(_auditoria_xl_empresa(
                wb, f"E{i}", t, nombre, comps_def, mbk, es_fin,
                matriz_multiplos, datos_bbg, datos_ciq,
                n_filas, n_fechas, dias_por_anio, ventanas, refs))

        # ── Hoja Resumen ─────────────────────────────────────────────────────
        wsR.cell(row=1, column=1, value="ZODA — AUDITORÍA DE FÓRMULAS: Múltiplos → Z → Z vs Basket").font = _F_TIT
        enc = ["Hoja", "Empresa (BBG)", "Grupo", "Nº comparables", "Última fecha",
               "Z absoluto (Excel)", "Z absoluto (Python)", "Z vs Basket (Excel)", "Z vs Basket (Python)",
               "Máx |Δ| múltiplos/basket", "Máx |Δ| Z", "Estado"]
        for k, h in enumerate(enc):
            _xl_hdr(wsR, 3, 1 + k, h)
        for i, res in enumerate(resultados):
            r = 4 + i
            wsR.cell(row=r, column=1, value=res["cod"])
            wsR.cell(row=r, column=2, value=res["empresa"])
            wsR.cell(row=r, column=3, value=res["grupo"])
            wsR.cell(row=r, column=4, value=res["n_comps"])
            wsR.cell(row=r, column=5, value=f"={res['fecha']}").number_format = "dd/mm/yyyy"
            wsR.cell(row=r, column=6, value=f"={res['z_abs_xl']}").number_format = "0.0000"
            wsR.cell(row=r, column=7, value=f"={res['z_abs_py']}").number_format = "0.0000"
            wsR.cell(row=r, column=8, value=f"={res['z_bk_xl']}").number_format = "0.0000"
            wsR.cell(row=r, column=9, value=f"={res['z_bk_py']}").number_format = "0.0000"
            wsR.cell(row=r, column=10, value="=MAX(" + ",".join(res["d_mult"]) + ")").number_format = "0.0E+00"
            wsR.cell(row=r, column=11, value="=MAX(" + ",".join(res["d_z"]) + ")").number_format = "0.0E+00"
            wsR.cell(row=r, column=12,
                     value=(f'=IF(AND(J{r}<={refs["tol"]},K{r}<={refs["tol"]}),'
                            f'"✓ Excel = Python","≠ difiere de la foto de Python")'))
        notas = [
            "CÓMO LEER ESTE LIBRO",
            "1) Flujo por empresa:  E#_Datos (inputs)  →  E#_Mult (múltiplos, basket, ratio)  →  E#_Z (Z por ventana y Z compuesto).",
            "2) Azul = input editable · Negro = fórmula · Gris cursiva = foto de Python al generar (solo contraste).",
            "3) Cambia un Market Cap, una utilidad o un peso en Parametros: Mult y Z se recalculan solos.",
            "   La columna 'Python' queda como foto del run original, por eso tras editar inputs el contraste mostrará",
            "   diferencias: es lo esperado. Lo que prueba el framework son las fórmulas, no la foto.",
            "4) En este Excel '1 año' = Parametros!B3 días hábiles (producción = 260). La lógica es idéntica; solo la ventana es más corta.",
            "5) Convención del framework: 0 o vacío = sin dato. Una ventana con algún hueco da Z vacío (min_periods de pandas).",
            "6) Z compuesto = Σ_múltiplos [ peso_múltiplo × Σ_ventanas ( peso_ventana × Z ) ]; ventana sin historia aporta 0.",
            "7) Se abre bien en Excel de escritorio (recalcula al abrir). Vistas previas web/móvil pueden mostrar celdas vacías.",
        ]
        for i, txt in enumerate(notas):
            c = wsR.cell(row=5 + len(resultados) + i, column=1, value=txt)
            if i == 0:
                c.font = _F_BOLD
        for col, w in zip("ABCDEFGHIJKL", [8, 24, 16, 14, 13, 16, 16, 16, 16, 20, 14, 30]):
            wsR.column_dimensions[col].width = w
        wsR.row_dimensions[3].height = 32

        wb.calculation = CalcProperties(fullCalcOnLoad=True)
        try:
            wb.save(ruta_salida)
        except PermissionError:
            raise PermissionError(f"No se pudo guardar '{os.path.basename(ruta_salida)}': "
                                  "está abierto en Excel. Ciérralo y vuelve a ejecutar.")
        print(f"  ✓ Excel de auditoría: {ruta_salida}")
        print(f"    → {len(resultados)} empresas × {n_filas} fechas diarias "
              f"(Z con fórmulas en las últimas {n_fechas}; 1 año = {dias_por_anio} días)")
    except Exception as e:
        import traceback
        print(f"  ✗ Error al generar el Excel de auditoría: {e}")
        traceback.print_exc()


# ==============================================================================
# SECCIÓN 13b: EXCEL DE Z PUROS Y DIAGNÓSTICO  (solo empresas del portafolio)
# ==============================================================================
# Responde dos preguntas que la hoja BD (que solo guarda el Z compuesto) no responde:
#   1) ¿POR QUÉ está caro/barato?  → Z puro de cada múltiplo × ventana y su aporte
#   2) ¿DESDE CUÁNDO y por quién?  → diagnóstico diario de ~12 meses (niveles de la
#      empresa, del basket y del ratio; composición del basket; calidad del dato)
#
# Hojas:  Guia · Pesos · Foto_Z · Foto_Aportes · Diag_<empresa en foco> ...
#   - Foto_*  : TODAS las empresas del portafolio (empresas con basket), último día.
#   - Diag_*  : solo las empresas de EMPRESAS_FOCO (una hoja por empresa).
# No inventa métricas: usa la misma Z(), los mismos pesos y los mismos baskets del script.
# El peer group NO se exporta (solo entra como insumo del basket).

# --- Parámetros (se cambian aquí, no en main) --------------------------------
EMPRESAS_FOCO         = None   # None = las 2 primeras de cada grupo; o lista, ej. ["BAP US Equity", ...]
XL_Z_DIAS_DIAG        = 260    # filas diarias del diagnóstico (≈ 12 meses)
XL_Z_UMBRAL_COBERTURA = 1.0    # alerta si la cobertura del basket es menor a este valor (1.0 = 100 %)

# --- Constantes internas ------------------------------------------------------
