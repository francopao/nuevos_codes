    # Z puros + subtotales + compuesto, para cada marco
    for marco, bloque, etq, pref in (("B", "zb", "vs Basket", "Z_Basket_"), ("A", "za", "Absoluto", "Z_")):
        z = d["zB"] if marco == "B" else d["zA"]
        for m in app:
