        add(f"comp{marco}", f"Z compuesto {etq} (Σ aportes)", bloque, "0.000",
            formula=(lambda r, P, marco=marco: "=SUM(" + ",".join(f"{P[f'sm{marco}|{m}']}{r}" for m in app) + ")"))
        col_bd = f"{pref}{t}"
        bd = (base_final_z[col_bd].reindex(fechas).values if col_bd in base_final_z.columns
              else np.full(n, np.nan))
        add(f"bd{marco}", f"Compuesto BD ({etq})", bloque, "0.000", bd)
        add(f"dl{marco}", f"|Δ| vs BD ({etq})", bloque, "0.0E+00",
            formula=(lambda r, P, marco=marco:
                     f'=IF(ISNUMBER({P[f"bd{marco}"]}{r}),ABS({P[f"comp{marco}"]}{r}-{P[f"bd{marco}"]}{r}),"—")'))

    # Calidad (día a día)
    qB = [_zp_alertas(d, "B", off + i, ventanas, act_mults, umbral) for i in range(n)]
    qA = [_zp_alertas(d, "A", off + i, ventanas, act_mults, umbral) for i in range(n)]
    add("qvB", "Ventanas válidas (vs Basket)", "cal", "@", [f"{x[0]}/{x[1]}" for x in qB])
    add("qvA", "Ventanas válidas (Absoluto)", "cal", "@", [f"{x[0]}/{x[1]}" for x in qA])
    add("qcov", "Cobertura mín. basket", "cal", "0%", [x[3] for x in qB])
    add("qal", "Alertas", "cal", "@", [" | ".join(s for s in dict.fromkeys(
        (qB[i][2] + " | " + qA[i][2]).split(" | ")) if s) for i in range(n)])

    # Posiciones de columna (A = fecha)
    P = {c["key"]: _L(2 + i) for i, c in enumerate(cols)}
    ws.cell(row=1, column=1, value=f"{t} — DIAGNÓSTICO DIARIO ({grupo})").font = _F_TIT
    ws.cell(row=2, column=1, value=("Niveles: ¿sube la empresa o baja el basket? · Causa: denominadores y pesos de los comparables · "
                                    "Z puros y aportes · Calidad del dato. Vacío = sin dato / no aplica."))
    _xl_hdr(ws, 5, 1, "Fecha")
    bloque_titulo = {"niv": "NIVELES", "cau": "CAUSA", "zb": "Z vs BASKET", "za": "Z ABSOLUTO", "cal": "CALIDAD"}
    previo = None
    for i, c in enumerate(cols):
        col = 2 + i
        h = _xl_hdr(ws, 5, col, c["h"])
        h.fill = PatternFill("solid", fgColor=_ZP_COLORES[c["b"]])
        if c["b"] != previo:
            ws.cell(row=4, column=col, value=bloque_titulo[c["b"]]).font = Font(bold=True, color=_ZP_COLORES[c["b"]])
            previo = c["b"]
        ws.column_dimensions[_L(col)].width = 14
    ws.column_dimensions[P["qal"]].width = 70
    ws.row_dimensions[5].height = 45
    for i in range(n):
        r = F0 + i
        ws.cell(row=r, column=1, value=_xl_val(pd.Timestamp(fechas[i]))).number_format = "dd/mm/yyyy"
        for j, c in enumerate(cols):
            if c["f"] is not None:
