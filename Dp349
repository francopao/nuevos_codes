# Patrón de nombre de archivo: "Riesgos Climáticos - 1S26.xlsx", "... 2S25.xlsx", etc.
FILE_PATTERN = re.compile(r"Riesgos\s*Clim[aá]ticos\s*-\s*([12])S(\d{2})\.xlsx$", re.IGNORECASE)

# Peligros CENEPRED (mismas 3 columnas que exporta Physical Risk 330).
HAZARDS = [
    {"key": "mm", "col": "Score MM", "label": "Movimientos de Masa"},
    {"key": "inu", "col": "Score Inund.", "label": "Inundación"},
    {"key": "seq", "col": "Score Sequía", "label": "Sequías Severas"},
]

# Niveles que se consideran "alto riesgo" (mismo criterio que el dashboard).
NIVELES_ALTOS = [4, 5]

# Mitigantes que cuentan como "NO mitigada" en el chart 1 (conservador: Bajo
# y "sin evaluar" pesan igual, sin ponderaciones inventadas).
MITIGANTES_NO_CUBRE = {"Bajo", "\u2014", "-", "N/D", ""}

# Diccionario EDITABLE de equivalencias Empresa (Activos/Score por Empresa)
# -> nombre EXACTO como aparece en la hoja "Mitigantes". Solo agrega aquí
# cuando el script te avise (log WARN) que no pudo resolver un mitigante;
# nunca lo completes "a ojo" sin confirmar con la fuente.
EQUIV_MITIGANTE = {
    "Nexa Resources Perú": "Nexa Perú",
    "Hochschild": "Hochshild",          # typo real en el archivo Mitigantes
    "InRetail Consumer": "InRetail",
    "Inretail Peru Corp": "InRetail",
    "InRetail Shopping Malls": "InRetail",
}

# Paleta corporativa AFP Integra (idéntica a Physical Risk 330).
AFP_AZUL = "#1E2E6E"
AFP_CYAN = "#00AECB"
AFP_AMAR = "#E3E829"
AFP_GRIS = "#DCDDDE"
AFP_PLOMO = "#7E8083"
AFP_ROJO = "#C0392B"

# ==============================================================================
# 2) UTILIDADES
# ==============================================================================

def log(msg, level="INFO"):
    print(f"[{level}] {msg}")


def norm(s):
    """Normaliza texto para comparar: sin acentos, mayúsculas, espacios simples."""
    s = str(s or "").strip()
    s = "".join(c for c in unicodedata.normalize("NFD", s) if unicodedata.category(c) != "Mn")
    return re.sub(r"\s+", " ", s).upper()


def periodo_orden(periodo):
    """'1S25' -> (2025,1), '2S26' -> (2026,2). Sirve para ordenar cronológicamente."""
    m = re.match(r"([12])S(\d{2})", periodo)
    sem, yy = int(m.group(1)), int(m.group(2))
    return (2000 + yy, sem)


def periodo_siguiente_nombre(periodo):
    """Solo para etiquetas legibles: '1S25' -> 'Jun25', '2S25' -> 'Dic25'."""
    sem, yy = periodo[0], periodo[2:]
    return ("Jun" if sem == "1" else "Dic") + yy


def detect_header_row(df_raw, required_tokens, max_scan=12):
    """Busca, entre las primeras filas, la que contiene TODOS los required_tokens
    (comparados normalizados). Devuelve el índice de fila (0-based) o None."""
    req = [norm(t) for t in required_tokens]
    for i in range(min(max_scan, len(df_raw))):
        vals = {norm(v) for v in df_raw.iloc[i].tolist() if v is not None}
        if all(r in vals for r in req):
            return i
    return None


def find_input_files(input_dir):
    """Encuentra todos los 'Riesgos Climáticos - <sem><yy>.xlsx' en la carpeta,
    devuelve lista de (periodo, ruta) ordenada cronológicamente."""
    if not os.path.isdir(input_dir):
        raise SystemExit(
            f"No existe la carpeta INPUT_DIR:\n  {input_dir}\n"
            f"-> Edita INPUT_DIR al inicio del script (o la variable de entorno RF_EVOL_INPUT)."
        )
    out = []
    for path in glob.glob(os.path.join(input_dir, "*.xlsx")):
        m = FILE_PATTERN.search(os.path.basename(path))
        if not m:
            continue
        periodo = f"{m.group(1)}S{m.group(2)}"
        out.append((periodo, path))
    if not out:
        raise SystemExit(
            f"No se encontró ningún archivo 'Riesgos Climáticos - <sem><yy>.xlsx' en:\n"
            f"  {input_dir}\n-> Revisa INPUT_DIR y el patrón de nombre."
        )
    out.sort(key=lambda t: periodo_orden(t[0]))
    return out


# ==============================================================================
# 3) LECTURA DE LAS 4 HOJAS POR ARCHIVO
# ==============================================================================

def load_activos_por_empresa(path):
    raw = pd.read_excel(path, sheet_name="Activos por Empresa", header=None)
    hdr = detect_header_row(raw, ["Empresa", "Sector", "Plata del Activo (S/)"])
    if hdr is None:
        raise SystemExit(f"'{path}': no se ubicó el encabezado en 'Activos por Empresa'.")
    df = pd.read_excel(path, sheet_name="Activos por Empresa", header=hdr)
    df.columns = [str(c).strip() for c in df.columns]
    req = ["Empresa", "Sector", "AUM Total Empresa (S/)", "Plata del Activo (S/)"] + \
          [h["col"] for h in HAZARDS]
    faltan = [c for c in req if c not in df.columns]
    if faltan:
        raise SystemExit(f"'{path}': faltan columnas en 'Activos por Empresa': {faltan}")
    return df


def load_score_empresa(path):
    raw = pd.read_excel(path, sheet_name="Score por Empresa", header=None)
    hdr = detect_header_row(raw, ["Empresa", "Sector", "Score Global"])
    if hdr is None:
        raise SystemExit(f"'{path}': no se ubicó el encabezado en 'Score por Empresa'.")
    df = pd.read_excel(path, sheet_name="Score por Empresa", header=hdr)
    df.columns = [str(c).strip() for c in df.columns]
    mit_cols = [c for c in df.columns if norm(c).startswith("MITIGANTE")]
    if not mit_cols:
        raise SystemExit(f"'{path}': no se halló una columna 'Mitigante (...)' en 'Score por Empresa'.")
    df = df.rename(columns={mit_cols[0]: "Mitigante_ScorePorEmpresa"})
    return df


def load_score_sector(path):
    raw = pd.read_excel(path, sheet_name="Score por Sector", header=None)
    hdr = detect_header_row(raw, ["Sector", "Score Global"])
    if hdr is None:
        raise SystemExit(f"'{path}': no se ubicó el encabezado en 'Score por Sector'.")
    df = pd.read_excel(path, sheet_name="Score por Sector", header=hdr)
    df.columns = [str(c).strip() for c in df.columns]
    return df


def load_mitigantes(path):
    raw = pd.read_excel(path, sheet_name="Mitigantes", header=None)
    hdr = detect_header_row(raw, ["Empresa", "Mitigante"])
    if hdr is None:
        raise SystemExit(f"'{path}': no se ubicó el encabezado en 'Mitigantes'.")
    df = pd.read_excel(path, sheet_name="Mitigantes", header=hdr)
    df.columns = [str(c).strip() for c in df.columns]
    return df[["Empresa", "Mitigante"]].dropna(subset=["Empresa"])


def resolver_mitigante(empresa, mitigantes_df, score_empresa_row, periodo, sin_resolver):
    """Prioridad: hoja 'Mitigantes' (fuente canónica) -> fallback a la columna
    Mitigante de 'Score por Empresa' -> si nada calza, "\u2014" y se reporta."""
    buscar = EQUIV_MITIGANTE.get(empresa, empresa)
    fila = mitigantes_df[mitigantes_df["Empresa"].apply(norm) == norm(buscar)]
    if len(fila):
        val = str(fila.iloc[0]["Mitigante"]).strip()
        return val if val else "\u2014"
    if score_empresa_row is not None and pd.notna(score_empresa_row.get("Mitigante_ScorePorEmpresa")):
        return str(score_empresa_row["Mitigante_ScorePorEmpresa"]).strip()
    sin_resolver.add((periodo, empresa))
    return "\u2014"


# ==============================================================================
# 4) CONSTRUCCIÓN DEL PANEL (empresa / sector / portafolio) × PERIODO
# ==============================================================================

def montos_por_nivel(df_activos, group_col, hazard_col):
    """Devuelve {clave_grupo: {nivel(1..5 o 'ND'): monto S/}}. 'ND' agrupa
    cualquier score no interpretable como 1-5 (N/D, vacío, texto raro)."""
    def nivel(v):
        try:
            iv = int(float(v))
            return iv if iv in (1, 2, 3, 4, 5) else "ND"
        except (TypeError, ValueError):
            return "ND"
    tmp = df_activos.copy()
    tmp["_nivel"] = tmp[hazard_col].apply(nivel)
    out = {}
    for key, g in tmp.groupby(group_col):
        out[key] = g.groupby("_nivel")["Plata del Activo (S/)"].sum().to_dict()
    return out


def build_panel(files):
    """files: lista [(periodo, path), ...] ya ordenada cronológicamente.
    Devuelve: panel_emisor (list of dict), panel_sector (list of dict),
    panel_portafolio (list of dict), y advertencias acumuladas."""
    panel_emisor, panel_sector, panel_portafolio = [], [], []
    sin_resolver = set()
    brecha_mapeo = []  # (periodo, empresa, aum_reportado, aum_mapeado) cuando difieren

    for periodo, path in files:
        log(f"Leyendo {periodo}: {os.path.basename(path)}")
        act = load_activos_por_empresa(path)
        se = load_score_empresa(path)
        mit = load_mitigantes(path)

        se_idx = se.set_index("Empresa")

        # ---- por empresa: montos por nivel y por peligro ----
        # OJO: el total por peligro (total_h, abajo) se recalcula SUMANDO los
        # activos de "Activos por Empresa" fila por fila. Para varios emisores
        # esto NO coincide con la columna "AUM Total Empresa (S/)"/"AUM Total
        # (S/)" de Score por Empresa: parte de su AUM no tiene NINGÚN activo
        # geolocalizado ese semestre (líneas de negocio sin hoja de ubicación,
        # holdings sin distribución, etc. — mismo caso que Physical Risk 330
        # reporta como "se omite ese renglón"). Usamos el AUM REALMENTE
        # MAPEADO (suma de activos) como denominador de los %, para que
        # coincida exactamente con la Posición usada en el puente (chart 2);
        # la diferencia con el AUM reportado se registra como advertencia.
        montos_emp = {h["key"]: montos_por_nivel(act, "Empresa", h["col"]) for h in HAZARDS}
        aum_reportado_map = act.groupby("Empresa")["AUM Total Empresa (S/)"].first().to_dict()

        empresas = sorted(set(act["Empresa"]) | set(se["Empresa"]))
        for emp in empresas:
            sector = None
            if emp in act["Empresa"].values:
                sector = act.loc[act["Empresa"] == emp, "Sector"].iloc[0]
            elif emp in se_idx.index:
                sector = se_idx.loc[emp, "Sector"]
            se_row = se_idx.loc[emp].to_dict() if emp in se_idx.index else None
            mitigante = resolver_mitigante(emp, mit, se_row, periodo, sin_resolver)

            # AUM mapeado = suma de "Plata del Activo" para esta empresa (idéntico
            # sin importar qué peligro se use para agrupar, porque son las mismas
            # filas). Si la empresa no tiene NINGÚN activo, cae en 0.
            totales_por_hz = {h["key"]: sum(montos_emp[h["key"]].get(emp, {}).values()) for h in HAZARDS}
            aum_mapeado = max(totales_por_hz.values()) if totales_por_hz else 0.0
            aum_reportado = float(aum_reportado_map.get(emp, se_row.get("AUM Total (S/)", 0.0) if se_row else 0.0))
            if abs(aum_reportado - aum_mapeado) > max(1000.0, 0.01 * max(aum_reportado, 1.0)):
                brecha_mapeo.append((periodo, emp, round(aum_reportado, 2), round(aum_mapeado, 2)))

            row = {
                "periodo": periodo, "empresa": emp, "sector": sector,
                "aum_total": round(aum_mapeado, 2), "aum_reportado": round(aum_reportado, 2),
                "mitigante": mitigante,
                "score_global": (round(float(se_row["Score Global"]), 2)
                                 if se_row and pd.notna(se_row.get("Score Global")) else None),
            }
            for h in HAZARDS:
                niveles = montos_emp[h["key"]].get(emp, {})
                total_h = sum(niveles.values())
                alto_h = sum(v for k, v in niveles.items() if k in NIVELES_ALTOS)
                row[f"aum_{h['key']}_total"] = round(total_h, 2)
                row[f"aum_{h['key']}_alto"] = round(alto_h, 2)
                row[f"pct_{h['key']}_alto"] = round(alto_h / total_h, 8) if total_h > 0 else None
                for niv in (1, 2, 3, 4, 5, "ND"):
                    row[f"{h['key']}_niv_{niv}"] = round(niveles.get(niv, 0.0), 2)
            panel_emisor.append(row)

        # ---- por sector: se agrega el mismo 'Activos por Empresa' por Sector ----
        montos_sec = {h["key"]: montos_por_nivel(act, "Sector", h["col"]) for h in HAZARDS}
        aum_sector_map = act.groupby("Sector")["Plata del Activo (S/)"].sum().to_dict()
        for sector, aum_sec in aum_sector_map.items():
            row = {"periodo": periodo, "sector": sector, "aum_total": round(float(aum_sec), 2)}
            for h in HAZARDS:
                niveles = montos_sec[h["key"]].get(sector, {})
                total_h = sum(niveles.values())
                alto_h = sum(v for k, v in niveles.items() if k in NIVELES_ALTOS)
                row[f"aum_{h['key']}_total"] = round(total_h, 2)
                row[f"aum_{h['key']}_alto"] = round(alto_h, 2)
                row[f"pct_{h['key']}_alto"] = round(alto_h / total_h, 8) if total_h > 0 else None
            panel_sector.append(row)

        # ---- portafolio total (denominador único por periodo y peligro) ----
        row = {"periodo": periodo, "aum_mapeado": round(float(act["Plata del Activo (S/)"].sum()), 2)}
        emp_mit = {r["empresa"]: r["mitigante"] for r in panel_emisor if r["periodo"] == periodo}
        for h in HAZARDS:
            niveles_port = montos_por_nivel(act.assign(_all=1), "_all", h["col"]).get(1, {})
            total_h = sum(niveles_port.values())
            valido_h = sum(v for k, v in niveles_port.items() if k != "ND")
            alto_h = sum(v for k, v in niveles_port.items() if k in NIVELES_ALTOS)
            # no mitigada = AUM en 4-5 de empresas cuyo mitigante NO cubre
            no_mit = 0.0
            for emp, montos in montos_emp[h["key"]].items():
                alto_emp = sum(v for k, v in montos.items() if k in NIVELES_ALTOS)
                if emp_mit.get(emp, "\u2014") in MITIGANTES_NO_CUBRE:
                    no_mit += alto_emp
            row[f"{h['key']}_total"] = round(total_h, 2)
            row[f"{h['key']}_valido"] = round(valido_h, 2)
            row[f"{h['key']}_alto"] = round(alto_h, 2)
            row[f"{h['key']}_no_mitigada"] = round(no_mit, 2)
            row[f"{h['key']}_pct_alto"] = round(alto_h / total_h, 8) if total_h > 0 else 0.0
            row[f"{h['key']}_pct_no_mitigada"] = round(no_mit / total_h, 8) if total_h > 0 else 0.0
            row[f"{h['key']}_pct_cobertura"] = round(valido_h / total_h, 8) if total_h > 0 else 0.0
            for niv in (1, 2, 3, 4, 5, "ND"):
                row[f"{h['key']}_niv_{niv}"] = round(niveles_port.get(niv, 0.0), 2)
        panel_portafolio.append(row)

    if sin_resolver:
        log(f"{len(sin_resolver)} par(es) empresa-periodo sin mitigante resuelto "
            f"(se muestran como \u2014; revisa EQUIV_MITIGANTE o la hoja 'Mitigantes'):", "WARN")
        for periodo, emp in sorted(sin_resolver):
            log(f"      {periodo}: '{emp}'", "WARN")

    if brecha_mapeo:
        log(f"{len(brecha_mapeo)} caso(s) donde el AUM reportado (Score por Empresa) "
            f"no coincide con el AUM realmente mapeado a un activo físico (Activos por "
            f"Empresa). Este panel usa el AUM MAPEADO como denominador de los %; la "
            f"diferencia es AUM sin geolocalizar ese semestre (revisa 'Activos sin "
            f"Ubigeo' / Holdings en Physical Risk 330 si la brecha te preocupa):", "WARN")
        for periodo, emp, rep, mapeado in brecha_mapeo:
            log(f"      {periodo}: '{emp}' — reportado S/ {rep:,.0f} vs. mapeado S/ {mapeado:,.0f}", "WARN")

    return panel_emisor, panel_sector, panel_portafolio


# ==============================================================================
# 5) EXPORTAR PANEL A EXCEL (auditoría — "no black box")
# ==============================================================================

def export_panel_excel(out_path, panel_emisor, panel_sector, panel_portafolio):
    with pd.ExcelWriter(out_path, engine="openpyxl") as xw:
        pd.DataFrame(panel_emisor).to_excel(xw, sheet_name="Panel Emisor", index=False)
        pd.DataFrame(panel_sector).to_excel(xw, sheet_name="Panel Sector", index=False)
        pd.DataFrame(panel_portafolio).to_excel(xw, sheet_name="Panel Portafolio", index=False)
    log(f"Panel de auditoría exportado: {out_path}")


