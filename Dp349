let CH1=null;
function renderChart1(){
  const hz = document.getElementById("selHazard1").value;
  const hzLabel = HAZ.find(h=>h.key===hz).label;
  document.getElementById("c1title").textContent = "1. Exposición alta vs. no mitigada — " + hzLabel;
  const bruto = PERIODOS.map(p => (PORTAFOLIO[p][hz].pct_alto||0)*100);
  const noMit = PERIODOS.map(p => (PORTAFOLIO[p][hz].pct_no_mitigada||0)*100);
  const labels = PERIODOS.map(p=>PLABEL[p]);
  if(CH1) CH1.destroy();
  CH1 = new Chart(document.getElementById("chart1"), {
    type:"line",
    data:{labels, datasets:[
      {label:"AUM en 4-5 (bruto)", data:bruto, borderColor:AFP.azul, backgroundColor:AFP.azul, borderWidth:2, pointRadius:4, tension:0},
      {label:"Sin mitigante Alto/Medio", data:noMit, borderColor:AFP.rojo, backgroundColor:AFP.rojo, borderWidth:2, pointRadius:4, tension:0, borderDash:[5,3]},
    ]},
    options:{responsive:true, maintainAspectRatio:false,
      plugins:{legend:{display:false},
        tooltip:{callbacks:{label:c=>c.dataset.label+": "+c.parsed.y.toFixed(1)+"%"}}},
      scales:{y:{title:{display:true,text:"% del AUM mapeado"},ticks:{callback:v=>v+"%"}}}}
  });
  const cov = PERIODOS.map(p => (PORTAFOLIO[p][hz].pct_cobertura||0)*100);
  document.getElementById("cov1").innerHTML =
    '<div style="font-size:11px;color:var(--plomo);margin-top:10px">Cobertura de score CENEPRED (AUM con score 1-5 / AUM mapeado)</div>' +
    '<div class="covstrip">' + PERIODOS.map((p,i)=>
      `<div class="covseg" style="flex:1;background:${AFP.gris}"><div style="width:${cov[i]}%;height:100%;background:${AFP.cyan};border-radius:2px"></div></div>`
    ).join("") + '</div>' +
    '<div style="display:flex;font-size:10px;color:var(--plomo);margin-top:3px">' +
      PERIODOS.map((p,i)=>`<div style="flex:1;text-align:center">${PLABEL[p]}: ${cov[i].toFixed(0)}%</div>`).join("") + '</div>';
}
document.getElementById("selHazard1").onchange = renderChart1;

// ---------------------------------------------------------------
// CHART 2 — puente entre dos cortes
// ---------------------------------------------------------------
function pares(){
  const out=[];
  for(let i=0;i<PERIODOS.length-1;i++) out.push([PERIODOS[i],PERIODOS[i+1]]);
  return out;
}
const PARES = pares();
document.getElementById("selPar2").innerHTML = PARES.map((pr,i)=>
  `<option value="${i}">${PLABEL[pr[0]]} → ${PLABEL[pr[1]]}</option>`).join("");
document.getElementById("selPar2").selectedIndex = PARES.length-1;

let CH2=null;
function calcPuente(p0, p1, hz){
  const e0 = EMISOR[p0]||{}, e1 = EMISOR[p1]||{};
  const emp0 = new Set(Object.keys(e0)), emp1 = new Set(Object.keys(e1));
  let tam=0, huella=0, altas=0, bajas=0;
  emp1.forEach(e=>{ if(!emp0.has(e)) altas += (e1[e][hz].aum_alto||0); });
  emp0.forEach(e=>{ if(!emp1.has(e)) bajas -= (e0[e][hz].aum_alto||0); });
  emp0.forEach(e=>{
    if(!emp1.has(e)) return;
    const a0=e0[e].aum_total||0, a1=e1[e].aum_total||0;
    const pc0=e0[e][hz].pct_alto||0, pc1=e1[e][hz].pct_alto||0;
    tam += (a1-a0)*pc0;
    huella += a1*(pc1-pc0);
  });
  const inicio = PORTAFOLIO[p0][hz].aum_alto||0;
  const fin = PORTAFOLIO[p1][hz].aum_alto||0;
  return {inicio, tam, huella, altas, bajas, fin};
}
function renderChart2(){
  const hz = document.getElementById("selHazard2").value;
  const hzLabel = HAZ.find(h=>h.key===hz).label;
  const [p0,p1] = PARES[document.getElementById("selPar2").value];
  document.getElementById("c2title").textContent =
    `2. Puente ${PLABEL[p0]} → ${PLABEL[p1]} — ${hzLabel}`;
  const b = calcPuente(p0,p1,hz);
  const M = v => v/1e6;
  const labels=["Inicio","Tamaño\n(AUM)","Huella /\nreclasif.","Emisores\nnuevos","Emisores\nque salieron","Fin"];
  const vals=[M(b.inicio), M(b.tam), M(b.huella), M(b.altas), M(b.bajas), M(b.fin)];
  // floating bars para que se vea como puente
  let acc=0; const floats=[];
  for(let i=0;i<vals.length;i++){
    if(i===0||i===vals.length-1){ floats.push([0, vals[i]]); acc=vals[i]; }
    else{ const from=acc; acc+=vals[i]; floats.push([Math.min(from,acc), Math.max(from,acc)]); }
  }
  const colors = vals.map((v,i)=> (i===0||i===vals.length-1) ? AFP.plomo : (v>=0?AFP.rojo:"#1D9E75"));
  if(CH2) CH2.destroy();
  CH2 = new Chart(document.getElementById("chart2"), {
    type:"bar",
    data:{labels, datasets:[{data:floats, backgroundColor:colors, borderRadius:4}]},
    options:{responsive:true, maintainAspectRatio:false,
      plugins:{legend:{display:false},
        tooltip:{callbacks:{label:c=>{
          const i=c.dataIndex;
          if(i===0||i===labels.length-1) return "S/ "+(vals[i]).toFixed(1)+" mm";
          const signo = vals[i]>=0?"+":"";
          return signo+vals[i].toFixed(1)+" mm S/";
        }}}},
      scales:{y:{title:{display:true,text:"AUM en niveles 4-5 (S/ millones)"}}}}
  });
}
document.getElementById("selHazard2").onchange = renderChart2;
document.getElementById("selPar2").onchange = renderChart2;

// ---------------------------------------------------------------
// CHART 3 — heatmap emisor/sector x periodo
// ---------------------------------------------------------------
function shade(pct){ // 0..1 -> azul claro..azul oscuro (secuencial, una sola rampa)
  if(pct==null) return "#F1EFE8";
  const k = Math.max(0, Math.min(1, pct));
  const c0=[230,241,251], c1=[4,44,83];
  const rgb = c0.map((v,i)=>Math.round(v+(c1[i]-v)*k));
  return `rgb(${rgb.join(",")})`;
}
function textOn(pct){ return (pct!=null && pct>0.55) ? "#fff" : "var(--texto)"; }

function renderChart3(){
  const hz = document.getElementById("selHazard3").value;
  const hzLabel = HAZ.find(h=>h.key===hz).label;
  const vista = document.getElementById("selVista3").value;
  document.getElementById("c3title").textContent =
    "3. " + (vista==="emisor"?"Emisores":"Sectores") + " por corte — " + hzLabel;
  const SRC = vista==="emisor" ? EMISOR : SECTOR;
  const ultimo = PERIODOS[PERIODOS.length-1];
  const prev = PERIODOS.length>1 ? PERIODOS[PERIODOS.length-2] : null;
  const claves = Object.keys(SRC[ultimo]||{});
  claves.sort((a,b)=> (SRC[ultimo][b][hz].pct_alto||0) - (SRC[ultimo][a][hz].pct_alto||0));

  let html = '<table class="heat"><thead><tr><th style="text-align:left">'+
    (vista==="emisor"?"Emisor":"Sector") + '</th>';
  PERIODOS.forEach(p=> html += `<th>${PLABEL[p]}</th>`);
  html += '<th>Δ último</th>';
  if(vista==="emisor"){ html += '<th>AUM mapeado (S/)</th><th>Mitigante</th>'; }
  html += '</tr></thead><tbody>';

  claves.forEach(k=>{
    html += `<tr><td class="nom">${k}</td>`;
    PERIODOS.forEach(p=>{
      const rec = (SRC[p]||{})[k];
      const pct = rec ? rec[hz].pct_alto : null;
      const bg = shade(pct); const fg = textOn(pct);
      html += `<td style="background:${bg};color:${fg}">${pct==null?"—":(pct*100).toFixed(0)+"%"}</td>`;
    });
    const rU = (SRC[ultimo]||{})[k], rP = prev ? (SRC[prev]||{})[k] : null;
    const pu = rU ? rU[hz].pct_alto : null, pp = rP ? rP[hz].pct_alto : null;
    let delta = "—";
    if(pu!=null && pp!=null) delta = ((pu-pp)*100>=0?"+":"") + ((pu-pp)*100).toFixed(1)+" pp";
    html += `<td>${delta}</td>`;
    if(vista==="emisor"){
      const info = EMP_ACTUAL[k] || {};
      const mit = info.mitigante || "—";
      const mitbg = mit==="Alto"?"#EAF3DE":mit==="Medio"?"#FAEEDA":mit==="Bajo"?"#FCEBEB":"transparent";
      html += `<td>${fmtS(info.aum_total)}</td><td class="mit" style="background:${mitbg}">${mit}</td>`;
    }
    html += '</tr>';
  });
  html += '</tbody></table>';
  document.getElementById("heatwrap").innerHTML = html;
  document.getElementById("leg3").innerHTML =
    '<span><span class="dot" style="background:'+shade(0.05)+'"></span>Bajo % en niveles 4-5</span>'+
    '<span><span class="dot" style="background:'+shade(0.9)+'"></span>Alto % en niveles 4-5</span>'+
    '<span><span class="dot" style="background:#F1EFE8;border:1px solid var(--linea)"></span>Sin AUM mapeado ese corte</span>';
}
document.getElementById("selHazard3").onchange = renderChart3;
document.getElementById("selVista3").onchange = renderChart3;

renderChart1(); renderChart2(); renderChart3();
</script>
</body>
</html>"""


def build_payload(panel_emisor, panel_sector, panel_portafolio, periodos):
    periodo_label = {p: periodo_siguiente_nombre(p) for p in periodos}

    portafolio = {}
    for r in panel_portafolio:
        p = r["periodo"]
        portafolio.setdefault(p, {})
        for h in HAZARDS:
            k = h["key"]
            portafolio[p][k] = {
                "pct_alto": r.get(f"{k}_pct_alto"),
                "pct_no_mitigada": r.get(f"{k}_pct_no_mitigada"),
                "pct_cobertura": r.get(f"{k}_pct_cobertura"),
                "aum_alto": r.get(f"{k}_alto"),
            }

    emisor = {}
    emp_actual = {}
    ultimo = periodos[-1]
    for r in panel_emisor:
        p = r["periodo"]
        emisor.setdefault(p, {})
        emisor[p][r["empresa"]] = {
            "aum_total": r["aum_total"],
            **{h["key"]: {"pct_alto": r.get(f"pct_{h['key']}_alto"),
                          "aum_alto": r.get(f"aum_{h['key']}_alto")} for h in HAZARDS}
        }
        if p == ultimo:
            emp_actual[r["empresa"]] = {
                "sector": r["sector"], "aum_total": r["aum_total"], "mitigante": r["mitigante"],
            }

    sector = {}
    for r in panel_sector:
        p = r["periodo"]
        sector.setdefault(p, {})
        sector[p][r["sector"]] = {
            "aum_total": r["aum_total"],
            **{h["key"]: {"pct_alto": r.get(f"pct_{h['key']}_alto"),
                          "aum_alto": r.get(f"aum_{h['key']}_alto")} for h in HAZARDS}
        }

    return {
        "generado": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "hazards": [{"key": h["key"], "label": h["label"]} for h in HAZARDS],
        "periodos": periodos,
        "periodo_label": periodo_label,
        "portafolio": portafolio,
        "emisor": emisor,
        "sector": sector,
        "emp_actual": emp_actual,
    }


def export_html(out_path, payload):
    html = _HTML_TEMPLATE
    html = html.replace("__PAYLOAD__", json.dumps(payload, ensure_ascii=False))
    html = html.replace("__GENERADO__", payload["generado"])
    for tag, val in [("__AZUL__", AFP_AZUL), ("__CYAN__", AFP_CYAN), ("__AMAR__", AFP_AMAR),
                      ("__GRIS__", AFP_GRIS), ("__PLOMO__", AFP_PLOMO), ("__ROJO__", AFP_ROJO)]:
        html = html.replace(tag, val)
    with open(out_path, "w", encoding="utf-8") as fh:
        fh.write(html)
    log(f"HTML generado: {out_path}")


# ==============================================================================
# 7) MAIN
# ==============================================================================

def main():
    log("=" * 60)
    log("EVOLUCIÓN HISTÓRICA DEL RIESGO FÍSICO — INICIO")
    log("=" * 60)

    files = find_input_files(INPUT_DIR)
    log(f"{len(files)} archivo(s) encontrado(s): {[p for p, _ in files]}")
    if len(files) < 2:
        log("Con un solo corte los 3 gráficos no aportan (necesitas al menos 2 periodos "
            "para el puente, y se recomiendan 3+ para la línea y el heatmap).", "WARN")

    panel_emisor, panel_sector, panel_portafolio = build_panel(files)
    periodos = [p for p, _ in files]

    os.makedirs(OUT_DIR, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d_%H%M")

    xlsx_out = os.path.join(OUT_DIR, f"Panel_Evolucion_Riesgo_Fisico_{stamp}.xlsx")
    export_panel_excel(xlsx_out, panel_emisor, panel_sector, panel_portafolio)

    payload = build_payload(panel_emisor, panel_sector, panel_portafolio, periodos)
    html_out = os.path.join(OUT_DIR, f"Evolucion_Riesgo_Fisico_{stamp}.html")
    export_html(html_out, payload)

    log("=" * 60)
    log("PROCESO COMPLETADO")
    log("=" * 60)
    return html_out, xlsx_out


if __name__ == "__main__":
    main()
