# Carpeta donde viven los "Riesgos Climáticos - <sem><yy>.xlsx" (la misma
# carpeta OUT_DIR de Physical Risk 330). Cambia esta ruta por la tuya.
INPUT_DIR = os.environ.get(
    "RF_EVOL_INPUT",
    r"Z:\Mesa de Inversiones\Bottom-Up\2 Proceso de Inversión Renta Fija\Corporates - Emisiones\Crédito - BU\3. ESG\21. TCFD\Reporte TCFD\Reporte TCFD\Mapeo de Distribución de Distritos - Riesgos Fisicos\Python\Output",
)

# Carpeta de salida (HTML + Excel de auditoría).
