def _nombre_col(c) -> str:
    """Nombres de columna siempre como texto (300011100001.0 / int → '300011100001')."""
    if isinstance(c, float) and c.is_integer():
        return str(int(c))
    return str(c).strip()


def _dia_fondo_fecha(serie: pd.Series) -> pd.Series:
    """Saca el día dd/mm/aaaa que va después del '_' en Fondo_Fecha."""
    suf = serie.astype(str).str.split("_", n=1).str[-1].str.strip()
    return pd.to_datetime(suf, format="%d/%m/%Y", errors="coerce")
```

