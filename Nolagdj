```javascript

// ---- posición (S/) del emisor en instrumentos "directo - Local", según la
// pestaña activa (Resumen = TOTAL; RV = Equity directo; RF = Deuda directa).
// Fuente: Clasificación ERR — independiente de EXP_CLASE/TIPO_RENTA.
function posKey(){ return TAB==='rv' ? 'RENTA VARIABLE' : TAB==='rf' ? 'RENTA FIJA' : 'TOTAL'; }
function posicionEmisor(emisor){
  const p = POSICION[emisor];
  return p ? (p[posKey()]||0) : 0;
}
function posicionEmisores(lista){
  return lista.reduce((s,e)=>s+posicionEmisor(e), 0);
}
const celPos = v => '<td class="num" style="text-align:right">'+fmtMonto(v)+'</td>';
```

