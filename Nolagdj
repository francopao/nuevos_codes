### EDIT 1 (Python) — nueva función de carga

**Ctrl+F:** `def load_enfen():`  → esto está en la línea **3222**. Pega el siguiente bloque **justo antes**, dejando 2 líneas en blanco como separador (mismo estilo que el resto del archivo):

```python
def load_posicion_directa_local(risk_path, sheet, equiv_canonico=None):
    """Lee 'Valorización de Instrumentos' y calcula, por emisor canónico, la
    POSICIÓN (S/) en instrumentos 'directo - Local' según la columna
    'Clasificación ERR' (buscada dinámicamente, mismo criterio que
    ERR_OBJETIVO en la hoja 'Cobertura' de generar_excel_tabla_resumen):
      - 'EQUITY DIRECTO - LOCAL'            -> clase RENTA VARIABLE
      - 'DEUDA CORPORATIVA DIRECTA - LOCAL' -> clase RENTA FIJA
    Devuelve {emisor_canónico: {'RENTA VARIABLE': x, 'RENTA FIJA': y,
    'TOTAL': x+y}}. A diferencia de exp_clase (que clasifica por TIPO_RENTA
    y agrupa TODA la cartera del emisor), aquí solo se suman esas dos
    clasificaciones ERR puntuales; alimenta la columna 'Posición' del
    dashboard HTML."""
    ERR_A_CLASE = {"EQUITY DIRECTO - LOCAL": "RENTA VARIABLE",
                   "DEUDA CORPORATIVA DIRECTA - LOCAL": "RENTA FIJA"}
    equiv_canonico = equiv_canonico or _equiv_exposicion_all()

    raw = pd.read_excel(risk_path, sheet_name=sheet, header=None)
    hdr_row, _ = detect_header_row(raw, ["Nombre (G&P)", "VALOR_VECTOR_LOCAL"],
                                   max_scan=10)
    df = pd.read_excel(risk_path, sheet_name=sheet, header=hdr_row).dropna(how="all")
    spec = {"nombre": (["Nombre (G&P)", "Nombre G P", "Nombre"], "AE"),
            "valor":  (["VALOR_VECTOR_LOCAL", "VALOR VECTOR LOCAL"], "K"),
            "err":    (["Clasificación ERR", "Clasificacion ERR", "ERR"], "AA")}
    cols = resolve_columns(df.columns, spec)
    df = df.rename(columns={cols["nombre"]: "nombre", cols["valor"]: "valor",
                            cols["err"]: "err"})
    df["valor"] = pd.to_numeric(df["valor"], errors="coerce").fillna(0.0)
    df["_errn"] = df["err"].astype(str).str.strip().apply(norm)

    err_norm_a_clase = {norm(k): v for k, v in ERR_A_CLASE.items()}
    eq_norm = {norm(k): v for k, v in equiv_canonico.items()}
    df["emisor"] = df["nombre"].apply(lambda n: eq_norm.get(norm(n)))

    posicion = {}
    for _, r in df.dropna(subset=["emisor"]).iterrows():
        clase = err_norm_a_clase.get(r["_errn"])
        if clase is None:
            continue
        d = posicion.setdefault(r["emisor"], {"RENTA VARIABLE": 0.0,
                                              "RENTA FIJA": 0.0, "TOTAL": 0.0})
        d[clase] += r["valor"]
        d["TOTAL"] += r["valor"]
    for k in posicion:
        for kk in posicion[k]:
            posicion[k][kk] = round(posicion[k][kk], 2)
    return posicion


```

