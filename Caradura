```python
###############################################################################
#                                                                             #
#   MÓDULO 15 — EXPORTADOR EXCEL NATIVO (Datos_Graficos_Huella)              #
#   Base de datos maestra (tidy) por chart, para que el usuario arme sus     #
#   propias Tablas Dinámicas / Slicers / gráficos nativos en Excel.          #
#   Se apoya en el mismo HISTORICO largo que consume el Dashboard (M14).     #
###############################################################################

NOMBRE_HOJA_SOBERANOS_HUELLA = "Huella Soberanos"
NOMBRE_HOJA_SOBERANOS_INT = "Intensidad Soberanos"
NOMBRE_HOJA_SECTOR_HUELLA = "Huella por Sector"
NOMBRE_HOJA_SECTOR_INT = "Intensidad por Sector"
NOMBRE_HOJA_ASSET_PERF = "Intensidad FFMM"
NOMBRE_HOJA_COMP_BENCH = "Intensidad y Benchmarks"
NOMBRE_HOJA_CONTRIB_BUTD = "Mayores contribuyentes"
NOMBRE_HOJA_AUDITORIA = "Auditoría"


def _corte_rol_map(cortes: list) -> tuple:
    """Mismo criterio que el Dashboard (M14) para marcar el par por
    defecto: corte más reciente = 'Actual', su T-1 (o el segundo más
    reciente si no existe T-1) = 'Comparación'."""
    cortes_ord = sorted(cortes, reverse=True)
    corte_actual = cortes_ord[0]
    comp_default = _semestre_anterior(corte_actual)
    if comp_default not in cortes_ord:
        comp_default = cortes_ord[1] if len(cortes_ord) > 1 else corte_actual
    rol = {c: "" for c in cortes_ord}
    rol[corte_actual] = "Actual"
    rol[comp_default] = "Comparación"
    return corte_actual, comp_default, rol


def _tabla_soberanos(hist: pd.DataFrame, metrica: str, rol_map: dict) -> pd.DataFrame:
    df = hist[(hist["OBJETO"] == "Soberanos") & (hist["METRICA"] == metrica)
              & (hist["DIM_1"] != "")].copy()
    df["Pais"] = df["DIM_1"].map(lambda n: PAIS_POR_EMISOR_SOBERANO.get(n, n))
    df = df.rename(columns={"FECHA_CORTE": "Corte", "DIM_1": "Emisor", "VALOR": "Valor"})
    df["Metrica"] = metrica
    df["Corte_Rol"] = df["Corte"].map(rol_map).fillna("")
    return df[["Corte", "Corte_Rol", "AFP", "Pais", "Emisor", "Metrica", "Valor"]] \
             .sort_values(["Corte", "AFP", "Pais", "Emisor"], ignore_index=True)


def _tabla_sector(hist: pd.DataFrame, metrica: str, rol_map: dict) -> pd.DataFrame:
    df = hist[(hist["OBJETO"] == "Sector_MSCI_Proxies") & (hist["METRICA"] == metrica)].copy()
    df = df.rename(columns={"FECHA_CORTE": "Corte", "DIM_1": "Categoria",
                             "DIM_2": "Tipo_Dato", "VALOR": "Valor"})
    df["Metrica"] = metrica
    df["Corte_Rol"] = df["Corte"].map(rol_map).fillna("")
    return df[["Corte", "Corte_Rol", "AFP", "Categoria", "Tipo_Dato", "Metrica", "Valor"]] \
             .sort_values(["Corte", "AFP", "Categoria", "Tipo_Dato"], ignore_index=True)


def _tabla_asset_perf(hist: pd.DataFrame, rol_map: dict, corte_actual: str,
                       bench_ffmm: dict) -> pd.DataFrame:
    df = hist[(hist["OBJETO"] == "TopSubCat_Asset") &
              (hist["METRICA"].isin(["Intensidad", "Weight"]))].copy()
    filas = []
    for _, r in df.iterrows():
        dim1, dim2, dim3 = r["DIM_1"], r["DIM_2"], r["DIM_3"]
        if dim1 in ("_BENCH_", "_BENCH_SUBCAT_", "_BENCH_SUBCAT_UNADJ_"):
            if r["METRICA"] != "Intensidad":
                continue
            tipo = {"_BENCH_": "Escalar_Portafolio",
                    "_BENCH_SUBCAT_": "Comparables_Subcat_Ajustado (x Weight del instrumento)",
                    "_BENCH_SUBCAT_UNADJ_": "Comparables_Subcat_SinAjustar"}[dim1]
            bloque_ref, _, subcat_ref = str(dim2).partition("|")
            filas.append({
                "Corte": r["FECHA_CORTE"], "AFP": r["AFP"], "Tipo_Fila": "Benchmark",
                "Bloque": bloque_ref if dim1 != "_BENCH_" else "",
                "Gestion": "", "Instrumento": "",
                "SubCategoria": subcat_ref if dim1 != "_BENCH_" else "",
                "Benchmark_Tipo": tipo,
                "Benchmark_Nombre": dim2 if dim1 == "_BENCH_" else "",
                "Metrica": "Intensidad", "Valor": r["VALOR"],
            })
        else:
            mgmt, _, nombre = str(dim2).partition("|")
            filas.append({
                "Corte": r["FECHA_CORTE"], "AFP": r["AFP"], "Tipo_Fila": "Instrumento",
                "Bloque": dim1,
                "Gestion": {"A": "Active", "P": "Passive"}.get(mgmt, mgmt),
                "Instrumento": nombre, "SubCategoria": dim3,
                "Benchmark_Tipo": "", "Benchmark_Nombre": "",
                "Metrica": r["METRICA"], "Valor": r["VALOR"],
            })
    for fondo, fce in bench_ffmm.items():
        filas.append({
            "Corte": corte_actual, "AFP": "", "Tipo_Fila": "Benchmark",
            "Bloque": "", "Gestion": "", "Instrumento": "", "SubCategoria": "",
            "Benchmark_Tipo": "FFMM (x Weight del instrumento)", "Benchmark_Nombre": fondo,
            "Metrica": "Intensidad", "Valor": fce,
        })
    out = pd.DataFrame(filas)
    if out.empty:
        return out
    out["Corte_Rol"] = out["Corte"].map(rol_map).fillna("")
    cols = ["Corte", "Corte_Rol", "AFP", "Tipo_Fila", "Bloque", "Gestion", "Instrumento",
            "SubCategoria", "Benchmark_Tipo", "Benchmark_Nombre", "Metrica", "Valor"]
    return out[cols].sort_values(["Corte", "Tipo_Fila", "Bloque", "Instrumento"], ignore_index=True)


def _tabla_comp_bench_afp(hist: pd.DataFrame, rol_map: dict) -> pd.DataFrame:
    filas = []
    d1 = hist[(hist["OBJETO"] == "Sector_MSCI_Proxies") & (hist["METRICA"] == "Intensidad")
              & (hist["AFP"].isin(["Integra", "Prima", "Profuturo", "Habitat"]))]
    for _, r in d1.iterrows():
        filas.append({"Corte": r["FECHA_CORTE"], "AFP": r["AFP"], "Segmento": "AFP_Categoria",
                      "Categoria": r["DIM_1"], "Tipo_Dato": r["DIM_2"], "Pais": "",
                      "Emisor": "", "Benchmark_Nombre": "", "Metrica": "Intensidad",
                      "Valor": r["VALOR"]})
    d2 = hist[(hist["OBJETO"] == "Comparables") & (hist["METRICA"] == "Intensidad")
              & (hist["AFP"] == "Integra") & (hist["DIM_1"].isin(["ACWI", "ILF", "CEMB", "EMB"]))]
    for _, r in d2.iterrows():
        filas.append({"Corte": r["FECHA_CORTE"], "AFP": "", "Segmento": "Benchmark_Mercado",
                      "Categoria": "", "Tipo_Dato": "", "Pais": "", "Emisor": "",
                      "Benchmark_Nombre": r["DIM_1"], "Metrica": "Intensidad",
                      "Valor": r["VALOR"]})
    d3 = hist[(hist["OBJETO"] == "Soberanos") & (hist["METRICA"] == "Intensidad")
              & (hist["AFP"] == "Integra") & (hist["DIM_1"] != "")]
    for _, r in d3.iterrows():
        filas.append({"Corte": r["FECHA_CORTE"], "AFP": "Integra", "Segmento": "Soberano_GOB",
                      "Categoria": "", "Tipo_Dato": "",
                      "Pais": PAIS_POR_EMISOR_SOBERANO.get(r["DIM_1"], r["DIM_1"]),
                      "Emisor": r["DIM_1"], "Benchmark_Nombre": "", "Metrica": "Intensidad",
                      "Valor": r["VALOR"]})
    out = pd.DataFrame(filas)
    if out.empty:
        return out
    out["Corte_Rol"] = out["Corte"].map(rol_map).fillna("")
    cols = ["Corte", "Corte_Rol", "AFP", "Segmento", "Categoria", "Tipo_Dato", "Pais",
            "Emisor", "Benchmark_Nombre", "Metrica", "Valor"]
    return out[cols].sort_values(["Corte", "Segmento"], ignore_index=True)


def _tabla_contrib_butd(hist: pd.DataFrame, rol_map: dict) -> pd.DataFrame:
    df = hist[(hist["OBJETO"] == "Contrib_Variacion_Intensidad") & (hist["DIM_1"] != "")].copy()
    df = df.rename(columns={"FECHA_CORTE": "Corte", "DIM_1": "Emisor",
                             "METRICA": "Metrica", "VALOR": "Valor"})
    df["Corte_Rol"] = df["Corte"].map(rol_map).fillna("")
    return df[["Corte", "Corte_Rol", "AFP", "Emisor", "Metrica", "Valor"]] \
             .sort_values(["Corte", "AFP", "Emisor"], ignore_index=True)


