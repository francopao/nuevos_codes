```javascript
// --- Chart ejecutivo Soberanos: Total -> Variación -> Emisores (por país) --
function paisDeEmisor(nombre){
  return CFG.pais_por_emisor[nombre] || nombre;
}

function serieSoberanosPorPais(metrica, corte, afp){
  const raw = serieCategoriaAfp('Soberanos', metrica, corte, afp); // Map(Nombre -> valor)
  const out = new Map();
  raw.forEach((v, nombre) => {
    const pais = paisDeEmisor(nombre);
    out.set(pais, (out.get(pais) || 0) + v);
  });
  return out;
}

function soberanosEjecutivo(div, metrica, cAct, cCmp, afp){
  const mCmp = serieSoberanosPorPais(metrica, cCmp, afp);
  const mAct = serieSoberanosPorPais(metrica, cAct, afp);
  const ordenPais = CFG.orden_paises;

  const keys = Array.from(new Set([...mCmp.keys(), ...mAct.keys()]))
    .filter(k => Math.abs(mCmp.get(k)||0) > 1e-9 || Math.abs(mAct.get(k)||0) > 1e-9)
    .sort((x, y) => {
      const ix = ordenPais.indexOf(x), iy = ordenPais.indexOf(y);
      const rx = ix < 0 ? 999 : ix, ry = iy < 0 ? 999 : iy;
      if (rx !== ry) return rx - ry;
      return ((mCmp.get(y)||0)+(mAct.get(y)||0)) - ((mCmp.get(x)||0)+(mAct.get(x)||0));
    });

  const cumCmp = _cumulativos(mCmp, keys);
  const cumAct = _cumulativos(mAct, keys);
  const etiqCmp = etiquetaCorte(cCmp), etiqAct = etiquetaCorte(cAct);

  const colorPais = (k, i) =>
    CFG.colores_pais[k] || CFG.colores_pais_fallback[i % CFG.colores_pais_fallback.length];

  const traces = keys.map((k, i) => ({
    type:'bar', name:k, showlegend:false, hoverinfo:'skip',
    x:[etiqCmp, etiqAct],
    y:[mCmp.get(k)||0, mAct.get(k)||0],
    marker: {color: colorPais(k, i), line:{color:'#FFFFFF', width:0.5}}
  }));

  const UMBRAL_LABEL = 0.025; // no etiquetar segmentos < 2.5% del total
  const etiquetasInternas = (cum, xEtq) => keys
    .filter(k => cum.total && (cum.porKey[k].v / cum.total) >= UMBRAL_LABEL)
    .map(k => ({
      x: xEtq, y:(cum.porKey[k].y0 + cum.porKey[k].y1)/2, xref:'x', yref:'y',
      text: k, showarrow:false,
      font:{size:9.5, color: CFG.color_texto}
    }));

  const totB = cumCmp.total, totA = cumAct.total;
  const varPct = totB ? (totA/totB - 1) : null;
  const colorVar = varPct===null ? CFG.color_texto : (varPct<0 ? '#1B8F5A' : '#C0392B');
  const Y_TOTALES = 1.14;
  const anotTotales = [
    { x: etiqCmp, y: Y_TOTALES, xref:'x', yref:'paper', xanchor:'center', showarrow:false,
      text:'<b>Total: '+fmt(totB)+'</b>', font:{size:12, color: CFG.color_texto},
      bgcolor:'#EDEFF2', bordercolor:'#EDEFF2', borderpad:6 },
    { x: etiqAct, y: Y_TOTALES, xref:'x', yref:'paper', xanchor:'center', showarrow:false,
      text:'<b>Total: '+fmt(totA)+'</b>', font:{size:12, color: CFG.color_texto},
      bgcolor:'#EDEFF2', bordercolor:'#EDEFF2', borderpad:6 },
    { x:0.5, y: Y_TOTALES, xref:'paper', yref:'paper', xanchor:'center', showarrow:false,
      text:'<span style="color:'+colorVar+'">➜ '+
        (varPct===null?'s/d':((varPct>0?'+':'')+(varPct*100).toFixed(0)+'%'))+'</span>',
      font:{size:12, color: colorVar} }
  ];

  const lay = LAYOUT();
  lay.xaxis.type = 'category';
  lay.barmode = 'stack';
  lay.bargap = 0.5;
  lay.showlegend = false;
  lay.width = 620;
  lay.height = 261;
  lay.autosize = false;
  lay.margin = {l:15, r:15, t:50, b:38};
  lay.yaxis.visible = false;
  lay.annotations = anotTotales
    .concat(etiquetasInternas(cumCmp, etiqCmp))
    .concat(etiquetasInternas(cumAct, etiqAct));

  Plotly.react(div, traces, lay, OPTS_PPT);
}

```

