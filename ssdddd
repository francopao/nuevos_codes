# ============================================================================
# FECHA / PERIODO OBJETIVO
# ============================================================================

def restar_meses(fecha, n):
    """Día 1 del mes que está n meses antes del mes de `fecha`."""
    mes = fecha.month - n
    anio = fecha.year
    while mes <= 0:
        mes += 12
        anio -= 1
    return date(anio, mes, 1)


def ultimo_dia_habil_del_mes(anio, mes):
    """Último día hábil (lunes a viernes) del mes indicado."""
    primer_dia_sig = date(anio + 1, 1, 1) if mes == 12 else date(anio, mes + 1, 1)
    d = primer_dia_sig - timedelta(days=1)
    while d.weekday() >= 5:  # 5=sábado, 6=domingo
        d -= timedelta(days=1)
    return d


_hoy = date.today()
_mes_referencia = restar_meses(_hoy, 2)
FECHA_OBJETIVO = ultimo_dia_habil_del_mes(_mes_referencia.year, _mes_referencia.month)
FECHA_OBJETIVO_STR = FECHA_OBJETIVO.strftime("%d/%m/%Y")
ANIO_OBJETIVO = FECHA_OBJETIVO.year
MES_OBJETIVO_NUM = FECHA_OBJETIVO.month


