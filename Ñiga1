def _norm(s):
    s = unicodedata.normalize("NFKD", str(s))
    s = "".join(c for c in s if not unicodedata.combining(c))
    return s.strip().upper()


ACTIVOS_ALCANCE = {
    "PLANTA DE CONC.SAN RAFAEL": "Cadena Estaño (San Rafael + Funsur)",
    "FUNSUR": "Cadena Estaño (San Rafael + Funsur)",
    "CONCESION DE BENEFICIO PUCAMARCA": "Pucamarca (Oro)",
    # "PLANTA DE OXIDOS Y PLANTA DE SULFUROS" (Marcona) = Mina Justa /
    # Marcobre: EXCLUIDO del alcance (Opcion A), decision explicita.
}


def cargar_scores_minsur(ruta_riesgos, empresa="Minsur"):
    wb = openpyxl.load_workbook(ruta_riesgos, data_only=True)
    ws = wb["Activos por Empresa"]
    headers = [ws.cell(1, c).value for c in range(1, ws.max_column + 1)]
    idx = {h: i + 1 for i, h in enumerate(headers) if h}

    activos = []
    for r in range(2, ws.max_row + 1):
        if ws.cell(r, idx["Empresa"]).value != empresa:
            continue
        nombre_activo = ws.cell(r, idx["Activo Físico"]).value
        clave = _norm(nombre_activo)
        unidad = None
        for k, v in ACTIVOS_ALCANCE.items():
            if _norm(k) == clave:
                unidad = v
                break
        if unidad is None:
            continue  # fuera de alcance (Opcion A)
        activos.append({
            "activo": nombre_activo,
            "unidad_economica": unidad,
            "score_mm": ws.cell(r, idx["Score MM"]).value,
            "score_inund": ws.cell(r, idx["Score Inund."]).value,
            "score_sequia": ws.cell(r, idx["Score Sequía"]).value,
        })
    if not activos:
        raise ValueError("No se encontraron activos de Minsur dentro del alcance definido (Opcion A).")
    return activos


def _buscar_valor_por_etiqueta(ws, etiqueta, col_etiqueta, col_valor,
                                fila_inicio=1, fila_fin=None, ocurrencia=1):
    fila_fin = fila_fin or ws.max_row
    vistos = 0
    for r in range(fila_inicio, fila_fin + 1):
        if ws.cell(r, col_etiqueta).value == etiqueta:
            vistos += 1
            if vistos == ocurrencia:
                return ws.cell(r, col_valor).value
    return None


def _col_del_anio(ws, fila_encabezado, anio, col_inicio=1, col_fin=None):
    col_fin = col_fin or ws.max_column
    for c in range(col_inicio, col_fin + 1):
        if ws.cell(fila_encabezado, c).value == anio:
            return c
    raise ValueError(f"No se encontro la columna del anio {anio} en fila {fila_encabezado}.")


def cargar_financieros_minsur(ruta_valorizacion, anio_base=ANIO_BASE):
    wb = openpyxl.load_workbook(ruta_valorizacion, data_only=True)

    # --- Segmento Individual (IS_Ind.): base del alcance (Opcion A) ---
    ws_ind = wb["IS_Ind."]
    col_ind = _col_del_anio(ws_ind, 2, anio_base)
    ventas_ind = _buscar_valor_por_etiqueta(ws_ind, "Ventas netas", 2, col_ind)
    ebitda_ind = _buscar_valor_por_etiqueta(ws_ind, "EBITDA", 2, col_ind)

    # --- Op: ingresos por producto (Estaño = San Rafael+Funsur, Oro =
    # Pucamarca), bajo "Consolidated sales" ---
    ws_op = wb["Op"]
    col_op = _col_del_anio(ws_op, 2, anio_base)
    revenue_estano = _buscar_valor_por_etiqueta(ws_op, "Estaño", 2, col_op, ocurrencia=1)
    revenue_oro = _buscar_valor_por_etiqueta(ws_op, "Oro", 2, col_op, ocurrencia=1)

    # --- COGS: costo de produccion por mina, bajo "Production cost
    # consolidated" ---
    ws_cogs = wb["COGS"]
    col_cogs = _col_del_anio(ws_cogs, 2, anio_base)
    costo_san_rafael = _buscar_valor_por_etiqueta(ws_cogs, "San Rafael", 2, col_cogs, ocurrencia=1)
    costo_pucamarca = _buscar_valor_por_etiqueta(ws_cogs, "Pucamarca", 2, col_cogs, ocurrencia=1)

    # --- Ratios_Minsur: metricas de credito CONSOLIDADAS (la deuda vive a
    # nivel de la compania, no del segmento) ---
    ws_rat = wb["Ratios_Minsur"]
    col_rat = _col_del_anio(ws_rat, 2, anio_base)
    ebitda_cons = _buscar_valor_por_etiqueta(ws_rat, "EBITDA", 1, col_rat)
    revenue_cons = _buscar_valor_por_etiqueta(ws_rat, "Revenue", 1, col_rat)
    net_debt_ebitda_cons = _buscar_valor_por_etiqueta(ws_rat, "Net debt / EBITDA (x)", 1, col_rat)

    faltantes = [n for n, v in [
        ("Ventas netas (IS_Ind.)", ventas_ind), ("EBITDA (IS_Ind.)", ebitda_ind),
        ("Estaño (Op)", revenue_estano), ("Oro (Op)", revenue_oro),
        ("San Rafael (COGS)", costo_san_rafael), ("Pucamarca (COGS)", costo_pucamarca),
        ("EBITDA consolidado (Ratios_Minsur)", ebitda_cons),
        ("Net debt / EBITDA consolidado (Ratios_Minsur)", net_debt_ebitda_cons),
    ] if v is None]
    if faltantes:
        raise ValueError(f"No se pudieron leer los siguientes datos: {faltantes}")

    return {
        "anio_base": anio_base,
        "ventas_individual": ventas_ind,
        "ebitda_individual": ebitda_ind,
        "revenue_estano": revenue_estano,
        "revenue_oro": revenue_oro,
        "costo_produccion_san_rafael": costo_san_rafael,
        "costo_produccion_pucamarca": costo_pucamarca,
        "ebitda_consolidado": ebitda_cons,
        "revenue_consolidado": revenue_cons,
        "net_debt_ebitda_consolidado_x": net_debt_ebitda_cons,
    }


# ============================================================================
# 3. UNIDADES ECONOMICAS (San Rafael+Funsur en cadena; Pucamarca aparte)
# ============================================================================

def construir_unidades_economicas(fin):
    revenue_total_unidades = fin["revenue_estano"] + fin["revenue_oro"]

    unidades = {
        "Cadena Estaño (San Rafael + Funsur)": {
            "revenue": fin["revenue_estano"],
            "costo_produccion": fin["costo_produccion_san_rafael"],
        },
        "Pucamarca (Oro)": {
            "revenue": fin["revenue_oro"],
            "costo_produccion": fin["costo_produccion_pucamarca"],
        },
    }

    for u in unidades.values():
        u["margen_contribucion"] = 1 - (u["costo_produccion"] / u["revenue"])
        u["ebitda_asignado"] = fin["ebitda_individual"] * (u["revenue"] / revenue_total_unidades)

    return unidades


# ============================================================================
# 4. MOTOR DE ESTRES (por activo x por escenario, SIN agregar entre si)
# ============================================================================

def correr_pruebas_de_estres(activos, unidades, fin):
    filas = []
    for activo in activos:
        unidad = unidades[activo["unidad_economica"]]
        scores_por_hazard = {
            "Movimiento de Masa": activo["score_mm"],
            "Inundación": activo["score_inund"],
            "Sequía": activo["score_sequia"],
        }
        for hazard, score in scores_por_hazard.items():
            elasticidad = elasticidad_por_score(hazard, score)
            if elasticidad is None:
                continue  # score = N/D: el escenario no se considera

            delta_revenue_usd = elasticidad * unidad["revenue"]
            delta_ebitda_usd = delta_revenue_usd * unidad["margen_contribucion"]
            delta_ebitda_pct_unidad = (
                delta_ebitda_usd / unidad["ebitda_asignado"] if unidad["ebitda_asignado"] else None
            )

            ebitda_cons_ajustado = fin["ebitda_consolidado"] + delta_ebitda_usd
            net_debt_usd = fin["net_debt_ebitda_consolidado_x"] * fin["ebitda_consolidado"]
            net_debt_ebitda_ajustado = (
                net_debt_usd / ebitda_cons_ajustado if ebitda_cons_ajustado else None
            )

            filas.append({
                "activo": activo["activo"],
                "unidad_economica": activo["unidad_economica"],
                "escenario_riesgo": hazard,
                "score_cenepred": score,
                "elasticidad_aplicada_pct": elasticidad,
                "revenue_base_unidad_usd_mm": unidad["revenue"],
                "delta_revenue_usd_mm": delta_revenue_usd,
                "margen_contribucion_unidad": unidad["margen_contribucion"],
                "delta_ebitda_usd_mm": delta_ebitda_usd,
                "delta_ebitda_pct_sobre_unidad": delta_ebitda_pct_unidad,
                "delta_ebitda_pct_sobre_consolidado": delta_ebitda_usd / fin["ebitda_consolidado"],
                "net_debt_ebitda_base_x": fin["net_debt_ebitda_consolidado_x"],
                "net_debt_ebitda_ajustado_x": net_debt_ebitda_ajustado,
            })
    return filas


