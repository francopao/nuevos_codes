        print(f"   - {a['activo']} ({a['unidad_economica']}): "
              f"MM={a['score_mm']}  Inund={a['score_inund']}  Sequia={a['score_sequia']}")

    print("\nCargando datos financieros (Minsur 261Q)...")
    fin = cargar_financieros_minsur(ruta_valorizacion)
    print(f"   Segmento Individual: Ventas={fin['ventas_individual']:.1f}  "
          f"EBITDA={fin['ebitda_individual']:.1f}  US$ mm")
    print(f"   Consolidado: Ventas={fin['revenue_consolidado']:.1f}  "
          f"EBITDA={fin['ebitda_consolidado']:.1f}  US$ mm  "
          f"Deuda Neta/EBITDA={fin['net_debt_ebitda_consolidado_x']:.2f}x")

    unidades = construir_unidades_economicas(fin)
    print("\nUnidades economicas construidas:")
    for nombre, u in unidades.items():
        print(f"   - {nombre}: Revenue={u['revenue']:.1f}  "
              f"Margen contrib.={u['margen_contribucion']:.1%}  "
              f"EBITDA asignado={u['ebitda_asignado']:.1f}")

    print("\nCorriendo pruebas de estres por activo x escenario (sin agregar)...")
    filas = correr_pruebas_de_estres(activos, unidades, fin)
    print(f"   {len(filas)} escenarios calculados.")

    escribir_excel(filas, fin, RUTA_SALIDA_EXCEL)

    print("\n" + "=" * 78)
    print("RESUMEN")
    print("=" * 78)
    for f in filas:
        print(f"{f['activo']:38s} | {f['escenario_riesgo']:20s} | score={f['score_cenepred']} | "
              f"DeltaEBITDA={f['delta_ebitda_usd_mm']:+7.2f} US$mm "
              f"({f['delta_ebitda_pct_sobre_consolidado']:+.2%} s/consolidado) | "
              f"DN/EBITDA {f['net_debt_ebitda_base_x']:.2f}x -> {f['net_debt_ebitda_ajustado_x']:.2f}x")


