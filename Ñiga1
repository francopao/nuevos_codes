ELASTICIDADES_LITERATURA = {
    # Inundacion y Movimiento de Masa comparten fuente: Clo et al., eventos
    # hidrogeologicos (inundaciones y deslizamientos) en municipios
    # italianos. Impacto sobre ingresos de la empresa, evento severo vs. no
    # severo.
    "Inundación": {5: -0.049, 4: -0.032, 3: -0.015},
    "Movimiento de Masa": {5: -0.049, 4: -0.032, 3: -0.015},
    # Sequia en mineria: reduccion de capacidad/utilizacion documentada en
    # la literatura de exposicion hidrica minera (Bonnafous, Lall & Siegel),
    # trasladada a % de ingresos bajo el supuesto theta=0 (tomador de
    # precio) ya establecido para el sector.
    "Sequía": {5: -0.25, 4: -0.15, 3: -0.05},
}


def elasticidad_por_score(hazard, score):
    if score is None or (isinstance(score, str) and score.strip().upper() == "N/D"):
        return None
    try:
        score_num = int(round(float(score)))
    except (TypeError, ValueError):
        return None
    if score_num <= 2:
        return 0.0
    score_num = min(score_num, 5)
    return ELASTICIDADES_LITERATURA[hazard][score_num]


