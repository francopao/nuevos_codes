def _archivo_valido(nombre):
    return not nombre.startswith("~$") and not nombre.startswith(".")


def _buscar_recursivo(carpeta_raiz, patron_regex, extensiones=(".xlsx", ".xlsm")):
    if not os.path.isdir(carpeta_raiz):
        raise FileNotFoundError(
            f"No existe o no es accesible: {carpeta_raiz}\n"
            f"Verifica que la unidad de red (Z:) este conectada."
        )
    regex = re.compile(patron_regex, re.IGNORECASE)
    encontrados = []
    for dirpath, _sub, filenames in os.walk(carpeta_raiz):
        for f in filenames:
            if not _archivo_valido(f):
                continue
            base, ext = os.path.splitext(f)
            if ext.lower() not in extensiones:
                continue
            if regex.search(base):
                ruta = os.path.join(dirpath, f)
                try:
                    mod = datetime.fromtimestamp(os.path.getmtime(ruta))
                except OSError:
                    mod = None
                encontrados.append({"ruta": ruta, "nombre": f, "modificado": mod})
    return encontrados


def encontrar_valorizacion(nombre_exacto, carpeta_raiz=RUTA_VALORIZACIONES):
    base = os.path.splitext(nombre_exacto)[0]
    patron = rf"^{re.escape(base)}$"
    candidatos = _buscar_recursivo(carpeta_raiz, patron)
    if not candidatos:
        raise FileNotFoundError(f"No se encontro '{nombre_exacto}' bajo {carpeta_raiz}")
    if len(candidatos) > 1:
        candidatos.sort(key=lambda r: r["modificado"] or datetime.min, reverse=True)
        print(f"[AVISO] Multiples coincidencias para '{nombre_exacto}', se usa la mas reciente:")
        for cnd in candidatos:
            print(f"   - {cnd['ruta']}")
    print(f"[OK] Valorizacion: {candidatos[0]['ruta']}")
    return candidatos[0]["ruta"]


_PATRON_PERIODO = re.compile(r"riesgos\s*clim[aá]ticos\s*-\s*([12])s(\d{2})", re.IGNORECASE)


def encontrar_riesgos_climaticos(periodo=None, carpeta_raiz=RUTA_RIESGOS_CLIMATICOS):
    candidatos = _buscar_recursivo(carpeta_raiz, r"riesgos\s*clim[aá]ticos")
    con_periodo = []
    for c in candidatos:
        m = _PATRON_PERIODO.search(c["nombre"].replace("_", " "))
        if m:
            c["anio"] = 2000 + int(m.group(2))
            c["semestre"] = int(m.group(1))
            con_periodo.append(c)
    if not con_periodo:
        raise FileNotFoundError(f"No se hallo ningun 'Riesgos Climaticos - XSYY' bajo {carpeta_raiz}")
    con_periodo.sort(key=lambda r: (r["anio"], r["semestre"]), reverse=True)
    if periodo is None:
        seleccionado = con_periodo[0]
        print(f"[OK] Riesgos Climaticos (mas reciente): {seleccionado['ruta']}")
        return seleccionado["ruta"]
    m = re.match(r"^([12])S(\d{2})$", periodo.strip().upper())
    if not m:
        raise ValueError(f"Formato de periodo invalido: '{periodo}'. Usa 'XSYY', ej. '2S26'.")
    sem, anio = int(m.group(1)), 2000 + int(m.group(2))
    for c in con_periodo:
        if c["anio"] == anio and c["semestre"] == sem:
            print(f"[OK] Riesgos Climaticos ({periodo}): {c['ruta']}")
            return c["ruta"]
    disponibles = [f"{c['semestre']}S{str(c['anio'])[-2:]}" for c in con_periodo]
    raise FileNotFoundError(f"Periodo '{periodo}' no encontrado. Disponibles: {disponibles}")


