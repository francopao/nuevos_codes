def _autoancho(ws, min_ancho=10, max_ancho=60):
    for col_cells in ws.columns:
        longitud = max((len(str(c.value)) for c in col_cells if c.value is not None), default=0)
        letra = get_column_letter(col_cells[0].column)
        ws.column_dimensions[letra].width = min(max(longitud + 2, min_ancho), max_ancho)


