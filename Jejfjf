# Empresas canónicas que son el universo de análisis (orden de reporte).
EMPRESAS_CANONICAS = ["Buenaventura", "Volcan", "Minsur", "Nexa Resources Perú",
                      "Hochschild", "Cerro Verde", "Hudbay", "Marcobre"]

# --- Participaciones cruzadas (lado PRODUCCIÓN) -------------------------------
# Una empresa "hija" ya es canónica por sí misma (reporta el 100% de su
# producción bajo su propio nombre), pero además parte de esa producción debe
# sumarse a otra empresa "dueña" por su % de participación accionaria — SIN
# restarle nada a la hija. Clave = empresa canónica hija; valor = lista de
# (empresa canónica dueña, fracción 0-1). Admite más de un dueño o más de una
# hija sin tocar el resto del script.
PARTICIPACIONES_CRUZADAS = {
    "Marcobre": [("Minsur", 0.60)],
}
```

