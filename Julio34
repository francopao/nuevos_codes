DIR_PRODUCCION_MINERA = r"Z:\Mesa de Inversiones\Bottom-Up\1 Proceso de Inversión Renta Variable\Proyecto Inputs Macro\Complementos BD\Minería\BD\Producción Minera"

def encontrar_archivo_produccion(directorio, anio, prefijo="Producción metálica"):
    """
    Busca en 'directorio' todos los .xlsx cuyo nombre empiece con 'prefijo'
    (sin importar tildes/mayúsculas/espacios) y contengan el año, y devuelve
    la ruta del que tenga la fecha de modificación más reciente.
    Si no encuentra ninguno así, intenta la ruta exacta "<prefijo> <año>.xlsx"
    como respaldo.
    """
    clave_prefijo = _clave(prefijo)
    candidatos = []
    try:
        entradas = os.listdir(directorio)
    except (FileNotFoundError, NotADirectoryError):
        entradas = []

    for nombre in entradas:
        ruta = os.path.join(directorio, nombre)
        if not os.path.isfile(ruta):
            continue
        if not nombre.lower().endswith(".xlsx"):
            continue
        if _clave(nombre).startswith(clave_prefijo) and str(anio) in nombre:
            candidatos.append(ruta)

    if candidatos:
        candidatos.sort(key=os.path.getmtime, reverse=True)
        return candidatos[0]

    ruta_exacta = os.path.join(directorio, f"{prefijo} {anio}.xlsx")
    if os.path.isfile(ruta_exacta):
        return ruta_exacta

    return None

# ---------------------------------------------------------------------------
# MEJORA 2: localizar la hoja "INFORMACION GENERAL" sin importar tildes,
# mayúsculas/minúsculas o espacios extra en el nombre.
# ---------------------------------------------------------------------------
def encontrar_hoja(ruta_archivo, nombre_objetivo):
    with pd.ExcelFile(ruta_archivo) as xl:
        hojas = xl.sheet_names
    clave_objetivo = _clave(nombre_objetivo)
    for hoja in hojas:
        if _clave(hoja) == clave_objetivo:
            return hoja, hojas
    for hoja in hojas:
        if clave_objetivo in _clave(hoja):
            return hoja, hojas
    return None, hojas

