_MAPA_TITULAR = {}
def _registrar(variante, unico):
    k = _clave(variante)
    if _MAPA_TITULAR.get(k, unico) != unico:
        raise ValueError(f"Alias contradictorio: '{variante}' -> '{unico}' y '{_MAPA_TITULAR[k]}'")
    _MAPA_TITULAR[k] = unico
for _u in TITULAR_UNICO:
    _registrar(_u, _u)
for _v, _u in TITULAR_ALIAS.items():
    _registrar(_u, _u)      # el destino se resuelve a sí mismo (evita cadenas A->B->C)
    _registrar(_v, _u)

def canonizar_titular(serie):
    return serie.map(lambda x: _MAPA_TITULAR.get(_clave(x), x) if isinstance(x, str) else x)

_PROCESO_FIX = {'LIXIVIACION': 'LIXIVIACIÓN', '(EN BLANCO)': 'No especifica'}
def normalizar_dimensiones(df):
    """MINERAL en mayúsculas ('Oro'->'ORO') y PROCESO sin variantes ('LIXIViACIÓN', '(en blanco)')."""
    d = df.copy()
    d['MINERAL'] = d['MINERAL'].map(lambda x: x.upper() if isinstance(x, str) else x)
    d['PROCESO'] = d['PROCESO'].map(lambda x: _PROCESO_FIX.get(_clave(x), x) if isinstance(x, str) else x)
    return d

def consolidar_base(df):
    """Unifica titulares/mineral/proceso en la base histórica y fusiona filas duplicadas.
    Columnas por posición: 0=Key1, 1-5=MINERAL..UNIDAD, 6+=meses (sirve con etiquetas datetime o texto).
    Celdas solapadas -> max (en tu base solo chocan 0 vs valor, o 0 vs 0)."""
    cols = list(df.columns)
    llaves, meses_c = cols[1:6], cols[6:]
    d = df.copy()
    basura = d['MINERAL'].astype(str).str.strip().eq('MINERAL')     # encabezado "fugado" a la base
    if basura.any():
        print(f"[BASE] Se elimina {int(basura.sum())} fila(s) basura (encabezado repetido).")
        d = d[~basura]
    d['TITULAR'] = canonizar_titular(d['TITULAR'])
    d = normalizar_dimensiones(d)
    d[meses_c] = d[meses_c].apply(pd.to_numeric, errors='coerce')
    antes_filas, antes_tot = len(d), d[meses_c].sum()
    g = d.groupby(llaves, sort=False, dropna=False)[meses_c]
    mx, mn = g.max(), g.min()
    conflictos = int((((mx - mn).abs() > 1e-9) & (mn != 0)).sum().sum())
    out = mx.reset_index()
    key1 = out['MINERAL'] + out['ETAPA'] + out['PROCESO'] + out['TITULAR'] + out['UNIDAD']
    out = pd.concat([key1.rename('Key1'), out], axis=1)[cols]
    dif = (out[meses_c].sum() - antes_tot).abs()
    print(f"[BASE] Filas {antes_filas} -> {len(out)} | titulares únicos: {out['TITULAR'].nunique()}")
    if conflictos:
        print(f"[BASE][ALERTA] {conflictos} celda(s) con 2 valores distintos no nulos (se tomó el mayor). Revisar.")
    if (dif > 1e-6).any():
        print("[BASE][ALERTA] Totales mensuales cambiaron en:", [str(c)[:10] for c in dif[dif > 1e-6].index])
    else:
        print("[BASE] Control de totales mensuales: OK (sin cambios).")
    return out

def _nucleo(s):
    """Nombre sin tildes/forma societaria/prefijos genéricos, solo para comparar parecidos."""
    n = re.sub(r'[\.,\-´`]', ' ', _clave(s))
    n = re.sub(r'\s+', ' ', n).strip()
    for _ in range(3):
        n = re.sub(r'\s(S A A|S A C|S R L|S C R L|E I R L|S A|SAC|SRL|SAA|LTDA|SA)$', '', n)
    n = re.sub(r'^(COMPANIA MINERA|COMPANIA DE MINAS|SOCIEDAD MINERA|EMPRESA MINERA|MINERA|CIA MINERA|COMPANIA)\s', '', n)
    return re.sub(r'\b(PERU|RESOURCES)\b', '', n).replace('  ', ' ').strip()

def reportar_titulares_nuevos(df_nuevo, df_base, umbral=0.85, max_sin_parecido=15):
    """Aviso preventivo: titulares del mes que no existen en la base y se parecen a uno existente."""
    base = sorted(set(df_base['TITULAR'].dropna()))
    nbase = {b: _nucleo(b) for b in base}
    nuevos = sorted(set(df_nuevo['TITULAR'].dropna()) - set(base))
    sin = []
    for n in nuevos:
        nn = _nucleo(n)
        cand = sorted(((difflib.SequenceMatcher(None, nn, nb).ratio(), b) for b, nb in nbase.items()), reverse=True)[:3]
        cand = [(r, b) for r, b in cand if r >= umbral or (len(nn) >= 5 and nn == nbase[b])]
        if cand:
            print(f"[TITULAR NUEVO] '{n}' se parece a: " + " | ".join(f"'{b}' ({r:.2f})" for r, b in cand))
            print("      -> si es la misma empresa, agrégala a TITULAR_ALIAS.")
        else:
            sin.append(n)
    if sin:
        print(f"[TITULAR NUEVO] {len(sin)} sin parecidos (entidades nuevas): " + "; ".join(sin[:max_sin_parecido])
              + (" ..." if len(sin) > max_sin_parecido else ""))

