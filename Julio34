def _clave(s):
    """Clave de comparación: sin tildes, MAYÚSCULAS, espacios simples, '*-*' -> '&'."""
    s = unicodedata.normalize('NFKD', str(s))
    s = ''.join(c for c in s if not unicodedata.combining(c)).upper()
    return re.sub(r'\s+', ' ', s.replace('*-*', '&')).strip()

