def valores_faltantes(df_diccionario, *series):
    conocidos = set(df_diccionario['Nombre_Antiguo'].dropna().unique())
    faltantes = set()
    for s in series:
        faltantes.update(s.dropna().unique())
    faltantes -= conocidos
    return sorted(v for v in faltantes if isinstance(v, str))

def actualizar_diccionario(ruta_diccionario, hoja, df_diccionario, valores_nuevos):
    filas_nuevas = pd.DataFrame({"Nombre_Antiguo": valores_nuevos, "Nombre_Nuevo": valores_nuevos})
    df_actualizado = pd.concat([df_diccionario, filas_nuevas], ignore_index=True)
    with pd.ExcelWriter(ruta_diccionario, mode="a", engine="openpyxl", if_sheet_exists="replace") as writer:
        df_actualizado.to_excel(writer, sheet_name=hoja, index=False)
    for valor in valores_nuevos:
        print(f"[DICCIONARIO] '{valor}' no existía: se agregó a la hoja '{hoja}' del archivo '{ruta_diccionario}' (mapeado a sí mismo).")
    return df_actualizado

