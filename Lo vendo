```python
NOMBRE_HOJA_BD = "BD"


def _agregar_cobertura_proxy(ws, bd: pd.DataFrame, fila_max_bd: int) -> None:
    """Tabla-resumen de cobertura Proxy vs directa (MSCI/SOV/ETF/etc.), por
    Corte x AFP x Universo, con fórmulas SUMIFS a la derecha de BD."""
    if bd.empty or fila_max_bd < 2:
        return
    combos = bd[["Corte", "AFP", "Universo"]].drop_duplicates().reset_index(drop=True)
    if combos.empty:
        return
    col_r = 24  # columna X, deja espacio después de Intensidad_Verif (U)
    headers = ["Corte", "AFP", "Universo", "Huella_Total", "Huella_Proxy",
               "% Huella Proxy", "Intensidad_Total", "Intensidad_Proxy",
               "% Intensidad Proxy"]
    for j, h in enumerate(headers):
        ws.cell(row=1, column=col_r + j, value=h)
    for k, row in combos.iterrows():
        fr = k + 2
        corte_esc = str(row["Corte"]).replace('"', '""')
        afp_esc = str(row["AFP"]).replace('"', '""')
        univ_esc = str(row["Universo"]).replace('"', '""')
        ws.cell(row=fr, column=col_r, value=row["Corte"])
        ws.cell(row=fr, column=col_r + 1, value=row["AFP"])
        ws.cell(row=fr, column=col_r + 2, value=row["Universo"])
        base = (f'$A$2:$A${fila_max_bd},"{corte_esc}",'
                f'$B$2:$B${fila_max_bd},"{afp_esc}",'
                f'$H$2:$H${fila_max_bd},"{univ_esc}"')
        f_ht = f'=SUMIFS($R$2:$R${fila_max_bd},{base})'
        f_hp = f'=SUMIFS($R$2:$R${fila_max_bd},{base},$J$2:$J${fila_max_bd},"Proxies")'
        f_it = f'=SUMIFS($S$2:$S${fila_max_bd},{base})'
        f_ip = f'=SUMIFS($S$2:$S${fila_max_bd},{base},$J$2:$J${fila_max_bd},"Proxies")'
        ws.cell(row=fr, column=col_r + 3, value=f_ht)
        ws.cell(row=fr, column=col_r + 4, value=f_hp)
        c1 = ws.cell(row=fr, column=col_r + 5,
                      value=f'=IF({get_column_letter(col_r+3)}{fr}=0,0,'
                            f'{get_column_letter(col_r+4)}{fr}/{get_column_letter(col_r+3)}{fr})')
        ws.cell(row=fr, column=col_r + 6, value=f_it)
        ws.cell(row=fr, column=col_r + 7, value=f_ip)
        c2 = ws.cell(row=fr, column=col_r + 8,
                      value=f'=IF({get_column_letter(col_r+6)}{fr}=0,0,'
                            f'{get_column_letter(col_r+7)}{fr}/{get_column_letter(col_r+6)}{fr})')
        c1.number_format = "0.0%"
        c2.number_format = "0.0%"


```

