def _cargar_emisor_proxy_map(anio: str, mes: str) -> dict:
    """Lee hoja 'BU' de Lista Proxies: mapea Nombre (col 5) → Proxy FUND_NAME
    (col 8) para emisores con cobertura ESG propia (Tiene Huella = 'Riesgos').
    Devuelve {nombre_emisor: {proxy: fund_name, fce: float}}."""
    ruta = RUTA_BENCHMARKS_FFMM
    if not FsPath(ruta).exists():
        return {}
    try:
        wb = openpyxl.load_workbook(ruta, read_only=True, data_only=True)
        # Paso 1: mapeo emisor → proxy FUND_NAME desde hoja BU
        if "BU" not in wb.sheetnames:
            wb.close()
            return {}
        ws_bu = wb["BU"]
        emisor_proxy = {}
        for row in ws_bu.iter_rows(min_row=2, values_only=True):
            nombre = row[5] if len(row) > 5 else None  # col 5 = Nombre
            tiene = str(row[6] or "") if len(row) > 6 else ""  # col 6 = Tiene Huella?
            proxy = row[8] if len(row) > 8 else None  # col 8 = Proxy (FUND_NAME)
            if nombre and tiene == "Riesgos" and proxy:
                emisor_proxy[str(nombre).strip()] = str(proxy).strip()
        # Paso 2: FCE de cada proxy desde hoja YYYYMM
        hoja = f"{anio}{mes}"
        fce_map = {}
        if hoja in wb.sheetnames:
            ws_mm = wb[hoja]
            hdr = list(ws_mm.iter_rows(min_row=1, max_row=1, values_only=True))[0]
            idx_fn = idx_fce = None
            for i, v in enumerate(hdr):
                if v == "FUND_NAME": idx_fn = i
                if v == "FUND_FINANCED_CARBON_EMISSIONS": idx_fce = i
            if idx_fn is not None and idx_fce is not None:
                for row in ws_mm.iter_rows(min_row=2, values_only=True):
                    fn = row[idx_fn] if idx_fn < len(row) else None
                    fv = row[idx_fce] if idx_fce < len(row) else None
                    if fn and fv is not None:
                        try:
                            fce_map[str(fn).strip()] = float(fv)
                        except (ValueError, TypeError):
                            pass
        wb.close()
        # Paso 3: combinar
        result = {}
        for emisor, proxy_name in emisor_proxy.items():
            # Buscar FCE: match exacto o parcial
            fce = fce_map.get(proxy_name)
            if fce is None:
                # Match parcial (el nombre en BU puede ser ligeramente distinto)
                for k, v in fce_map.items():
                    if proxy_name in k or k in proxy_name:
                        fce = v
                        break
            if fce is not None:
                result[emisor] = {"proxy": proxy_name, "fce": fce}
        print(f"  [Emisor→Proxy] {len(result)} emisores con benchmark de {len(emisor_proxy)} con cobertura ESG")
        return result
    except Exception as e:
        print(f"  [Emisor→Proxy] Error: {e}")
        return {}


