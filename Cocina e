// --- Chart 4: "Emisores con cobertura ESG vs Benchmark" -------------------
// Barras horizontales = Intensidad. Marcadores = Intensidad del benchmark
// (FCE del proxy × weight del emisor). Slicer de AFP.
const EMISOR_PROXY = __EMISOR_PROXY__;

function emisoresEsgBenchmark(div, corte, afpSel){
  const afp = afpSel || 'Integra';
  // Leer Contrib_ESG_Benchmark para la AFP seleccionada
  const emisores = [];
  for(const r of HIST){
    if(r.OBJETO!=='Contrib_ESG_Benchmark' || String(r.FECHA_CORTE)!==String(corte) ||
       (r.AFP||'')!==afp) continue;
    if(!r.DIM_1) continue;
    let e = emisores.find(x=>x.nombre===r.DIM_1);
    if(!e){ e={nombre:r.DIM_1}; emisores.push(e); }
    if(r.METRICA==='Intensidad') e.intens = +r.VALOR||0;
    if(r.METRICA==='Weight') e.weight = +r.VALOR||0;
  }
  // Filtrar solo emisores que tienen proxy en EMISOR_PROXY (cobertura ESG propia)
  const conProxy = emisores.filter(e => {
    // Match: nombre exacto o parcial
    for(const k of Object.keys(EMISOR_PROXY)){
      if(e.nombre===k || e.nombre.includes(k) || k.includes(e.nombre)){
        e.proxyInfo = EMISOR_PROXY[k]; e.matchKey = k; return true;
      }
    }
    return false;
  });
  if(!conProxy.length){ document.getElementById(div).innerHTML='<p style="color:#8A99A8;text-align:center">Sin emisores con cobertura ESG para '+afp+'</p>'; return; }
  // Ordenar desc por Intensidad, tomar top 15
  conProxy.sort((a,b)=>(b.intens||0)-(a.intens||0));
  const top = conProxy.slice(0, 15);
  // Invertir para que el mayor quede arriba (horizontal bottom-up)
  const sorted = top.slice().reverse();
  const yNames = sorted.map(s=>s.nombre);
  const xIntens = sorted.map(s=>s.intens||0);
  const xBench = sorted.map(s => {
    const fce = s.proxyInfo ? s.proxyInfo.fce : 0;
    return fce * (s.weight||0);
  });
  const colores = sorted.map((_,i) => P[i % P.length]);
  const traces = [
    {type:'bar', orientation:'h', name:'Intensidad emisor',
     x:xIntens, y:yNames, marker:{color:colores}, showlegend:false,
     text:xIntens.map(v=>v.toFixed(2)), textposition:'outside', cliponaxis:false,
     textfont:{size:10,color:CFG.color_texto}},
    {type:'scatter', mode:'markers', name:'Benchmark',
     x:xBench, y:yNames,
     marker:{size:11, color:'#E74C3C', symbol:'circle',
             line:{width:1.5, color:'#fff'}},
     hovertemplate:'%{y}<br>Benchmark: %{x:.2f}<extra></extra>'}
  ];
  const lay = LAYOUT();
  lay.yaxis = {type:'category', showgrid:false, showline:false, ticks:'',
               automargin:true, tickfont:{size:10}};
  lay.xaxis = {title:'Intensidad (Tn CO2 / USD MM)', showgrid:true,
               gridcolor:CFG.color_grid, zeroline:true};
  lay.legend = {orientation:'h', yanchor:'bottom', y:1.05, x:0, bgcolor:'rgba(0,0,0,0)'};
  lay.margin = {l:200, r:60, t:55, b:45};
  lay.height = Math.max(CFG.alto, sorted.length*28 + 100);
  Plotly.react(div, traces, lay, OPTS);
}



