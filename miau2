def _chart_termometro_fen(ax):
    datos_mensuales = cargar_primario_mensual(ARCHIVO_BCRP)
    serie_anual = construir_serie_anual_primario(datos_mensuales)
    proyeccion = cargar_proyeccion_ri2026(ARCHIVO_BCRP)
    episodios = cargar_episodios_fen(ARCHIVO_MEMORIA)
    construir_chart_termometro_fen(serie_anual, proyeccion, episodios, ax)


