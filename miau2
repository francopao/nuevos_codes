# CHART #1 — TERMÓMETRO FEN
# ============================================================

def construir_chart_termometro_fen(serie_anual, proyeccion, episodios, ax, anio_inicio=1995):
    """
    Grafico el PBI primario: línea sólida con el histórico observado (reconstruido
    a partir del promedio de las variaciones mensuales interanuales), sombreado en
    los años de FEN Fuerte/Extraordinario dentro del rango de datos, y un tramo
    final punteado con la proyección del BCRP (RI Jun.26) para 2026-2027.
    """
    fig = ax.figure

    anios_obs = [a for a in serie_anual if a >= anio_inicio]
    valores_obs = [serie_anual[a] for a in anios_obs]

    # Para el año 2025 uso la cifra oficial que publica el propio Reporte de
    # Inflación (columna '2025'), en vez de mi promedio mensual: así el tramo
    # forecast arranca exactamente del mismo ancla que usa el BCRP.
    if proyeccion.get(2025) is not None and 2025 in anios_obs:
        valores_obs[anios_obs.index(2025)] = proyeccion[2025]

    ultimo_anio_obs = anios_obs[-1]
    anios_fc = [ultimo_anio_obs, 2026, 2027]
    valores_fc = [valores_obs[-1], proyeccion[2026], proyeccion[2027]]

    # Sombreo los episodios FEN primero, para que queden detrás de la línea.
    # axvspan usa coordenadas de ejes en el eje Y, así que cubre todo el alto
    # del chart sin que me importe todavía cuál va a ser el ylim final.
    for ep in episodios:
        ini, fin = max(ep["inicio"], anio_inicio), min(ep["fin"], 2027.4)
        if fin <= anio_inicio:
            continue
        ax.axvspan(ini, fin, color=COLOR_BANDA_FEN, alpha=0.7, zorder=1, lw=0)

    # Zona de forecast, para separar visualmente lo observado de la proyección.
    ax.axvspan(ultimo_anio_obs, 2027.4, color=COLOR_ZONA_FORECAST, alpha=0.6, zorder=0, lw=0)

    ax.axhline(0, color=COLOR_CERO, linewidth=0.9, zorder=2)

    ax.plot(anios_obs, valores_obs, color=COLOR_LINEA, linewidth=2.2,
             zorder=3, solid_capstyle="round", label="Observado")
    ax.plot(anios_fc, valores_fc, color=COLOR_LINEA, linewidth=2.2,
             linestyle=(0, (4, 2)), zorder=3, solid_capstyle="round", label="Proyección BCRP")
    ax.scatter([2026, 2027], [proyeccion[2026], proyeccion[2027]],
                color=COLOR_LINEA, s=26, zorder=4)

    ax.set_xlim(anio_inicio - 0.5, 2027.6)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.spines["left"].set_visible(False)
    ax.grid(False)
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: f"{v:.0f}%"))
    ax.tick_params(axis="both", which="both", length=0, labelsize=8.5)

    # Dejo espacio arriba para las etiquetas de los episodios FEN y las
    # anotaciones de la proyección, una vez que matplotlib ya autoescaló el eje Y.
    fig.canvas.draw()
    ymin, ymax = ax.get_ylim()
    margen_top = (ymax - ymin) * 0.30
    ax.set_ylim(ymin - (ymax - ymin) * 0.04, ymax + margen_top)
    y_label_fen = ymax + margen_top * 0.42

    for ep in episodios:
        ini, fin = max(ep["inicio"], anio_inicio), min(ep["fin"], 2027.4)
        if fin <= anio_inicio:
            continue
        ax.text((ini + fin) / 2, y_label_fen, ep["label"], ha="center", va="bottom",
                 fontsize=7.2, color=COLOR_TEXTO_SECUNDARIO, linespacing=1.25)

    ax.annotate(
        f"{proyeccion[2026]:+.1f}%",
        xy=(2026, proyeccion[2026]), xytext=(2026, proyeccion[2026] - (ymax - ymin) * 0.16),
        ha="center", va="top", fontsize=9, color=COLOR_TEXTO_PRINCIPAL, fontweight="bold",
    )
    ax.annotate(
        f"{proyeccion[2027]:+.1f}%",
        xy=(2027, proyeccion[2027]), xytext=(2027, proyeccion[2027] + (ymax - ymin) * 0.13),
        ha="center", va="bottom", fontsize=9, color=COLOR_TEXTO_PRINCIPAL, fontweight="bold",
    )

    ax.set_title(
        "PBI primario: intensamente cíclico al ritmo del FEN",
        fontsize=12, color=COLOR_TEXTO_PRINCIPAL, fontweight="bold", loc="left", pad=28,
    )
    ax.text(
        0, 1.03,
        "El BCRP proyecta una nueva contracción en 2026 y recuperación en 2027, tras el FEN 2023-24",
        transform=ax.transAxes, fontsize=9, color=COLOR_TEXTO_SECUNDARIO, ha="left", va="bottom",
    )
    ax.text(
        1, -0.14,
        "Var. % interanual, anual  ·  sombreado: FEN Fuerte/Extraordinario  ·  punteado: proyección BCRP (RI Jun.26)",
        transform=ax.transAxes, fontsize=7, color=COLOR_TEXTO_SECUNDARIO, ha="right", va="top",
    )

    return ax


