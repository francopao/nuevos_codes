def _agregar_logo(fig):
    """Pego el logo de Integra en la esquina si el archivo existe; si no, sigo sin él."""
    if not os.path.isfile(ARCHIVO_LOGO):
        return
    try:
        logo = mpimg.imread(ARCHIVO_LOGO)
        ax_logo = fig.add_axes([0.90, 0.90, 0.09, 0.09], anchor="NE", zorder=10)
        ax_logo.imshow(logo)
        ax_logo.axis("off")
    except Exception:
        pass


def ensamblar_dashboard(nombres_charts, filas=1, columnas=1, figsize_por_chart=(10, 5)):
    """
    Armo la grilla del dashboard a partir de los nombres registrados en
    CHARTS_DASHBOARD. Con un solo chart hoy me basta 1x1, pero la grilla ya
    queda lista para cuando agregue más y solo tenga que ajustar filas/columnas.
    """
    ancho = figsize_por_chart[0] * columnas
    alto = figsize_por_chart[1] * filas
    fig, axes = plt.subplots(filas, columnas, figsize=(ancho, alto), dpi=170)

    if filas * columnas == 1:
        axes = [axes]
    else:
        axes = axes.flatten()

    for nombre, ax in zip(nombres_charts, axes):
        CHARTS_DASHBOARD[nombre](ax)

    for ax_sobrante in axes[len(nombres_charts):]:
        ax_sobrante.axis("off")

    _agregar_logo(fig)
    fig.patch.set_facecolor("white")
    fig.tight_layout(rect=[0, 0, 1, 0.97])
    return fig


def exportar_png(fig, nombre_archivo):
    """Exporto en alta resolución, listo para pegar directo en PowerPoint."""
    ruta = os.path.join(OUTPUT_DIR, nombre_archivo)
    fig.savefig(ruta, dpi=300, bbox_inches="tight", facecolor="white")
    return ruta


