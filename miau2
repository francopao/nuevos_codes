def _parse_valor(v):
    """Convierto a float, porque varias celdas del BCRP vienen como texto con coma decimal."""
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return float(v)
    s = str(v).strip().replace(",", ".")
    try:
        return float(s)
    except ValueError:
        return None


def cargar_primario_mensual(path_bcrp):
    """
    Leo la hoja 'Mensuales' y me quedo con la columna de Sectores Primarios
    (var. % interanual). La elijo como base porque es la única serie del archivo
    que trae el dato de primario completo y sin huecos, desde 1995.
    """
    wb = openpyxl.load_workbook(path_bcrp, data_only=True)
    ws = wb["Mensuales"]

    datos = []
    for row in ws.iter_rows(min_row=3, values_only=True):
        etiqueta = row[0]
        if not etiqueta:
            continue
        mes_txt, anio_txt = etiqueta[:3], etiqueta[3:]
        if mes_txt not in MESES:
            continue
        anio = int(anio_txt)
        anio = 2000 + anio if anio < 50 else 1900 + anio
        primario = _parse_valor(row[2])
        if primario is not None:
            datos.append((anio, MESES[mes_txt], primario))
    return datos


def construir_serie_anual_primario(datos_mensuales):
    """
    El archivo del BCRP no trae un agregado anual de PBI primario después de 1952
    (la hoja 'anual' deja de traer esa columna justo ahí), así que reconstruyo el
    dato anual como el promedio simple de las 12 variaciones interanuales mensuales
    de cada año. Solo calculo el promedio en años con los 12 meses completos, para
    no mezclar un año cerrado con uno parcial.
    """
    por_anio = defaultdict(list)
    for anio, _mes, valor in datos_mensuales:
        por_anio[anio].append(valor)

    serie = {anio: sum(vals) / len(vals) for anio, vals in por_anio.items() if len(vals) == 12}
    return dict(sorted(serie.items()))


def cargar_proyeccion_ri2026(path_bcrp):
    """
    Leo la fila de PBI primario del Reporte de Inflación 2026: el dato 2025 ya
    cerrado y la proyección más reciente del BCRP (RI Jun.26) para 2026 y 2027,
    que es la que uso para el tramo forecast del chart.
    """
    wb = openpyxl.load_workbook(path_bcrp, data_only=True)
    ws = wb["Reporte de Inflacion 2026"]

    encabezados = [c.value for c in next(ws.iter_rows(min_row=1, max_row=1))]

    fila_primario = None
    for row in ws.iter_rows(min_row=2, values_only=True):
        if row[0] and "primario" in str(row[0]).lower():
            fila_primario = row
            break
    if fila_primario is None:
        raise ValueError("No encontré la fila de PBI primario en 'Reporte de Inflacion 2026'.")

    valores = {encabezados[i]: _parse_valor(fila_primario[i]) for i in range(1, len(encabezados))}

    return {
        2025: valores.get(2025),
        2026: valores.get("2026 RI Jun.26*"),
        2027: valores.get("2027 RI Jun.26*"),
    }


def cargar_episodios_fen(path_memoria):
    """
    Leo el catálogo de FEN de la Memoria (hoja p41) y me quedo solo con los
    episodios Fuerte y Extraordinario: son los que de verdad mueven la aguja
    del PBI primario y los que quiero sombrear en el chart, sin saturarlo con
    los episodios Débil/Moderado que casi no dejan huella en la serie.
    """
    wb = openpyxl.load_workbook(path_memoria, data_only=True)
    ws = wb["p41"]

    episodios = []
    for row in ws.iter_rows(min_row=2, values_only=True):
        if row[0] is None:
            continue
        anio_ini, mes_ini, anio_fin, mes_fin, _duracion, magnitud = row
        if magnitud not in ("Fuerte", "Extraordinario"):
            continue
        inicio_dec = anio_ini + (mes_ini - 1) / 12
        fin_dec = anio_fin + (mes_fin - 1) / 12
        etiqueta_anios = f"{anio_ini}" if anio_ini == anio_fin else f"{anio_ini}-{str(anio_fin)[-2:]}"
        episodios.append({
            "inicio": inicio_dec,
            "fin": fin_dec,
            "magnitud": magnitud,
            "label": f"FEN {magnitud}\n{etiqueta_anios}",
        })
    return episodios


