import os
import datetime
import win32com.client as win32
import pythoncom


def _log(msg):
    """Log simple con marca de tiempo para identificar rápido en consola."""
    print("[{}] {}".format(datetime.datetime.now().strftime("%H:%M:%S"), msg))


def _enumerar_workbooks_abiertos():
    """
    Devuelve una lista de tuplas (excel_app, workbook) para TODOS los libros de Excel
    abiertos en cualquier instancia, usando la Running Object Table (ROT) de COM.
    Best-effort: si la ROT falla, devuelve lista vacía sin romper el flujo.
    """
    resultados = []
    try:
        contexto = pythoncom.CreateBindCtx(0)
        rot = pythoncom.GetRunningObjectTable()
    except Exception as e:
        _log("Aviso: no se pudo acceder a la Running Object Table: {}".format(e))
        return resultados

    try:
        monikers = list(rot)
    except Exception:
        try:
            monikers = list(rot.EnumRunning())
        except Exception as e:
            _log("Aviso: no se pudo enumerar la ROT: {}".format(e))
            return resultados

    for moniker in monikers:
        try:
            display = moniker.GetDisplayName(contexto, None)
        except Exception:
            display = ""
        # Los libros de Excel se exponen en la ROT con extensión de archivo Excel
        if not display or not display.lower().endswith(
            (".xlsx", ".xlsm", ".xlsb", ".xls", ".csv")
        ):
            continue
        try:
            obj = rot.GetObject(moniker)
            wb = win32.Dispatch(obj)
            _ = wb.Name           # valida que realmente es un Workbook
            app = wb.Application
            resultados.append((app, wb))
        except Exception:
            # No es un workbook manipulable; se ignora
            continue
    return resultados


def _resolver_workbook_destino(nombre_objetivo):
    """
    Localiza el libro destino por nombre (con o sin extensión, sin distinguir mayúsculas)
    primero en la instancia activa y luego en todas las instancias abiertas.
    Devuelve (excel_app, workbook). Si no se encuentra, lanza un error claro y accionable.
    """
    objetivo = str(nombre_objetivo).lower()
    objetivo_sin_ext = os.path.splitext(objetivo)[0]

    # 1) Instancia activa (comportamiento original, pero tolerante a fallos)
    excel_activo = None
    try:
        excel_activo = win32.GetActiveObject("Excel.Application")
    except Exception:
        excel_activo = None

    if excel_activo is not None:
        try:
            total = excel_activo.Workbooks.Count
            for k in range(1, total + 1):
                wb = excel_activo.Workbooks(k)
                n = str(wb.Name).lower()
                if n == objetivo or os.path.splitext(n)[0] == objetivo_sin_ext:
                    return excel_activo, wb
        except Exception as e:
            _log("Aviso: no se pudo inspeccionar la instancia activa: {}".format(e))

    # 2) Todas las instancias vía ROT
    abiertos = _enumerar_workbooks_abiertos()
    for app, wb in abiertos:
        try:
            n = str(wb.Name).lower()
        except Exception:
            continue
        if n == objetivo or os.path.splitext(n)[0] == objetivo_sin_ext:
            return app, wb

    # 3) No encontrado -> error claro
    disponibles = []
    for _, wb in abiertos:
        try:
            disponibles.append(str(wb.Name))
        except Exception:
            pass
    disponibles = sorted(set(disponibles))
    raise RuntimeError(
        "No se encontró el libro destino '{}' entre los libros de Excel abiertos.\n"
        "Libros actualmente abiertos: {}\n"
        "Abre '{}' en Excel antes de ejecutar esta celda.".format(
            nombre_objetivo, disponibles, nombre_objetivo
        )
    )


def _obtener_hoja(workbook, nombre_hoja):
    """Devuelve la hoja indicada o lanza un error claro listando las hojas disponibles."""
    try:
        return workbook.Worksheets(nombre_hoja)
    except Exception:
        hojas = []
        try:
            for k in range(1, workbook.Worksheets.Count + 1):
                hojas.append(str(workbook.Worksheets(k).Name))
        except Exception:
            pass
        raise RuntimeError(
            "No se encontró la hoja '{}' en el libro '{}'. Hojas disponibles: {}".format(
                nombre_hoja, getattr(workbook, "Name", "?"), hojas
            )
        )


def _nombre_hoja_unico(workbook, base):
    """Evita el error de nombre duplicado al recrear la hoja en re-ejecuciones."""
    existentes = set()
    try:
        for k in range(1, workbook.Worksheets.Count + 1):
            existentes.add(str(workbook.Worksheets(k).Name))
    except Exception:
        pass
    if base not in existentes:
        return base
    return "{}_{}".format(base, datetime.datetime.now().strftime("%Y%m%d_%H%M%S"))


def copiar_hoja_libro2_a_libro3():
    """
    Copia el contenido de 'Hoja1' de Libro2.xlsx a una nueva hoja en el libro destino
    (Libro3.xlsx) abierto en Excel. Mantiene el objetivo original con manejo robusto.
    """
    ruta_origen = r"C:\Users\p048530\Downloads\Libro2.xlsx"

    # Libro destino (abierto en Excel / OneDrive)
    excel, wb_destino = _resolver_workbook_destino("Libro3.xlsx")
    _log("Libro destino localizado: {}".format(getattr(wb_destino, "Name", "?")))

    # Validar archivo origen antes de abrirlo
    if not os.path.isfile(ruta_origen):
        raise FileNotFoundError(
            "No existe el archivo origen esperado:\n{}".format(ruta_origen)
        )

    # Abrir archivo origen en la MISMA instancia que tiene el libro destino
    try:
        wb_origen = excel.Workbooks.Open(ruta_origen)
    except Exception as e:
        raise RuntimeError(
            "No se pudo abrir el archivo origen '{}': {}".format(ruta_origen, e)
        )

    try:
        # Hojas
        ws_origen = _obtener_hoja(wb_origen, "Hoja1")

        # Crear una nueva hoja en el libro destino (nombre único para re-ejecuciones)
        ws_nueva = wb_destino.Worksheets.Add()
        nombre_final = _nombre_hoja_unico(wb_destino, "Hoja1_Copiada")
        ws_nueva.Name = nombre_final
        _log("Hoja destino creada: {}".format(nombre_final))

        # Copiar contenido
        ws_origen.UsedRange.Copy(ws_nueva.Range("A1"))

        # Guardar destino
        wb_destino.Save()
        _log("Contenido copiado y libro destino guardado.")
    finally:
        # Cerrar origen sin guardar, aunque haya ocurrido un error en el proceso
        try:
            wb_origen.Close(False)
        except Exception as e:
            _log("Aviso: no se pudo cerrar el libro origen: {}".format(e))


try:
    copiar_hoja_libro2_a_libro3()
    print("Proceso terminado.")
except Exception as e:
    # Fail-fast con contexto claro para identificar el problema al instante
    raise RuntimeError(
        "[BLOQUE COM] Error copiando Hoja1 de Libro2.xlsx a Libro3.xlsx -> {}: {}".format(
            type(e).__name__, e
        )
    ) from e

