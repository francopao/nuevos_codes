def hoja_actual(hoja):
    if not os.path.exists(ARCHIVO_SALIDA):
        return pd.DataFrame()
    try:
        return pd.read_excel(ARCHIVO_SALIDA, sheet_name=hoja, engine="openpyxl")
    except ValueError:
        return pd.DataFrame()


def juntar(viejo, nuevo, llave):
    if not nuevo:
        return viejo
    nuevo = pd.DataFrame(nuevo)
    junto = pd.concat([viejo, nuevo], ignore_index=True) if not viejo.empty else nuevo
    if "Fecha" in junto.columns:
        junto["Fecha"] = pd.to_datetime(junto["Fecha"], errors="coerce")
    llave = [c for c in llave if c in junto.columns]
    junto = junto.drop_duplicates(subset=llave, keep="last")
    return junto.sort_values(by=[c for c in ["Fecha"] + llave if c in junto.columns],
                              na_position="last").reset_index(drop=True)


