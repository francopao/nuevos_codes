PAT_PEORES = re.compile(r"^(\d{6})[ _]*Peores[ _]*Contribuyentes[ _]*BD", re.IGNORECASE)

COLS_PEORES = ["Fecha_Dato", "Afp", "Strategy", "Fondo", "AssetClass", "Factor",
               "Nombre", "Rating", "Weight", "Score", "ESG", "Controversies",
               "CO2_Sales", "Cod_OriginadorBU"]


def leer_peores_contribuyentes(archivo):
    wb = openpyxl.load_workbook(archivo["path"], data_only=True, read_only=True)
    ws = wb[wb.sheetnames[0]]
    grid = leer_grid(ws)
    wb.close()

    filas = []
    f, vacios = 2, 0
    while vacios < 20 and f <= len(grid) - 1:
        valores = [v(grid, f, c) for c in range(1, 15)]
        if all(x is None for x in valores):
            vacios += 1
            f += 1
            continue
        vacios = 0
        fila = dict(zip(COLS_PEORES, valores))
        if fila["Nombre"] not in (None, "", "#N/A", "#REF!"):
            fila["Weight"] = num(fila["Weight"])
            fila["Score"] = num(fila["Score"])
            fila["ESG"] = num(fila["ESG"])
            fila["Controversies"] = num(fila["Controversies"])
            fila["CO2_Sales"] = num(fila["CO2_Sales"])
            fila["Fecha"] = archivo["fecha"]
            filas.append(fila)
        f += 1
    return filas


