ORDEN_RATINGS = ["AAA", "AA", "A", "BBB", "BB", "B", "CCC", "Not Rated"]


def rating_distribution(grid, fila_aaa, col_label, c_comp, c_fun, c_tot):
    filas, f = [], fila_aaa
    for rating in ORDEN_RATINGS:
        etq = v(grid, f, col_label)
        if str(etq).strip() if etq is not None else None != rating:
            if (str(etq).strip() if etq is not None else None) != rating:
                break
        filas.append({"Rating": rating, "Companies": num(v(grid, f, c_comp)),
                       "Funds": num(v(grid, f, c_fun)), "Total": num(v(grid, f, c_tot))})
        f += 1
    return filas


def leer_msci(archivo):
    wb = openpyxl.load_workbook(archivo["path"], data_only=True, read_only=True)
    ws = wb["Portfolio Report"]
    grid = leer_grid(ws)
    wb.close()

    base = {"Fecha": archivo["fecha"], "Fondo": archivo["fondo"], "Variante": archivo["variante"]}
    out = {"mv_coverage": [], "scorecard": [], "rating_dist": [],
           "rating_summary": [], "rating_momentum": [], "risk": []}

    # fecha "as of" real del reporte (distinta al mes-llave del nombre de archivo)
    fecha_reporte = next((v(grid, f, 127) for f in range(90, 115)
                          if isinstance(v(grid, f, 127), (datetime, date))), None)
    base["Fecha_Reporte_MSCI"] = fecha_reporte

    for etq, nombre, cp, cb, ca in SCORECARD:
        f = fila_con_etiqueta(grid, 2, etq, *V_SCORECARD)
        if f:
            out["scorecard"].append({**base, "Metrica": nombre, "Portfolio": num(v(grid, f, cp)),
                                      "Benchmark": num(v(grid, f, cb)), "Activo": num(v(grid, f, ca))})

    f0, f1 = V_RATING_DIST
    filas_aaa = [f for f in range(f0, min(f1, len(grid) - 1) + 1)
                 if str(v(grid, f, 127) or "").strip() == "AAA"]
    for dim, f_aaa in zip(["Overall", "Environmental"], filas_aaa):
        for fila in rating_distribution(grid, f_aaa, 127, 128, 129, 130):
            out["rating_dist"].append({**base, "Dimension": dim, **fila})

    f0, f1 = V_RISK
    for grupo, etq, cp, cb, ca in RIESGO_AMBIENTAL:
        f = fila_con_etiqueta(grid, 2, etq, f0, f1)
        if f:
            out["risk"].append({**base, "Grupo": grupo, "Metrica": etq.replace("\n", " "),
                                 "Portfolio": num(v(grid, f, cp)), "Benchmark": num(v(grid, f, cb)),
                                 "Activo": num(v(grid, f, ca))})
    for etq, cp, cb, ca in RIESGO_REPUTACIONAL:
        f = fila_con_etiqueta(grid, 43, etq, f0, f1)
        if f:
            out["risk"].append({**base, "Grupo": "Reputational Risk", "Metrica": etq,
                                 "Portfolio": num(v(grid, f, cp)), "Benchmark": num(v(grid, f, cb)),
                                 "Activo": num(v(grid, f, ca))})
    for etq, cp, cb, ca in RIESGO_GOBIERNO:
        f = fila_con_etiqueta(grid, 84, etq, f0, f1)
        if f:
            out["risk"].append({**base, "Grupo": "Governance Risk", "Metrica": etq,
                                 "Portfolio": num(v(grid, f, cp)), "Benchmark": num(v(grid, f, cb)),
                                 "Activo": num(v(grid, f, ca))})

    f_leader = fila_con_etiqueta(grid, 127, "Leader", *V_RATING_SUMMARY)
    if f_leader:
        for i, cat in enumerate(["Leader", "Average", "Laggard", "Not Covered"]):
            f = f_leader + i
            if str(v(grid, f, 127) or "").strip() != cat:
                break
            out["rating_summary"].append({
                **base, "Categoria": cat,
                "Portfolio_Companies": num(v(grid, f, 128)), "Portfolio_Funds": num(v(grid, f, 129)),
                "Portfolio_Total": num(v(grid, f, 130)), "Benchmark_Companies": num(v(grid, f, 131)),
                "Benchmark_Funds": num(v(grid, f, 132)), "Benchmark_Total": num(v(grid, f, 133)),
            })

    f_up = fila_con_etiqueta(grid, 127, "Upward", *V_RATING_MOMENTUM)
    if f_up:
        for i, cat in enumerate(["Upward", "Stable", "Downward", "Not Rated"]):
            f = f_up + i
            if str(v(grid, f, 127) or "").strip() != cat:
                break
            out["rating_momentum"].append({
                **base, "Categoria": cat,
                "Portfolio_Companies": num(v(grid, f, 128)), "Portfolio_Funds": num(v(grid, f, 129)),
                "Portfolio_Govt": num(v(grid, f, 130)), "Portfolio_Total": num(v(grid, f, 131)),
                "Benchmark_Companies": num(v(grid, f, 132)), "Benchmark_Funds": num(v(grid, f, 133)),
                "Benchmark_Govt": num(v(grid, f, 134)), "Benchmark_Total": num(v(grid, f, 135)),
            })

    f_port = fila_con_etiqueta(grid, 2, "Portfolio", *V_MV_COVERAGE)
    f_bench = fila_con_etiqueta(grid, 2, "Primary Benchmark", *V_MV_COVERAGE)
    categorias = [("ESG Quality", 45), ("Carbon Risk", 65), ("Reputational Risk", 85), ("Governance Risk", 105)]
    for serie, fila_serie in [("Portfolio", f_port), ("Primary Benchmark", f_bench)]:
        if fila_serie:
            for cat, col in categorias:
                out["mv_coverage"].append({**base, "Serie": serie, "Categoria": cat,
                                            "Cobertura_pct": num(v(grid, fila_serie, col))})
    return out


