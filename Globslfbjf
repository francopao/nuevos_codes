# 4) Cobertura de holdings (sale de "Analisis BD")
# ---------------------------------------------------------------------------
# Analisis BD tiene una fila por ISIN x Fondo (varios miles por mes), pero lo
# único que necesitamos de ahí es el % de cobertura por Fondo x Afp -- no hay
# que guardar el detalle línea por línea en el maestro, solo el agregado.
# (si alguna vez hace falta el detalle, está en el archivo original de la
# carpeta "Base Comité Mensual"). BD1_S no aporta nada que no esté ya acá,
# así que no se procesa.

PAT_ANALISIS_BD = re.compile(r"(\d{6})[ _]*Analisis[ _]*BD", re.IGNORECASE)

# posiciones de columna dentro de "Analisis BD" (66 columnas en total)
COL_ISIN, COL_WEIGHT, COL_FONDO, COL_AFP, COL_COBERTURA = 3, 4, 5, 8, 53


def grupo_afp(afp):
    # Las fórmulas de cobertura que se usaban en la hoja "BD1_S" agrupaban
    # todo lo que no fuera Integra (Habitat/Profuturo/Prima/Ex_Integra) en
    # un solo bucket "Ex_Integra". Se mantiene esa misma agrupación acá.
    return "Integra" if afp == "Integra" else "Ex_Integra"


def leer_cobertura_analisis_bd(archivo):
    wb = openpyxl.load_workbook(archivo["path"], data_only=True, read_only=True)
    ws = wb[wb.sheetnames[0]]
    grid = leer_grid(ws)
    wb.close()
    fecha = archivo["fecha"]

    if str(v(grid, 1, COL_ISIN) or "").strip() != "ISIN":
        raise ValueError("cambió el layout de Analisis BD, columna ISIN ya no está donde se esperaba")

    filas, f, vacios = [], 2, 0
    while vacios < 50 and f <= len(grid) - 1:
        isin = v(grid, f, COL_ISIN)
        if isin in (None, "", "#N/A", "#REF!"):
            vacios += 1
            f += 1
            continue
        vacios = 0
        filas.append({
            "Fondo": v(grid, f, COL_FONDO),
            "AfpGrupo": grupo_afp(v(grid, f, COL_AFP)),
            "Weight": num(v(grid, f, COL_WEIGHT)),
            "Cobertura": v(grid, f, COL_COBERTURA),
        })
        f += 1

    if not filas:
        return []

    # % cobertura = Weight cubierto / Weight total, por Fondo x AfpGrupo
    # (reemplaza el SUMIFS que vivía en la hoja "BD1_S", rango R1:Y21)
    df = pd.DataFrame(filas)
    cobertura = []
    for (fondo, afp_grupo), g in df.groupby(["Fondo", "AfpGrupo"]):
        cov = g.loc[g["Cobertura"] == "Cov", "Weight"].sum()
        nocov = g.loc[g["Cobertura"] == "NoCov", "Weight"].sum()
        total = cov + nocov
        cobertura.append({"Fecha": fecha, "Fondo": fondo, "AfpGrupo": afp_grupo,
                           "Cov": cov, "NoCov": nocov, "Total": total,
                           "Cobertura_pct": (cov / total) if total else None})
    return cobertura


