PAT_TEMATICA = re.compile(r"(\d{6})(?=\.xls[xm]$)", re.IGNORECASE)


def leer_graf_pie(archivo):
    wb = openpyxl.load_workbook(archivo["path"], data_only=True, read_only=True)
    ws = wb["GRAF PIE"]
    grid = leer_grid(ws)
    wb.close()
    fecha = archivo["fecha"]

    resumen = []
    for f in range(2, 5):
        cat = v(grid, f, 1)
        if cat is not None:
            resumen.append({"Fecha": fecha, "Categoria": str(cat).strip(), "Inv_MMUSD": num(v(grid, f, 2))})

    detalle = []
    clase = None
    for f in range(2, 11):
        clase_celda = v(grid, f, 8)
        emisor, etiqueta, aum, pct = v(grid, f, 9), v(grid, f, 10), v(grid, f, 11), v(grid, f, 12)
        if clase_celda is not None:
            clase = str(clase_celda).strip()
        if emisor is None and aum is None:
            continue
        detalle.append({
            "Fecha": fecha, "Clase": clase, "Es_Total": bool(clase and clase.lower().startswith("total")),
            "Emisor": str(emisor).strip() if emisor is not None else None,
            "Etiqueta": str(etiqueta).strip() if etiqueta is not None else None,
            "AUM_MMUSD": num(aum), "Pct_Clase_Activo": num(pct),
        })

    return resumen, detalle


