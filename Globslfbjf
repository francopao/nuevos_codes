def num(v):
    """Castea a float sin romperse con celdas vacías, '#N/A', '-', etc."""
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return None if pd.isna(v) else float(v)
    s = str(v).strip().replace("%", "").replace(",", ".")
    if s in ("", "N/A", "n/a", "#N/A", "#REF!", "-"):
        return None
    try:
        return float(s)
    except ValueError:
        return None


def fecha_de_yyyymm(s):
    return date(int(s[0:4]), int(s[4:6]), 1)


def fecha_de_mmyyyy(s):
    return date(int(s[2:6]), int(s[0:2]), 1)


def leer_grid(ws):
    """ws.cell(fila, col) es lentísimo en modo read_only (vuelve a escanear
    la hoja en cada llamada). Mejor cargar todo una vez con iter_rows y
    después leer del arreglo en memoria."""
    filas = [()]
    for fila in ws.iter_rows(values_only=True):
        filas.append(fila)
    return filas


def v(grid, fila, col):
    if fila <= 0 or fila >= len(grid):
        return None
    f = grid[fila]
    return f[col - 1] if 0 < col <= len(f) else None


def fila_con_etiqueta(grid, col, etiqueta, f0, f1):
    """Primera fila entre f0 y f1 donde la columna `col` dice exactamente
    `etiqueta`. MSCI no siempre deja el layout en la misma fila de un mes a
    otro, así que mejor buscar por texto que confiar en el número de fila."""
    for f in range(f0, min(f1, len(grid) - 1) + 1):
        val = v(grid, f, col)
        if val is not None and str(val).strip() == etiqueta:
            return f
    return None


def listar_archivos(carpeta, patron, orden="yyyymm"):
    if not os.path.isdir(carpeta):
        return []
    convertir = fecha_de_yyyymm if orden == "yyyymm" else fecha_de_mmyyyy
    archivos = []
    for nombre in os.listdir(carpeta):
        if nombre.startswith("~$") or not nombre.lower().endswith((".xlsx", ".xlsm")):
            continue
        m = patron.search(nombre)
        if not m:
            continue
        try:
            fecha = convertir(m.group(1))
        except ValueError:
            continue
        archivos.append({"path": os.path.join(carpeta, nombre), "nombre": nombre, "fecha": fecha})
    return archivos


