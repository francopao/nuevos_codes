def copy_file_to_directory(source, des):
    """Copia el archivo base a la carpeta de backups. No detiene el proceso si falla."""
    try:
        if not os.path.exists(source):
            print(f"[AVISO] No existe el archivo fuente para backup: {source}")
            return
        if not os.path.exists(des):
            os.makedirs(des)
        file_name = os.path.basename(source)
        dest_file = os.path.join(des, file_name)
        shutil.copyfile(source, dest_file)
        print("[OK] Backup creado correctamente.")
    except Exception as e:
        print(f"[ERROR] No se pudo crear el backup: {e}")


