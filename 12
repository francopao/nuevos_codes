    DF_Total2 = DF_Total2.loc[DF_Total2['Indicador'].isin([np.nan])].sort_index(ignore_index=True)
    DF_Total2 = DF_Total2.drop(['Indicador'], axis=1)
    n_nuevas = len(DF_Total2)
    BD_Total = pd.concat([BD_Total, DF_Total2])

    # Volcado de la columna del periodo
    DF_Total = DF_Total.set_index("key")
    dic_cr = DF_Total.to_dict()
    fecha_str = '01' + '/' + meses_n[meses_.index(mes_)] + '/' + anio
    fecha_col = datetime.datetime.strptime(fecha_str, '%d/%m/%Y')
    BD_Total[fecha_col] = BD_Total['key'].map(dic_cr[fecha_col])

    with pd.ExcelWriter(RUTA_BASE, mode="a", engine="openpyxl",
                        if_sheet_exists='replace') as writer:
        BD_Total.to_excel(writer, sheet_name="Castigos", index=False)

    print(f"   [OK] Escritura completada. Filas nuevas agregadas: {n_nuevas}.")


