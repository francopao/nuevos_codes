def renombrar_columnas_por_posicion(df, mapping):
    """Renombra columnas por índice posicional de forma segura."""
    cols = list(df.columns)
    for pos, nombre in mapping.items():
        if pos < len(cols):
            cols[pos] = nombre
        else:
            print(f"   [AVISO] No existe la columna en posición {pos} "
                  f"(el DF tiene {len(cols)} columnas). No se renombró a '{nombre}'.")
    df.columns = cols
    return df


def resolver_archivo(subcarpeta, codigo, mes_, anio, etiqueta):
    """
    Devuelve la ruta del archivo del mes; si no existe, cae al mes anterior.
    Lanza FileNotFoundError con mensaje claro si tampoco existe el mes anterior.
    """
    base_dir = PREF_DESCARGAS + subcarpeta + "\\"
    archivo = f"{base_dir}{codigo}-{mes_}{anio}.XLS"
    if os.path.isfile(archivo):
        return archivo

    print(f"   [AVISO] {etiqueta}: no se halló '{codigo}-{mes_}{anio}.XLS'. "
          f"Probando mes anterior...")
    idx = meses_.index(mes_)
    mn = meses_n[idx]
    if mn == '01':
        mesA = '12'
        a = str(int(anio) - 1)
    else:
        mesA = str(int(mn) - 1).zfill(2)
        a = anio
    mesB = MESES_ABREV.get(mesA)
    archivo = f"{base_dir}{codigo}-{mesB}{a}.XLS"
    if not os.path.isfile(archivo):
        raise FileNotFoundError(
            f"{etiqueta}: no se encontró archivo para {mes_}{anio} "
            f"ni para el mes anterior ({mesB}{a}). Ruta esperada: {archivo}")
    print(f"   [AVISO] {etiqueta}: usando fallback del mes anterior ({mesB}{a}).")
    return archivo


def convertir_numerico(df):
    """
    Convierte a numérico todas las columnas salvo la primera (Detallada).
    Usa isetitem (asignación posicional de columna completa) para permitir el
    cambio de dtype y así EVITAR el error 'Invalid value for dtype str' que
    ocurría con DF.iloc[:, 1:] = ...  (asignación in-place que preservaba el dtype).
    """
    for pos in range(1, df.shape[1]):
        df.isetitem(pos, pd.to_numeric(df.iloc[:, pos], errors="coerce"))
    return df


def _aplicar_diccionario(row, dic_ren):
    """Renombra 'Detallada' según el diccionario; si no está, deja el valor original."""
    try:
        return dic_ren['Nombre_Nuevo'][row["Detallada"]]
    except Exception:
        return row["Detallada"]


def leer_y_limpiar(archivo, etiqueta, dropna_numerico=False, filtro_no_cero=False):
    """Lee el XLS de la SBS, recorta cabecera y limpia. Devuelve el DF listo para transponer."""
    DF = pd.read_excel(archivo, sheet_name=0)

    if DF.shape[1] <= 3:
        raise ValueError(f"{etiqueta}: el archivo tiene solo {DF.shape[1]} columnas; "
                         f"estructura inesperada -> {archivo}")

    # Recorta filas hasta la primera no nula de la columna 3
    for index, row in enumerate(DF.iloc[:, 3]):
        if not pd.isnull(row):
            break
        DF.drop(index, inplace=True)

    if DF.empty:
        raise ValueError(f"{etiqueta}: DF vacío tras recortar cabecera -> {archivo}")

    DF.columns = DF.iloc[0, ::]
    DF.drop(DF.index[0], inplace=True)
    DF = DF.dropna(axis=1, how="all")
    DF = DF.dropna(how="all")

    if filtro_no_cero:
        DF = DF.loc[(DF != 0).any(axis=1)]

    if DF.shape[1] <= 8:
        print(f"   [AVISO] {etiqueta}: DF con {DF.shape[1]} columnas; "
              f"no se pudo mapear la posición 8 ('Total').")

    DF = renombrar_columnas_por_posicion(DF, {0: "Detallada"})
    DF = renombrar_columnas_por_posicion(DF, {8: "Total"})

    if dropna_numerico:
        DF = DF.dropna()
        DF = convertir_numerico(DF)   # <-- fix del error original
        DF = DF.fillna(0)

    if DF.empty:
        raise ValueError(f"{etiqueta}: DF vacío tras la limpieza -> {archivo}")

    return DF


def transformar_y_construir(DF, institucion, mes_, anio, dic_ren, limpiar_check=False):
    """Aplica diccionario, transpone y arma la base larga para una institución."""
    DF["Detallada"] = DF.apply(lambda r: _aplicar_diccionario(r, dic_ren), axis=1)
    DF = DF.T
    DF = DF.reset_index()
    DF.columns = DF.iloc[0, ::]
    DF = DF.drop([0])
    DF["Detallada"] = DF.apply(lambda r: _aplicar_diccionario(r, dic_ren), axis=1)
    DF = DF.dropna(axis=1, how="all")

    if limpiar_check:
        nan_columns = [col for col in DF.columns if pd.isnull(col)]
        if nan_columns:
            DF = DF.drop(columns=nan_columns)
        if "CHECK TOTALES EDP" in DF.columns:
            DF = DF.drop("CHECK TOTALES EDP", axis=1)

    fecha_str = '01' + '/' + meses_n[meses_.index(mes_)] + '/' + anio
    fecha_col = datetime.datetime.strptime(fecha_str, '%d/%m/%Y')

    base = pd.DataFrame()
    for i in range(0, len(DF.columns) - 1):
        a = DF.columns[1::][i]
        DF_1 = DF.get(['Detallada']).copy()
        DF_1.insert(0, "Tipo", "Riesgo Crediticio")
        DF_1.insert(0, 'Nombre', a)
        DF_1.insert(0, 'Moneda', "MN")
        DF_1.insert(0, 'Institución', institucion)
        DF_1.insert(1, 'Estructura', "Castigos")
        DF_1.insert(6, fecha_col, DF[a])
        base = pd.concat([base, DF_1])

    print(f"   [OK] {institucion}: {len(DF.columns) - 1} entidades procesadas.")
    return base


