```python
def construir_excel_graficos(ruta_historico, ruta_salida,
                              bd_instrumentos: pd.DataFrame = None) -> str:
    """Genera Datos_Graficos_Huella.xlsx: hoja 'BD' única a nivel
    instrumento (fuente de Huella/Intensidad Soberanos y Huella/Intensidad
    por Sector vía SUMIFS), más Intensidad FFMM / Intensidad y Benchmarks /
    Mayores contribuyentes (desde HISTORICO) + Auditoría."""
    hist = HistoricoExporter(str(ruta_historico)).cargar_historico()
    if hist.empty:
        raise ValueError("El histórico está vacío: ejecutar el pipeline primero.")
    hist = hist.copy()
    hist["FECHA_CORTE"] = hist["FECHA_CORTE"].astype(str)
    for c in ["DIM_1", "DIM_2", "DIM_3", "OBJETO", "METRICA"]:
        if c in hist.columns:
            hist[c] = hist[c].fillna("").astype(str)
    if "AFP" not in hist.columns:
        hist["AFP"] = "Integra"
    else:
        hist["AFP"] = hist["AFP"].fillna("Integra").astype(str)
    hist["VALOR"] = pd.to_numeric(hist["VALOR"], errors="coerce").fillna(0.0).round(6)

    # --- BD: fusiona lo nuevo de esta corrida con lo ya acumulado (si el
    # archivo de salida ya existe), purgando los cortes que se reprocesan.
    bd_nuevo = bd_instrumentos.copy() if bd_instrumentos is not None else pd.DataFrame()
    if not bd_nuevo.empty:
        bd_nuevo["Corte"] = bd_nuevo["Corte"].astype(str)
    bd_prev = _cargar_bd_existente(ruta_salida)
    if not bd_prev.empty and "Corte" in bd_prev.columns and not bd_nuevo.empty:
        cortes_nuevos = set(bd_nuevo["Corte"].unique())
        bd_prev = bd_prev[~bd_prev["Corte"].astype(str).isin(cortes_nuevos)]
    bd = (pd.concat([bd_prev, bd_nuevo], ignore_index=True)
          if not bd_prev.empty else bd_nuevo)

    if not bd.empty:
        bd["Corte"] = bd["Corte"].astype(str)
        bd = _agregar_emisor_limpio(bd)
        cols_final = ["Corte", "AFP", "Fondo", "Portafolio", "SBS", "ISIN", "Estrategia",
                      "Universo", "Categoria", "Tipo_Dato", "Pais", "Nombre_Original",
                      "Emisor", "PERDIO_HUELLA", "CO2-H", "Weight", "Inv_MM_USD",
                      "Huella", "Intensidad"]
        for c in cols_final:
            if c not in bd.columns:
                bd[c] = ""
        bd = bd[cols_final].reset_index(drop=True)
        col_co2h = get_column_letter(cols_final.index("CO2-H") + 1)
        col_weight = get_column_letter(cols_final.index("Weight") + 1)
        col_inv = get_column_letter(cols_final.index("Inv_MM_USD") + 1)
        filas_excel = range(2, len(bd) + 2)
        bd["Huella_Verif"] = [f"={col_co2h}{r}*{col_inv}{r}" for r in filas_excel]
        bd["Intensidad_Verif"] = [f"={col_co2h}{r}*{col_weight}{r}" for r in filas_excel]

    cortes = sorted(set(hist["FECHA_CORTE"].unique())
                     | (set(bd["Corte"].unique()) if not bd.empty else set()))
    corte_actual, corte_comparacion, rol_map = _corte_rol_map(cortes)

    _anio = corte_actual[:4] if len(corte_actual) >= 6 else "2026"
    _mes = corte_actual[4:6] if len(corte_actual) >= 6 else "06"
    bench_ffmm = _cargar_benchmarks_ffmm(_anio, _mes)

    hojas = {
        NOMBRE_HOJA_ASSET_PERF: _tabla_asset_perf(hist, rol_map, corte_actual, bench_ffmm),
        NOMBRE_HOJA_COMP_BENCH: _tabla_comp_bench_afp(hist, rol_map),
        NOMBRE_HOJA_CONTRIB_BUTD: _tabla_contrib_butd(hist, rol_map),
        NOMBRE_HOJA_AUDITORIA: _tabla_auditoria(corte_actual, corte_comparacion),
    }

    ruta = FsPath(str(ruta_salida))
    ruta.parent.mkdir(parents=True, exist_ok=True)
    with pd.ExcelWriter(str(ruta), engine="openpyxl") as xw:
        (bd if not bd.empty else pd.DataFrame({"Aviso": ["Sin datos"]})) \
            .to_excel(xw, sheet_name=NOMBRE_HOJA_BD, index=False)
        for nombre in (NOMBRE_HOJA_SOBERANOS_HUELLA, NOMBRE_HOJA_SOBERANOS_INT,
                       NOMBRE_HOJA_SECTOR_HUELLA, NOMBRE_HOJA_SECTOR_INT):
            xw.book.create_sheet(nombre)
        for nombre, df in hojas.items():
            (df if not df.empty else pd.DataFrame({"Aviso": ["Sin datos"]})) \
                .to_excel(xw, sheet_name=nombre[:31], index=False)

        fila_max_bd = len(bd) + 1
        _agregar_chart_soberanos(xw.sheets[NOMBRE_HOJA_SOBERANOS_HUELLA], bd, "Huella",
                                  corte_actual, corte_comparacion, fila_max_bd)
        _agregar_chart_soberanos(xw.sheets[NOMBRE_HOJA_SOBERANOS_INT], bd, "Intensidad",
                                  corte_actual, corte_comparacion, fila_max_bd)
        _agregar_chart_sector(xw.sheets[NOMBRE_HOJA_SECTOR_HUELLA], bd, "Huella",
                               corte_actual, corte_comparacion, fila_max_bd)
        _agregar_chart_sector(xw.sheets[NOMBRE_HOJA_SECTOR_INT], bd, "Intensidad",
                               corte_actual, corte_comparacion, fila_max_bd)

    print(f"  [Módulo 15] Datos_Graficos_Huella -> {ruta}")
    return str(ruta)
