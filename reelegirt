def _agregar_chart_soberanos(ws, bd: pd.DataFrame, metrica: str, corte_actual: str,
                              corte_comparacion: str, fila_max_bd: int) -> None:
    """Misma presentación de siempre (sin título, sin cuadrícula, sin
    leyenda, país dentro de cada segmento, caja 'Total: X', variación %),
    pero la tabla-resumen ahora lee con SUMIFS desde la hoja 'BD'
    (Universo='Soberanos') en vez de una tabla local."""
    if bd.empty or fila_max_bd < 2:
        return
    d = bd[(bd["Universo"] == "Soberanos") & (bd["AFP"] == "Integra")
           & (bd["Corte"].isin([corte_actual, corte_comparacion]))]
    if d.empty:
        return
    tot_por_pais = d.groupby("Pais")[metrica].sum()
    paises = [p for p in tot_por_pais.index if abs(tot_por_pais[p]) > 1e-9]

    def _clave_orden(p):
        try:
            i = ORDEN_PAISES.index(p)
        except ValueError:
            i = 999
        return (i, -tot_por_pais.get(p, 0.0))
    paises = sorted(paises, key=_clave_orden)
    if not paises:
        return

    col_metrica = "R" if metrica == "Huella" else "S"
    col_label = ws.max_column + 2
    col_total = col_label + 1 + len(paises)
    col_var = col_total + 1
    fila_r = 1

    ws.cell(row=fila_r, column=col_label, value="Corte")
    for j, pais in enumerate(paises):
        ws.cell(row=fila_r, column=col_label + 1 + j, value=pais)
    ws.cell(row=fila_r, column=col_total, value="Total")

    for i, corte_val in enumerate([corte_comparacion, corte_actual]):
        fr = fila_r + 1 + i
        ws.cell(row=fr, column=col_label, value=_etiqueta_corte(corte_val))
        for j, pais in enumerate(paises):
            col_l = get_column_letter(col_label + 1 + j)
            f = (f"=SUMIFS('BD'!${col_metrica}$2:${col_metrica}${fila_max_bd},"
                 f"'BD'!$H$2:$H${fila_max_bd},\"Soberanos\","
                 f"'BD'!$B$2:$B${fila_max_bd},\"Integra\","
                 f"'BD'!$K$2:$K${fila_max_bd},{col_l}${fila_r},"
                 f"'BD'!$A$2:$A${fila_max_bd},\"{corte_val}\")")
            ws.cell(row=fr, column=col_label + 1 + j, value=f)
        rango_fila = (f"{get_column_letter(col_label+1)}{fr}:"
                      f"{get_column_letter(col_label+len(paises))}{fr}")
        ws.cell(row=fr, column=col_total, value=f"=SUM({rango_fila})")

