def _limpiar_emisor(nombre) -> str:
    """Quita asteriscos sobrantes (en cualquier posición) y espacios
    repetidos. El asterisco final se repone después solo para
    Perdieron Huella."""
    s = str(nombre or "").strip()
    s = re.sub(r"\*+", "", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s


def _clave_norm_emisor(nombre: str) -> str:
    """Clave de agrupación: mayúsculas, sin tildes, sin puntuación —
    para que 'peru', 'PERU' y 'Perú' caigan en el mismo grupo."""
    s = _limpiar_emisor(nombre).upper()
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode("ascii")
    s = re.sub(r"[^A-Z0-9 ]", "", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s


def _riqueza_variante(s: str) -> tuple:
    """Puntaje para elegir la variante 'oficial' dentro de un grupo: más
    caracteres acentuados, luego más minúsculas (Title Case > MAYÚSCULAS)."""
    acentos = sum(1 for ch in s if unicodedata.normalize("NFKD", ch) != ch)
    minusculas = sum(1 for ch in s if ch.islower())
    return (acentos, minusculas)


def _agregar_emisor_limpio(bd: pd.DataFrame) -> pd.DataFrame:
    """Agrega la columna Emisor (limpia y canonicalizada) a partir de
    Nombre_Original. Solo lleva '*' final si PERDIO_HUELLA es True."""
    bd = bd.copy()
    limpio = bd["Nombre_Original"].map(_limpiar_emisor)
    clave = limpio.map(_clave_norm_emisor)
    tmp = pd.DataFrame({"limpio": limpio, "clave": clave})
    oficial_por_clave = {}
    for clave_g, grupo in tmp.groupby("clave"):
        if clave_g == "":
            continue
        conteo = grupo["limpio"].value_counts()
        mejor = max(conteo.index, key=lambda v: (_riqueza_variante(v), conteo[v]))
        oficial_por_clave[clave_g] = mejor
    emisor = clave.map(oficial_por_clave).fillna(limpio)
    perdio = (bd["PERDIO_HUELLA"].fillna(False).astype(bool)
              if "PERDIO_HUELLA" in bd.columns else pd.Series(False, index=bd.index))
    bd["Emisor"] = emisor.where(~perdio, emisor + "*")
    return bd


def _cargar_bd_existente(ruta_salida) -> pd.DataFrame:
    """Lee la hoja 'BD' del Datos_Graficos_Huella.xlsx anterior, si existe,
    para acumular cortes entre corridas (una sola lectura, no por AFP)."""
    ruta = FsPath(str(ruta_salida))
    if not ruta.exists():
        return pd.DataFrame()
    try:
        return pd.read_excel(str(ruta), sheet_name=NOMBRE_HOJA_BD, engine="openpyxl")
    except Exception:
        return pd.DataFrame()


