def _col_ci(df: pd.DataFrame, *candidatos: str) -> str:
    """Devuelve el nombre REAL de columna que matchee (case/espacio-insensible)
    alguno de los candidatos. Si no hay match, lanza KeyError mostrando las
    columnas disponibles para poder diagnosticar rápido."""
    norm = {str(c).strip().lower(): c for c in df.columns}
    for cand in candidatos:
        real = norm.get(cand.strip().lower())
        if real is not None:
            return real
    raise KeyError(f"No se encontró ninguna de {candidatos} en columnas: {list(df.columns)}")


```

