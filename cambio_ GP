**AGREGA DEBAJO** (todo este bloque, antes de `# ---- Precios`):
```python
    b.qest_rf = leer_xlsx(R_QEST, 'DQ_RF')

    # ========================================================================
    #  QEST %Fondo -> reemplaza el posicionamiento absoluto de Integra (INF1/
    #  2/3) que antes venía de G&P/Detallado. El GAP sigue viniendo de G&P sin
    #  tocarse: competencia = INF_nuevo - GAP (misma fórmula de operaciones()).
    #  Sin match en QEST -> se reporta y se EXCLUYE (sin fallback, por decisión
    #  explícita). Se renormaliza a 100% ANTES de que operaciones() filtre
    #  Asset Class, porque CAJ/DPZ/CPC/CPP sí pesan y deben estar en el
    #  denominador (si no, lo que sobrevive al filtro no cerraría en el 100%).
    # ========================================================================
    qin_pct = leer_xlsx(R_QEST, 'DQ_IN')          # cacheado: no vuelve a tocar red
    qin_pct.columns = qin_pct.iloc[10, ::]
    qin_pct = qin_pct.drop([10], axis=0)
    qpct = qin_pct[(qin_pct['Dato'] == '%Fondo') &
                   (qin_pct['Fecha'] == datetime.fromisoformat(b.fecha_iso + ' 00:00:00'))]
    if qpct.empty:
        raise ProcesoError(f"QEST DQ_IN: no hay fila '%Fondo' para {b.fecha_iso}. "
                            f"Verifica que QEST esté actualizado a ese corte.")
    tp = qpct.transpose(); tp.columns = tp.iloc[0, ::]
    dic_pct = tp.to_dict()   # dic_pct['IN-FONDO1'][col_qest] = peso (fracción)

    _META_QEST = {'Fondo', 'Dato', 'Fecha', 'SBS', 'VALFON'}  # 'SBS' aquí = id compuesto, no código
    _FONDO_KEYS = {'INF1': 'IN-FONDO1', 'INF2': 'IN-FONDO2', 'INF3': 'IN-FONDO3'}

    b.qest_pct_universo = {}   # fondo -> {col_qest: peso renormalizado} (incluye CAJ/DPZ/CPC/CPP)
    print("\n--- [QEST %Fondo] Cuadre antes de renormalizar (esperado ~1.0) ---")
    for nombre_inf, fondo_key in _FONDO_KEYS.items():
        serie = {k: v for k, v in dic_pct[fondo_key].items()
                 if k not in _META_QEST and isinstance(v, (int, float))}
        suma = sum(serie.values())
        print(f"  {fondo_key}: suma={suma:.6f} (n={len(serie)}) -> renormalizando a 1.0")
        if suma <= 0:
            raise ProcesoError(f"QEST DQ_IN: suma de %Fondo de {fondo_key} = {suma} (se esperaba ~1.0).")
        b.qest_pct_universo[nombre_inf] = {k: v / suma for k, v in serie.items()}

    # --- Sustitución INF1/INF2/INF3 (solo SBS que existen como columna en QEST) ---
    _sbs_norm = b.df['SBS'].astype(str).str.strip()
    for nombre_inf in ['INF1', 'INF2', 'INF3']:
        nuevo = _sbs_norm.map(b.qest_pct_universo[nombre_inf])
        _sin_match = b.df.loc[nuevo.isna() & b.df[nombre_inf].notna() & (b.df[nombre_inf] != 0)]
        if len(_sin_match):
            print(f"[QEST %Fondo] {nombre_inf}: {len(_sin_match)} SBS con peso en G&P sin match "
                  f"en QEST -> se EXCLUYEN de esta rama:")
            for _, r in _sin_match.iterrows():
                print(f"    SBS={r['SBS']}  Nombre={r.get('Nombre')}  "
                      f"Asset Class={r.get('Asset Class')}  {nombre_inf}_G&P={r[nombre_inf]}")
        b.df[nombre_inf] = nuevo

    b.df = b.df.loc[b.df[['INF1', 'INF2', 'INF3']].notna().any(axis=1)].reset_index(drop=True)
    for c in ['INF1', 'INF2', 'INF3']:
        b.df[c] = b.df[c].fillna(0.0)   # cinturón de seguridad; no debería activarse (ver nota abajo)

    # --- Filas nuevas: CAJ / DPZ / CPC / CPP / CDBCR (no existen en G&P) -------
    # GAP = NaN a propósito: no hay forma de saber la posición de la competencia
    # en estos rubros, y NaN evita que "Dejados de lado" les atribuya el peso de
    # Integra a Habitat/Prima/Profuturo/Sistema. Estas filas se filtran solas en
    # operaciones() (Asset Class no admitido) -> no llegan a BU/TD/SOB/BD1.
    _GAP_COLS = ['HAF1GAP','RIF1GAP','PFF1GAP','SIF1GAP','HAF2GAP','RIF2GAP',
                 'PFF2GAP','SIF2GAP','HAF3GAP','RIF3GAP','PFF3GAP','SIF3GAP']
    _cols_nuevas = [c for c in dic_pct['IN-FONDO1'].keys()
                    if c not in _META_QEST and _clasificar_qest_col(c) is not None]
    filas_nuevas = []
    for col in _cols_nuevas:
        ac, nom = _clasificar_qest_col(col)
        filas_nuevas.append({
            'SBS': col, 'ISIN': None, 'Nombre': nom, 'Asset Class': ac,
            'Cat': ac, 'SubCat': ac, 'Sub Cat2': ac, 'Categoría': ac,
            'AC Dir': None, 'Rank Rt': ac,
            'INF1': b.qest_pct_universo['INF1'].get(col, 0.0),
            'INF2': b.qest_pct_universo['INF2'].get(col, 0.0),
            'INF3': b.qest_pct_universo['INF3'].get(col, 0.0),
            **{g: np.nan for g in _GAP_COLS},
        })
    if filas_nuevas:
        b.df = pd.concat([b.df, pd.DataFrame(filas_nuevas)], ignore_index=True)
        b.df['SBS2'] = b.df['SBS'].apply(recor)   # recalcular; idéntico para filas preexistentes
    print(f"[QEST %Fondo] +{len(filas_nuevas)} posiciones CAJ/DPZ/CPC/CPP/CDBCR agregadas "
          f"(aparecerán en Descartes como 'Asset Class no admitido' — esperado, no es error).")
```

