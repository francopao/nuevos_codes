**Reemplaza por:**
```python
    # FIX: escribir primero LOCAL (sin red de por medio), verificar ahí mismo,
    # y recién entonces copiar el archivo ya completo a Z:\ en una sola operación.
    # Esto evita el problema real: la red/sync no confirma la escritura tan rápido
    # como el script vuelve a leer el archivo.
    ruta_local = os.path.join(tempfile.gettempdir(), f"_tmp_{os.path.basename(Ruta_Base)}")
    with pd.ExcelWriter(ruta_local, engine="openpyxl") as writer:
        BD_Total.to_excel(writer, sheet_name="Sheet1", index=False)

    comprobacion_local = pd.read_excel(ruta_local, sheet_name="Sheet1")
    n_local = comprobacion_local[fecha_col].notna().sum() if fecha_col in comprobacion_local.columns else -1
    if n_local != filas_con_dato:
        raise RuntimeError(
            f"{mes_cod} {anio}: el archivo LOCAL recién escrito no coincide "
            f"({n_local} filas con dato vs {filas_con_dato} esperadas). No se copia a la red; "
            f"revisa el cálculo, esta vez sí sería un bug real.")

    shutil.copyfile(ruta_local, Ruta_Base)
    os.remove(ruta_local)
    print(f"[OK] {mes_cod} {anio}: {filas_con_dato} de {len(DF_F)} filas con dato "
          f"(verificado local y copiado a la red).")
```

