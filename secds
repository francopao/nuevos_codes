#   Lee "Reporte ASG Mensual" + hoja YYYYMM + Soberanos.xlsx                 #
#                                                                             #
###############################################################################

def _normalize_nombre(s):
    """Normaliza un nombre para fuzzy matching: minúsculas, sin *, espacios
    extra, tildes simplificadas."""
    if s is None:
        return ""
    s = str(s).strip().lower()
    s = re.sub(r'[*\.\,\-\(\)]+', ' ', s)
    s = re.sub(r'\s+', ' ', s).strip()
    return s


def _determinar_hoja_proxy(forzar_yyyymm: Optional[str] = None) -> str:
    """Hoja YYYYMM a leer. Si forzar_yyyymm es None, usa la lógica del día 16:
    si hoy > 16 → mes actual, sino → mes anterior."""
    if forzar_yyyymm:
        return str(forzar_yyyymm)
    hoy = datetime.now()
    if hoy.day > 16:
        return hoy.strftime("%Y%m")
    # Mes anterior
    primer_dia = hoy.replace(day=1)
    mes_ant = primer_dia - timedelta(days=1)
    return mes_ant.strftime("%Y%m")


class ProxyLoaderASG:
    """Carga proxies desde 'Lista Proxies - Huella y Comite mensual ASG.xlsx'.

    Produce:
      - intensidad_overrides: {Client_ID_instrumento → intensidad CO2}
      - plus_overrides: {Client_ID_instrumento → {"Plus":"Proxies","Plus_1":"Proxies"}}
    """

    def __init__(self, path_proxies: str, path_soberanos: Optional[str] = None,
                 hoja_yyyymm: Optional[str] = None,
                 bd_msci_isins: Optional[set] = None,
                 verbose: bool = True):
        self.path = path_proxies
        self.path_sob = path_soberanos
        self.hoja = _determinar_hoja_proxy(hoja_yyyymm)
        self.bd_msci_isins = bd_msci_isins or set()
        self.verbose = verbose
        self.intensidad_overrides: Dict[str, float] = {}
        self.plus_overrides: Dict[str, dict] = {}
        self._skipped_msci: List[str] = []

    def load(self) -> "ProxyLoaderASG":
        if not os.path.exists(self.path):
            if self.verbose:
                print(f"  [ProxyASG] [AVISO] No encontrado: {self.path}")
            return self

        import openpyxl
        wb = openpyxl.load_workbook(self.path, read_only=True, data_only=True)
        try:
            asignacion = self._leer_asignacion(wb)
            intensidades_fund = self._leer_hoja_yyyymm(wb)
        finally:
            wb.close()

        intensidades_sob = self._leer_soberanos()

        n_ok, n_skip, n_nodata = 0, 0, 0
        for instr_id, proxy_id in asignacion.items():
            # Punto 2: prioridad BD MSCI
            if instr_id in self.bd_msci_isins:
                self._skipped_msci.append(instr_id)
                n_skip += 1
                continue

            # Buscar intensidad del proxy
            intens = intensidades_fund.get(proxy_id)
            if intens is None:
                intens = intensidades_sob.get(proxy_id)
            if intens is None:
                n_nodata += 1
                continue

            self.intensidad_overrides[instr_id] = float(intens)
            self.plus_overrides[instr_id] = {
                BD_COL_PLUS: "Proxies", BD_COL_PLUS_1: "Proxies"
            }
            n_ok += 1

        if self.verbose:
            print(f"  [ProxyASG] Hoja intensidades: '{self.hoja}'")
            print(f"  [ProxyASG] Asignaciones: {len(asignacion)} | "
                  f"Con intensidad: {n_ok} | Sin dato: {n_nodata} | "
                  f"Ya en BD MSCI (ignorados): {n_skip}")
            if self._skipped_msci:
                print(f"  [ProxyASG] Instrumentos con proxy asignado pero ya "
                      f"cubiertos por BD MSCI ({n_skip}):")
                for sid in self._skipped_msci[:15]:
                    print(f"             {sid}")
                if n_skip > 15:
                    print(f"             ... y {n_skip - 15} más.")
        return self

    def _leer_asignacion(self, wb) -> Dict[str, str]:
        """Lee 'Reporte ASG Mensual' → {ISIN_instrumento → ISIN_proxy}.
        Match por SBS, ISIN, o nombre fuzzy."""
        if PROXIES_HOJA_ASIGNACION not in wb.sheetnames:
            if self.verbose:
                print(f"  [ProxyASG] [AVISO] Falta hoja '{PROXIES_HOJA_ASIGNACION}'")
            return {}

        ws = wb[PROXIES_HOJA_ASIGNACION]
        rows = list(ws.iter_rows(values_only=True))
        if len(rows) < 2:
            return {}

        header = [str(h).strip().upper() if h else '' for h in rows[0]]
        # Detectar columnas flexiblemente
        def _find(candidates):
            for c in candidates:
                cu = c.upper()
                for j, h in enumerate(header):
                    if cu == h or cu in h:
                        return j
            return None

        col_sbs = _find(['SBS', 'CODIGO_SBS']) or 0
        col_isin = _find(['ISIN', 'CODIGO_ISIN']) or 1
        col_emisor = _find(['EMISOR', 'NOMBRE']) or 4
        col_proxy = _find(['PROXY']) or 7

        asign: Dict[str, str] = {}   # instrument_key → proxy_ISIN
        _by_nombre: Dict[str, str] = {}  # nombre_normalizado → proxy_ISIN (fallback)

        for row in rows[1:]:
            if not row or col_proxy >= len(row):
                continue
            proxy_isin = _to_string(row[col_proxy]) if row[col_proxy] else None
            if not proxy_isin:
                continue

            sbs = _to_string(row[col_sbs]) if col_sbs < len(row) and row[col_sbs] else None
            isin = _to_string(row[col_isin]) if col_isin < len(row) and row[col_isin] else None
            emisor = row[col_emisor] if col_emisor < len(row) else None

            # Clave primaria: SBS
            if sbs:
                asign.setdefault(sbs, proxy_isin)
            # Clave secundaria: ISIN del instrumento
            if isin:
                asign.setdefault(isin, proxy_isin)
            # Clave terciaria: nombre normalizado
            if emisor:
                nm = _normalize_nombre(emisor)
                if nm:
                    _by_nombre.setdefault(nm, proxy_isin)

        # Guardar nombres para fuzzy matching en segunda pasada
        self._nombre_map = _by_nombre
        return asign

    def match_por_nombre(self, nombre_cartera: str) -> Optional[str]:
        """Fuzzy match contra los nombres de Reporte ASG Mensual."""
        if not hasattr(self, '_nombre_map') or not self._nombre_map:
            return None
        nm = _normalize_nombre(nombre_cartera)
        if not nm:
            return None
        # Exacto normalizado
        if nm in self._nombre_map:
            return self._nombre_map[nm]
        # Contains bidireccional
        for key, proxy in self._nombre_map.items():
            if nm in key or key in nm:
                return proxy
        # Fuzzy (ratio > 0.85)
        matches = difflib.get_close_matches(nm, self._nombre_map.keys(), n=1, cutoff=0.85)
        if matches:
            return self._nombre_map[matches[0]]
        return None

    def _leer_hoja_yyyymm(self, wb) -> Dict[str, float]:
        """Lee la hoja YYYYMM → {FUND_ISIN/Client_ID → FUND_FINANCED_CARBON_EMISSIONS}."""
        if self.hoja not in wb.sheetnames:
            if self.verbose:
                print(f"  [ProxyASG] [AVISO] Hoja '{self.hoja}' no existe. "
                      f"Hojas: {wb.sheetnames}")
            return {}

        ws = wb[self.hoja]
        rows = list(ws.iter_rows(values_only=True))
        if len(rows) < 2:
            return {}

        header = [str(h).strip() if h else '' for h in rows[0]]
        header_up = [h.upper() for h in header]

        # Buscar FUND_FINANCED_CARBON_EMISSIONS flexiblemente
        col_intens = None
        for j, h in enumerate(header_up):
            if 'FUND_FINANCED_CARBON_EMIS' in h:
                col_intens = j
                break
        if col_intens is None:
            if self.verbose:
                print(f"  [ProxyASG] [AVISO] No se encontró FUND_FINANCED_CARBON_EMISSIONS "
                      f"en hoja '{self.hoja}'.")
            return {}

        # Buscar FUND_ISIN o Client_ID
        col_isin = None
        for cand in ['FUND_ISIN', 'CLIENT_ID']:
            for j, h in enumerate(header_up):
                if h == cand:
                    col_isin = j
                    break
            if col_isin is not None:
                break
        if col_isin is None:
            if self.verbose:
                print(f"  [ProxyASG] [AVISO] No se encontró FUND_ISIN ni Client_ID "
                      f"en hoja '{self.hoja}'.")
            return {}

        result: Dict[str, float] = {}
        for row in rows[1:]:
            isin = _to_string(row[col_isin]) if col_isin < len(row) and row[col_isin] else None
            if not isin:
                continue
            val = row[col_intens] if col_intens < len(row) else None
            if val is not None:
                try:
                    result[isin] = float(val)
                except (ValueError, TypeError):
                    pass
        if self.verbose:
            print(f"  [ProxyASG] Hoja '{self.hoja}': {len(result)} proxies con intensidad.")
        return result

    def _leer_soberanos(self) -> Dict[str, float]:
        """Lee {yyyymm} Soberanos.xlsx → {client1 → GHG_INTENSITY × 1000}."""
        if not self.path_sob or not os.path.exists(self.path_sob):
            if self.verbose and self.path_sob:
                print(f"  [ProxyASG] [AVISO] Soberanos no encontrado: {self.path_sob}")
            return {}

        import openpyxl
        wb = openpyxl.load_workbook(self.path_sob, data_only=True)
        try:
            ws = wb[wb.sheetnames[0]]
            rows_all = list(ws.iter_rows(values_only=True))
        finally:
            wb.close()

        if not rows_all:
            return {}

        header_up = [str(h).strip().upper() if h else '' for h in rows_all[0]]

        # Buscar client1 y CARBON_GOVERNMENT_GHG_INTENSITY_KG_PPP_MR
        col_c1 = None
        for j, h in enumerate(header_up):
            if h == 'CLIENT1':
                col_c1 = j
                break
        col_ghg = None
        for j, h in enumerate(header_up):
            if 'CARBON_GOVERNMENT_GHG_INTENSIT' in h:
                col_ghg = j
                break

        if col_c1 is None or col_ghg is None:
            if self.verbose:
                print(f"  [ProxyASG] [AVISO] Soberanos: no se encontró client1 o "
                      f"CARBON_GOVERNMENT_GHG_INTENSITY.")
            return {}

        result: Dict[str, float] = {}
        for row in rows_all[1:]:
            c1 = _to_string(row[col_c1]) if col_c1 < len(row) and row[col_c1] else None
            if not c1:
                continue
            val = row[col_ghg] if col_ghg < len(row) else None
            if val is not None:
                try:
                    result[c1] = float(val) * 1000
                except (ValueError, TypeError):
                    pass
        if self.verbose:
            print(f"  [ProxyASG] Soberanos: {len(result)} con GHG intensity.")
        return result

# Proxies -> filas que se AGREGAN a BD(MSCI) (además de sobrescribir intensidad).
# Bloque tipo reporte BD, headers FILA 3. Alts/TD en col V; BU en col U.
# Se resuelve por NOMBRE de header (robusto a cambios de posición).
PROXY_BD_SHEETS = ["Alts", "TD", "BU"]


class BDMSCIBuilder:
    """DataFrame BD(MSCI) desde Base MSCI (hoja periodo) + filas de Proxies."""

    def __init__(self, config: Config, sheet: Optional[str] = None, verbose: bool = True):
        self.config = config
        self.path = getattr(config, "path_base_msci", None)
        self.sheet = sheet if sheet is not None else getattr(config, "base_msci_sheet", None)
        self.verbose = verbose
        self.df: Optional[pd.DataFrame] = None

    def build(self) -> pd.DataFrame:
        self._guard_file()
        import openpyxl
        wb = openpyxl.load_workbook(self.path, read_only=True, data_only=True)
        try:
            if self.sheet not in wb.sheetnames:  # R11: match exacto
                wb.close()
                raise ValueError(f"Base MSCI: no existe hoja '{self.sheet}' (match exacto). "
                                 f"Hojas: {wb.sheetnames}")
            ws = wb[self.sheet]
            rows = list(ws.iter_rows(values_only=True))
        finally:
            wb.close()
        if not rows:
            raise ValueError(f"Base MSCI hoja '{self.sheet}' vacía.")
        data_rows = rows[1:]
        n_src = len(BASE_MSCI_SOURCE_COLS)
        idx_client1 = BASE_MSCI_SOURCE_COLS.index("client1")
        idx_cat = BASE_MSCI_SOURCE_COLS.index("CAT")
        idx_cid = BASE_MSCI_SOURCE_COLS.index("Client_ID")
        registros = []
        for row in data_rows:
            src = [row[i] if i < len(row) else None for i in range(n_src)]
            client_id = _to_string(src[idx_cid])
            if client_id in (None, ""):
                continue
            cat = src[idx_cat]
            reg = {BD_COL_A: self._deriv_a(src[idx_client1])}
            for name, val in zip(BASE_MSCI_SOURCE_COLS, src):
                reg[name] = val
            reg[BD_COL_PLUS] = self._plus(cat)
            reg[BD_COL_PLUS_1] = self._plus1(cat, reg[BD_COL_PLUS])
            registros.append(reg)
        df = pd.DataFrame(registros, columns=BD_MSCI_COLS)
        for col in df.columns:
            if col in BD_STRING_COLS:
                df[col] = df[col].map(_to_string)
            elif col in BD_NUMERIC_COLS:
                df[col] = df[col].map(_to_number)
        self.df = df
        if self.verbose:
            print(f"  [Módulo 6] BD(MSCI) hoja '{self.sheet}' -> {df.shape[0]}x{df.shape[1]}.")
        return self

    @staticmethod
    def _deriv_a(client1):
        s = _to_string(client1)
        return s[:6][-4:] if s not in (None, "") else None

    @staticmethod
    def _plus(cat):
        c = (_to_string(cat) or "").upper()
        if c in ("ETF_ETY", "ETF_SOV"):
            return "ETF"
        if c == "RF_SOV":
            return "SOV"
        if c == "-":
            return "Cuestionario Integra"
        return "Portafolio"

    @staticmethod
    def _plus1(cat, w):
        c = (_to_string(cat) or "").upper()
        if c == "ETF_ETY":
            return "Otros ETFs"
        if c == "ETF_SOV":
            return "Soberanos"
        return w

    def append_proxies(self, proxies_path: Optional[str] = None,
                       verbose: bool = True) -> "BDMSCIBuilder":
        """Agrega a BD(MSCI) las filas de Nueva Lista Proxies (hojas Alts/BU/TD).

        Reproduce el pegado manual del bloque V:AR (Alts/TD) o U:AQ (BU) en las
        columnas B:V de BD(MSCI), y recalcula A/W/X desde CAT. Si un Client_ID
        ya existe en BD, la fila de proxies MANDA (keep='last').
        Llamar DESPUÉS de build()."""
        if self.df is None:
            raise RuntimeError("Llama build() antes de append_proxies().")
        path = proxies_path or getattr(self.config, "path_proxies", None)
        if not path or not os.path.exists(path):
            if verbose:
                print("  [Módulo 6] [AVISO] Proxies no encontrado; BD queda sin proxies.")
            return self
        import openpyxl
        wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
        nuevas = []
        try:
            for sheet in PROXY_BD_SHEETS:
                real = self._resolve_sheet_generic(wb.sheetnames, sheet)
                if real is None:
                    if verbose:
                        print(f"  [Módulo 6] [AVISO] Proxies sin hoja '{sheet}'; omito.")
                    continue
                rows = list(wb[real].iter_rows(min_row=3, values_only=True))
                if len(rows) < 2:
                    continue
                header = list(rows[0])
                # Se resuelven también Plus / Plus_1: en las hojas de proxies
                # esos valores son AUTORITATIVOS (traen 'Proxies', 'Alts', ...)
                # y NO deben recalcularse desde CAT.
                _cols_proxy = list(BASE_MSCI_SOURCE_COLS) + [BD_COL_PLUS, BD_COL_PLUS_1]
                mapping, _ = _resolve_headers(
                    header, {c: [c] for c in _cols_proxy})
                idx = {canon: i for i, canon in mapping.items()}
                if "Client_ID" not in idx:
                    if verbose:
                        print(f"  [Módulo 6] [AVISO] Hoja '{sheet}': sin Client_ID; omito.")
                    continue
                n_sheet = 0
                for row in rows[1:]:
                    i_cid = idx["Client_ID"]
                    cid = _to_string(row[i_cid]) if i_cid < len(row) else None
                    if cid in (None, ""):
                        continue
                    reg = {}
                    for name in BASE_MSCI_SOURCE_COLS:
                        i = idx.get(name)
                        reg[name] = row[i] if (i is not None and i < len(row)) else None
                    cat = reg.get("CAT")
                    reg[BD_COL_A] = self._deriv_a(reg.get("client1"))
                    # Plus / Plus_1 tal cual vienen de la hoja de proxies.
                    # Solo si la hoja no los trae se derivan desde CAT.
                    i_plus = idx.get(BD_COL_PLUS)
                    i_plus1 = idx.get(BD_COL_PLUS_1)
                    v_plus = (_to_string(row[i_plus])
                              if (i_plus is not None and i_plus < len(row)) else None)
                    v_plus1 = (_to_string(row[i_plus1])
                               if (i_plus1 is not None and i_plus1 < len(row)) else None)
                    reg[BD_COL_PLUS] = v_plus or self._plus(cat)
                    reg[BD_COL_PLUS_1] = v_plus1 or self._plus1(cat, reg[BD_COL_PLUS])
                    nuevas.append(reg)
                    n_sheet += 1
                if verbose:
                    _sin_plus = (BD_COL_PLUS not in idx)
                    print(f"  [Módulo 6] Proxies hoja '{sheet}': +{n_sheet} filas"
                          + (" [AVISO: sin col Plus, se deriva de CAT]"
                             if _sin_plus else ""))
        finally:
            wb.close()

        if nuevas:
            df_new = pd.DataFrame(nuevas, columns=BD_MSCI_COLS)
            for col in df_new.columns:
                if col in BD_STRING_COLS:
                    df_new[col] = df_new[col].map(_to_string)
                elif col in BD_NUMERIC_COLS:
                    df_new[col] = df_new[col].map(_to_number)
            antes = len(self.df)
            self.df = pd.concat([self.df, df_new], ignore_index=True)
            self.df = self.df.drop_duplicates(
                BD_COL_CLIENT_ID, keep="last").reset_index(drop=True)
            if verbose:
                print(f"  [Módulo 6] BD(MSCI) con proxies: {antes} -> {len(self.df)} filas "
                      f"({len(nuevas)} de proxies, los repetidos sobrescriben).")
        return self

    @staticmethod
    def _resolve_sheet_generic(available: List[str], wanted: str) -> Optional[str]:
        if wanted in available:
            return wanted
        target = _normalize(wanted)
        for name in available:
            if _normalize(name) == target:
                return name
        return None

    def as_intensidad_lookup(self) -> Dict[str, float]:
        if self.df is None:
            raise RuntimeError("Llama build() antes.")
        tmp = self.df[[BD_COL_CLIENT_ID, BD_COL_INTENSIDAD]].dropna(
            subset=[BD_COL_CLIENT_ID]).drop_duplicates(BD_COL_CLIENT_ID, keep="first")
        return dict(zip(tmp[BD_COL_CLIENT_ID], tmp[BD_COL_INTENSIDAD]))

    def as_plus_lookup(self) -> Dict[str, dict]:
        if self.df is None:
            raise RuntimeError("Llama build() antes.")
        tmp = self.df[[BD_COL_CLIENT_ID, BD_COL_PLUS, BD_COL_PLUS_1]].dropna(
            subset=[BD_COL_CLIENT_ID]).drop_duplicates(BD_COL_CLIENT_ID, keep="first")
        return tmp.set_index(BD_COL_CLIENT_ID).to_dict("index")

    def as_attrs_lookup(self) -> Dict[str, dict]:
        """Client_ID -> {Sector, País, Rating, Controversia} para enriquecer M12."""
        if self.df is None:
            raise RuntimeError("Llama build() antes.")
        cols = [BD_COL_CLIENT_ID, "Sector", "País", "Rating", "Controversia"]
        cols = [c for c in cols if c in self.df.columns]
        tmp = self.df[cols].dropna(subset=[BD_COL_CLIENT_ID]).drop_duplicates(
            BD_COL_CLIENT_ID, keep="first")
        return tmp.set_index(BD_COL_CLIENT_ID).to_dict("index")

    def _guard_file(self) -> None:
        if not self.path:
            raise ValueError("Config no define path_base_msci.")
        if not os.path.exists(self.path):
            raise FileNotFoundError(f"No encuentro Base MSCI en:\n  {self.path}")


