// ---------------------------------------------------------------------------
function metricaDisponible(objeto, metrica, corte){
  for(const r of HIST){
    if(r.OBJETO===objeto && r.METRICA===metrica &&
       String(r.FECHA_CORTE)===String(corte)) return metrica;
  }
  if(metrica==='Intensidad') return 'Intensidad-M';
  return metrica;
}

// ---------------------------------------------------------------------------
// ESTILO COMITÉ: eje X = corte (actual vs comparación), segmentos apilados =
// categorías. Es la orientación real de las láminas del ppt (cats Dic-25 /
// Jul-26). Los segmentos en cero no se dibujan, así no quedan huecos.
// ---------------------------------------------------------------------------
function apiladoPorCorte(div, objeto, metrica, cAct, cCmp, opts){
  opts = opts || {};
  const orden = opts.orden || null;
  const serie = (corte) => {
    const met = metricaDisponible(objeto, metrica, corte);
    const m = new Map();
    for(const r of HIST){
      if(r.OBJETO!==objeto || r.METRICA!==met) continue;
      if(String(r.FECHA_CORTE)!==String(corte)) continue;
      if(opts.excluir && opts.excluir.includes(r.DIM_1)) continue;
      const k = opts.clave ? opts.clave(r) : r.DIM_1;
      if(!k) continue;
      m.set(k, (m.get(k)||0) + (+r.VALOR||0));
    }
    return m;
  };
  const a = serie(cAct), b = serie(cCmp);
  let keys = [...new Set([...a.keys(), ...b.keys()])];
  keys = keys.filter(k => Math.abs(a.get(k)||0) > 1e-9 || Math.abs(b.get(k)||0) > 1e-9);
  if(orden) keys.sort((x,y)=>{
    const ix = orden.indexOf(x), iy = orden.indexOf(y);
    return (ix<0?99:ix) - (iy<0?99:iy);
  });
  else keys.sort((x,y)=>(a.get(y)||0)-(a.get(x)||0));

  const etiqCmp = etiquetaCorte(cCmp), etiqAct = etiquetaCorte(cAct);
  const ejeX = [etiqCmp, etiqAct];
  const traces = keys.map((k,i)=>({
    type:'bar', name:k, x:ejeX,
    y:[b.get(k)||0, a.get(k)||0],
    marker: opts.marker ? opts.marker(k, i) : {color:P[i % P.length]},
    text:[fmt(b.get(k)||0), fmt(a.get(k)||0)],
    textposition:'inside', insidetextanchor:'middle',
    textfont:{size:10, color:CFG.color_texto}
  }));
  const totB = keys.reduce((s,k)=>s+(b.get(k)||0),0);
  const totA = keys.reduce((s,k)=>s+(a.get(k)||0),0);
  const lay = LAYOUT();
  lay.xaxis.type = 'category';
  lay.barmode = 'stack';
  lay.bargap = 0.55;
  lay.yaxis.title = opts.y || metrica;
  const varPct = totB ? (totA/totB - 1) : null;
  lay.annotations = [
    {x:etiqCmp, y:totB, text:'<b>'+fmt(totB)+'</b>', showarrow:false, yshift:16},
    {x:etiqAct, y:totA, text:'<b>'+fmt(totA)+'</b>' +
      (varPct===null ? '' :
        '<br><span style="color:'+(varPct<0?'#1B8F5A':'#C0392B')+'">'+
        (varPct>0?'+':'')+(varPct*100).toFixed(1)+'%</span>'),
     showarrow:false, yshift:24}
  ];
  Plotly.react(div, traces, lay, OPTS);
}

