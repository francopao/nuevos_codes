#   ADAPTADOR BD1S → VALORIZACIÓN                                             #
#   Lee BD1_S_Huella.xlsx y produce inputs compatibles con                    #
#   ValorizacionBuilder (sin modificar ninguna clase existente).              #
#                                                                             #
###############################################################################

def _cargar_bd1s_huella(ruta_bd1s: str, afp: str = "Integra",
                         verbose: bool = True):
    """Lee BD1_S_Huella.xlsx para una AFP y produce los inputs que
    ValorizacionBuilder espera.

    Estrategia clave: VVL = Weight × AUM (reverse-engineered) para que
    ValorizacionBuilder calcule Weight = VVL/AUM = Weight original.
    Así no se modifica el builder y el Weight queda idéntico al reporte X.

    Retorna: (df_val, caja_map, tc, aum_mm, caja_neta_mm,
              parametria_lookup, sector_lookup)
    """
    df = pd.read_excel(ruta_bd1s, engine="openpyxl")

    # --- Filtrar por AFP y solo F1/F2/F3 (excluir Multifondos) ----
    df = df[df["Afp"] == afp].copy()
    df = df[df["Fondo"].isin(["F1", "F2", "F3"])].copy()
    if df.empty:
        raise ValueError(f"No hay datos para AFP='{afp}' (F1/F2/F3) en BD1_S_Huella.")

    # --- TC ---
    tc = float(df["TC_USD"].iloc[0])

    # --- Mapear Fondo → PORTAFOLIO ---
    _fondo_a_port = {"F1": "IN-FONDO1", "F2": "IN-FONDO2", "F3": "IN-FONDO3"}
    df["PORTAFOLIO"] = df["Fondo"].map(_fondo_a_port)

    # --- Renombrar al esquema de Valorización ---
    df = df.rename(columns={
        "SBS":       "CODIGO_SBS",
        "ISIN":      "CODIGO_ISIN",
        "Nombre":    "TITULO",
        "codEmisor": "EMISOR",
    })

    # --- VVL reverse-engineered: Weight × AUM → Weight = VVL/AUM ✓ ---
    _w = pd.to_numeric(df["Weight"], errors="coerce").fillna(0.0)
    _aum = pd.to_numeric(df["AUM"], errors="coerce").fillna(0.0)
    df["VALOR_VECTOR_LOCAL"] = _w * _aum
    # --- MEJORA A: normalizar Weight al 100% por fondo (dentro de esta AFP) ---
    _wt = pd.to_numeric(df["Weight"], errors="coerce").fillna(0.0)
    _sum_fondo = _wt.groupby(df["Fondo"]).transform("sum")
    _gap = _wt.groupby(df["Fondo"]).sum().to_dict()          # sumas ORIGINALES
    df["Weight"] = _wt.divide(_sum_fondo).where(_sum_fondo != 0, _wt)
    # Recalcular VVL con weights ya normalizados (todo downstream lo usa)
    df["VALOR_VECTOR_LOCAL"] = pd.to_numeric(
        df["Weight"], errors="coerce").fillna(0.0) * _aum
    if verbose:
        _det = " | ".join(f"{f}: {_gap.get(f, 0.0):.4f} → 1.0000"
                          for f in ["F1", "F2", "F3"] if f in _gap)
        print(f"  [Normalización] {afp} — {_det}")
    # --- caja_map: PORTAFOLIO → AUM (patrimonio del fondo) ---
    caja_map = {}
    for port in ["IN-FONDO1", "IN-FONDO2", "IN-FONDO3"]:
        sub = df[df["PORTAFOLIO"] == port]
        if not sub.empty:
            caja_map[port] = float(sub["AUM"].iloc[0])

    # --- AUM multifondos en USD MM ---
    aum_total_pen = sum(caja_map.values())
    aum_mm = aum_total_pen / tc / 1e6

    # --- Caja neta = 0 (no se usa en Cobertura) ---
    caja_neta_mm = 0.0

    # --- Parametria lookup desde columnas de BD1_S_Huella ---
    parametria_lookup: Dict[str, dict] = {}
    for _, row in df.drop_duplicates(subset=["CODIGO_SBS"]).iterrows():
        sbs = _to_string(row.get("CODIGO_SBS"))
        if not sbs:
            continue
        parametria_lookup[sbs] = {
            "NOMBRE":  row.get("TITULO"),
            "CODIGO":  _to_string(row.get("Categoria")),
            "RIESGOS": _to_string(row.get("Strategy")),
            "RANKEST": _to_string(row.get("RANKEST") or row.get("assetclass")),
        }

    # --- Sector lookup ---
    sector_lookup: Dict[str, str] = {}
    for _, row in df.drop_duplicates(subset=["CODIGO_SBS"]).iterrows():
        sbs = _to_string(row.get("CODIGO_SBS"))
        sector = row.get("Sector_GICS")
        if sbs and pd.notna(sector) and str(sector).strip():
            # Doble clave: por SBS y por Nombre (para compatibilidad con M12)
            sector_lookup[f"SBS::{sbs}"] = str(sector).strip()

    if verbose:
        print(f"  [BD1S] AFP={afp}: {len(df)} filas, TC={tc:.4f}, "
              f"AUM={aum_mm:,.2f} USD MM, Fondos={list(caja_map.keys())}")

    return df, caja_map, tc, aum_mm, caja_neta_mm, parametria_lookup, sector_lookup


def construir_valorizacion_bd1s(cfg: "Config", ruta_bd1s: str,
                                 afp: str = "Integra",
                                 shared: Optional[dict] = None,
                                 verbose: bool = True):
    """Módulos 1..10 usando BD1_S_Huella como cartera.

    'shared' es un dict con recursos compartidos (bd, px, perd, comp, mkt)
    para evitar recargarlos en cada AFP. Si es None, se construyen aquí.
    """
    df_val, caja_map, tc, aum_mm, caja_neta_mm, param_lk, sector_lk = \
        _cargar_bd1s_huella(ruta_bd1s, afp, verbose)

    # --- Recursos compartidos (se construyen una vez para todas las AFPs) ---
    if shared is None:
        shared = _construir_shared(cfg, verbose)

    vb = ValorizacionBuilder(
        df_val,
        caja_map=caja_map,
        usd_rate=tc,
        parametria_lookup=param_lk,
        intensidad_post=shared["intensidad_post"],
        plus_lookup=shared["plus_lookup"],
        intensidad_t1={},
        proxy_engine=shared["proxy_engine"],
        perdieron_lookup=shared["perd_lookup"],
        perdieron_mode="fill",
        attrs_lookup=shared["attrs_lookup"],
        gyp_lookup=shared.get("gyp_lookup"),
        aum_multifondos_mm=aum_mm,
        verbose=verbose,
    )
    vb.build()

    ctx = {
        "config": cfg, "tc": tc, "sector_lookup": sector_lk,
        "aum_multifondos_mm": aum_mm, "caja_neta_mm": caja_neta_mm,
        "valorizacion_builder": vb,
        "market_cap_loader": shared.get("mkt"),
        "herencias": vb.get_inherited_history(),
    }
    return vb.df, ctx


def _construir_shared(cfg: "Config", verbose: bool = True,
                      hoja_proxy_yyyymm: Optional[str] = None) -> dict:
    """Construye BD MSCI, ProxyASG, Perdieron. Se comparten entre AFPs."""
    if verbose:
        print("  [SHARED] Construyendo recursos compartidos...")

    bd = BDMSCIBuilder(cfg).build()
    # NO llamar bd.append_proxies() — el nuevo sistema lo reemplaza.

    # Set de ISINs ya cubiertos por BD MSCI (para prioridad punto 2)
    bd_isins = set(bd.df[BD_COL_CLIENT_ID].dropna().unique())

    # Soberanos
    path_sob = str(Path(D_SOBERANOS) / FNAME_SOBERANOS.format(
        yyyymm=cfg.semestre))
    if not os.path.exists(path_sob):
        # Intentar con base_msci_sheet como alternativa
        path_sob_alt = str(Path(D_SOBERANOS) / FNAME_SOBERANOS.format(
            yyyymm=cfg.base_msci_sheet))
        if os.path.exists(path_sob_alt):
            path_sob = path_sob_alt

    # Nuevo proxy loader
    proxy_asg = ProxyLoaderASG(
        path_proxies=cfg.path_proxies,
        path_soberanos=path_sob,
        hoja_yyyymm=hoja_proxy_yyyymm,
        bd_msci_isins=bd_isins,
        verbose=verbose,
    ).load()

    # Agregar proxy overrides al catálogo de BD MSCI (para Plus lookup)
    _filas_proxy = []
    for cid, info in proxy_asg.plus_overrides.items():
        intens = proxy_asg.intensidad_overrides.get(cid, 0.0)
        _filas_proxy.append({
            BD_COL_A: None, "Nombre": None, BD_COL_CLIENT_ID: cid,
            "client1": None, "client2": None, "Valor": None,
            "País": None, "Sector": None, "EVIC": None, "CO2": None,
            "CO2/EVIC": None, "ESG": None, "E": None, "S": None,
            "G": None, "Controversia": None, "Co2/Sales": None,
            "Gov_pctl": None, "Rating": None,
            BD_COL_INTENSIDAD: intens,
            "%DebtPub": None, "CAT": None,
            BD_COL_PLUS: info[BD_COL_PLUS],
            BD_COL_PLUS_1: info[BD_COL_PLUS_1],
        })
    if _filas_proxy:
        df_proxy = pd.DataFrame(_filas_proxy, columns=BD_MSCI_COLS)
        antes = len(bd.df)
        bd.df = pd.concat([bd.df, df_proxy], ignore_index=True)
        bd.df = bd.df.drop_duplicates(BD_COL_CLIENT_ID, keep="first").reset_index(drop=True)
        if verbose:
            print(f"  [SHARED] BD(MSCI) + ProxyASG: {antes} -> {len(bd.df)} filas.")

    perd = PerdieronHuellaLoader(cfg).build()
    perd_lookup = perd.as_intensidad_lookup() if not perd.df.empty else {}

    # ProxyEngine minimalista: solo para apply_inheritance (no lee archivo)
    # Creamos un stub con los overrides ya cargados
    px = ProxyEngine.__new__(ProxyEngine)
    px.config = cfg
    px.path = cfg.path_proxies
    px.verbose = verbose
    px.etf_ref_col = None
    px.proxy_overrides = proxy_asg.intensidad_overrides
    px.msci_ref = {}
    px.df_inherited = None

    intensidad_post = px.apply_to_bd(bd.as_intensidad_lookup())

    comp = ComparablesLoader(cfg, verbose=verbose).build()
    mkt = _market_cap_seguro(cfg, verbose)

    # G&P (Detallado, B:U) — universo AFO líquido para charts "mayores
    # contribuyentes por AFP". Se carga una sola vez para todas las AFPs.
    gyp_lookup = GyPDetalladoLoader(cfg, verbose=verbose).build().as_lookup()

    return {
        "bd": bd,
        "proxy_engine": px,
        "proxy_asg": proxy_asg,
        "intensidad_post": intensidad_post,
        "plus_lookup": bd.as_plus_lookup(),
        "attrs_lookup": bd.as_attrs_lookup(),
        "perd_lookup": perd_lookup,
        "comp": comp,
        "mkt": mkt,
        "gyp_lookup": gyp_lookup,
    }



def run_pipeline_bd1s(semestre: str,
                      ruta_bd1s: str,
                      output_dir: str = OUTPUT_DIR_DEFAULT,
                      afps: Optional[List[str]] = None,
                      ruta_historico: Optional[str] = None,
                      ruta_dashboard: Optional[str] = None,
                      hoja_proxy_yyyymm: Optional[str] = None,
                      verbose: bool = True):
    """Pipeline multi-AFP completo usando BD1_S_Huella como cartera.

    Para cada AFP construye Valorización + pivots y los exporta al
    histórico. Después genera el dashboard con charts existentes (por AFP)
    + charts comparativos (multi-AFP).
    """
    out = FsPath(str(output_dir))
    out.mkdir(parents=True, exist_ok=True)
    ruta_historico = ruta_historico or str(out / NOMBRE_HISTORICO)
    ruta_dashboard = ruta_dashboard or str(out / NOMBRE_DASHBOARD)

    cfg = Config.from_semestre(semestre)
    if verbose:
        print(cfg.summary())

    # --- Determinar AFPs disponibles ---
    df_full = pd.read_excel(ruta_bd1s, engine="openpyxl")
    available = sorted(df_full["Afp"].unique())
    if afps is None:
        afps = available
    if verbose:
        print(f"  [BD1S] AFPs disponibles: {available}")
        print(f"  [BD1S] AFPs a procesar: {afps}")
    del df_full

    # --- Recursos compartidos (una sola carga) ---
    faltantes = cfg.check_paths(verbose=verbose)
    shared = _construir_shared(cfg, verbose, hoja_proxy_yyyymm=hoja_proxy_yyyymm)

    # --- Procesar cada AFP ---
    exp = HistoricoExporter(ruta_historico)
    all_results: Dict[str, dict] = {}

    for afp in afps:
        if verbose:
            print(f"\n{'='*60}")
            print(f"  HUELLA — AFP: {afp}")
            print(f"{'='*60}")
        try:
            val, ctx = construir_valorizacion_bd1s(
                cfg, ruta_bd1s, afp=afp, shared=shared, verbose=verbose)

            pres = PresentacionBuilder(
                val, cfg.semestre,
                sector_lookup=ctx.get("sector_lookup", {}),
                intensidades_comp=shared["comp"].intensidades,
                aum_comp=(shared["mkt"].aum if shared["mkt"] else {}),
                caja_neta_mm=ctx.get("caja_neta_mm", 0.0),
                aum_total_mm=ctx.get("aum_multifondos_mm"),
            )
            objetos = pres.build_all()

            # --- Exportar al histórico con sufijo AFP ---
            # Inyectar columna AFP en el formato largo para el dashboard
            largo = pres.to_long()
            largo.insert(1, "AFP", afp)
            _exportar_con_afp(exp, largo, cfg.semestre, afp, pres, verbose)

            all_results[afp] = {
                "valorizacion": val, "objetos": objetos,
                "aum_mm": ctx.get("aum_multifondos_mm"),
                "presentacion": pres,
            }
            if verbose:
                print(f"  [{afp}] {len(objetos)} objetos, {len(pres.df)} registros.")

            # --- Reporte de instrumentos sin huella y Cuestionario Integra ---
            vb = ctx["valorizacion_builder"]
            _cols_rep = ["PORTAFOLIO", "TITULO", "CODIGO_SBS", "CODIGO_ISIN",
                         "GRUPO_ECONOMICO", "Plus", "Inv MM$", "Huella", "CO2-H"]
            _cols_rep = [c for c in _cols_rep if c in val.columns]

            prob = val.loc[
                (pd.to_numeric(val["CO2-H"], errors="coerce").fillna(0.0) == 0) &
                (pd.to_numeric(val["Inv MM$"], errors="coerce").fillna(0.0).abs() > 1e-9),
                _cols_rep].copy()
            if not prob.empty:
                prob.insert(0, "AFP", afp)
                prob.insert(1, "Tipo", "PROBLEMÁTICO (con inversión, sin huella)")
            cuest = val.loc[val["Plus"] == "Cuestionario Integra", _cols_rep].copy()
            if not cuest.empty:
                cuest.insert(0, "AFP", afp)
                cuest.insert(1, "Tipo", "Cuestionario Integra")
            all_results[afp]["diagnostico"] = pd.concat(
                [prob, cuest], ignore_index=True)

        except Exception as exc:
            if verbose:
                print(f"  [{afp}] [ERROR] {exc}")
                import traceback; traceback.print_exc()
    # --- Exportar diagnóstico consolidado ---
    diag_frames = [r["diagnostico"] for r in all_results.values()
                   if "diagnostico" in r and not r["diagnostico"].empty]
    if diag_frames:
        diag = pd.concat(diag_frames, ignore_index=True)
        diag = diag.sort_values(["AFP", "Tipo", "PORTAFOLIO"], ignore_index=True)
        ruta_diag = str(FsPath(output_dir) / "Diagnostico_Cobertura.xlsx")
        diag.to_excel(ruta_diag, index=False, sheet_name="Diagnóstico")
        if verbose:
            n_prob = (diag["Tipo"].str.startswith("PROB")).sum()
            n_cuest = (diag["Tipo"] == "Cuestionario Integra").sum()
            print(f"\n  [Diagnóstico] {n_prob} PROBLEMÁTICOS + {n_cuest} Cuestionario Integra")
            print(f"  [Diagnóstico] -> {ruta_diag}")
    # --- Dashboard (existente + multi-AFP) ---
    if verbose:
        print(f"\n  [Dashboard] Generando con {len(all_results)} AFP(s)...")
    construir_dashboard(ruta_historico, ruta_dashboard)

    return {
        "config": cfg, "resultados": all_results,
        "ruta_historico": ruta_historico, "ruta_dashboard": ruta_dashboard,
    }


def _exportar_con_afp(exp: "HistoricoExporter", largo: pd.DataFrame,
                       semestre: str, afp: str,
                       builder: "PresentacionBuilder",
                       verbose: bool = True):
    """Exporta los datos de una AFP al histórico, incluyendo la columna AFP.

    Preserva cortes previos y acumula en la hoja HISTORICO.
    La hoja del corte se nombra '{semestre}_{afp}' para no colisionar.
    """
    hojas = exp._leer_existente()
    nombre_hoja = f"{semestre}_{afp}"[:31]

    # --- HISTORICO acumulado: purgar este corte+AFP y reinsertar ---
    hist_prev = hojas.get(exp.HOJA_HISTORICO, pd.DataFrame())
    if not hist_prev.empty:
        # Añadir AFP a datos históricos previos que no la tengan
        if "AFP" not in hist_prev.columns:
            hist_prev.insert(1, "AFP", "Integra")
        # Purgar este corte+AFP
        mask = ((hist_prev["FECHA_CORTE"].astype(str) == semestre) &
                (hist_prev["AFP"].astype(str) == afp))
        hist_prev = hist_prev[~mask]

    historico = (pd.concat([hist_prev, largo], ignore_index=True)
                 if not hist_prev.empty else largo)
    historico = historico.sort_values(
        ["FECHA_CORTE", "AFP", "OBJETO", "METRICA"], ignore_index=True)

    # --- Metadata ---
    meta_prev = hojas.get(exp.HOJA_META, pd.DataFrame())
    if not meta_prev.empty and "FECHA_CORTE" in meta_prev.columns:
        mask = (meta_prev["FECHA_CORTE"].astype(str) == semestre)
        if "AFP" in meta_prev.columns:
            mask = mask & (meta_prev["AFP"].astype(str) == afp)
        meta_prev = meta_prev[~mask]
    meta_new = pd.DataFrame([{
        "FECHA_CORTE": semestre, "AFP": afp,
        "GENERADO": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "N_REGISTROS_FUENTE": len(builder.df),
        "HUELLA_TOTAL": float(builder.df[COL["huella"]].sum()),
        "AUM_TOTAL_MM": float(builder.df[COL["inv"]].sum()),
    }])
    meta = (pd.concat([meta_prev, meta_new], ignore_index=True)
            if not meta_prev.empty else meta_new)

    # --- Reescritura preservando cortes previos ---
    otros = {k: v for k, v in hojas.items()
             if k not in (exp.HOJA_HISTORICO, exp.HOJA_META, nombre_hoja)}

    with pd.ExcelWriter(exp.ruta, engine="openpyxl") as xw:
        historico.to_excel(xw, sheet_name=exp.HOJA_HISTORICO, index=False)
        meta.to_excel(xw, sheet_name=exp.HOJA_META, index=False)
        largo.to_excel(xw, sheet_name=nombre_hoja, index=False)
        for nombre, df in sorted(otros.items(), reverse=True):
            df.to_excel(xw, sheet_name=str(nombre)[:31], index=False)

    # Aviso de duplicado de período
    _periodo_yyyymm = semestre[:6]
    if not hist_prev.empty and "FECHA_CORTE" in hist_prev.columns:
        _cortes_existentes = hist_prev["FECHA_CORTE"].astype(str).unique()
        _mismos_mes = [c for c in _cortes_existentes
                       if c[:6] == _periodo_yyyymm and c != semestre]
        if _mismos_mes:
            print(f"  [AVISO] Ya existen datos para el mes {_periodo_yyyymm} con "
                  f"corte(s) diferente(s): {_mismos_mes}.")
            print(f"          Se purgaron las filas de {_mismos_mes} y se reemplazan "
                  f"por el corte actual '{semestre}' (AFP={afp}).")
            # Purgar los cortes viejos del mismo mes
            for _c_viejo in _mismos_mes:
                mask_viejo = ((historico["FECHA_CORTE"].astype(str) == _c_viejo) &
                              (historico["AFP"].astype(str) == afp))
                historico = historico[~mask_viejo]
    if verbose:
        print(f"  [Módulo 13] {afp} -> hoja '{nombre_hoja}' en histórico.")


def construir_valorizacion(cfg: "Config", verbose: bool = True):
    """Módulos 1..10 de Huella1. Devuelve (df_valorizacion, contexto)."""
    reader = QueryReader(cfg)
    data = reader.read_all()

    caja = CajaLoader(data.caja).build()                       # Módulo 2
    tc = TipoCambioLoader(data.tipo_cambio).build()            # Módulo 3
    aum_mm = caja.aum_multifondos_mm(tc.usd_rate())            # K10 de la hoja
    if verbose:
        print(f"  [Módulo 2] AUM multifondos = {aum_mm:,.2f} USD MM "
              f"(TC {tc.usd_rate()})")

    # Módulo 5 (Parametria se lee directa del workbook; input manual)
    parametria_lookup = ParametriaBuilder.leer_parametria_directa(cfg)
    try:
        sector_lookup = ParametriaBuilder.leer_sector_buckets(cfg)
    except Exception:
        sector_lookup = {}

    bd = BDMSCIBuilder(cfg).build()                            # Módulo 6
    bd.append_proxies(cfg.path_proxies)
    bd_t1 = BDMSCITMinus1(cfg).build()                         # Módulo 7

    perd = PerdieronHuellaLoader(cfg).build()                  # Módulo 8
    perd_lookup = perd.as_intensidad_lookup() if not perd.df.empty else {}

    px = ProxyEngine(cfg).load()                               # Módulo 9
    intensidad_post = px.apply_to_bd(bd.as_intensidad_lookup())

    # G&P (Detallado, B:U) — universo AFO líquido para charts "mayores
    # contribuyentes por AFP". Independiente de Parametria (que se lee
    # directa del workbook, sin pasar por G&P).
    gyp_lookup = GyPDetalladoLoader(cfg, verbose=verbose).build().as_lookup()

    vb = ValorizacionBuilder(                                  # Módulo 10
        data.valorizacion,
        caja_map=caja.as_map(),
        usd_rate=tc.usd_rate(),
        parametria_lookup=parametria_lookup,
        intensidad_post=intensidad_post,
        plus_lookup=bd.as_plus_lookup(),
        intensidad_t1={},
        proxy_engine=px,
        perdieron_lookup=perd_lookup,
        perdieron_mode="fill",
        attrs_lookup=bd.as_attrs_lookup(),
        gyp_lookup=gyp_lookup,
        aum_multifondos_mm=aum_mm,
        verbose=verbose,
    )
    vb.build()

    ctx = {
        "config": cfg, "caja": caja, "tipo_cambio": tc, "bd": bd, "bd_t1": bd_t1,
        "proxies": px, "perdieron": perd, "sector_lookup": sector_lookup,
        "aum_multifondos_mm": aum_mm,
        "valorizacion_builder": vb,
        "market_cap_loader": _market_cap_seguro(cfg, verbose),
        "herencias": vb.get_inherited_history(),
    }
    return vb.df, ctx


def _market_cap_seguro(cfg: "Config", verbose: bool = True):
    """MarketCapLoader sobre la hoja MKT. No debe abortar el pipeline."""
    try:
        return MarketCapLoader(cfg, verbose=verbose).build()
    except Exception as exc:
        if verbose:
            print(f"  [MarketCap] [AVISO] no disponible: {exc}")
        return None

def _procesar_corte(cfg, exp, verbose=True):
    """Módulos 1..13 para UN corte: arma Valorización + pivots y lo exporta
    al histórico. Se usa IDÉNTICO para T y para T-1."""
    val, ctx = construir_valorizacion(cfg, verbose=verbose)
    comp = ComparablesLoader(cfg, verbose=verbose).build()
    mkt = ctx.get("market_cap_loader")
    pres = PresentacionBuilder(
        val, cfg.semestre,
        sector_lookup=ctx.get("sector_lookup", {}),
        intensidades_comp=comp.intensidades,
        aum_comp=(mkt.aum if mkt is not None else {}),
        caja_neta_mm=ctx["caja"].caja_neta_multifondos_mm(ctx["tipo_cambio"].usd_rate()),
        aum_total_mm=ctx.get("aum_multifondos_mm"),
    )
    objetos = pres.build_all()
    if verbose:
        print(f"  [Módulo 12] {len(objetos)} objetos ({len(pres.df)} registros) "
              f"para corte {cfg.semestre}.")
    exp.exportar(pres)
    if verbose:
        print(f"  [Módulo 13] Corte {cfg.semestre} -> histórico.")
    return val, ctx, objetos

def run_pipeline(semestre: str,
                 output_dir: str = OUTPUT_DIR_DEFAULT,
                 ruta_historico: Optional[str] = None,
                 ruta_dashboard: Optional[str] = None,
                 verbose: bool = True):
    """Corrida completa de punta a punta para un semestre."""
    out = FsPath(str(output_dir))
    out.mkdir(parents=True, exist_ok=True)
    ruta_historico = ruta_historico or str(out / NOMBRE_HISTORICO)
    ruta_dashboard = ruta_dashboard or str(out / NOMBRE_DASHBOARD)

    cfg = Config.from_semestre(semestre)
    if verbose:
        print(cfg.summary())
        cfg.print_refresh_reminder()
    faltantes = cfg.check_paths(verbose=verbose)
    cfg.validate_workbook_b1(verbose=verbose)
    if "path_workbook" in faltantes:
        raise SystemExit(">>> Falta el workbook refrescado. Deposítalo y reintenta.")

    exp = HistoricoExporter(ruta_historico)

    # --- T-1: se arma IDÉNTICO a T, desde su propio workbook -----------------
    try:
        cfg_t1 = Config.from_semestre(cfg.semestre_t1)
        cfg_t1.validate_workbook_b1(verbose=verbose)
        _procesar_corte(cfg_t1, exp, verbose=verbose)
    except Exception as exc:
        if verbose:
            print(f"  [T-1] [AVISO] no se pudo armar {cfg.semestre_t1}: {exc}")

    # --- T: corte actual -----------------------------------------------------
    val, ctx, objetos = _procesar_corte(cfg, exp, verbose=verbose)

    # --- Módulo 14: dashboard ------------------------------------------------
    construir_dashboard(ruta_historico, ruta_dashboard)

    return {"config": cfg, "valorizacion": val, "objetos": objetos,
            "historico": exp.cargar_historico(), "contexto": ctx,
            "ruta_historico": ruta_historico, "ruta_dashboard": ruta_dashboard}



