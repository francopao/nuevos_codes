GYP_SHEET_DETALLADO = "Detallado"
GYP_COL_SBS = "B"
GYP_COL_NOMBRE = "D"
GYP_COL_ASSET_CLASS = "F"
GYP_COL_RANK_RT = "Q"
GYP_COL_SBS_TIPO = "U"
GYP_HEADER_ROWS = 1

# Universo AFO líquido (fondos mutuos abiertos / ETFs) para charts de
# "mayores contribuyentes por AFP". Excluye vehículos cerrados de
# alternativos (Inter_AFO_FMA, Local_AFO_FIV, Local_AFO_FIT).
