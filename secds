// --- KPIs de portada: nivel actual y variación vs comparación --------------
function kpis(cAct, cCmp){
  const tot = (corte, metrica) => {
    const met = metricaDisponible('Resumen_Bloques', metrica, corte);
    let t=0;
    for(const r of HIST){
      if(r.OBJETO==='Resumen_Bloques' && r.METRICA===met &&
         String(r.FECHA_CORTE)===String(corte) && r.DIM_1==='TOTAL') t+=+r.VALOR||0;
    }
    return t;
  };
  const cob = (corte, metrica) => {
    for(const r of HIST){
      if(r.OBJETO==='Cobertura' && r.METRICA===metrica &&
         String(r.FECHA_CORTE)===String(corte) && r.DIM_1==='TOTAL') return +r.VALOR||0;
    }
    return null;
  };
  const items = [
    ['Huella de Carbono', 'Huella (miles Tn)', 'miles Tn CO2'],
    ['Intensidad',        'Intensidad',        'Tn CO2 / USD MM'],
    ['AUM',               'Inv MM$',           'USD MM']
  ];
  const html = items.map(([titulo, metrica, unidad])=>{
    const va = tot(cAct, metrica), vb = tot(cCmp, metrica);
    const d = vb ? (va/vb - 1) : null;
    const color = d===null ? '#5A6B7B' : (d<0 ? '#1B8F5A' : '#C0392B');
    const flecha = d===null ? '' : (d<0 ? '▼' : '▲');
    return '<div class="kpi"><span class="kpi-t">'+titulo+'</span>'+
      '<span class="kpi-v">'+fmt(va)+'</span>'+
      '<span class="kpi-u">'+unidad+'</span>'+
      '<span class="kpi-d" style="color:'+color+'">'+flecha+' '+
      (d===null?'s/d':((d>0?'+':'')+(d*100).toFixed(1)+'% vs '+cCmp))+'</span></div>';
  }).join('');
  const cobItems = [
    ['Cob. Directa', 'Cobertura_Directa', 'data MSCI directa'],
    ['Cob. Proxy',   'Cobertura_Proxy',   'data por proxy']
  ];
  const htmlCob = cobItems.map(([titulo, metrica, unidad])=>{
    const ca = cob(cAct, metrica), cb = cob(cCmp, metrica);
    if(ca===null) return '';
    const dpp = (cb!==null) ? (ca - cb)*100 : null;
    const colr = dpp===null ? '#5A6B7B' : (dpp>=0 ? '#1B8F5A' : '#C0392B');
    const flc = dpp===null ? '' : (dpp>=0 ? '▲' : '▼');
    return '<div class="kpi"><span class="kpi-t">'+titulo+'</span>'+
      '<span class="kpi-v">'+(ca*100).toFixed(1)+'%</span>'+
      '<span class="kpi-u">'+unidad+'</span>'+
      '<span class="kpi-d" style="color:'+colr+'">'+flc+' '+
      (dpp===null?'s/d':((dpp>=0?'+':'')+dpp.toFixed(1)+' pp vs '+cCmp))+'</span></div>';
  }).join('');
  document.getElementById('kpis').innerHTML = html + htmlCob;
}

