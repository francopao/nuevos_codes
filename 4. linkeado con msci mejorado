def Opr(result):
    def replace_rating(value):
        if pd.isna(value):
            return "NoCov"
        else:
            return "Cov"

    # Aplicar la función a la columna 'Rating' y crear una nueva columna 'Cobertura'
    result['Cobertura'] = result['RATING'].apply(lambda x: replace_rating(x))

    def sumar_condicional(fila):
        rating_value = fila['RATING']
        if pd.isna(rating_value):
            rating_value = ''
        return result[(result['Fondo'] == fila['Fondo']) & (result['Afp'] == fila['Afp']) & (result['Cobertura'] ==  fila['Cobertura'])]['Weight'].sum()

    def sumar_condicional2(fila):
        rating_value = fila['RATING']
        if pd.isna(rating_value):
            rating_value = ''
        return result[(result['Fondo'] == fila['Fondo']) & (result['Afp'] == fila['Afp'])]['Weight'].sum()

    result['Weight_Ingresado'] = result.apply(sumar_condicional2, axis=1)
    result['Weight_Cubierto'] = result.apply(sumar_condicional, axis=1)
    result['Weight_N'] = result['Weight']/result['Weight_Cubierto']


    result['trend*Wn'] = result['Weight_N']*result['IVA_RATING_TREND']
    result['E*Wn'] = result['Weight_N']*result['E']
    result['S*Wn'] = result['Weight_N']*result['S']
    result['G*Wn'] = result['Weight_N']*result['G']
    result['ESG*Wn'] = result['Weight_N']*result['INDUSTRY_ADJUSTED_SCORE']
    result['Controversia*Wn'] = result['Weight_N']*result['CONTROVERSIES']
    result['CO2/Sales*Wn'] = result['Weight_N']*result['CO2/Sales']
    result['CO2/EVIC*Wn'] = result['Weight_N']*result['CO2/EVIC']
    result['CO2*Wn'] = result['Weight_N']*result['CO2 Tn']
    result['Gov*Wn'] = result['Weight_N']*result['GOVERNANCE_PILLAR_QUARTILE']
    
    return result
