def calcular_periodo_proxy(periodo_manual=None, fecha_ejecucion=None):
    """
    Determina la hoja mensual (formato 'YYYYMM') a utilizar del archivo de proxies.
    Prioridad: 1) periodo_manual definido por el usuario, 2) cálculo automático
    según la fecha de ejecución (<=15 -> mes actual, >15 -> mes siguiente).
    """
    if periodo_manual:
        return periodo_manual

    fecha_ejecucion = fecha_ejecucion or datetime.now()

    if fecha_ejecucion.day <= 15:
        anio_p, mes_p = fecha_ejecucion.year, fecha_ejecucion.month
    else:
        if fecha_ejecucion.month == 12:
            anio_p, mes_p = fecha_ejecucion.year + 1, 1
        else:
            anio_p, mes_p = fecha_ejecucion.year, fecha_ejecucion.month + 1

    return f"{anio_p}{mes_p:02d}"
#%%
def cargar_mapa_proxies(ruta_proxies):
    """
    Lee la hoja 'Reporte ASG Mensual' del archivo de proxies y arma el diccionario
    ISIN original (columna B) -> ISIN proxy (columna H).
    """
    wb = xw.Book(ruta_proxies, read_only=True, update_links=False)
    sheet = wb.sheets['Reporte ASG Mensual']
    datos = sheet.used_range.value
    wb.close()

    df_map = pd.DataFrame(datos)
    df_map.columns = df_map.iloc[0, ::]
    df_map = df_map.drop([0], axis=0)

    isin_col = df_map.columns[1]   # Columna B: ISIN original
    proxy_col = df_map.columns[7]  # Columna H: Proxy

    df_map = df_map[[isin_col, proxy_col]].dropna()
    df_map[isin_col] = df_map[isin_col].astype(str).str.strip().str.upper()
    df_map[proxy_col] = df_map[proxy_col].astype(str).str.strip().str.upper()
    df_map = df_map.drop_duplicates(subset=[isin_col])

    return df_map.set_index(isin_col)[proxy_col].to_dict()
#%%
def cargar_esg_proxy(ruta_proxies, periodo):
    """
    Lee la hoja mensual 'YYYYMM' del archivo de proxies con la información ESG MSCI
    asociada a los ISIN proxy, y arma un diccionario de diccionarios por campo,
    indexado por 'Client_ID' (ISIN del proxy).
    """
    wb = xw.Book(ruta_proxies, read_only=True, update_links=False)
    nombres_hojas = [s.name for s in wb.sheets]
    if periodo not in nombres_hojas:
        wb.close()
        raise ValueError(f"No existe la hoja '{periodo}' en el archivo de proxies.")

    sheet = wb.sheets[periodo]
    datos = sheet.used_range.value
    wb.close()

    df_esg = pd.DataFrame(datos)
    df_esg.columns = df_esg.iloc[0, ::]
    df_esg = df_esg.drop([0], axis=0)
    df_esg['Client_ID'] = df_esg['Client_ID'].astype(str).str.strip().str.upper()
    df_esg = df_esg.drop_duplicates(subset=['Client_ID'])
    df_esg = df_esg.set_index('Client_ID')

    return df_esg.to_dict()
