def aplicar_proxies_esg(result_bd, ruta_proxies, periodo_manual=None):
    """
    Para los registros sin cobertura MSCI directa (RATING nulo, i.e. 'NoCov'),
    completa los campos ESG con la información del proxy definido manualmente
    en 'Reporte ASG Mensual', tomando los valores desde la hoja mensual 'YYYYMM'
    correspondiente. No modifica los atributos propios del instrumento
    (ISIN, Cod. Originador, Fondo, Afp, Weight, Fecha, etc.).
    """
    periodo = calcular_periodo_proxy(periodo_manual)
    mapa_proxy = cargar_mapa_proxies(ruta_proxies)
    esg_proxy_dict = cargar_esg_proxy(ruta_proxies, periodo)

    result_bd = result_bd.copy()
    isin_norm = result_bd['ISIN'].astype(str).str.strip().str.upper()

    sin_cobertura = result_bd['RATING'].isna()

    isin_proxy = pd.Series(np.nan, index=result_bd.index, dtype=object)
    isin_proxy.loc[sin_cobertura] = isin_norm.loc[sin_cobertura].map(mapa_proxy)

    for columna, clave in MAPEO_PROXY_COLUMNAS:
        if columna not in result_bd.columns:
            continue
        diccionario_campo = esg_proxy_dict.get(clave, {})
        valores_proxy = isin_proxy.map(diccionario_campo)
        mascara = sin_cobertura & result_bd[columna].isna() & isin_proxy.notna()
        result_bd.loc[mascara, columna] = valores_proxy.loc[mascara]

    return result_bd
