 .fila {{ display:flex; gap:20px; align-items:flex-start; }}
 .fecha {{ border:1px solid #7F7F7F; display:inline-flex; margin-bottom:8px; font-weight:700; }}
 .fecha span {{ padding:3px 12px; }} .fecha span+span {{ border-left:1px solid #7F7F7F; }}
 .pie {{ font-size:12px; color:#444; margin-top:8px; }} .pie ul {{ margin:4px 0 0 18px; padding:0; }}
</style></head><body>
<div class="b1">Monitor Z Valuation RVL</div>
<div class="b2">Valuation Relativo Acciones RVL</div>
<div class="fila">
  <div>
    <div class="fecha"><span>Fecha</span><span>{meta['fecha']:%d/%m/%Y}</span></div>
    {h_tab}
    <div class="pie"><b>Weights of Z-Dist</b> (informativo): {pesos}<br>
    <b>Benchmark RV</b>: {e(meta['modo'])}</div>
  </div>
  <div>{h_bub}</div>
</div>
<div class="pie">
  Posiciones (tamaño de burbuja) al {meta['fecha_pos']:%d/%m/%Y} · Tamaño = (Fondo1+Fondo2+Fondo3 PxQ)/{DIVISOR_TAMANO:,}.
  <br><b>Notas de calidad de datos</b><ul>{notas}</ul>
</div>
</body></html>"""


# %% 7. ORQUESTADOR


def generar_monitor(ruta_xlsm=RUTA_XLSM, fecha=FECHA, modo=MODO, validar=VALIDAR_CONTRA_EXCEL):
    """Pipeline completo: lee el libro, calcula el Monitor, valida contra Excel y escribe el HTML.

    Parámetros: ruta_xlsm (Path), fecha ('monitor' | 'ultima' | 'AAAA-MM-DD'), modo ('monitor' | 'Basket' | 'Indice'),
                validar (bool).
    Retorna: (ruta_html, df_monitor). Lanza excepciones explícitas ante datos o mapeos inconsistentes.
    """
    ruta_xlsm = Path(ruta_xlsm)
    if not ruta_xlsm.exists():
        raise FileNotFoundError(f"No se encontró el libro: {ruta_xlsm}")
    alertas = []
    print(f"Leyendo {ruta_xlsm.name} (puede tardar por DQ_IN)…")
    wb = load_workbook(ruta_xlsm, read_only=True, data_only=True)
    try:
        faltan = [h for h in ("Monitor", "Parametría", "BD", "DQ_IN", "Baskets") if h not in wb.sheetnames]
        if faltan:
            raise KeyError(f"Faltan hojas en el libro: {faltan}")
        mon = leer_monitor(wb)
        param = leer_parametria(wb)
        bd = leer_bd(wb)
        sbs = [param.loc[t, "sbs"] for t in mon["universo"] if t in param.index and t not in TAMANO_FIJO]
        pxq, sin_sbs = leer_dq_in(wb, sbs)
        baskets = leer_baskets(wb)
    finally:
        wb.close()

    modo_ef = mon["modo"] if str(modo).lower() == "monitor" else str(modo).capitalize()
    if modo_ef not in ("Basket", "Indice"):
        raise ValueError(f"MODO debe ser 'Basket' o 'Indice' (recibido: {modo_ef!r}).")
    if str(fecha).lower() == "monitor":
        if mon["fecha"] is None:
            raise ValueError("Monitor!B6 está vacío; indique FECHA explícita.")
        f_sol = mon["fecha"]
    elif str(fecha).lower() == "ultima":
        f_sol = bd.index.max()
    else:
        f_sol = pd.Timestamp(fecha)
    fecha_bd = resolver_fecha_bd(bd, f_sol, RETROCEDER_FECHA_BD, alertas)
    cols_sbs = [c for c in pxq.columns]
    fecha_pos = resolver_fecha_posicion(pxq, fecha_bd, cols_sbs, alertas)

    df = construir_monitor(bd, param, pxq, mon["universo"], fecha_bd, fecha_pos, modo_ef, baskets, alertas)

    # Calidad de datos
    for t in df.index[df["x"].isna() | df["y"].isna()]:
        alertas.append(f"{t}: sin Z válido en la fecha; no se dibuja en el chart y aparece como n.d. en la tabla.")
    for t in df.index[(df["tamano"] == 0) & ~df.index.isin(TAMANO_FIJO)]:
        alertas.append(f"{t}: sin posición en DQ_IN a esa fecha; no se dibuja la burbuja.")
    fuera = df[((df["x"] < EJE_X["rango"][0]) | (df["x"] > EJE_X["rango"][1]) |
                (df["y"] < EJE_Y["rango"][0]) | (df["y"] > EJE_Y["rango"][1]))]
    for t in fuera.index:
        alertas.append(f"{t} está fuera de los ejes fijos del chart (X {EJE_X['rango']}, Y {EJE_Y['rango']}): no se ve.")

    if validar:
        if fecha_bd == mon["fecha"] and modo_ef == mon["modo"]:
            d = validar_contra_excel(df, mon["cache"])
            print(f"✔ Validación vs Excel OK (dif. máx.: X {d['x']:.1e} · Y {d['y']:.1e} · tamaño {d['tamano']:.1e})")
        else:
            print("ℹ Validación vs Excel omitida: fecha/modo distintos a los guardados en Monitor.")

    meta = dict(fecha=fecha_bd, fecha_pos=fecha_pos, modo=modo_ef, pesos=mon["pesos"])
    fig_t, fig_b = figura_tabla(df, modo_ef), figura_bubble(df, modo_ef)
    carpeta = Path(CARPETA_SALIDA) if CARPETA_SALIDA else ruta_xlsm.parent
    base = carpeta / f"Monitor_Replica_{fecha_bd:%Y%m%d}_{modo_ef}"
    ruta_html = base.with_suffix(".html")
    ruta_html.write_text(construir_html(fig_t, fig_b, meta, alertas), encoding="utf-8")
    print(f"✔ HTML: {ruta_html}")
    if EXPORTAR_PNG:
        try:
            fig_b.write_image(str(base) + "_bubble.png", scale=2)
            fig_t.write_image(str(base) + "_tabla.png", scale=2)
            print("✔ PNG exportados.")
        except Exception as exc:   # kaleido/Chrome no disponible: no es crítico
            print(f"⚠ No se pudieron exportar PNG ({exc}).")
    for a in alertas:
        print("  •", a)
    return ruta_html, df


