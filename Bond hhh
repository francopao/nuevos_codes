Reemplaza con:
```python
        sbs = df[self.sbs_col].map(_to_string)

        def _nombre_con_fallback(s, emisor_cod):
            # 1) Nombre desde BD1_S_Huella (vía parametria_lookup)
            v = self._param(s, "NOMBRE")
            if v is not None and not (isinstance(v, float) and pd.isna(v)) and str(v).strip() != "":
                return v
            # 2) Fallback: Nombre desde G&P Detallado (columna D del G&P_MLab)
            g = (self.gyp_lookup.get(s) or {}).get("NOMBRE") if self.gyp_lookup else None
            if g is not None and not (isinstance(g, float) and pd.isna(g)) and str(g).strip() != "":
                return g
            # 3) Último recurso: 'Cliente <codEmisor>' — identificador temporal
            # que al menos distingue emisores entre sí mientras se resuelve la fuente.
            cod = _to_string(emisor_cod)
            if cod:
                return f"Cliente {cod}"
            return None

        cod_emisor = df["EMISOR"] if "EMISOR" in df.columns else pd.Series([None] * len(df))
        df[V_G] = [_nombre_con_fallback(s, e) for s, e in zip(sbs, cod_emisor)]
```

