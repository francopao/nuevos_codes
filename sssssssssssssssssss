// --- Chart 1: 4 bloques por AFP en orden fijo (excluye Ex_Integra a
//     propósito). Barras = Intensidad; marcador = Weight combinado F1+F2+F3
//     (eje Y2, %). Separadores punteados SOLO en límites entre AFP; nombre
//     de la AFP centrado arriba de cada bloque. -----------------------------
const AFP_ORDEN_CHART1 = ['Integra', 'Profuturo', 'Prima', 'Habitat'];

function _gypDatosChart1(corte, topPorAfp){
  const ZWSP = '\u200B';   // disambigua nombres repetidos entre bloques de AFP
                           // sin usar tickvals/ticktext (ver nota Módulo 14).
  const nombres = [], afpFila = [], barVals = [], mkVals = [], bloques = [];
  let cursor = 0;
  AFP_ORDEN_CHART1.forEach((afp, bi) => {
    const bar = new Map(), mk = new Map();
    for(const r of HIST){
      if(r.OBJETO!=='Contrib_GyP_AFP' || String(r.FECHA_CORTE)!==String(corte) ||
         r.AFP!==afp || !r.DIM_1) continue;
      if(r.METRICA==='Intensidad') bar.set(r.DIM_1, (bar.get(r.DIM_1)||0) + (+r.VALOR||0));
      if(r.METRICA==='Weight') mk.set(r.DIM_1, (mk.get(r.DIM_1)||0) + (+r.VALOR||0));
    }
    const top = [...bar.keys()].sort((a,b)=>(bar.get(b)||0)-(bar.get(a)||0)).slice(0, topPorAfp);
    if(!top.length) return;
    const start = cursor;
    top.forEach(n => {
      nombres.push(n + ZWSP.repeat(bi)); afpFila.push(afp);
      barVals.push(bar.get(n)||0); mkVals.push(mk.get(n)||0);
      cursor++;
    });
    bloques.push({afp, start, end: cursor-1, centro: (start+cursor-1)/2});
  });
  return {nombres, afpFila, barVals, mkVals, bloques};
}

// Elige el mayor divisor (1 / mil / millón / mil millones) tal que el
// máximo escalado siga siendo >= 1, para dejar como máximo ~2 dígitos.
function _escalaEje(valores){
  const max = Math.max(0, ...valores.map(v => Math.abs(v||0)));
  const niveles = [[1,''], [1e3,'Miles'], [1e6,'Millones'], [1e9,'Miles de millones']];
  let elegido = niveles[0];
  for(const nivel of niveles){ if(max / nivel[0] >= 1) elegido = nivel; }
  return {div: elegido[0], suf: elegido[1]};
}

function contribuyentesGyPHuella(div, corte){
  const {nombres, afpFila, barVals, mkVals, bloques} = _gypDatosChart1(corte, 6);
  if(!nombres.length){ document.getElementById(div).innerHTML=''; return; }
  const esc = _escalaEje(barVals);
  const barEsc = barVals.map(v => v / esc.div);
  const colores = afpFila.map(afp => CAFP2[afp] || '#666');
  const traces = [
    {type:'bar', name:'Intensidad (Tn CO2 / USD MM)', x:nombres, y:barEsc,
     marker:{color:colores}, text:barEsc.map(v => v.toFixed(1)), textposition:'outside',
     cliponaxis:false, textfont:{size:10,color:CFG.color_texto}},
    {type:'scatter', mode:'markers', name:'Weight (F1+F2+F3)',
     x:nombres, y:mkVals, yaxis:'y2',
     marker:{size:12, color:'#fff', line:{width:2,color:C_ACC}}}
  ];
  const lay = LAYOUT();
  lay.xaxis = {type:'category', tickangle:-90, showgrid:false,
               showline:true, linecolor:CFG.color_grid, ticks:''};
  lay.yaxis.title = 'Intensidad (Tn CO2 / USD MM)' + (esc.suf ? ' — ' + esc.suf : '');
  lay.yaxis2 = {overlaying:'y', side:'right', showgrid:false, zeroline:false,
                title:'Weight', tickformat:'.0%'};
  lay.legend = {orientation:'h', yanchor:'bottom', y:1.16, x:0, bgcolor:'rgba(0,0,0,0)'};
  lay.margin = {l:60, r:60, t:70, b:150};
  lay.shapes = bloques.slice(1).map(b => ({
    type:'line', xref:'x', yref:'y domain',
    x0:b.start-0.5, x1:b.start-0.5, y0:0, y1:1,
    line:{color:'#B8C2CC', width:1, dash:'dot'}
  }));
  lay.annotations = bloques.map(b => ({
    x:b.centro, xref:'x', y:1, yref:'y domain', yshift:14,
    text:'<b>'+b.afp+'</b>', showarrow:false,
    font:{size:12, color:CFG.color_texto}, xanchor:'center', yanchor:'bottom'
  }));
  Plotly.react(div, traces, lay, OPTS);
}
