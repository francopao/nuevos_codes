    def gyp_pesos_universo(self) -> pd.DataFrame:
        """Fila a fila (SBS x Fondo), TODO el universo (BU+TD+SOB+ALT+
        Proxies+ETF): los inputs crudos (Weight_Original_BD1S, Patrimonio=
        AUM del fondo, TC_USD) que sustentan la renormalización de Weight
        y el cálculo de Inv MM$. Con el universo completo, Suma_Weight_
        Fondo se calcula con SUMIFS en Excel — ya no hace falta pegar el
        valor desde Python."""
        requeridas = [COL["sbs"], "Weight_Original_BD1S", "Patrimonio", "TC_USD",
                       COL["portafolio"]]
        if any(c not in self.df.columns for c in requeridas):
            return pd.DataFrame()
        d = self.df.copy()
        cols = [COL["sbs"], COL["isin"], COL["nombre"], COL["portafolio"],
                COL["estrategia"], "Weight_Original_BD1S", "Patrimonio", "TC_USD"]
        cols = [c for c in cols if c in d.columns]
        out = d[cols].copy()
        out = out.rename(columns={COL["sbs"]: "SBS", COL["isin"]: "ISIN",
                                   COL["nombre"]: "Emisor", COL["portafolio"]: "Portafolio",
                                   COL["estrategia"]: "Estrategia"})
        out["Fondo"] = "F" + out["Portafolio"].astype(str).str.extract(r"(\d)$")[0].fillna("")
        return out
