INSERTAR ANTES:
```js
function sanitizeSheetName(name){
  return name.replace(/[\\/?*\[\]:]/g,"-").slice(0,31) || "Datos";
}

function buildSheetAOA(panel){
  const traces = buildTraces(panel);
  const aoa = [["Fecha", ...traces.map(t=>t.name)]];
  const n = traces.length ? traces[0].x.length : 0;
  for(let i=0;i<n;i++){
    aoa.push([traces[0].x[i], ...traces.map(t=>t.y[i])]);
  }
  return aoa;
}

function exportWorkbook(){
  const wb = XLSX.utils.book_new();
  const basisLabel = BASIS === "trail" ? "Trailing" : "Forward";
  PAYLOAD.panels.forEach(panel=>{
    const ws = XLSX.utils.aoa_to_sheet(buildSheetAOA(panel));
    const sheetName = sanitizeSheetName(`${panelTitle(panel)} (${basisLabel})`);
    XLSX.utils.book_append_sheet(wb, ws, sheetName);
  });
  XLSX.writeFile(wb, "Multiplos_ZODA_export.xlsx");
}

function initExport(){
  document.getElementById("exportBtn").addEventListener("click", exportWorkbook);
}
```

Notas:
- `buildSheetAOA` reutiliza `buildTraces(panel)`, que ya refleja target/comps seleccionados, basis (trail/fwd) y rango de fechas activo — mismos datos que ve el usuario en el chart.
- Cada hoja: header `Fecha` + una columna por serie mostrada (targets, "Comps", comparables individuales), nombre de hoja truncado a 31 caracteres (límite de Excel).
- El título del card (`panelTitle`) ahora se arma con los shortnames de los targets seleccionados, así que BAP aparecerá por default en el chart 1 junto con IFS, y el título se actualiza solo si el usuario cambia el slicer de target.
