# ------------------------------------------------------------------ MAIN
def main():
    print("=" * 62)
    print("  Monitor de Múltiplos — Generador de Dashboard HTML")
    print("=" * 62)
    check_deps()

    xlsx_path = os.path.join(BASE_DIR, XLSX_NAME)
    logo_path = os.path.join(BASE_DIR, LOGO_NAME)
    out_path  = os.path.join(BASE_DIR, OUT_NAME)

    if not os.path.isdir(BASE_DIR):
        err(f"No existe la ruta base: {BASE_DIR}")
        sys.exit(1)
    if not os.path.isfile(xlsx_path):
        err(f"No se encontró el Excel: {xlsx_path}")
        sys.exit(1)
    if not os.path.isfile(logo_path):
        warn(f"No se encontró el logo: {logo_path} (el dashboard saldrá sin logo)")

    try:
        dataset, fechas = construir_dataset(xlsx_path)
        validar_defaults(dataset)
        logo_uri = b64_logo(logo_path) if os.path.isfile(logo_path) else ""
        html = build_html(dataset, fechas, logo_uri)
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(html)
        log(f"Dashboard generado: {out_path}")
        log(f"Tamaño: {os.path.getsize(out_path)/1024:.0f} KB")
        print("=" * 62)
        print("  LISTO. Abre el HTML en tu navegador (requiere internet para Plotly CDN).")
        print("=" * 62)
    except Exception as e:
        err(f"Fallo inesperado: {e}")
        traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
