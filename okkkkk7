  toImageButtonOptions:{ format:"png", scale:3, filename:"multiplo" } };

function getSel(pid,kind){
  const el=document.getElementById(pid+"_"+kind);
  return Array.from(el.selectedOptions).map(o=>o.value);
}

function redraw(panel){
  Plotly.react(panel.id+"_plot", buildTraces(panel), layout(panel), CFG);
}

function optionsFor(sector, selected){
  const names=Object.keys(DATA[sector]||{}).sort((a,b)=>a.localeCompare(b));
  return names.map(n=>`<option value="${n.replace(/"/g,'&quot;')}"`
