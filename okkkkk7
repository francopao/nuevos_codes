      line:{ color:COL.target[i%COL.target.length], width:2.6 } });
  });

  const compArrays = comps.filter(n=>sect[n]).map(n=>sect[n][BASIS]);
  if(compArrays.length){
    traces.push({ x:FECHAS, y:meanSeries(compArrays), name:"Comps",
      mode:"lines", connectgaps:true, hovertemplate:"%{y:.1f}<extra>Comps</extra>",
      line:{ color:COL.comps, width:2.2 } });
  }
  comps.forEach((name,i)=>{
    if(!sect[name]) return;
    traces.push({ x:FECHAS, y:sect[name][BASIS], name:shortName(name),
      mode:"lines", connectgaps:true, hovertemplate:"%{y:.1f}<extra>"+shortName(name)+"</extra>",
      line:{ color:COL.indiv[i%COL.indiv.length], width:1.4 } });
  });
