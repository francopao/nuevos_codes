# ------------------------------------------------------------------ HELPERS
def log(msg):  print(f"[INFO] {msg}", flush=True)
def warn(msg): print(f"[WARN] {msg}", flush=True)
def err(msg):  print(f"[ERROR] {msg}", flush=True)


def check_deps():
    faltan = []
    try:
        import openpyxl  # noqa
    except Exception:
        faltan.append("openpyxl")
    try:
        import pandas  # noqa
    except Exception:
        faltan.append("pandas")
    if faltan:
        err("Faltan librerías: " + ", ".join(faltan))
        err("Instala con:  pip install " + " ".join(faltan))
        sys.exit(1)


# ------------------------------------------------------------------ EXTRACT
def construir_dataset(xlsx_path):
    import pandas as pd
    import numpy as np  # noqa

    sectores_necesarios = sorted({p["sector"] for p in PANELS})
    log(f"Leyendo hojas: {', '.join(sectores_necesarios)}")
    hojas = pd.read_excel(xlsx_path, sheet_name=sectores_necesarios, header=None)

    data = {}          # sector -> {empresa -> {"fwd": Series, "trail": Series}}
    fechas_ref = None  # eje X común (YYYY-MM)

    for sector in sectores_necesarios:
        if sector not in hojas:
            warn(f"Sector ausente en el Excel: '{sector}' (se omite)")
            continue
        df = hojas[sector]                     # fila0=Empresa, fila1=Multiplo, fila3+=datos
        empresas_row = df.iloc[0].tolist()
        mult_row = df.iloc[1].tolist()
        fechas = pd.to_datetime(df.iloc[3:, 0], errors="coerce")
        mask = fechas.notna()
        fechas = fechas[mask]

        metric = next(p["metric"] for p in PANELS if p["sector"] == sector)
        col_fwd, col_trail = METRIC_COLS[metric]

        # bloques: columna donde arranca cada empresa
        bloques, cur = [], None
        for c in range(1, df.shape[1]):
            nm = empresas_row[c]
            if isinstance(nm, str) and nm.strip():
                cur = nm.strip()
                bloques.append((cur, c))

        data[sector] = {}
        vistas = set()
        for name, st in bloques:
            if name in vistas:
                continue
            vistas.add(name)
            mults = [mult_row[st + k] if st + k < df.shape[1] else None for k in range(8)]
            reg = {}
            for tag, mcol in (("fwd", col_fwd), ("trail", col_trail)):
                if mcol in mults:
                    col = st + mults.index(mcol)
                    vals = pd.to_numeric(df.iloc[3:, col], errors="coerce")[mask.values]
                    s = pd.Series(vals.values, index=fechas.values, dtype="float64")
                    s = s.resample(RESAMPLE).last()
                    s = s[s.index >= FECHA_INICIO]
                    reg[tag] = s
            if not reg:
                continue
            ref = reg.get("trail", reg.get("fwd"))
            if fechas_ref is None:
                fechas_ref = [pd.Timestamp(d).strftime("%Y-%m") for d in ref.index]
            data[sector][name] = reg

    if fechas_ref is None:
        err("No se pudo construir el eje temporal (sin datos válidos).")
        sys.exit(1)

    # alinear todas las series al eje comun (clave 'YYYY-MM') -> listas con None
    import numpy as np
    n = len(fechas_ref)
    salida = {}
    total_emp = 0
    for sector, emps in data.items():
        salida[sector] = {}
        for name, reg in emps.items():
            row = {}
            for tag in ("fwd", "trail"):
                if tag in reg:
                    s = reg[tag]
                    d = {pd.Timestamp(ix).strftime("%Y-%m"): val
                         for ix, val in zip(s.index, s.values)}
                    row[tag] = [None if (d.get(k) is None or
                                         (isinstance(d.get(k), float) and np.isnan(d.get(k))))
                                else round(float(d[k]), 3) for k in fechas_ref]
                else:
                    row[tag] = [None] * n
            salida[sector][name] = row
            total_emp += 1
        log(f"Sector '{sector}': {len(emps)} empresas procesadas.")

    log(f"Total empresas: {total_emp} | Puntos temporales: {n} "
        f"({fechas_ref[0]} → {fechas_ref[-1]})")
    return salida, fechas_ref


# ------------------------------------------------------------------ VALIDATE
def validar_defaults(dataset):
    for p in PANELS:
        sect = dataset.get(p["sector"], {})
        for grupo in ("targets", "comps"):
            faltan = [e for e in p[grupo] if e not in sect]
            if faltan:
                warn(f"[{p['id']}] no encontradas en '{p['sector']}': {faltan}")
            p[grupo] = [e for e in p[grupo] if e in sect]  # solo válidas


# ------------------------------------------------------------------ HTML
def b64_logo(path):
    try:
        with open(path, "rb") as f:
            return "data:image/png;base64," + base64.b64encode(f.read()).decode()
    except Exception as e:
        warn(f"No se pudo cargar el logo ({e}); se omite.")
        return ""


