<script>
const PAYLOAD = __DATA__;
const FECHAS = PAYLOAD.fechas;
const DATA   = PAYLOAD.data;
const COL    = PAYLOAD.colors;
let BASIS = "trail";

function meanSeries(seriesList){
  const n = FECHAS.length, out = new Array(n).fill(null);
  for(let i=0;i<n;i++){
    let s=0,c=0;
    for(const arr of seriesList){ const v=arr[i]; if(v!==null&&v!==undefined){s+=v;c++;} }
    out[i] = c ? s/c : null;
  }
  return out;
}

function buildTraces(panel){
  const sect = DATA[panel.sector] || {};
  const targets = getSel(panel.id,"tg");
  const comps   = getSel(panel.id,"cp");
  const traces = [];

  targets.forEach((name,i)=>{
