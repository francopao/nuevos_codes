**EDIT 1 — Nueva función lectora de weights.** Ctrl+F: `# 4. LIMPIEZA HOJA RVL` y pega este bloque **justo encima** de esa línea (queda a nivel de módulo):

```python
def leer_weights_in(path: Path, sbs_validos: list[str]) -> dict[str, pd.DataFrame]:
    """Weights YA CALCULADOS de QEST_BD!DQ_IN: filas con Dato='%Fondo',
    SBS en la fila 11 (col E+), Fecha en col C. Sin precios, cantidades ni TC."""
    import openpyxl
    wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
    filas = list(wb["DQ_IN"].iter_rows(values_only=True))
    wb.close()
    cab = [str(v).strip() if v is not None else "" for v in filas[10]]  # fila 11 = SBS
    disponibles = set(cab[4:])
    faltan_w = [s for s in sbs_validos if s not in disponibles]
    if faltan_w:
        print(f"[AVISO] {len(faltan_w)} instrumento(s) de Parametria SIN weight en "
              f"DQ_IN (van con peso 0): {faltan_w[:8]}{'…' if len(faltan_w) > 8 else ''}")
    out = {}
    for f in FONDOS:
        reg = [r for r in filas if str(r[0]).strip() == f"IN-FONDO{f}"
               and str(r[1]).strip() == "%Fondo"]
        if not reg:
            fallar(f"DQ_IN: sin filas '%Fondo' para IN-FONDO{f}.")
        df = pd.DataFrame(reg)
        df.columns = cab
        df.index = pd.to_datetime([r[2] for r in reg], errors="coerce")
        df = df.iloc[:, 4:]                       # de la col E = instrumentos
        df = df.loc[df.index.notna()]
        df = df.loc[:, ~df.index.duplicated(keep="last")] if False else df  # (no-op)
        df = df[~df.index.duplicated(keep="last")]
        keep = [c for c in sbs_validos if c in df.columns]
        df = df.loc[:, keep]
        df = df.loc[:, ~df.columns.duplicated()]
        out[f"IN_F{f}"] = df.apply(pd.to_numeric, errors="coerce").fillna(0.0).sort_index()
    return out
```

