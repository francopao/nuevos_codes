_FECHA_RE = re.compile(r'^\d{4}-\d{2}-\d{2}$')

def _fecha_desde_entorno():
    """Prioridad: FECHA_FORZADA (variable editable) > argumento CLI con formato
    YYYY-MM-DD. Ignora flags de Spyder/IPython (p.ej. '-f <kernel.json>')."""
    if FECHA_FORZADA:
        return FECHA_FORZADA
    for a in sys.argv[1:]:
        if _FECHA_RE.match(a):
            return a
    return None

def main():
    fecha_forzada = _fecha_desde_entorno()
    try:
        fecha_dt = detectar_fecha(fecha_forzada)
        base = construir_base(fecha_dt)
        imprimir_proxies()   # reporte de proxies, separado del de descartes

        res_n = procesar_rama(base, soberanos=False)
        res_s = procesar_rama(base, soberanos=True)

        # --- Un solo archivo de descartes: hoja NORMAL + hoja SOBERANOS -------
        ruta_desc = D_INTERMEDIO + 'Descartes.xlsx'
        try:
            with pd.ExcelWriter(ruta_desc, engine='openpyxl') as _w:
                for _tag, _res in [('NORMAL', res_n), ('SOBERANOS', res_s)]:
                    _d = _res.get('descartes')
                    if _d is None or not len(_d):
                        _d = pd.DataFrame(columns=['SBS', 'ISIN', 'Nombre', 'Etapa', 'Motivo'])
                    _d.to_excel(_w, sheet_name=_tag, index=False)
            print(f"\n[DESCARTES] Archivo único (2 hojas) -> {ruta_desc}")
        except Exception as e:
            print(f"[AVISO] No se pudo escribir el archivo único de descartes: {e}")
        # --- Huella: enriquecimiento de BD1_S con columnas para Huella ----
        try:
            res_h = enriquecer_para_huella(base, res_s['BD1'], base.anio, base.mes)
        except Exception as e:
            print(f"\n[HUELLA] [AVISO] Enriquecimiento falló (no crítico): {e}")
            import traceback; traceback.print_exc()
            res_h = {'BD1_S_Huella': None}

        print("\n================  LISTO  ================")
        print("NORMAL   :", res_n)
        print("SOBERANOS:", res_s)
        print("HUELLA   :", res_h)
    except ProcesoError as e:
        print("\n[ERROR CONTROLADO]\n" + str(e))
        sys.exit(1)
    except Exception as e:
        import traceback
        print("\n[ERROR INESPERADO]")
        traceback.print_exc()
        sys.exit(2)
    finally:
        global _XW_APP
        if _XW_APP is not None:
            try:
                _XW_APP.quit()
            except Exception:
                pass
            _XW_APP = None  # evita procesos Excel huérfanos


if __name__ == '__main__':
    main()
