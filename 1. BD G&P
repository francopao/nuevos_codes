def fechas_datavalorcuota():
    df = leer_xlsx(R_VALORCUOTA, 'DataHistórica')
    # header en fila 5 (Excel 6); Fecha en la primera col del bloque 1:22
    fechas = []
    for v in df.iloc[6:, 1].tolist():
        if isinstance(v, datetime):
            fechas.append(v)
    if not fechas:
        raise ProcesoError("DataValorCuota: no se pudo leer ninguna 'Fecha' válida.")
    return sorted(fechas)

def detectar_fecha(fecha_forzada=None):
    """Regla de negocio:
       - si estamos en la 1ra semana del mes (día <= 7): último día del mes anterior.
       - si no: día anterior a hoy.
       Luego se ANCLA al último dato disponible <= objetivo en DataValorCuota_IN.
       Override: fecha_forzada 'YYYY-MM-DD'."""
    disponibles = fechas_datavalorcuota()
    if fecha_forzada:
        try:
            f = datetime.strptime(fecha_forzada, '%Y-%m-%d')
        except ValueError:
            raise ProcesoError(f"Fecha forzada inválida '{fecha_forzada}' (use YYYY-MM-DD).")
        # se respeta tal cual (el usuario manda), pero se avisa si no hay dato
        if f not in disponibles:
            print(f"[AVISO] {fecha_forzada} no aparece en DataValorCuota; se usará igual.")
        return f
    hoy = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    if hoy.day <= 7:
        objetivo = hoy.replace(day=1) - timedelta(days=1)      # fin de mes anterior
    else:
        objetivo = hoy - timedelta(days=1)                      # día anterior
    candidatas = [d for d in disponibles if d <= objetivo]
    elegida = max(candidatas) if candidatas else max(disponibles)
    print(f"[FECHA] hoy={hoy:%Y-%m-%d} objetivo={objetivo:%Y-%m-%d} -> corte={elegida:%Y-%m-%d}")
    return elegida


