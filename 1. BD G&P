            try:
                return dic_vp['ID'][row["ISIN"]]
            except Exception:
                return row['Empresa']
        return row['Empresa']

    dic_p1['Empresa'] = dic_p1.apply(_reemplazar_nombre, axis=1)
    column_order = ['SBS', 'ISIN', 'Weight', 'Fondo', 'assetclass', 'Strategy', 'AFP',
                    'AUM', 'Tipo', 'Precio', 'Q', 'Inversión', 'Nombre', 'Empresa',
                    'Fecha', 'codEmisor', 'key1']
    dic_p1 = dic_p1[column_order]

    # Trazabilidad de origen del ISIN como ÚLTIMA columna (tras el reorder, para
    # no romper column_order). Se re-deriva por SBS (llave estable, nunca tocada).
    dic_p1['ISIN_Origen'] = dic_p1['SBS'].map(base.isin_origen).fillna('N/D')


    ruta_port = D_INTERMEDIO + f'{anio}{mes} Portafolio{suf}.xlsx'
    dic_p1.to_excel(ruta_port, index=False)
    print(f"[OK] Portafolio{suf} -> {ruta_port}")
    _tic("Portafolio escrito, entrando a par_bu")

    # ---- nuevos instrumentos (Para.xlsx / Para_S.xlsx) ----------------------
    try:
        _par_bu(base.param_bu, ruta_port, suf, dic_p1)
    except Exception as e:
        print(f"[AVISO] par_bu{suf} falló (no crítico): {e}")

    _tic("par_bu terminado")
    print(f"[OK] BD1{suf} -> {ruta_bd1}")
    print(f"\n[DESCARTES] Resumen para rama {etiqueta}:")
    _desc_rama = imprimir_descartes(etiqueta, D_INTERMEDIO)
    _DESCARTES.clear()
    return {'BD1': ruta_bd1, 'Portafolio': ruta_port, 'descartes': _desc_rama}


def _par_bu(param_bu, ruta_port, suf, df_portafolio_mem):
    df = param_bu.copy(deep=True)
    df.columns = df.iloc[0, ::]
    df = df.drop([0], axis=0)
    df = df.drop(df.loc[df['ISIN'].isin([None])].index)

    df2 = df.copy(); df2['validador'] = "Existe"; df2 = df2.set_index("ISIN")
    dic = df2.to_dict()

    df_pbu = df_portafolio_mem.copy(deep=True)
    df_pbu = df_pbu.loc[df_pbu['Strategy'].isin(['BU'])]
    df_pbu["validador"] = df_pbu["ISIN"].map(dic['validador'])
    df_pbu = df_pbu.loc[df_pbu["validador"].isin([np.nan])]
    df_pbu = df_pbu.get(['ISIN', 'SBS', 'codEmisor', 'Nombre'])
    df_pbu.columns = ['ISIN', 'SBS', 'Cod.Emisor', 'Nombre']

    df3 = param_bu.copy(deep=True)
    df3.columns = df3.iloc[0, ::]
    df3 = df3.drop([0], axis=0)
    df3 = df3.drop(df3.loc[df3['Cod.Emisor'].isin([None])].index).set_index('Cod.Emisor')
    dic3 = df3.to_dict()
    df_pbu.insert(4, 'Moneda', df_pbu['Cod.Emisor'].map(dic3['moneda']))
    df_pbu.insert(5, 'Sector', df_pbu['Cod.Emisor'].map(dic3['Sector']))
    df_pbu.insert(6, 'Pais', df_pbu['Cod.Emisor'].map(dic3['País']))
    df_pbu.insert(7, 'Region', df_pbu['Cod.Emisor'].map(dic3['Region']))
    df_pbu.insert(8, 'Mercado', df_pbu['Cod.Emisor'].map(dic3['mercado']))

    df_Total = pd.concat([df, df_pbu])
    # DECISIÓN: el original escribía 'Para.xlsx' en ambos scripts (se pisaban al correr
    # secuencialmente). Aquí soberanos usa 'Para_S.xlsx' para no destruir el normal en
    # una sola corrida. Si se requiere el nombre único original, quitar {suf}.
    df_Total.to_excel(R_PARA_OUT.format(suf=suf), index=False)


