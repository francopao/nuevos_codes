_PROXY_STATS = {}   # se llena una vez en construir_base(); se imprime aparte

def _proxy_col(header, candidatos, fallback):
    """Ubica una columna por encabezado (case-insensitive, admite parcial).
    Si no la encuentra, usa la posición 'fallback'."""
    up = [str(h).strip().upper() for h in header]
    for cand in candidatos:                       # match exacto
        if cand.upper() in up:
            return up.index(cand.upper())
    for cand in candidatos:                       # match parcial
        c = cand.upper()
        for i, h in enumerate(up):
            if c in h:
                return i
    return fallback

def cargar_mapa_proxies():
    """dict {SBS -> ISIN_proxy} desde el archivo externo de proxies. Reutiliza
    SOLO la ubicación/lectura (no la lógica ESG). Lectura cacheada vía leer_xlsx
    (no se relee aunque el script corra ambas ramas en una sola ejecución)."""
    try:
        dfp = leer_xlsx(R_PROXIES, R_PROXIES_HOJA)
    except ProcesoError as e:
        print(f"[AVISO] No se pudo leer el archivo de proxies -> se OMITE el "
              f"rescate por proxy (los SBS sin ISIN quedan sin ISIN).\n  {e}")
        return {}
    if dfp is None or dfp.shape[0] < 2:
        print("[AVISO] La hoja de proxies está vacía -> se omite el rescate.")
        return {}
    header = list(dfp.iloc[0])
    col_sbs  = _proxy_col(header, ['SBS'], PROXY_COL_SBS)
    col_isin = _proxy_col(header, ['ISIN_proxy', 'ISIN proxy', 'Proxy'], PROXY_COL_ISIN)
    ncols = dfp.shape[1]
    if col_sbs >= ncols or col_isin >= ncols:
        print(f"[AVISO] Columnas de proxy fuera de rango (hoja con {ncols} cols; "
              f"SBS={col_sbs}, ISIN={col_isin}) -> se omite el rescate.")
        return {}
    print(f"[OK] Proxies: SBS=col {col_sbs}, ISIN_proxy=col {col_isin} "
          f"en '{R_PROXIES_HOJA}'. (verifica que sean las correctas)")
    dm = dfp.iloc[1:, [col_sbs, col_isin]].copy()
    dm.columns = ['SBS', 'ISIN_proxy']
    dm['SBS'] = dm['SBS'].astype(str).str.strip()
    dm['ISIN_proxy'] = dm['ISIN_proxy'].astype(str).str.strip().str.upper()
    # No forzar ni inventar: descartar filas sin llave o sin proxy real.
    dm = dm[(dm['SBS'] != '') & (dm['SBS'].str.lower() != 'none') &
            (~dm['ISIN_proxy'].str.lower().isin(['', 'none', 'nan']))]
    dm = dm.drop_duplicates(subset=['SBS'])
    return dm.set_index('SBS')['ISIN_proxy'].to_dict()

