def _Q_X_OPE(df, fecha_nueva, AFP):
    df = df.copy(deep=True)
    df.columns = df.iloc[15, ::]
    df = df.drop([15], axis=0)
    f1, f2, f3 = (AFP + "-FONDO1_" + fecha_nueva, AFP + "-FONDO2_" + fecha_nueva,
                  AFP + "-FONDO3_" + fecha_nueva)
    df = df[(df['Fondo_Fecha'] == f1) | (df['Fondo_Fecha'] == f2) | (df['Fondo_Fecha'] == f3)]
    t = df.transpose(); t.columns = t.iloc[0, ::]
    return t

def _gen_dic(rv, rf, fecha_nueva, AFP):
    return pd.concat([_Q_X_OPE(rv, fecha_nueva, AFP),
                      _Q_X_OPE(rf, fecha_nueva, AFP)]).to_dict()

def _ret_f(row, f):
    if row['Fondo'] == f or row['Fondo'] == "Multifondos":
        return row[f]
    return 0
def _ret_multi(row):
    return (row['F1'] + row['F2'] + row['F3']) if row['Fondo'] == "Multifondos" else 0
def _corr(row, f):
    if row['Fondo'] == "Multifondos":
        return 0
    if row['Fondo'] == f:
        return row[f]

def Q_AFP(AFP, AFP_, f1, f2, f3, rv, rf, fecha_nueva, abrAFP):
    PM = pd.concat([AFP, AFP_])
    dic = _gen_dic(rv, rf, fecha_nueva, abrAFP)
    PM.insert(9, 'F1', PM["SBS"].map(dic[f1]))
    PM.insert(10, 'F2', PM["SBS"].map(dic[f2]))
    PM.insert(11, 'F3', PM["SBS"].map(dic[f3]))
    PM['F1'] = PM.apply(lambda r: _ret_f(r, 'F1'), axis=1)
    PM['F2'] = PM.apply(lambda r: _ret_f(r, 'F2'), axis=1)
    PM['F3'] = PM.apply(lambda r: _ret_f(r, 'F3'), axis=1)
    PM.insert(12, 'Multifondos', PM.apply(_ret_multi, axis=1))
    PM['F1'] = PM.apply(lambda r: _corr(r, 'F1'), axis=1)
    PM['F2'] = PM.apply(lambda r: _corr(r, 'F2'), axis=1)
    PM['F3'] = PM.apply(lambda r: _corr(r, 'F3'), axis=1)
    PM['F1'] = PM['F1'].replace(np.nan, 0)
    PM['F2'] = PM['F2'].replace(np.nan, 0)
    PM['F3'] = PM['F3'].replace(np.nan, 0)
    PM["Q"] = PM['F1'] + PM['F2'] + PM['F3'] + PM['Multifondos']
    return PM.drop(['F1', 'F2', 'F3', 'Multifondos'], axis=1)


