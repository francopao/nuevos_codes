def leer_riesgo(fecha_yyyymmdd):
    """Escribe la fecha en B1 de 'Tipo de Cambio', recalcula y cachea el rango."""
    if fecha_yyyymmdd in _CACHE_RIESGO:
        return _CACHE_RIESGO[fecha_yyyymmdd].copy()
    wb = _abrir_xw(R_RIESGO)
    try:
        try:
            sheet = wb.sheets['Tipo de Cambio']
        except Exception:
            raise ProcesoError("RIESGO no tiene la hoja 'Tipo de Cambio'.")
        sheet.range('B1').value = fecha_yyyymmdd
        try:
            wb.app.calculate()
        except Exception:
            pass
        _espera_activa(sheet, 'B1', timeout=20, minimo=1.0)   # antes: sleep(5/6) fijo
        valores = sheet.used_range.value
    finally:
        wb.close()
    df = pd.DataFrame(valores)
    _CACHE_RIESGO[fecha_yyyymmdd] = df.copy()
    return df


