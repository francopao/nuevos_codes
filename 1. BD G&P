            raise ProcesoError(f"No se encontró (COM):\n  {ruta}\n  {_diag_ruta(ruta)}")
        raise


def _espera_activa(sheet, celda, timeout=25, intervalo=0.3, minimo=0.8):
    """Reemplaza time.sleep fijo: espera hasta que 'celda' tenga valor (recálculo
    listo) o hasta timeout. 'minimo' asegura un pequeño margen inicial."""
    time.sleep(minimo)
    t0 = time.time()
    prev = object()
    while time.time() - t0 < timeout:
        try:
            val = sheet.range(celda).value
        except Exception:
            val = None
        if val is not None and val == prev:      # estable y no vacío
            return val
        prev = val
        time.sleep(intervalo)
    return sheet.range(celda).value


# --------------------------------------------------- G&P (escenario + recálculo)
def leer_gyp(escenario, mesanio):
    """Escribe el escenario en Abs!E3, fuerza recálculo y devuelve 'Detallado'."""
    ruta = R_GYP_TMPL.format(mesanio=mesanio)
    wb = _abrir_xw(ruta, alterna=R_GYP_ALT)
    try:
        try:
            sh_abs = wb.sheets['Abs']
            sh_det = wb.sheets['Detallado']
        except Exception:
            raise ProcesoError("G&P no tiene las hojas 'Abs' y/o 'Detallado'.")
        sh_abs.range('E3').value = escenario
        try:
            wb.app.calculate()
        except Exception:
            pass
        _espera_activa(sh_det, 'C5', timeout=30, minimo=1.0)  # antes: sleep(10) fijo
        print("G&P C5 =", sh_det.range('C5').value)
        valores = sh_det.used_range.value
    finally:
        wb.close()
    return pd.DataFrame(valores)


