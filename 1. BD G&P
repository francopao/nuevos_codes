    input1 = pd.concat([Portafolio, Multifondos]).sort_index(ignore_index=True)
    input1.insert(0, "Fecha", fecha_nueva)

    crear_txts(BUIN, TDIN, IN_, mes, anio)  # TXT Base Alerta (mismos nombres que original)

    # ---- Q por AFP (QEST) ----------------------------------------------------
    IN_PORT = Q_AFP_integra(Portafolio, base.dic_sbs)
