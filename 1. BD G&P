    p.insert(11, 'F3', p["SBS"].map(dic_sbs['IN-FONDO3']))
    p['F1'] = p.apply(lambda r: _retorna(r, 'F1', 'Integra'), axis=1)
    p['F2'] = p.apply(lambda r: _retorna(r, 'F2', 'Integra'), axis=1)
    p['F3'] = p.apply(lambda r: _retorna(r, 'F3', 'Integra'), axis=1)
    p["Q"] = p['F1'] + p['F2'] + p['F3']
    return p.drop(['F1', 'F2', 'F3'], axis=1)

