def operaciones(df):
    for a, b in zip(['HAF1', 'RIF1', 'PFF1', 'SIF1', 'HAF2', 'RIF2', 'PFF2', 'SIF2',
                     'HAF3', 'RIF3', 'PFF3', 'SIF3'],
                    ["INF1", "INF1", "INF1", "INF1", "INF2", "INF2", "INF2", "INF2",
                     "INF3", "INF3", "INF3", "INF3"]):
        df[a] = df[b] - df[a + "GAP"]
    df_antes = df.copy()
    df = df.loc[df['Asset Class'].isin(['Renta Fija', 'Renta Variable', 'Alternativos'])]
    # Conteo breve de ruido conocido (Derivados/Monedas): NO entra al reporte de
    # descartes ni a "Dejados de lado"; solo un dato informativo en consola.
    _ac_fuera = df_antes.loc[~df_antes['Asset Class'].isin(
        ['Renta Fija', 'Renta Variable', 'Alternativos'])]
    global _AC_RUIDO
    _AC_RUIDO = {'Derivados': int((_ac_fuera['Asset Class'] == 'Derivados').sum()),
                 'Monedas':   int((_ac_fuera['Asset Class'] == 'Monedas').sum())}
    # Solo se registran como descarte los Asset Class NO-ruido (para trazabilidad
    # de casos raros distintos de Derivados/Monedas).
    _ac_reportable = df_antes.loc[
        ~df_antes['Asset Class'].isin(['Renta Fija', 'Renta Variable', 'Alternativos',
                                       'Derivados', 'Monedas'])]
    _registrar_descarte(pd.concat([df, _ac_reportable]), df,
                        'operaciones() - Asset Class',
                        'Asset Class no admitido (excl. Derivados/Monedas)')
    return df


def BU(df, soberanos):
    d = df.copy(deep=True)
    d = d.drop(df.loc[df['Cat'].isin(['Gobierno'])].index)
    d = d.drop(df.loc[df['SubCat'].isin(['Gobierno'])].index)
    d = d.drop(df.loc[df['Sub Cat2'].isin(['Gobierno'])].index)
    d['Categoría'] = d['Categoría'].apply(FM)
    d = d.drop(d.loc[d['Categoría'].isin(["borrar"])].index)
    d = d.loc[d['AC Dir'].isin(["PE", "PEC", "EMC", "INTER", "ALT"])]
    # RAMA: soberanos excluye además el SBS2 '43'
    excl = ["52", "54", "50", "48", "PR", "08", "01", "FT", "PT"]
    if soberanos:
        excl = ["52", "54", "50", "48", "PR", "08", "01", "43", "FT", "PT"]
    d = d.drop(d.loc[d['SBS2'].isin(excl)].index)
    # Rescate explícito: vehículos que deben vivir en BU aunque no pasen los
    # filtros estándar (p. ej. FIBPRIME SBS2='37', real estate). Se reincorpora
    # desde el df original, sin duplicar los que ya están en d.
    _rescate_bu = ['37']
    _extra = df.loc[df['SBS2'].isin(_rescate_bu) & ~df.index.isin(d.index)]
    d = pd.concat([d, _extra])
    _registrar_descarte(df, d, 'BU() - filtros Bottom-Up',
                        'No calificó para BU (Gobierno/Categoría/AC Dir/SBS2)')
    return d


