        print(f"  (mostrando 30 de {len(_no_clasificados)}; detalle completo en el Excel de 'Dejados de lado')")
    else:
        print(f"\n[SIN CLASIFICAR] Ningún instrumento quedó fuera de BU/TD/SOB ({etiqueta}).")
    Portafolio = pd.concat([IN, HA, PF, RI, SI]).sort_index(ignore_index=True)
    IN_ = X_AFP_(IN, base.auminf1, base.auminf2, base.auminf3)
