NOMBRE_HOJA_COMPARABLES_UNIV = "Comparables_Universo"


def _escribir_comparables_universo(xw, universo: pd.DataFrame):
    """Escribe el universo cross-AFP + tabla de consolidación por emisor +
    tabla de promedio por SubCat ('Comparables_Subcat_SinAjustar'), todo
    con fórmulas SUMIFS/AVERAGEIFS vivas. Devuelve (nombre_hoja,
    fila_max_universo, fila_max_benchmark)."""
    if universo is None or universo.empty:
        pd.DataFrame({"Aviso": ["Sin datos"]}).to_excel(
            xw, sheet_name=NOMBRE_HOJA_COMPARABLES_UNIV, index=False)
        return NOMBRE_HOJA_COMPARABLES_UNIV, 1, 1

    cols = ["Corte", "AFP", "Fondo", "Emisor", "Bloque", "SubCat", "Intensidad"]
    for c in cols:
        if c not in universo.columns:
            universo[c] = ""
    universo = universo[cols].reset_index(drop=True)
    universo.to_excel(xw, sheet_name=NOMBRE_HOJA_COMPARABLES_UNIV, index=False)
    ws = xw.sheets[NOMBRE_HOJA_COMPARABLES_UNIV]
    fila_max_universo = len(universo) + 1

    combos = universo[["Bloque", "SubCat", "Emisor"]].drop_duplicates().reset_index(drop=True)
    col_i = 9
    ws.cell(row=1, column=col_i, value="Bloque")
    ws.cell(row=1, column=col_i + 1, value="SubCat")
    ws.cell(row=1, column=col_i + 2, value="Emisor")
    ws.cell(row=1, column=col_i + 3, value="Intensidad_Consolidada")
    for k, row in combos.iterrows():
        fr = k + 2
        bloque_esc = str(row["Bloque"]).replace('"', '""')
        subcat_esc = str(row["SubCat"]).replace('"', '""')
        emisor_esc = str(row["Emisor"]).replace('"', '""')
        ws.cell(row=fr, column=col_i, value=row["Bloque"])
        ws.cell(row=fr, column=col_i + 1, value=row["SubCat"])
        ws.cell(row=fr, column=col_i + 2, value=row["Emisor"])
        f = (f'=SUMIFS($G$2:$G${fila_max_universo},$E$2:$E${fila_max_universo},"{bloque_esc}",'
             f'$F$2:$F${fila_max_universo},"{subcat_esc}",'
             f'$D$2:$D${fila_max_universo},"{emisor_esc}")')
        ws.cell(row=fr, column=col_i + 3, value=f)
    fila_max_consol = len(combos) + 1

    subcats = universo[["Bloque", "SubCat"]].drop_duplicates().reset_index(drop=True)
    col_n = 14
    ws.cell(row=1, column=col_n, value="Bloque")
    ws.cell(row=1, column=col_n + 1, value="SubCat")
    ws.cell(row=1, column=col_n + 2, value="Comparables_Subcat_SinAjustar")
    for k, row in subcats.iterrows():
        fr = k + 2
        bloque_esc = str(row["Bloque"]).replace('"', '""')
        subcat_esc = str(row["SubCat"]).replace('"', '""')
        ws.cell(row=fr, column=col_n, value=row["Bloque"])
        ws.cell(row=fr, column=col_n + 1, value=row["SubCat"])
        f = (f'=AVERAGEIFS($L$2:$L${fila_max_consol},$I$2:$I${fila_max_consol},"{bloque_esc}",'
             f'$J$2:$J${fila_max_consol},"{subcat_esc}")')
        ws.cell(row=fr, column=col_n + 2, value=f)
    fila_max_bench = len(subcats) + 1
    return NOMBRE_HOJA_COMPARABLES_UNIV, fila_max_universo, fila_max_bench


```

