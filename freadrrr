```python
def _agregar_chart_asset_perf(ws, tabla: pd.DataFrame, corte_actual: str,
                               nombre_hoja_comp: str, fila_max_bench: int) -> None:
    if tabla.empty:
        return
    ultima_fila = len(tabla) + 1
    d = tabla[(tabla["Corte"] == corte_actual) & (tabla["Tipo_Fila"] == "Instrumento")
              & (tabla["AFP"] == "Integra")].copy()
    if d.empty:
        return
    orden_bloque = {"Equities": 0, "Fixed Income": 1}
    d["__ord_bloque"] = d["Bloque"].map(orden_bloque).fillna(9)
    d = d.sort_values(["__ord_bloque", "Valor"], ascending=[True, False]).reset_index(drop=True)

    n = len(d)
    col_label = ws.max_column + 2
    fila_r = 1
    ws.cell(row=fila_r, column=col_label, value="Instrumento")
    ws.cell(row=fila_r, column=col_label + 1, value="Intensidad")
    ws.cell(row=fila_r, column=col_label + 2, value="Benchmark_SinAjustar")

    for i, (_, r) in enumerate(d.iterrows()):
        fr = fila_r + 1 + i
        ws.cell(row=fr, column=col_label, value=r["Instrumento"])
        inst_esc = str(r["Instrumento"]).replace('"', '""')
        f_int = (f'=SUMIFS($L$2:$L${ultima_fila},$G$2:$G${ultima_fila},"{inst_esc}",'
                 f'$E$2:$E${ultima_fila},"{r["Bloque"]}",$D$2:$D${ultima_fila},"Instrumento",'
                 f'$C$2:$C${ultima_fila},"Integra",$A$2:$A${ultima_fila},"{corte_actual}")')
        ws.cell(row=fr, column=col_label + 1, value=f_int)
        subcat_esc = str(r["SubCategoria"]).replace('"', '""')
        f_bench = (f"=SUMIFS('{nombre_hoja_comp}'!$P$2:$P${fila_max_bench},"
                   f"'{nombre_hoja_comp}'!$N$2:$N${fila_max_bench},\"{r['Bloque']}\","
                   f"'{nombre_hoja_comp}'!$O$2:$O${fila_max_bench},\"{subcat_esc}\")")
        ws.cell(row=fr, column=col_label + 2, value=f_bench)

    chart = BarChart()
    chart.type = "col"
    chart.title = None
    chart.legend = None
    chart.y_axis.delete = True
    chart.y_axis.majorGridlines = None
    chart.x_axis.delete = False
    chart.x_axis.axPos = "b"
    chart.y_axis.axPos = "l"
    chart.height = 9
    chart.width = 20

    data_ref = Reference(ws, min_col=col_label + 1, max_col=col_label + 1,
                          min_row=fila_r, max_row=fila_r + n)
    chart.add_data(data_ref, titles_from_data=True)
    cats_ref = Reference(ws, min_col=col_label, max_col=col_label,
                          min_row=fila_r + 1, max_row=fila_r + n)
    chart.set_categories(cats_ref)

    serie = chart.series[0]
    serie.graphicalProperties = GraphicalProperties(solidFill="00AECB")
    for i, (_, r) in enumerate(d.iterrows()):
        color = "00AECB" if r["Gestion"] == "Active" else "002060"
        pt = DataPoint(idx=i)
        pt.graphicalProperties = GraphicalProperties(solidFill=color)
        serie.data_points.append(pt)
    dl = DataLabelList()
    dl.showVal = True
    dl.showSerName = False
    dl.showCatName = False
    dl.showLegendKey = False
    dl.numFmt = "0.0"
    dl.dLblPos = "outEnd"
    serie.dLbls = dl

    bench_ref = Reference(ws, min_col=col_label + 2, max_col=col_label + 2,
                           min_row=fila_r, max_row=fila_r + n)
    linea = LineChart()
    linea.add_data(bench_ref, titles_from_data=True)
    linea.set_categories(cats_ref)
    st = linea.series[0]
    st.graphicalProperties = GraphicalProperties()
    st.graphicalProperties.line = LineProperties(noFill=True)
    st.marker = Marker(symbol="circle", size=8)
    st.marker.graphicalProperties = GraphicalProperties(solidFill="E8543E")
    st.smooth = False
    linea.y_axis.delete = True
    linea.y_axis.majorGridlines = None
    linea.x_axis.delete = True
    chart += linea

    ws.add_chart(chart, f"{get_column_letter(col_label)}{fila_r + n + 3}")


```

