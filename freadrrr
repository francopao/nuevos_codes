def _peer_group_intensidad_detalle(vals_ctx: dict) -> pd.DataFrame:
    """Universo fila-a-fila (AFP, Fondo, Emisor, Bloque, SubCat, Intensidad)
    que sustenta _peer_group_intensidad — mismos filtros (excluye Ex_Integra,
    GyP_UNIVERSO_VALIDO, no-Proxy, Huella!=0, Intensidad!=0). Sirve para
    recalcular 'Comparables_Subcat_SinAjustar' con fórmulas de Excel."""
    ac_map = {"Renta Variable": "Equities", "Renta Fija": "Fixed Income"}
    piezas = []
    for afp, par in vals_ctx.items():
        if afp == "Ex_Integra":
            continue
        val = par[0]
        if val is None or val.empty:
            continue
        d = _base(val)
        d = _sin_huella_cero(d)
        if "GyP_UNIVERSO_VALIDO" not in d.columns:
            continue
        d = d[d["GyP_UNIVERSO_VALIDO"] == True]
        if COL["plus"] in d.columns:
            d = d[d[COL["plus"]] != "Proxies"]
        d = d.copy()
        d[COL["intensidad"]] = pd.to_numeric(d[COL["intensidad"]], errors="coerce").fillna(0.0)
        d = d[d[COL["intensidad"]] != 0]
        if d.empty:
            continue
        d["Bloque"] = d["GyP_ASSET_CLASS"].map(ac_map)
        d = d[d["Bloque"].notna()]
        if d.empty:
            continue
        d = d.copy()
        d["SubCat"] = d.apply(lambda r: _subcat_activo(r, r["Bloque"]), axis=1)
        d["AFP"] = afp
        if COL["portafolio"] in d.columns:
            d["Fondo"] = "F" + d[COL["portafolio"]].astype(str).str.extract(r"(\d)$")[0].fillna("")
        else:
            d["Fondo"] = ""
        cols = ["AFP", "Fondo", COL["nombre"], "Bloque", "SubCat", COL["intensidad"]]
        cols = [c for c in cols if c in d.columns]
        piezas.append(d[cols])
    if not piezas:
        return pd.DataFrame()
    out = pd.concat(piezas, ignore_index=True)
    out = out.rename(columns={COL["nombre"]: "Emisor", COL["intensidad"]: "Intensidad"})
    return out


```

