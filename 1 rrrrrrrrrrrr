function _gypDatosPorAfp(corte, metricaBar, topPorAfp){
  const afps = getAfps();
  const metricaMarker = metricaBar === 'Huella' ? 'Intensidad' : 'Huella';
  const out = [];
  afps.forEach(afp => {
    const bar = new Map(), mk = new Map();
    for(const r of HIST){
      if(r.OBJETO!=='Contrib_GyP_AFP' || String(r.FECHA_CORTE)!==String(corte) ||
         r.AFP!==afp || !r.DIM_1) continue;
      if(r.METRICA===metricaBar) bar.set(r.DIM_1, (bar.get(r.DIM_1)||0) + (+r.VALOR||0));
      if(r.METRICA===metricaMarker) mk.set(r.DIM_1, (mk.get(r.DIM_1)||0) + (+r.VALOR||0));
    }
    const nombres = [...bar.keys()].sort((a,b)=>(bar.get(b)||0)-(bar.get(a)||0)).slice(0, topPorAfp);
    nombres.forEach(n => out.push({afp, nombre:n, bar:bar.get(n)||0, marker:mk.get(n)||0}));
  });
  return out;
}

