// Elige el mayor divisor (1 / mil / millón / mil millones) tal que el
// máximo escalado siga siendo >= 1, para dejar como máximo ~2 dígitos.
function _escalaEje(valores){
  const max = Math.max(0, ...valores.map(v => Math.abs(v||0)));
  const niveles = [[1,''], [1e3,'Miles'], [1e6,'Millones'], [1e9,'Miles de millones']];
  let elegido = niveles[0];
  for(const nivel of niveles){ if(max / nivel[0] >= 1) elegido = nivel; }
  return {div: elegido[0], suf: elegido[1]};
}

