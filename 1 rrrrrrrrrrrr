function _cumulativos(mapa, keys){
  let acc = 0; const porKey = {};
  keys.forEach(k => {
    const v = mapa.get(k) || 0;
    porKey[k] = {y0: acc, y1: acc + v, v: v};
    acc += v;
  });
  return {porKey: porKey, total: acc};
}


