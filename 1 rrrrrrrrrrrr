      x: etiqCmp, y:(r.y0+r.y1)/2, xref:'x', yref:'y',
      xanchor:'left', yanchor:'middle', xshift: OFFSET_PX, showarrow:false, align:'left',
      text:'<b>'+ETIQUETA_ESTRATEGIA[est]+':</b> '+fmt(v),
      font:{size:11, color: COLOR_ESTRATEGIA[est]}
    };
  });

  const anotActual = ORDEN_ESTRATEGIAS.filter(est => estAct[est]).map(est => {
    const r = estAct[est], v = r.y1 - r.y0;
    const base = estCmp[est] ? (estCmp[est].y1 - estCmp[est].y0) : 0;
    const pct = base ? (v/base - 1) : null;
    const colorPct = pct===null ? CFG.color_texto : (pct<0 ? '#1B8F5A' : '#C0392B');
    const flecha = pct===null ? '' : (pct<0 ? '▼' : '▲');
    const linea2 = pct===null ? '' :
      '<br><span style="color:'+colorPct+'">'+flecha+' ('+(pct>0?'+':'')+(pct*100).toFixed(0)+'%)</span>';
    return {
      x: etiqAct, y:(r.y0+r.y1)/2, xref:'x', yref:'y',
      xanchor:'left', yanchor:'middle', xshift: OFFSET_PX, showarrow:false, align:'left',
      text:'<b>'+ETIQUETA_ESTRATEGIA[est]+':</b> '+fmt(v)+linea2,
      font:{size:11, color: COLOR_ESTRATEGIA[est]}
    };
  });

  // --- Bloque superior de Totales + narrativa de evolución ------------------
  const totB = cumCmp.total, totA = cumAct.total;
  const varPct = totB ? (totA/totB - 1) : null;
  const colorVar = varPct===null ? CFG.color_texto : (varPct<0 ? '#1B8F5A' : '#C0392B');
  const Y_TOTALES = 1.16;
  const anotTotales = [
    { x: etiqCmp, y: Y_TOTALES, xref:'x', yref:'paper', xanchor:'center', showarrow:false,
      text:'<b>Total: '+fmt(totB)+'</b>', font:{size:13, color: CFG.color_texto},
      bgcolor:'#EDEFF2', bordercolor:'#EDEFF2', borderpad:8 },
    { x: etiqAct, y: Y_TOTALES, xref:'x', yref:'paper', xanchor:'center', showarrow:false,
      text:'<b>Total: '+fmt(totA)+'</b>', font:{size:13, color: CFG.color_texto},
      bgcolor:'#EDEFF2', bordercolor:'#EDEFF2', borderpad:8 },
    { x:0.5, y: Y_TOTALES, xref:'paper', yref:'paper', xanchor:'center', showarrow:false,
      text:'<span style="color:'+colorVar+'">➜ '+
        (varPct===null?'s/d':((varPct>0?'+':'')+(varPct*100).toFixed(0)+'%'))+'</span>',
      font:{size:13, color: colorVar} }
  ];

  const lay = LAYOUT();
  lay.xaxis.type = 'category';
  lay.barmode = 'stack';
  lay.bargap = 0.62;
  lay.showlegend = false;
  lay.width = 620;
  lay.height = 320;
  lay.autosize = false;
  lay.margin = {l:20, r:135, t:60, b:40};
  lay.yaxis.visible = false;
  lay.annotations = anotTotales
    .concat(etiquetasInternas(cumCmp, etiqCmp))
    .concat(etiquetasInternas(cumAct, etiqAct))
    .concat(anotBase)
    .concat(anotActual);

  Plotly.react(div, traces, lay, OPTS_PPT);
}


