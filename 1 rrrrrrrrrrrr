def _base(df: pd.DataFrame) -> pd.DataFrame:
    """Universo base común a todas las pivots: multifondos 1-2-3."""
    out = df[df[COL["portafolio"]].isin(PORTAFOLIOS_VALIDOS)].copy()
    for c in METRICAS + [COL["intensidad"]]:
        if c in out.columns:
            out[c] = pd.to_numeric(out[c], errors="coerce").fillna(0.0)
    for c in [COL["plus"], COL["plus_1"], COL["estrategia"], COL["rank_rt"],
              COL["tipo_renta"], COL["nombre"]]:
        if c in out.columns:
            out[c] = out[c].astype(str).str.strip()
    return out


def _sin_huella_cero(df: pd.DataFrame) -> pd.DataFrame:
    if EXCLUIR_HUELLA_CERO:
        return df[df[COL["huella"]] != 0]
    return df


def _agg(df: pd.DataFrame, keys: list[str], metricas: list[str] | None = None) -> pd.DataFrame:
    metricas = metricas or METRICAS
    metricas = [m for m in metricas if m in df.columns]
    if df.empty:
        return pd.DataFrame(columns=keys + metricas)
    out = (df.groupby(keys, dropna=False)[metricas]
             .sum()
             .reset_index()
             .sort_values(metricas[0], ascending=False, ignore_index=True))
    return out

# SubCat de un instrumento FFMM/ETF: Mercado para RV (DM/EM/Commodities),
# AC_Dir para RF (HY/IG/EM/DM/Senior Loans). Función única y compartida:
# la usan tanto el top 5 de cada AFP como el peer group cross-AFP del
# benchmark "Intensidad Promedio - Comparables", para que ambos agrupen
# exactamente igual.
def _subcat_activo(row, bloque: str) -> str:
    if bloque == "Equities":
        m = str(row.get("GyP_MERCADO", "") or "").strip()
        return m if m else str(row.get("GyP_CAT", "") or "").strip() or "Otros"
    else:
        raw = str(row.get("GyP_AC_DIR", "") or "").strip()
        if "HY" in raw: return "HY"
        if "IG" in raw: return "IG"
        if "EM" in raw: return "EM"
        if "DM" in raw: return "DM"
        if "SL" in raw: return "Senior Loans"
        cat = str(row.get("GyP_CAT", "") or "").strip()
        return cat if cat else raw or "Otros"


def _peer_group_co2h(vals_ctx: dict) -> Dict[str, float]:
    """Promedio de CO2-H (intensidad intrínseca del instrumento, SIN el
    Weight de ningún fondo) por (Bloque, SubCat), usando el universo
    FFMM/ETF no-proxy de TODAS las AFPs juntas (F1+F2+F3 de cada una) —
    el peer group ampliado del benchmark 'Intensidad Promedio - Comparables'
    de Chart 3. Puramente informativo para ese benchmark: NO modifica
    ningún Weight real de ninguna cartera."""
    piezas = []
    for afp, par in vals_ctx.items():
        if afp == "Ex_Integra":
            continue
        val = par[0]
        if val is None or val.empty:
            continue
        d = _base(val)
        d = _sin_huella_cero(d)
        if "GyP_UNIVERSO_VALIDO" not in d.columns:
            continue
        d = d[d["GyP_UNIVERSO_VALIDO"] == True]
        if COL["plus"] in d.columns:
            d = d[d[COL["plus"]] != "Proxies"]
        if not d.empty:
            piezas.append(d)
    if not piezas:
        return {}
    universo = pd.concat(piezas, ignore_index=True)

    ac_map = {"Renta Variable": "Equities", "Renta Fija": "Fixed Income"}
    out: Dict[str, float] = {}
    for ac_orig, bloque in ac_map.items():
        sub = universo[universo["GyP_ASSET_CLASS"] == ac_orig]
        if sub.empty:
            continue
        sub = sub.copy()
        sub["__subcat"] = sub.apply(lambda r: _subcat_activo(r, bloque), axis=1)
        sub["CO2-H"] = pd.to_numeric(sub["CO2-H"], errors="coerce").fillna(0.0)
        prom = sub.groupby("__subcat")["CO2-H"].mean()
        for sc, v in prom.items():
            out[bloque + "|" + str(sc)] = float(v)
    return out


def _peer_group_intensidad(vals_ctx: dict) -> Dict[str, float]:
    """Promedio de Intensidad CONSOLIDADA por emisor, por (Bloque, SubCat) —
    peer group cross-AFP (F1+F2+F3, EXCLUYENDO Ex_Integra), no-proxy, con
    Intensidad != 0. Si un emisor aparece en más de un fondo/AFP, primero se
    SUMAN sus Intensidad (consolidación por emisor) y recién ese número
    consolidado -uno por emisor- entra al promedio. Así un emisor repetido
    entre varios fondos no pesa más que uno que aparece una sola vez. Es el
    benchmark 'sin ajustar Weight' de Chart 3: un solo valor por SubCat,
    igual para toda barra de ese grupo (no se multiplica por Weight del eje X)."""
    piezas = []
    for afp, par in vals_ctx.items():
        if afp == "Ex_Integra":
            continue
        val = par[0]
        if val is None or val.empty:
            continue
        d = _base(val)
        d = _sin_huella_cero(d)
        if "GyP_UNIVERSO_VALIDO" not in d.columns:
            continue
        d = d[d["GyP_UNIVERSO_VALIDO"] == True]
        if COL["plus"] in d.columns:
            d = d[d[COL["plus"]] != "Proxies"]
        d = d.copy()
        d[COL["intensidad"]] = pd.to_numeric(d[COL["intensidad"]], errors="coerce").fillna(0.0)
        d = d[d[COL["intensidad"]] != 0]  # tercer filtro: debe tener Intensidad
        if not d.empty:
            piezas.append(d)
    if not piezas:
        return {}
    universo = pd.concat(piezas, ignore_index=True)

    ac_map = {"Renta Variable": "Equities", "Renta Fija": "Fixed Income"}
    out: Dict[str, float] = {}
    for ac_orig, bloque in ac_map.items():
        sub = universo[universo["GyP_ASSET_CLASS"] == ac_orig]
        if sub.empty:
            continue
        sub = sub.copy()
        sub["__subcat"] = sub.apply(lambda r: _subcat_activo(r, bloque), axis=1)
        # Paso 1: consolidar por emisor -> SUMAR Intensidad si el mismo
        # emisor aparece en más de un fondo/AFP dentro de la misma SubCat.
        consolidado = sub.groupby(["__subcat", COL["nombre"]])[COL["intensidad"]].sum()
        # Paso 2: promediar esos valores YA consolidados, uno por emisor.
        prom = consolidado.groupby(level="__subcat").mean()
        for sc, v in prom.items():
            out[bloque + "|" + str(sc)] = float(v)
    return out


def _exportar_universo_ffmm_debug(vals_ctx: dict, output_dir: str,
                                   verbose: bool = True) -> Optional[str]:
    """Excel de diagnóstico: TODO el universo FFMM/ETF (GyP_UNIVERSO_VALIDO),
    F1+F2+F3 de TODAS las AFPs, SIN aplicar huella!=0, SIN excluir Proxy,
    SIN exigir Intensidad!=0 — el universo exacto 'antes de filtros' que
    usan _peer_group_co2h / _peer_group_intensidad antes de filtrar, para
    poder replicar y auditar esos filtros a mano en Excel."""
