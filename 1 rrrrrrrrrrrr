function sectorEjecutivo(div, metrica, cAct, cCmp, afp){
  const SUF = ' (Proxies)';
  const baseCat = k => k.endsWith(SUF) ? k.slice(0, -SUF.length) : k;

  const mCmp = serieCategoriaAfp('Sector_MSCI_Proxies', metrica, cCmp, afp);
  const mAct = serieCategoriaAfp('Sector_MSCI_Proxies', metrica, cAct, afp);

  const ordenSeries = [];
  CFG.categorias_sector.forEach(c=>{ ordenSeries.push(c, c + SUF); });
  const keys = ordenSeries.filter(k =>
    Math.abs(mCmp.get(k)||0) > 1e-9 || Math.abs(mAct.get(k)||0) > 1e-9);

  const cumCmp = _cumulativos(mCmp, keys);
  const cumAct = _cumulativos(mAct, keys);
  const etiqCmp = etiquetaCorte(cCmp), etiqAct = etiquetaCorte(cAct);

  // --- Trazas apiladas: solo color/patrón, sin texto automático ni leyenda -
  const traces = keys.map(k => ({
    type:'bar', name:k, showlegend:false, hoverinfo:'skip',
    x:[etiqCmp, etiqAct],
    y:[mCmp.get(k)||0, mAct.get(k)||0],
    marker: markerCategoria(k)
  }));

  // --- Etiquetas internas: una por categoría base, centrada en su bloque ---
  const UMBRAL_LABEL = 0.035; // no etiquetar segmentos < 3.5% del total
  const etiquetasInternas = (cum, xEtq) => {
    const rangos = {};
    keys.forEach(k => {
      const bc = baseCat(k), seg = cum.porKey[k];
      if(!rangos[bc]) rangos[bc] = {y0: seg.y0, y1: seg.y1};
      else { rangos[bc].y0 = Math.min(rangos[bc].y0, seg.y0);
             rangos[bc].y1 = Math.max(rangos[bc].y1, seg.y1); }
    });
    return Object.entries(rangos)
      .filter(function(e){ return cum.total && (e[1].y1 - e[1].y0) / cum.total >= UMBRAL_LABEL; })
      .map(function(e){
        const bc = e[0], r = e[1];
        return {
          x: xEtq, y: (r.y0 + r.y1) / 2, xref:'x', yref:'y',
          text: bc, showarrow:false,
          font:{size:9, color: CFG.color_texto}
        };
      });
  };

  // --- Anotaciones externas por estrategia ----------------------------------
  const rangoEstrategias = (cum) => {
    const rangos = {};
    keys.forEach(k => {
      const est = estrategiaDeCategoria(baseCat(k)), seg = cum.porKey[k];
      if(!rangos[est]) rangos[est] = {y0: seg.y0, y1: seg.y1};
      else { rangos[est].y0 = Math.min(rangos[est].y0, seg.y0);
             rangos[est].y1 = Math.max(rangos[est].y1, seg.y1); }
    });
    return rangos;
  };
  const estCmp = rangoEstrategias(cumCmp), estAct = rangoEstrategias(cumAct);

  const OFFSET_PX = 55;
  const anotBase = ORDEN_ESTRATEGIAS.filter(est => estCmp[est]).map(est => {
    const r = estCmp[est], v = r.y1 - r.y0;
