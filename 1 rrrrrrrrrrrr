    # --------------------------------------------------------------------------
    # Charts 52 y 63 (bloque DN53:DU68) — Huella / Intensidad por categoría,
    # partida en MSCI vs Proxies.
    # Materials y Utilities salen del sector de Parametria (col O -> col P);
    # "Otros" es el residuo del BU; RF/RV vienen de TD por TIPO_RENTA;
    # Alts de la estrategia ALT.
    # --------------------------------------------------------------------------
    @staticmethod
    def _norm_nombre(x) -> str:
        """Normaliza para machear Parametria!O contra Valorización!Nombre."""
        t = unicodedata.normalize("NFKD", str(x or ""))
        t = "".join(c for c in t if not unicodedata.combining(c))
        return " ".join(t.upper().split())

    def _mapear_sector(self, sub: pd.DataFrame) -> pd.Series:
        """Sector del instrumento.

        Fuente primaria: 'Sector_BD' (col H de BD(MSCI), por ISIN) — es el
        sector GICS de MSCI y cubre casi todo el portafolio.
        Respaldo: sector_lookup de Parametria (col O -> col P) por Nombre.
        """
        idx = sub.index
        out = pd.Series([None] * len(sub), index=idx, dtype=object)
        lk = self.sector_lookup or {}

        # 1) Parametria por SBS (exacto). Es el sector GICS del reporte.
        if lk and COL["sbs"] in sub.columns:
            out = sub[COL["sbs"]].map(
                lambda x: lk.get(f"SBS::{_to_string(x)}") if x is not None else None)

        # 2) Parametria por Name normalizado.
        faltan = out.isna()
        if faltan.any() and lk:
            norm = {self._norm_nombre(k): v for k, v in lk.items()
                    if not str(k).startswith("SBS::")}
            out.loc[faltan] = (sub.loc[faltan, COL["nombre"]]
                               .map(lambda x: norm.get(self._norm_nombre(x))))

        # 3) Respaldo: Sector de BD(MSCI) (col H), normalizado a bucket GICS.
        faltan = out.isna()
        if faltan.any() and "Sector_BD" in sub.columns:
            out.loc[faltan] = sub.loc[faltan, "Sector_BD"].map(self._bucket_gics)

        cobertura = float(out.notna().mean()) if len(out) else 0.0
        print(f"  [Módulo 12] Sector identificado en {cobertura:.0%} de las "
              f"filas BU (el resto cae al bucket 'Otros').")
        if cobertura < 0.15:
            print("  [Módulo 12] [AVISO] cobertura de sector muy baja: "
                  "revisar Parametria col C (SBS) / col P (Sector).")
        return out.fillna("Otros")

    @staticmethod
    def _bucket_gics(valor) -> Optional[str]:
        """Colapsa el Sector de MSCI ('Equity Sector Materials', 'Construction
        Materials', ...) al bucket del reporte."""
        t = str(valor or "").lower()
        if not t:
            return None
        if "material" in t or "metals" in t or "mining" in t:
            return "Materials"
        if "utilit" in t:
            return "Utilities"
        return None

    def sector_msci_vs_proxies(self) -> pd.DataFrame:
        d = _sin_huella_cero(self.df)
        met = [COL["huella"], COL["intensidad"], COL["intensidad_m"], COL["inv"]]
        met = [m for m in met if m in d.columns]

        def suma(sub) -> dict:
            return {m: float(sub[m].sum()) for m in met}

        bu = d[d[COL["estrategia"]].eq("BU")]
        bu_msci = bu[bu[COL["plus"]].eq("Portafolio")].copy()
        bu_prox = bu[bu[COL["plus"]].eq("Proxies")].copy()
        if not bu_msci.empty:
            bu_msci["__sector"] = self._mapear_sector(bu_msci)
        else:
            bu_msci["__sector"] = pd.Series(dtype=object)

        td = d[d[COL["estrategia"]].eq("TD")
               & ~d[COL["plus_1"]].isin(["BU", "Alts"])]
        td_msci = td[td[COL["plus"]].isin(["ETF", "Portafolio"])]
        td_prox = td[td[COL["plus"]].eq("Proxies")]
        alt = d[d[COL["estrategia"]].eq("ALT")
                & d[COL["plus"]].eq("Proxies")
                & d[COL["plus_1"]].eq("Alts")]

        filas = []

        def agrega(bloque, categoria, sub):
            filas.append({"Bloque": bloque, "Categoria": categoria, **suma(sub)})

        # Materials/Utilities/Otros: SOLO la porción MSCI (no proxy) de BU.
        tot_bu_msci = suma(bu_msci)
        for cat in ("Materials", "Utilities"):
            agrega("MSCI", cat, bu_msci[bu_msci["__sector"].eq(cat)])
        usados = bu_msci[bu_msci["__sector"].isin(["Materials", "Utilities"])]
        filas.append({"Bloque": "MSCI", "Categoria": "Otros",
                      **{m: tot_bu_msci[m] - float(usados[m].sum()) for m in met}})

        # RF / RV: SOLO la porción MSCI (no proxy).
        agrega("MSCI", "RF", td_msci[td_msci[COL["tipo_renta"]].eq("RENTA FIJA")])
        agrega("MSCI", "RV", td_msci[td_msci[COL["tipo_renta"]].eq("RENTA VARIABLE")])

        # Alts: se queda igual, NO se absorbe en "Proxies" — Private Markets
        # no tiene cobertura ESG propia, todo Alts ya es proxy por diseño.
        agrega("Proxies", "Alts", alt)

        # "Proxies": TODO el universo proxy no-Alts consolidado en una sola
        # porción — BU Proxies (Materials/Utilities/Otros) + RF Proxies +
        # RV Proxies, sin distinguir origen.
        proxies_todos = pd.concat([bu_prox, td_prox], ignore_index=True)
        agrega("Proxies", "Proxies", proxies_todos)

        out = pd.DataFrame(filas)
        # DIM_1 = Categoria, DIM_2 = Bloque (así lo consume el dashboard).
        out = out[["Categoria", "Bloque"] + met]
        out["__ord"] = out["Categoria"].map(
            {c: i for i, c in enumerate(CATEGORIAS_SECTOR)}).fillna(99)
        return (out.sort_values(["__ord", "Bloque"])
                   .drop(columns="__ord").reset_index(drop=True))

        out["__ord"] = out["Categoria"].map(
            {c: i for i, c in enumerate(CATEGORIAS_SECTOR)}).fillna(99)
        return (out.sort_values(["__ord", "Bloque"])
                   .drop(columns="__ord").reset_index(drop=True))

    def sector_msci_vs_proxies_detalle(self) -> pd.DataFrame:
        """Igual clasificación Categoria/Bloque que sector_msci_vs_proxies(),
        pero SIN agregar: una fila por instrumento (Emisor + SBS), para
        poder auditar qué instrumentos caen en cada categoría."""
        d = _sin_huella_cero(self.df)
        met = [COL["huella"], COL["intensidad"], COL["intensidad_m"], COL["inv"]]
        met = [m for m in met if m in d.columns]

        bu = d[d[COL["estrategia"]].eq("BU")]
        bu_msci = bu[bu[COL["plus"]].eq("Portafolio")].copy()
        bu_prox = bu[bu[COL["plus"]].eq("Proxies")].copy()
        if not bu_msci.empty:
            bu_msci["__sector"] = self._mapear_sector(bu_msci)
        else:
            bu_msci["__sector"] = pd.Series(dtype=object)

        td = d[d[COL["estrategia"]].eq("TD")
               & ~d[COL["plus_1"]].isin(["BU", "Alts"])]
        td_msci = td[td[COL["plus"]].isin(["ETF", "Portafolio"])]
        td_prox = td[td[COL["plus"]].eq("Proxies")]
        alt = d[d[COL["estrategia"]].eq("ALT")
                & d[COL["plus"]].eq("Proxies")
                & d[COL["plus_1"]].eq("Alts")]

        piezas = []

        def _marcar(sub, bloque, categoria):
            if sub.empty:
                return
            t = sub.copy()
            t["Bloque"] = bloque
            t["Categoria"] = categoria
            piezas.append(t)

        for cat in ("Materials", "Utilities"):
            _marcar(bu_msci[bu_msci["__sector"].eq(cat)], "MSCI", cat)
        usados = bu_msci["__sector"].isin(["Materials", "Utilities"])
        _marcar(bu_msci[~usados], "MSCI", "Otros")

        _marcar(td_msci[td_msci[COL["tipo_renta"]].eq("RENTA FIJA")], "MSCI", "RF")
        _marcar(td_msci[td_msci[COL["tipo_renta"]].eq("RENTA VARIABLE")], "MSCI", "RV")

        _marcar(alt, "Proxies", "Alts")
        _marcar(pd.concat([bu_prox, td_prox], ignore_index=True), "Proxies", "Proxies")

        if not piezas:
            return pd.DataFrame()

        out = pd.concat(piezas, ignore_index=True)
        out["__SBS"] = out[COL["sbs"]].astype(str) if COL["sbs"] in out.columns else ""
        out["__CatTipo"] = out["Categoria"] + "|" + out["Bloque"]
        result = out[[COL["nombre"], "__SBS", "__CatTipo"] + met].copy()
        result = result.rename(columns={COL["nombre"]: "Nombre", "__SBS": "SBS",
                                         "__CatTipo": "Categoria_Tipo"})
        return result.reset_index(drop=True)

    def construir_bd_instrumentos(self) -> pd.DataFrame:
        """Base de datos única a nivel instrumento (por Fondo/SBS) que
        alimenta, vía SUMIFS en Excel, las hojas Huella/Intensidad
        Soberanos, Huella/Intensidad por Sector y Mayores Contribuyentes.
        Cada fila queda etiquetada con 'Universo' para que cada hoja
        filtre solo lo suyo."""
        met = [COL["huella"], COL["intensidad"], "CO2-H", "Weight", COL["inv"]]
        met = [m for m in met if m in self.df.columns]
        ident = [COL["nombre"], COL["sbs"], COL["isin"], COL["portafolio"], COL["estrategia"]]
        ident = [c for c in ident if c in self.df.columns]
        tiene_perdio = "PERDIO_HUELLA" in self.df.columns

        piezas = []

        def _tomar(sub, universo, categoria, tipo_dato, pais_serie=None):
            if sub.empty:
                return
            cols = ident + met + (["PERDIO_HUELLA"] if tiene_perdio else [])
            t = sub[cols].copy()
            t["Universo"] = universo
            t["Categoria"] = categoria
            t["Tipo_Dato"] = tipo_dato
            t["Pais"] = pais_serie if pais_serie is not None else ""
            piezas.append(t)

        # --- Universo Soberanos ---
        d = _sin_huella_cero(self.df[self.df[COL["estrategia"]].isin(["GOB", "SOB"])])
        if not d.empty:
            pais = d[COL["nombre"]].map(lambda n: PAIS_POR_EMISOR_SOBERANO.get(n, n))
            _tomar(d, "Soberanos", "GOB", "", pais_serie=pais)

        # --- Universo Sector (misma clasificación que sector_msci_vs_proxies) ---
        d = _sin_huella_cero(self.df)
        bu = d[d[COL["estrategia"]].eq("BU")]
        bu_msci = bu[bu[COL["plus"]].eq("Portafolio")].copy()
        bu_prox = bu[bu[COL["plus"]].eq("Proxies")].copy()
        if not bu_msci.empty:
            bu_msci["__sector"] = self._mapear_sector(bu_msci)
        else:
            bu_msci["__sector"] = pd.Series(dtype=object)
        td = d[d[COL["estrategia"]].eq("TD")
               & ~d[COL["plus_1"]].isin(["BU", "Alts"])]
        td_msci = td[td[COL["plus"]].isin(["ETF", "Portafolio"])]
        td_prox = td[td[COL["plus"]].eq("Proxies")]
        alt = d[d[COL["estrategia"]].eq("ALT")
                & d[COL["plus"]].eq("Proxies")
                & d[COL["plus_1"]].eq("Alts")]

        for cat in ("Materials", "Utilities"):
            _tomar(bu_msci[bu_msci["__sector"].eq(cat)], "Sector", cat, "MSCI")
        usados = bu_msci["__sector"].isin(["Materials", "Utilities"])
        _tomar(bu_msci[~usados], "Sector", "Otros", "MSCI")
        _tomar(td_msci[td_msci[COL["tipo_renta"]].eq("RENTA FIJA")], "Sector", "RF", "MSCI")
        _tomar(td_msci[td_msci[COL["tipo_renta"]].eq("RENTA VARIABLE")], "Sector", "RV", "MSCI")
        _tomar(alt, "Sector", "Alts", "Proxies")
        _tomar(pd.concat([bu_prox, td_prox], ignore_index=True), "Sector", "Proxies", "Proxies")

        # --- Universo Mayores Contribuyentes (BU+TD sin Proxy) ---
        d2 = self.df[
            self.df[COL["estrategia"]].isin(["BU", "TD"])
            & ~self.df[COL["plus_1"]].isin(["SOV", "Alts"])
            & (self.df[COL["plus"]] != "Proxies")
        ]
        d2 = _sin_huella_cero(d2)
        _tomar(d2, "Mayores", "", "")

        if not piezas:
            return pd.DataFrame()

        out = pd.concat(piezas, ignore_index=True)
        out = out.rename(columns={
            COL["nombre"]: "Nombre_Original", COL["sbs"]: "SBS", COL["isin"]: "ISIN",
            COL["portafolio"]: "Portafolio", COL["estrategia"]: "Estrategia",
            COL["huella"]: "Huella", COL["intensidad"]: "Intensidad", COL["inv"]: "Inv_MM_USD",
        })
        if "PERDIO_HUELLA" not in out.columns:
            out["PERDIO_HUELLA"] = False
        out["Fondo"] = "F" + out["Portafolio"].astype(str).str.extract(r"(\d)$")[0].fillna("")
        return out

    # --------------------------------------------------------------------------
    # Charts 49, 48 y 39 — portafolio vs benchmarks.
    # Huella comparable = Intensidad del ETF x AUM del ETF (USD MM). Sin escalar
    # (el Market Cap de la hoja MKT ya viene en millones).
    # --------------------------------------------------------------------------
    def comparables(self) -> pd.DataFrame:
        d = _sin_huella_cero(self.df)
        filas = [{
            "Serie": "Integra",
            COL["huella"]: float(d[COL["huella"]].sum()),
            COL["intensidad"]: float(d[COL["intensidad"]].sum()),
            "AUM MM": float(d[COL["inv"]].sum()),
        }]
        for alias in ("ACWI", "ILF", "CEMB", "EMB"):
            if alias not in self.intensidades_comp:
                continue
            inten = float(self.intensidades_comp[alias])
            aum = float(self.aum_comp.get(alias, 0.0))
            filas.append({"Serie": alias,
                          COL["huella"]: aum * inten,
                          COL["intensidad"]: inten,
                          "AUM MM": aum})
        return pd.DataFrame(filas)

    # --------------------------------------------------------------------------
    # Chart 58 (y 55 / 57) — soberanos por país: top N + "Otros".
    # --------------------------------------------------------------------------
    def soberanos_por_pais(self, top_n: int = 4) -> pd.DataFrame:
        # Filtro propio (independiente de soberanos()) para que Chart 58 no se
        # mueva si el universo de soberanos() cambia (p.ej. a Estrategia=GOB).
        d = self.df[
            self.df[COL["plus"]].isin(["ETF", "SOV"])
            & (self.df[COL["plus_1"]] == "SOV")
        ]
        d = _sin_huella_cero(d)
        sob = _agg(d, [COL["nombre"]], METRICAS)
        if sob.empty:
            return pd.DataFrame(columns=["Pais"] + METRICAS)
        sob = sob.copy()
        sob["Pais"] = sob[COL["nombre"]].map(PAIS_POR_EMISOR_SOBERANO).fillna("Otros")
        met = [m for m in [COL["huella"], COL["intensidad"],
                           COL["intensidad_m"], COL["inv"]] if m in sob.columns]
        out = (sob.groupby("Pais", dropna=False)[met].sum()
                  .sort_values(COL["huella"], ascending=False).reset_index())
        if len(out) > top_n:
            cabeza = out.head(top_n).copy()
            resto = out.tail(len(out) - top_n)
            cabeza.loc[len(cabeza)] = {"Pais": "Otros",
                                       **{m: float(resto[m].sum()) for m in met}}
            out = cabeza
        return out.reset_index(drop=True)


    def cobertura(self) -> pd.DataFrame:
        """Cobertura en 2 niveles por fondo:
          - Directa: Plus ∈ {Portafolio, ETF, SOV}  (data MSCI real)
          - Proxy  : Plus == 'Proxies'
        Denominador = AUM del fondo = Σ(Inv MM$) del fondo (con weights ya
        normalizados al 100% en Mejora A). Directa + Proxy = 100%.
        """
        _map = {"IN-FONDO1": "F1", "IN-FONDO2": "F2", "IN-FONDO3": "F3"}
        d = self.df.copy()
        d["_Fondo"] = d[COL["portafolio"]].map(_map)
        d = d[d["_Fondo"].notna()]
        d["_inv"] = pd.to_numeric(d[COL["inv"]], errors="coerce").fillna(0.0)

        filas = []
        for fondo in ["F1", "F2", "F3"]:
            sub = d[d["_Fondo"] == fondo]
            aum_f = float(sub["_inv"].sum())
            num_dir = float(sub.loc[
                sub[COL["plus"]].isin(["Portafolio", "ETF", "SOV"]), "_inv"].sum())
            num_prx = float(sub.loc[
                sub[COL["plus"]] == "Proxies", "_inv"].sum())
            filas.append({
                "Fondo": fondo,
                "Cobertura_Directa": (num_dir / aum_f) if aum_f else 0.0,
                "Cobertura_Proxy":   (num_prx / aum_f) if aum_f else 0.0,
                "AUM_Fondo": aum_f,
            })

        # --- Total por AFP: ponderado por AUM de cada fondo ---
        aum_tot = sum(f["AUM_Fondo"] for f in filas)
        if aum_tot:
            tot_dir = sum(f["Cobertura_Directa"] * f["AUM_Fondo"] for f in filas) / aum_tot
            tot_prx = sum(f["Cobertura_Proxy"] * f["AUM_Fondo"] for f in filas) / aum_tot
        else:
            tot_dir = tot_prx = 0.0
        filas.append({"Fondo": "TOTAL", "Cobertura_Directa": tot_dir,
                      "Cobertura_Proxy": tot_prx, "AUM_Fondo": aum_tot})
        return pd.DataFrame(filas)
