//     Top 5 FFMM/ETFs por Intensidad. SubCat bajo nombres. Slicer de benchmark.
const MGMT_COLOR = {A: '#00AECB', P: '#002060'};
const MGMT_LABEL = {A: 'Active', P: 'Passive'};
const BENCH_FFMM = __BENCHMARKS_FFMM__;

function _wrapName(txt, maxChars){
  if(!txt || txt.length <= maxChars) return txt||'';
  const words = txt.split(/\s+/);
  const lines = []; let cur = '';
  for(const w of words){
    if(cur && (cur.length + 1 + w.length) > maxChars){ lines.push(cur); cur = w; }
    else { cur = cur ? cur + ' ' + w : w; }
  }
  if(cur) lines.push(cur);
  return lines.join('<br>');
}

function _parseAssetPerf(corte){
  const benchmarks = {};
  const benchmarksSubcat = {};
  const benchmarksSubcatUnadj = {};
  const filas = [];
  for(const r of HIST){
    if(r.OBJETO!=='TopSubCat_Asset' || String(r.FECHA_CORTE)!==String(corte)) continue;
    if(r.METRICA==='Intensidad'){
      if(r.DIM_1==='_BENCH_'){
        benchmarks[r.DIM_2] = +r.VALOR||0; continue;
      }
      if(r.DIM_1==='_BENCH_SUBCAT_'){
        if((r.AFP||'Integra')!=='Integra') continue; // mismo valor en todas, tomar una sola vez
        benchmarksSubcat[r.DIM_2] = +r.VALOR||0; continue;
      }
      if(r.DIM_1==='_BENCH_SUBCAT_UNADJ_'){
        if((r.AFP||'Integra')!=='Integra') continue;
        benchmarksSubcatUnadj[r.DIM_2] = +r.VALOR||0; continue;
      }
      const parts = (r.DIM_2||'').split('|');
      const mgmt = parts[0]||'A', nombre = parts.slice(1).join('|')||'';
      filas.push({bloque:r.DIM_1, mgmt, nombre, val:+r.VALOR||0, afp:r.AFP||'',
                  subcat:r.DIM_3||''});
    }
    if(r.METRICA==='Weight' && r.DIM_1!=='_BENCH_' && r.DIM_1!=='_BENCH_SUBCAT_'
       && r.DIM_1!=='_BENCH_SUBCAT_UNADJ_'){
      const parts2 = (r.DIM_2||'').split('|');
      const n2 = parts2.slice(1).join('|')||'';
      const match = filas.find(f=>f.nombre===n2 && f.bloque===r.DIM_1 && f.afp===(r.AFP||''));
      if(match) match.weight = +r.VALOR||0;
    }
  }
  return {filas, benchmarks, benchmarksSubcat, benchmarksSubcatUnadj};
}

function assetPerformanceAfp(div, corte, benchKey){
  const {filas, benchmarks, benchmarksSubcat, benchmarksSubcatUnadj} = _parseAssetPerf(corte);
  if(!filas.length){ document.getElementById(div).innerHTML=''; return; }
  const integra = filas.filter(f => f.afp==='Integra' || f.afp==='');
  if(!integra.length){ document.getElementById(div).innerHTML=''; return; }
  const bloqueOrden = ['Equities','Fixed Income'];
  const sorted = [];
  bloqueOrden.forEach(b => {
    sorted.push(...integra.filter(f=>f.bloque===b).sort((a,c)=>c.val-a.val).slice(0,5));
  });
  const xLabels = sorted.map(s => _wrapName(s.nombre, 14));
  const esc = _escalaEje(sorted.map(s=>s.val));
  const yVals = sorted.map(s=>s.val / esc.div);
  const colores = sorted.map(s => MGMT_COLOR[s.mgmt] || '#666');
  // Bloques
  const bloques = [];
  let cursor = 0;
  bloqueOrden.forEach(bNombre => {
    const items = sorted.filter(s=>s.bloque===bNombre);
    if(!items.length) return;
    const start = cursor; cursor += items.length;
