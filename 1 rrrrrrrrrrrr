class PresentacionBuilder:
    """Construye todos los objetos que antes vivían en la hoja 'Presentacion'."""

    def __init__(self, df_valorizacion: pd.DataFrame, fecha_corte: str,
                 sector_lookup: dict | None = None,
                 intensidades_comp: dict | None = None,
                 aum_comp: dict | None = None,
                 caja_neta_mm: float = 0.0,
                 aum_total_mm: float | None = None,
                 bench_peer_co2h: dict | None = None,
                 bench_peer_intensidad: dict | None = None):
        """
        df_valorizacion   : DataFrame de M10 (columnas formuladas ya construidas)
        fecha_corte       : 'yyyymm' o 'yyyy-mm-dd'
        sector_lookup     : {Nombre -> Sector} de Parametria (col O -> col P)
        intensidades_comp : {alias -> intensidad} de ComparablesLoader
        aum_comp          : {alias -> AUM USD MM} de MarketCapLoader (hoja MKT)
        bench_peer_co2h      : {"Bloque|SubCat" -> CO2-H promedio} del peer
                               group cross-AFP (ver _peer_group_co2h). Benchmark
                               "ajustado" (se multiplica x Weight del eje X).
        bench_peer_intensidad: {"Bloque|SubCat" -> Intensidad promedio, tal
                               cual, sin homogeneizar} (ver _peer_group_intensidad).
                               Benchmark "sin ajustar Weight".
        """
        self.fecha_corte = str(fecha_corte)
        self.df = _base(df_valorizacion)
        self.sector_lookup = sector_lookup or {}
        self.intensidades_comp = intensidades_comp or {}
        self.aum_comp = aum_comp or {}
        self.caja_neta_mm = float(caja_neta_mm or 0.0)
        self.aum_total_mm = aum_total_mm
        self.bench_peer_co2h = bench_peer_co2h or {}
        self.bench_peer_intensidad = bench_peer_intensidad or {}
        self.objetos: dict[str, pd.DataFrame] = {}
        self._diagnostico_plus()

    def _diagnostico_plus(self) -> None:
        """Avisa si desaparecieron categorías de Plus (típico: 'Proxies')."""
        if COL["plus"] not in self.df.columns:
            return
        dist = self.df[COL["plus"]].value_counts().to_dict()
        print(f"  [Módulo 12] Distribución de Plus: {dist}")
        if "Proxies" not in dist:
            print("  [Módulo 12] [AVISO] NO hay filas con Plus='Proxies'. "
                  "Los bloques BU/TD/ALT Proxies saldrán en cero. "
                  "Revisar ProxyEngine y la col W de BD(MSCI).")

    # --------------------------------------------------------------------------
    # PivotTable1 (Z3:AA14) — AUM por Rank_rt  -> charts 2/4/5 (composición AUM)
    # --------------------------------------------------------------------------
    def aum_por_rank(self) -> pd.DataFrame:
        out = _agg(self.df, [COL["rank_rt"]], [COL["inv"]])
        total = out[COL["inv"]].sum()
        out["% AUM"] = np.where(total, out[COL["inv"]] / total, 0.0)
        return out.sort_values(COL["inv"], ascending=False, ignore_index=True)

    # --------------------------------------------------------------------------
    # PivotTable4 (AE4:AF37) — AUM por Rank_rt x Plus_1  -> chart1
    # Reemplaza los ~30 GETPIVOTDATA de la columna AJ
    # --------------------------------------------------------------------------
    def aum_rank_x_plus1(self) -> pd.DataFrame:
        out = _agg(self.df, [COL["rank_rt"], COL["plus_1"]], [COL["inv"]])
        total = out[COL["inv"]].sum()
        out["% AUM"] = np.where(total, out[COL["inv"]] / total, 0.0)
        return out


    # --------------------------------------------------------------------------
    # PivotTable3 (AQ52:AS187) — mejores/peores contribuyentes BU + TD
    # Filtros: Estrategia in {BU, TD} ; Plus_1 not in {SOV, Alts} ; Huella != 0
    # --------------------------------------------------------------------------
    def contribuyentes_variacion_intensidad(self) -> pd.DataFrame:
        """Universo BU+TD, EXCLUYENDO Proxy (dato ESG directo únicamente),
        agregado por emisor: Huella, Intensidad, Inv MM$ + flag PERDIO_HUELLA
        (True si alguna de sus posiciones usó el dato de respaldo de la hoja
        'Perdieron Huella'). Es la base del chart de variación de Intensidad
        por emisor — el dashboard arma la comparación entre cortes y la
        descomposición CO2-H vs Weight con estos tres números."""
        d = self.df[
            self.df[COL["estrategia"]].isin(["BU", "TD"])
            & ~self.df[COL["plus_1"]].isin(["SOV", "Alts"])
            & (self.df[COL["plus"]] != "Proxies")
        ]
        d = _sin_huella_cero(d)
        out = _agg(d, [COL["nombre"]],
                   [COL["huella"], COL["intensidad"], COL["inv"]])
        if out.empty:
            out["PERDIO_HUELLA"] = pd.Series(dtype=bool)
            return out
        if "PERDIO_HUELLA" in d.columns:
            flag = d.groupby(COL["nombre"])["PERDIO_HUELLA"].any()
            out["PERDIO_HUELLA"] = out[COL["nombre"]].map(flag).fillna(False)
        else:
            out["PERDIO_HUELLA"] = False
        return out

    def contribuyentes_bu_td(self, top_n: int = 15) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
        d = self.df[
            self.df[COL["estrategia"]].isin(["BU", "TD"])
            & ~self.df[COL["plus_1"]].isin(["SOV", "Alts"])
        ]
        d = _sin_huella_cero(d)
        full = _agg(d, [COL["nombre"]], [COL["huella"], COL["intensidad_m"], COL["inv"]])
        total = full[COL["huella"]].sum()
        full["% Huella"] = np.where(total, full[COL["huella"]] / total, 0.0)
        full["Ranking"] = full[COL["huella"]].rank(ascending=False, method="first").astype(int)
        peores = full.head(top_n).reset_index(drop=True)
        mejores = full.tail(top_n).sort_values(COL["huella"]).reset_index(drop=True)
        return full, peores, mejores

    # --------------------------------------------------------------------------
    # PivotTable5 (Z80:AC88) — exposición a soberanos
    # Filtros: Plus in {ETF, SOV} ; Plus_1 == 'SOV' ; Huella != 0
    # --------------------------------------------------------------------------
    def soberanos(self) -> pd.DataFrame:
        d = self.df[self.df[COL["estrategia"]].isin(["GOB", "SOB"])]
        d = _sin_huella_cero(d)
        out = _agg(d, [COL["nombre"]], METRICAS)
        tot_h = out[COL["huella"]].sum()
        tot_i = out[COL["inv"]].sum()
        out["% Huella"] = np.where(tot_h, out[COL["huella"]] / tot_h, 0.0)
        out["% AUM"] = np.where(tot_i, out[COL["inv"]] / tot_i, 0.0)
        # Intensidad implícita del emisor soberano (Tn CO2 / USD MM)
        out["Intensidad implícita"] = np.where(
            out[COL["inv"]] != 0, out[COL["huella"]] / out[COL["inv"]], 0.0)
        return out

    # --------------------------------------------------------------------------
    # PivotTable2 (Z110:AB115) — informativo: Estrategia x Plus_1
    # Filtros: Plus not in {Cash, #N/A, Cuestionario Integra} ; Huella != 0
    # --------------------------------------------------------------------------
    def estrategia_x_plus1(self) -> pd.DataFrame:
        d = self.df[~self.df[COL["plus"]].isin(["Cash", "#N/A", "nan", "Cuestionario Integra"])]
        d = _sin_huella_cero(d)
        return _agg(d, [COL["estrategia"], COL["plus_1"]], METRICAS)

    # --------------------------------------------------------------------------
    # PivotTable8 (ED50:EF241) — peores contribuyentes GENERAL (sin filtro de huella)
    # Filtros: Plus not in {Cash, Cuestionario Integra}
    # --------------------------------------------------------------------------
    def contribuyentes_general(self, top_n: int = 20) -> tuple[pd.DataFrame, pd.DataFrame]:
        d = self.df[~self.df[COL["plus"]].isin(["Cash", "Cuestionario Integra"])]
        full = _agg(d, [COL["nombre"]], [COL["huella"], COL["inv"]])
        total = full[COL["huella"]].sum()
        full["% Huella"] = np.where(total, full[COL["huella"]] / total, 0.0)
        full["Intensidad implícita"] = np.where(
            full[COL["inv"]] != 0, full[COL["huella"]] / full[COL["inv"]], 0.0)
        full["Ranking"] = full[COL["huella"]].rank(ascending=False, method="first").astype(int)
        return full, full.head(top_n).reset_index(drop=True)

    # --------------------------------------------------------------------------
    # Charts nuevos — "mayores contribuyentes por AFP" (multicategory +
    # horizontal), acotados al universo AFO líquido de G&P:
    #   SBS_TIPO ∈ {Inter_AFO_FM, Local_AFO_FM, Local_AFO_ETF}
    #   Asset Class ∈ {Renta Fija, Renta Variable}
    # top_n generoso a nivel Python: el recorte final (top N por AFP en cada
    # chart) se hace en JS, así ambos charts pueden usar distinto N sin
    # tocar el pipeline.
    # --------------------------------------------------------------------------
    def contribuyentes_gyp_afp(self) -> pd.DataFrame:
        d = self.df[~self.df[COL["plus"]].isin(["Cash", "Cuestionario Integra"])]
        d = d[d["GyP_UNIVERSO_VALIDO"] == True] if "GyP_UNIVERSO_VALIDO" in d.columns else d.iloc[0:0]
        d = _sin_huella_cero(d)
        full = _agg(d, [COL["nombre"]], [COL["huella"], COL["intensidad"], COL["inv"]])
        if full.empty:
            return full
        full["Ranking"] = full[COL["huella"]].rank(ascending=False, method="first").astype(int)
        # Weight = Inv MM$ del emisor / AUM combinado F1+F2+F3 de la AFP en curso
        # (self.aum_total_mm ya llega así, ver ctx["aum_multifondos_mm"] en ambas rutas).
        full["Weight"] = (full[COL["inv"]] / self.aum_total_mm) if self.aum_total_mm else 0.0
        return full.reset_index(drop=True)

    def contribuyentes_intensidad_afp(self) -> pd.DataFrame:
        """Ranking de intensidad para Chart 2 horizontal: universo TD + BU
        (se excluyen Proxies, Cash, Cuestionario Integra, y GOB/SOB —
        soberanos ya tienen su propio chart dedicado). No filtra por
        GyP_UNIVERSO_VALIDO para no restringir a solo FM/ETF."""
        d = self.df[
            ~self.df[COL["plus"]].isin(["Cash", "Cuestionario Integra", "Proxies"])
            & ~self.df[COL["estrategia"]].isin(["GOB", "SOB"])
        ]
        d = _sin_huella_cero(d)
        full = _agg(d, [COL["nombre"]], [COL["huella"], COL["intensidad"], COL["inv"]])
        if full.empty:
            return full
        full["Ranking"] = full[COL["intensidad"]].rank(ascending=False, method="first").astype(int)
        full["Weight"] = (full[COL["inv"]] / self.aum_total_mm) if self.aum_total_mm else 0.0
        return full.reset_index(drop=True)

    def contribuyentes_esg_benchmark(self) -> pd.DataFrame:
        """Emisores con cobertura ESG propia (ISIN_Origen='VP' en BD1_S),
        ordenados por Intensidad desc. Incluye Weight para cálculo de
        benchmark en JS. Si ISIN_Origen no existe en el DataFrame (ruta
        Integra workbook), exporta todos los no-Cash como fallback."""
        d = self.df[~self.df[COL["plus"]].isin(["Cash", "Cuestionario Integra"])]
        # Solo universo BU
        if COL["estrategia"] in d.columns:
            d = d[d[COL["estrategia"]] == "BU"]
        # Solo VP (cobertura ESG propia, no proxy)
        if "ISIN_Origen" in d.columns:
            d = d[d["ISIN_Origen"] == "VP"]
        d = _sin_huella_cero(d)
        full = _agg(d, [COL["nombre"]], [COL["huella"], COL["intensidad"], COL["inv"]])
        if full.empty:
            return full
        full["Ranking"] = full[COL["intensidad"]].rank(ascending=False, method="first").astype(int)
        full["Weight"] = (full[COL["inv"]] / self.aum_total_mm) if self.aum_total_mm else 0.0
        return full.reset_index(drop=True)


    def top_por_subcat_asset(self) -> pd.DataFrame:
        """Top 5 FFMM/ETFs por Intensidad para Equities (RV) y Fixed Income (RF).
        Incluye SubCat (Mercado para RV, AC_Dir para RF), Mgmt, y benchmarks:
        Intensidad promedio cartera, F1, F2, F3, y el peer group cross-AFP
        (self.bench_peer_co2h, ver _peer_group_co2h)."""
        d = self.df.copy()
        if "GyP_UNIVERSO_VALIDO" not in d.columns:
            return pd.DataFrame()
        d = d[d["GyP_UNIVERSO_VALIDO"] == True]
        d = _sin_huella_cero(d)
        for c in [COL["intensidad"], COL["huella"], COL["inv"]]:
            d[c] = pd.to_numeric(d[c], errors="coerce").fillna(0.0)
        # Intensidad promedio por fondo (F1/F2/F3) y total: SUMA de la Intensidad
        # oficial por instrumento (CO2-H x Weight dentro de su propio fondo) —
        # la misma fórmula que usa cualquier otro objeto del pipeline. Antes se
        # recalculaba como Huella/Inv, una razón distinta a la métrica oficial.
        intens_total = float(d[COL["intensidad"]].sum())
        intens_por_fondo = {}
        if COL["portafolio"] in d.columns:
            for pf in ["IN-FONDO1", "IN-FONDO2", "IN-FONDO3"]:
                sf = d[d[COL["portafolio"]] == pf]
                intens_por_fondo[pf] = float(sf[COL["intensidad"]].sum())
        AC_MAP = {"Renta Variable": "Equities", "Renta Fija": "Fixed Income"}
        filas = []
        for ac_orig, bloque in AC_MAP.items():
            sub = d[d["GyP_ASSET_CLASS"] == ac_orig]
            if sub.empty:
                continue
            agg_df = _agg(sub, [COL["nombre"]], [COL["intensidad"], COL["inv"]])
            if agg_df.empty:
                continue
            for _, row in agg_df.head(5).iterrows():
                nombre = row[COL["nombre"]]
                top_rows = sub[sub[COL["nombre"]] == nombre]
                mgmt = "A"
                sc = ""
                if not top_rows.empty:
                    if "GyP_A_P" in top_rows.columns:
                        raw = str(top_rows["GyP_A_P"].iloc[0]).strip()
                        mgmt = raw if raw in ("A", "P") else "A"
                    sc = _subcat_activo(top_rows.iloc[0], bloque)
                # Weight "implícito" de X: se despeja de su propia Intensidad
                # oficial (Intensidad_X = CO2-H_X x Weight_X) en vez de
                # aproximarlo con Inv/AUM total cartera. Así el benchmark
                # ajustado queda exactamente en la misma base que la barra
                # que acompaña (y de paso, el benchmark FFMM:xxx puntual
                # que ya existía también queda más preciso, porque usa
                # este mismo Weight para escalar).
                co2h_val = 0.0
                if not top_rows.empty and "CO2-H" in top_rows.columns:
                    co2h_val = float(pd.to_numeric(
                        top_rows["CO2-H"], errors="coerce").fillna(0.0).iloc[0])
                intens_x = float(row[COL["intensidad"]])
                wt = (intens_x / co2h_val) if co2h_val else 0.0
                filas.append({
                    "Bloque": bloque, "SubCat": sc, "Mgmt": mgmt,
                    COL["nombre"]: nombre,
                    COL["intensidad"]: float(row[COL["intensidad"]]),
                    "Weight": float(wt),
                })
        out = pd.DataFrame(filas)
        if out.empty:
            return out
        # Codificar en DIM_2 = Mgmt|Nombre, DIM_3 = SubCat
        out["Mgmt_Nombre"] = out["Mgmt"] + "|" + out[COL["nombre"]]
        result = out[["Bloque", "Mgmt_Nombre", "SubCat", COL["intensidad"], "Weight"]].copy()
        # Filas especiales de benchmark
        benchmarks = [
            ("_BENCH_", "Total_Integra", intens_total),
            ("_BENCH_", "F1_Integra", intens_por_fondo.get("IN-FONDO1", 0.0)),
            ("_BENCH_", "F2_Integra", intens_por_fondo.get("IN-FONDO2", 0.0)),
            ("_BENCH_", "F3_Integra", intens_por_fondo.get("IN-FONDO3", 0.0)),
        ]
        bench_df = pd.DataFrame([{
            "Bloque": b, "Mgmt_Nombre": mn, "SubCat": "",
            COL["intensidad"]: v, "Weight": 0.0
        } for b, mn, v in benchmarks])
        # "Intensidad Promedio - Comparables" (ajustado): CO2-H promedio del
        # peer group cross-AFP. Se guarda SIN multiplicar por ningún Weight —
        # eso lo hace el dashboard (JS) usando el Weight propio del eje X.
        bench_subcat_df = pd.DataFrame([{
            "Bloque": "_BENCH_SUBCAT_", "Mgmt_Nombre": clave, "SubCat": "",
            COL["intensidad"]: val, "Weight": 0.0
        } for clave, val in self.bench_peer_co2h.items()])
        # "Benchmark sin ajustar Weight": Intensidad promedio del peer group
        # tal cual viene (con el Weight propio de cada comparable adentro,
        # sin homogeneizar). Un solo valor por SubCat, igual para toda barra
        # de ese grupo — el dashboard NO lo multiplica por nada.
        bench_subcat_unadj_df = pd.DataFrame([{
            "Bloque": "_BENCH_SUBCAT_UNADJ_", "Mgmt_Nombre": clave, "SubCat": "",
            COL["intensidad"]: val, "Weight": 0.0
        } for clave, val in self.bench_peer_intensidad.items()])
        return pd.concat([result, bench_df, bench_subcat_df, bench_subcat_unadj_df],
                          ignore_index=True)


