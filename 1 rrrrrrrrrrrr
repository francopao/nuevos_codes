            "Bloque": d["Bloque"],
            "SubCat": d["SubCat"],
            "Weight": d["Weight"] if "Weight" in d.columns else 0.0,
            "Huella": d[COL["huella"]] if COL["huella"] in d.columns else 0.0,
            "Intensidad": d[COL["intensidad"]] if COL["intensidad"] in d.columns else 0.0,
            "CO2-H": d["CO2-H"] if "CO2-H" in d.columns else 0.0,
            "Es_Proxy": d["Es_Proxy"],
            "CO2H_Fuente": d["CO2H_FUENTE"] if "CO2H_FUENTE" in d.columns else "?",
        }))
    if not filas:
        if verbose:
            print("  [Debug] Universo FFMM/ETF vacío, no se generó el Excel.")
        return None
    universo = pd.concat(filas, ignore_index=True)
    ruta = str(FsPath(output_dir) / "Universo_FFMM_ETF_Debug.xlsx")
    universo.to_excel(ruta, index=False, sheet_name="Universo")
    if verbose:
        print(f"  [Debug] Universo FFMM/ETF ({len(universo)} filas) -> {ruta}")
    return ruta




