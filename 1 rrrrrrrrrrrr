def _agregar_chart_sector(ws, bd: pd.DataFrame, metrica: str, corte_actual: str,
                           corte_comparacion: str, fila_max_bd: int) -> None:
    """Misma presentación de siempre (Materials/Utilities/Otros/RF/RV
    sólidos, Alts/Proxies rayado), pero la tabla-resumen ahora lee con
    SUMIFS desde 'BD' (Universo='Sector') en vez de una tabla local."""
    if bd.empty or fila_max_bd < 2:
        return
    d = bd[(bd["Universo"] == "Sector") & (bd["AFP"] == "Integra")
           & (bd["Corte"].isin([corte_actual, corte_comparacion]))]
    if d.empty:
        return
    tot_por_cat = d.groupby("Categoria")[metrica].sum()
    tipo_por_cat = d.groupby("Categoria")["Tipo_Dato"].first()
    categorias = [c for c in tot_por_cat.index if abs(tot_por_cat[c]) > 1e-9]
    categorias = sorted(categorias, key=lambda c: (
        CATEGORIAS_SECTOR.index(c) if c in CATEGORIAS_SECTOR else 99))
    if not categorias:
        return

    col_metrica = "R" if metrica == "Huella" else "S"
    col_label = ws.max_column + 2
