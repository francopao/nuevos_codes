        d["Es_Proxy"] = np.where(d[COL["plus"]] == "Proxies", "Sí", "No") \
            if COL["plus"] in d.columns else "?"
        filas.append(pd.DataFrame({
            "AFP": afp,
            "Portafolio": d[COL["portafolio"]] if COL["portafolio"] in d.columns else "",
            "CODIGO_SBS": d["CODIGO_SBS"] if "CODIGO_SBS" in d.columns else "",
