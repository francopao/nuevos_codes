## CAMBIO 2 — Reescribir `construir_chart1` (timeline por bloques)

**Buscar:** `def construir_chart1(df):`
Selecciona **toda la función**, hasta la línea `return dict(columnas=columnas, puntos=puntos)` (inclusive), y reemplázala por:

```python
def construir_chart1(df):
    """'Proyectos mineros': línea de tiempo horizontal por bloques (año de
    inicio de construcción), con burbujas coloreadas por categoría/etapa y
    un bloque agregado 'Por Definir' para proyectos sin fecha de inicio."""
    con_fecha, sin_fecha = [], []
    for _, r in df.iterrows():
        proyecto = str(r["proyecto"]).strip()
        if not proyecto or proyecto.lower() == "nan":
            continue
        anio = extraer_anio_inicio(r["inicio_fin"])
        capex = float(r["capex"]) if r["capex"] is not None and str(r["capex"]) != "nan" else 0.0
        categoria = clasificar_categoria(proyecto)
        etapa_grp = clasificar_etapa_grupo(str(r["etapa"]) if r["etapa"] is not None else "")
        item = dict(
            proyecto=proyecto,
            operador=str(r["operador"]) if r["operador"] is not None else "",
            departamento=str(r["departamento"]) if r["departamento"] is not None else "",
            producto=str(r["producto"]) if r["producto"] is not None else "",
            etapa=str(r["etapa"]) if r["etapa"] is not None else "",
            capex=round(capex, 1), categoria=categoria, etapa_grupo=etapa_grp,
            color=GRUPO_COLOR[(categoria, etapa_grp)],
        )
        if anio is not None:
            item["anio"] = anio
            con_fecha.append(item)
        else:
            sin_fecha.append(item)

    anios = sorted({it["anio"] for it in con_fecha})
    columnas = [str(a) for a in anios]
    if sin_fecha:
        columnas.append("Por Definir")

    max_dated = max([it["capex"] for it in con_fecha] + [0.1])
    agregado_capex = sum(it["capex"] for it in sin_fecha)
    max_global = max(max_dated, agregado_capex, 0.1)

    def size_px(capex_val):
        capex_val = max(capex_val, 0.1)
        return 22 + 58 * math.sqrt(capex_val / max_global)

    puntos = []
    for idx_col, col in enumerate(columnas):
        if col == "Por Definir":
            n = len(sin_fecha)
            puntos.append(dict(
                x=idx_col, y=0.0, size=size_px(agregado_capex),
                proyecto=f"{n} proyectos", operador="", departamento="",
                producto="", etapa="Por Definir", categoria="Por Definir",
                etapa_grupo="Por Definir",
                capex=round(agregado_capex, 1), agregado=True, n=n,
                color=COLOR_COMPS,
            ))
            continue
        items = [it for it in con_fecha if it["anio"] == int(col)]
        items.sort(key=lambda it: it["capex"], reverse=True)
        for k, it in enumerate(items):
            dx, dy = spiral_offset(k, spacing=0.30)
            puntos.append(dict(
                x=idx_col + dx, y=dy, size=size_px(it["capex"]),
                proyecto=it["proyecto"], operador=it["operador"],
                departamento=it["departamento"], producto=it["producto"],
                etapa=it["etapa"], categoria=it["categoria"],
                etapa_grupo=it["etapa_grupo"],
                capex=it["capex"], agregado=False,
                color=it["color"],
            ))

    log(f"Chart1 'Proyectos mineros': {len(puntos)} burbujas en "
        f"{len(columnas)} bloques temporales ({', '.join(columnas)}).")
    return dict(columnas=columnas, puntos=puntos)
```

