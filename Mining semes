def construir_chart5(df):
    """'Proyectos de energía renovable': mapa de Perú con los proyectos
    ubicados por departamento, coloreados por tecnología."""
    registros = []
    conteo_coord = {}
    omitidos = []
    for _, r in df.iterrows():
        proyecto = str(r["proyecto"]).strip()
        if not proyecto or proyecto.lower() == "nan":
            continue
        dpto = RENOVABLE_DPTO.get(proyecto, "Lima")
        coords = DEPTO_COORDS.get(dpto)
        if not coords:
            omitidos.append(proyecto)
            continue
        tecnologia = str(r["tecnologia"]).strip()
        k = conteo_coord.get(dpto, 0)
        conteo_coord[dpto] = k + 1
        jdx, jdy = spiral_offset(k, spacing=0.4)
        monto = float(r["monto"]) if r["monto"] is not None and str(r["monto"]) != "nan" else 0.0
        registros.append(dict(
            proyecto=proyecto,
            horizonte=str(r["horizonte"]) if r["horizonte"] is not None else "",
            tecnologia=tecnologia,
            empresa=str(r["empresa"]) if r["empresa"] is not None else "",
            monto=round(monto, 1),
            departamento=dpto,
            color=TECNOLOGIA_COLOR.get(tecnologia, "#8C8C8C"),
            lat=round(coords[0] + jdy * 0.06, 4),
            lon=round(coords[1] + jdx * 0.06, 4),
        ))
    if omitidos:
        warn(f"Chart5: {len(omitidos)} proyecto(s) sin departamento asignado: "
             f"{', '.join(omitidos)}")
    log(f"Chart5 'Proyectos de energía renovable': {len(registros)} proyectos ubicados.")
    return registros


# ------------------------------------------------------------------ CHART 6
def construir_chart6(df):
    """'Producción eléctrica': empresas ubicadas por macrozona, coloreadas
    según su fuente de generación dominante (Hidro/Termo/RER), más el
    resumen Hidro/Termo/RER promedio por macrozona."""
    registros = []
    conteo_coord = {}
    for _, r in df.iterrows():
        empresa = str(r["empresa"]).strip() if r["empresa"] is not None else ""
        if not empresa or empresa.lower() == "nan":
            continue
        macro = str(r["macrozona"]).strip()
        dpto = MACROZONA_DPTO.get(macro)
        coords = DEPTO_COORDS.get(dpto)
        if not coords:
            continue
        hidro = float(r["hidro_pct"] or 0)
        termo = float(r["termo_pct"] or 0)
        rer = float(r["rer_pct"] or 0)
        dominante = max([("Hidro", hidro), ("Termo", termo), ("RER", rer)],
                         key=lambda x: x[1])[0]
        k = conteo_coord.get(macro, 0)
        conteo_coord[macro] = k + 1
        jdx, jdy = spiral_offset(k, spacing=0.5)
        registros.append(dict(
            empresa=empresa, region=str(r["region"]) if r["region"] is not None else "",
            macrozona=macro, hidro=hidro, termo=termo, rer=rer,
            dominante=dominante, color=TIPO_COLOR[dominante],
            lat=round(coords[0] + jdy * 0.08, 4),
            lon=round(coords[1] + jdx * 0.08, 4),
        ))

    resumen = {}
    for macro in ["Norte", "Centro", "Sur"]:
        filas = [x for x in registros if x["macrozona"] == macro]
        if not filas:
            continue
        resumen[macro] = dict(
            hidro=round(sum(f["hidro"] for f in filas) / len(filas), 1),
            termo=round(sum(f["termo"] for f in filas) / len(filas), 1),
            rer=round(sum(f["rer"] for f in filas) / len(filas), 1),
            n=len(filas),
        )
    total_n = sum(v["n"] for v in resumen.values()) or 1
    distribucion = {m: round(100 * v["n"] / total_n, 1) for m, v in resumen.items()}

    log(f"Chart6 'Producción eléctrica': {len(registros)} empresas en "
        f"{len(resumen)} macrozonas.")
    return dict(empresas=registros, resumen=resumen, distribucion=distribucion)


