function renderChart1(){
  const c1 = PAYLOAD.chart1;
  const cols = c1.columnas;
  const pts = c1.puntos;

  const BANDA_A = "#EAF0F8", BANDA_B = "#F5F3EC";
  const shapes = [];
  cols.forEach((c,i)=>{
    shapes.push({ type:"rect", xref:"x", yref:"paper",
      x0:i-0.5, x1:i+0.5, y0:0, y1:1,
      fillcolor: c==="Por Definir" ? "#eef1f5" : (i%2===0 ? BANDA_A : BANDA_B),
      line:{width:0}, layer:"below" });
    if(i>0){
      shapes.push({ type:"line", xref:"x", yref:"paper",
        x0:i-0.5, x1:i-0.5, y0:0, y1:1,
        line:{color:"#c7cfdb", width:1, dash:"dot"}, layer:"below" });
    }
  });

  const grupos = {};
  pts.forEach(p=>{
    const key = p.categoria+"|"+p.etapa_grupo;
    (grupos[key]=grupos[key]||[]).push(p);
  });
  const traces = Object.keys(grupos).map(key=>{
    const arr = grupos[key];
    const [categoria, etapa] = key.split("|");
    return {
      type:"scatter", mode:"markers+text",
      x: arr.map(p=>p.x), y: arr.map(p=>p.y),
      name: categoria==="Por Definir" ? "Por Definir" : `${categoria} · ${etapa}`,
      text: arr.map(p=> p.agregado ? p.proyecto : `${shortNameProyecto(p.proyecto)}<br>US$ ${fmtMM(p.capex)} MM`),
      textposition:"middle center",
      textfont:{ size: arr.map(p=>Math.max(7, Math.min(10.5, p.size/7))), color:"#ffffff" },
      marker:{ size: arr.map(p=>p.size), color: arr[0].color,
               line:{color:"#ffffff", width:1.2}, opacity:0.94 },
      hovertemplate: arr.map(p=>
        p.agregado
          ? `<b>${p.proyecto}</b><br>CAPEX total: US$ ${fmtMM(p.capex)} MM<extra></extra>`
          : `<b>${p.proyecto}</b><br>${p.operador}<br>${p.departamento} · ${p.producto}<br>${p.etapa}<br>CAPEX: US$ ${fmtMM(p.capex)} MM<extra></extra>`
      )
    };
  });

  const layout = {
    margin:{l:20,r:20,t:6,b:44}, plot_bgcolor:"#fff", paper_bgcolor:"#fff",
    font:{ family:"Segoe UI, Arial", size:11, color:"#333" },
    showlegend:true,
    legend:{ orientation:"h", x:0.5, xanchor:"center", y:-0.18, font:{size:9.5} },
    shapes,
    xaxis:{ tickvals: cols.map((c,i)=>i), ticktext: cols,
            range:[-0.5, Math.max(cols.length-0.5, 0.5)], showgrid:false,
            zeroline:false, linecolor:"#7f8fa6", linewidth:2,
            tickfont:{size:12,color:"#1F3864"} },
    yaxis:{ visible:false, range:[-3.2,3.2] }
  };
  Plotly.newPlot("c1_plot", traces, layout, CFG);
}
