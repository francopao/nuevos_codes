#%%
def archivo_esta_bloqueado(ruta):
    """
    Prueba si el archivo puede abrirse en modo lectura/escritura.
    Si otro proceso (típicamente Excel) lo tiene abierto, Windows
    devuelve PermissionError al intentar abrirlo en modo 'r+b'.
    Si el archivo no existe todavía, no se considera "bloqueado".
    """
    if not os.path.isfile(ruta):
        return False
    try:
        with open(ruta, 'r+b'):
            pass
        return False
    except PermissionError:
        return True

def esperar_archivo_libre(ruta, intentos=6, espera_seg=10, avisar=True):
    """
    Reintenta hasta que el archivo deje de estar bloqueado (p. ej. mientras
    alguien lo tiene abierto en Excel, o mientras OneDrive/el share todavía
    retiene el lock tras una escritura anterior) o se agoten los intentos.
    Devuelve True si quedó libre, False si se agotaron los intentos.
    """
    for intento in range(1, intentos + 1):
        if not archivo_esta_bloqueado(ruta):
            return True
        if avisar:
            print(f"⚠ Archivo en uso/bloqueado: {ruta}")
            print(f"  Ciérralo si lo tienes abierto en Excel. "
                  f"Reintentando en {espera_seg}s... (intento {intento}/{intentos})")
        time.sleep(espera_seg)
    return not archivo_esta_bloqueado(ruta)

