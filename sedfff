        isin = df[self.isin_col].map(_to_string)
        df[V_AJ] = [self._lookup_id(self.intensidad_post, i, s) for i, s in zip(isin, sbs)]
        # Trazabilidad del origen del CO2-H (solo diagnóstico, no afecta
        # ningún cálculo): capturamos el estado ANTES de que Perdieron
        # Huella y la Herencia por Grupo Económico lo modifiquen.
        _co2h_ok_inicial = [v is not None and not (isinstance(v, float) and pd.isna(v))
                            for v in df[V_AJ].tolist()]
        _plus_inicial = [self._lookup_id(self.plus_lookup, i, s) for i, s in zip(isin, sbs)]
        self._apply_perdieron(df, isin, sbs)
        self._apply_inheritance(df)
        _heredados = set()
        if self.inherited_history is not None and not self.inherited_history.empty \
                and "ISIN_heredado" in self.inherited_history.columns:
            _heredados = set(self.inherited_history["ISIN_heredado"].astype(str))
        _fuente = []
        for k in range(len(df)):
            if _co2h_ok_inicial[k]:
                _fuente.append("Proxy" if _plus_inicial[k] == "Proxies" else "BD MSCI directa")
            elif bool(df["PERDIO_HUELLA"].iat[k]):
                _fuente.append("Perdieron Huella")
            elif isin.iat[k] in _heredados:
                _fuente.append("Herencia (Grupo Económico)")
            else:
                _fuente.append("Sin match")
        df["CO2H_FUENTE"] = _fuente
