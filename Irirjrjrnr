class MesOmitido(Exception):
    """Se usa para saltar un mes de forma controlada cuando ocurre un caso
    especial esperado (archivo faltante, mes sin datos, etc), sin que esto
    se confunda con un error real del codigo."""
    pass


def main(mes, anio, mes_, mapa_nombres, nombres_nuevos_globales):
    archivo = os.path.join(CARPETA_BD_MENSUAL, mes + anio + ".xlsx")
    print(f"Procesando {mes} {anio}. Archivo esperado: {archivo}")

    if not os.path.isfile(archivo):
        raise MesOmitido(f"No se encontro el archivo para {mes} {anio}. Se omite este mes y se continua con el siguiente.")

    BD = pd.read_excel(archivo, header=None)

    fila_encabezado = localizar_fila_encabezado(BD, columna=1, etiqueta="Empresa")
    if fila_encabezado is None:
        raise MesOmitido(f"No se encontro la fila de encabezado 'Empresa' en el archivo de {mes} {anio}. Revisa si el formato del reporte cambio este mes.")

    BD = BD.iloc[fila_encabezado:, 1:5].copy().reset_index(drop=True)

    Titulos = BD.iloc[0].tolist()
    BD = BD[1:]
    BD.columns = Titulos
    BD.columns = (pd.Index([str(c) for c in BD.columns])
                    .str.replace('\ufeff', '', regex=False)
                    .str.strip())

    BD_Fill = BD.ffill(axis=0)

    if len(BD_Fill) == 0:
        raise MesOmitido(f"El archivo de {mes} {anio} no trae ninguna empresa registrada debajo del encabezado. Puede ser un reporte todavia incompleto para ese mes. Se omite y se continua con el siguiente.")

    col_empresa = encontrar_columna(BD_Fill, 'Empresa')
    col_central = encontrar_columna(BD_Fill, 'Central')
    col_unidad = encontrar_columna(BD_Fill, 'Unidad')

    if not col_empresa or not col_central or not col_unidad:
        raise MesOmitido(f"No se encontraron las columnas Empresa, Central o Unidad en el archivo de {mes} {anio}. Columnas presentes: {list(BD_Fill.columns)}.")

    nombres_nuevos_de_este_mes = {}

    def dic_renombre_cambio(fila):
        clave = str(fila).strip()
        if clave in mapa_nombres:
            return mapa_nombres[clave]
        # Caso especial: nombre que todavia no existe en el diccionario.
        # En vez de detener todo el proceso, se registra con su mismo nombre
        # como valor temporal y se avisa para que alguien lo revise despues.
        mapa_nombres[clave] = clave
        nombres_nuevos_de_este_mes[clave] = clave
        nombres_nuevos_globales[clave] = clave
        return clave

    BD_Fill[col_empresa] = BD_Fill[col_empresa].apply(dic_renombre_cambio)
    BD_Fill[col_central] = BD_Fill[col_central].apply(dic_renombre_cambio)
    BD_Fill[col_unidad] = BD_Fill[col_unidad].apply(dic_renombre_cambio)

    if nombres_nuevos_de_este_mes:
        print(f"Se encontraron {len(nombres_nuevos_de_este_mes)} nombres que no estaban en el diccionario para {mes} {anio}: {list(nombres_nuevos_de_este_mes.keys())}. Se agregaron con el mismo nombre como valor temporal. Conviene revisarlos y asignarles el nombre estandarizado correcto.")

    Total = BD_Fill.copy()
    Total[col_central] = "TOTAL"
    Total[col_unidad] = "TOTAL"
    Total = Total.groupby([col_empresa, col_central, col_unidad], as_index=False).sum()

    TotalTotal = Total.copy()
    TotalTotal[col_empresa] = "MÁXIMA DEMANDA TOTAL"
    TotalTotal = TotalTotal.groupby([col_empresa, col_central, col_unidad], as_index=False).sum()

    BD_Fill = pd.concat([BD_Fill, Total, TotalTotal])

    fecha_col_str = "01/" + meses_n[meses_.index(mes_)] + "/" + anio
    fecha_col = datetime.datetime.strptime(fecha_col_str, '%d/%m/%Y')

    if len(BD_Fill.columns) >= 4:
        cols = list(BD_Fill.columns)
        cols[3] = fecha_col
        BD_Fill.columns = cols
    else:
        raise MesOmitido(f"El archivo de {mes} {anio} no tiene las cuatro columnas esperadas para asignarle la fecha. Columnas encontradas: {list(BD_Fill.columns)}.")

    # Antes esta suma de columnas fallaba cuando los tipos de datos quedaban
    # mezclados entre texto normal y texto vacio. Se fuerza aqui el mismo
    # tipo de dato en las tres columnas para que la union siempre funcione.
    key = (BD_Fill[col_empresa].astype(str)
           + BD_Fill[col_central].astype(str)
           + BD_Fill[col_unidad].astype(str))
    BD_Fill.insert(0, "Key1", key)
    DF_Max_Demanda = BD_Fill.copy()

    if not os.path.isfile(RUTA_BASE_HISTORICA):
        raise MesOmitido(f"No se encontro la base historica en {RUTA_BASE_HISTORICA}. No se puede actualizar {mes} {anio} sin esa base.")

    DF_F = DF_Max_Demanda.copy()

    with pd.ExcelFile(RUTA_BASE_HISTORICA) as lector:
        BD_Total = lector.parse(sheet_name='Sheet1')

    BD_Total_ = BD_Total.copy()
    BD_Total_['Indicador'] = 'Mapeado'
    BD_Total_ = BD_Total_.set_index("Key1")
    dic_Total_ = BD_Total_.to_dict()

    DF_Total2 = DF_F.copy()
    DF_Total2['Indicador'] = DF_Total2['Key1'].map(dic_Total_['Indicador'])
    DF_Total2 = DF_Total2.loc[DF_Total2['Indicador'].isin([np.nan])].sort_index(ignore_index=True)
    DF_Total2 = DF_Total2.drop(['Indicador'], axis=1)
    BD_Total = pd.concat([BD_Total, DF_Total2])

    DF_Total = DF_F.set_index("Key1")
    dic_cr = DF_Total.to_dict()
    BD_Total[fecha_col] = BD_Total['Key1'].map(dic_cr[fecha_col])

    with pd.ExcelWriter(RUTA_BASE_HISTORICA, mode="a", engine="openpyxl", if_sheet_exists='replace') as escritor:
        BD_Total.to_excel(escritor, sheet_name="Sheet1", index=False)

    print(f"{mes} {anio} actualizado correctamente en la base historica.")
    return nombres_nuevos_de_este_mes
