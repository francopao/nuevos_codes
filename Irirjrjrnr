def localizar_fila_encabezado(df, columna, etiqueta):
    """Busca la fila donde empieza la tabla real (la que tiene 'Empresa' como
    titulo) en lugar de asumir siempre la misma posicion fija. Cada reporte
    mensual puede traer una cantidad distinta de filas de resumen arriba,
    y por eso la posicion del encabezado puede moverse de un mes a otro."""
    objetivo = etiqueta.strip().lower()
    for idx in range(len(df)):
        valor = df.iat[idx, columna]
        if isinstance(valor, str) and valor.strip().lower() == objetivo:
            return idx
    return None


def encontrar_columna(df, objetivo):
    objetivo_norm = objetivo.strip().lower()
    cols_norm = {c: str(c).strip().lower().replace('\ufeff', '') for c in df.columns}
    for original, norm in cols_norm.items():
        if norm == objetivo_norm:
            return original
    for original, norm in cols_norm.items():
        if objetivo_norm in norm:
            print(f"Se esta usando la columna '{original}' como equivalente de '{objetivo}'.")
            return original
    return None


def cargar_diccionario(ruta_diccionario, hoja="Utilities"):
    df_ren = pd.read_excel(ruta_diccionario, sheet_name=hoja)
    mapa = df_ren.set_index("Nombre_Antiguo")["Nombre_Nuevo"].to_dict()
    return mapa


def guardar_diccionario(ruta_diccionario, hoja, mapa_nombres):
    """Escribe de vuelta el diccionario con los nombres nuevos ya incluidos,
    para que la proxima vez no haga falta abrirlo ni completarlo a mano.
    Si el guardado falla, el proceso principal no se detiene: simplemente
    esos nombres se volveran a detectar como nuevos la siguiente vez."""
    try:
        df_actualizado = pd.DataFrame({
            "Nombre_Antiguo": list(mapa_nombres.keys()),
            "Nombre_Nuevo": list(mapa_nombres.values()),
        })
        with pd.ExcelWriter(ruta_diccionario, mode="a", engine="openpyxl", if_sheet_exists="replace") as escritor:
            df_actualizado.to_excel(escritor, sheet_name=hoja, index=False)
        return True
    except Exception as error:
        print(f"No se pudo guardar el diccionario actualizado. Motivo: {error}. Esos nombres se detectaran de nuevo en la proxima ejecucion.")
        return False
