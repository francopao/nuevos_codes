def copiar_archivo_a_backup(origen, carpeta_destino):
    """Guarda una copia de seguridad antes de tocar la base historica.
    Si la unidad de red no esta disponible o el archivo no existe, se avisa
    y el proceso continua: un backup fallido no debe impedir la actualizacion."""
    try:
        if not os.path.isfile(origen):
            print(f"No se encontro el archivo a respaldar en {origen}. Se omite el backup y se continua con el proceso.")
            return False
        if not os.path.exists(carpeta_destino):
            os.makedirs(carpeta_destino)
        nombre_archivo = os.path.basename(origen)
        marca_tiempo = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        nombre_con_fecha = f"{os.path.splitext(nombre_archivo)[0]}_{marca_tiempo}{os.path.splitext(nombre_archivo)[1]}"
        destino = os.path.join(carpeta_destino, nombre_con_fecha)
        shutil.copyfile(origen, destino)
        print(f"Backup creado correctamente en {destino}.")
        return True
    except Exception as error:
        print(f"No se pudo crear el backup. Motivo: {error}. Se continua con el proceso de todas formas.")
        return False


