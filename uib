// --- Chart 4: "Emisores con cobertura ESG vs Benchmark" -------------------
// Barras horizontales = Intensidad de todos los emisores VP (cobertura propia).
// Marcadores = benchmark (FCE × weight) solo para los que tienen proxy en BU.
const EMISOR_PROXY = __EMISOR_PROXY__;

function _normName(s){
  return (s||'').replace(/\*+/g,'').replace(/\s+S\.A\..*$/i,'').replace(/\s+/g,' ').trim().toLowerCase();
}
function _findProxy(nombre){
  const ne = _normName(nombre);
  for(const k of Object.keys(EMISOR_PROXY)){
    const nk = _normName(k);
    if(ne===nk || ne.includes(nk) || nk.includes(ne)) return EMISOR_PROXY[k];
  }
  return null;
}

function emisoresEsgBenchmark(div, corte, afpSel){
  const afp = afpSel || 'Integra';
  const emisores = [];
  for(const r of HIST){
    if(r.OBJETO!=='Contrib_ESG_Benchmark' || String(r.FECHA_CORTE)!==String(corte) ||
       (r.AFP||'')!==afp) continue;
    if(!r.DIM_1) continue;
    let e = emisores.find(x=>x.nombre===r.DIM_1);
    if(!e){ e={nombre:r.DIM_1}; emisores.push(e); }
    if(r.METRICA==='Intensidad') e.intens = +r.VALOR||0;
    if(r.METRICA==='Weight') e.weight = +r.VALOR||0;
  }
  if(!emisores.length){
    document.getElementById(div).innerHTML=
      '<p style="color:#8A99A8;text-align:center">Sin emisores VP para '+afp+'</p>';
    return;
  }
  // Ordenar desc por Intensidad, top 10
  emisores.sort((a,b)=>(b.intens||0)-(a.intens||0));
  const top = emisores.slice(0, 10);
  const sorted = top.slice().reverse();
  const yNames = sorted.map(s=>s.nombre.replace(/\*+/g,'').trim());
  const xIntens = sorted.map(s=>s.intens||0);
  // Benchmark: solo para emisores que matchean en EMISOR_PROXY
  const xBench = sorted.map(s => {
    const proxy = _findProxy(s.nombre);
    if(!proxy) return null;
    return proxy.fce * (s.weight||0);
  });
  const colores = sorted.map((_,i) => P[i % P.length]);
  const traces = [
    {type:'bar', orientation:'h', name:'Intensidad emisor',
     x:xIntens, y:yNames, marker:{color:colores}, showlegend:false,
     text:xIntens.map(v=>v.toFixed(2)), textposition:'outside', cliponaxis:false,
     textfont:{size:10,color:CFG.color_texto}}
  ];
  // Marcadores de benchmark solo donde hay dato (no null)
  const benchX = [], benchY = [];
  xBench.forEach((v,i) => { if(v!==null){ benchX.push(v); benchY.push(yNames[i]); } });
  if(benchX.length){
    traces.push({type:'scatter', mode:'markers', name:'Benchmark',
     x:benchX, y:benchY,
     marker:{size:11, color:'#E74C3C', symbol:'circle',
             line:{width:1.5, color:'#fff'}},
     hovertemplate:'%{y}<br>Benchmark: %{x:.2f}<extra></extra>'});
  }
  const lay = LAYOUT();
  lay.yaxis = {type:'category', showgrid:false, showline:false, ticks:'',
               automargin:true, tickfont:{size:10}};
  lay.xaxis = {title:'Intensidad (Tn CO2 / USD MM)', showgrid:true,
               gridcolor:CFG.color_grid, zeroline:true};
  lay.legend = {orientation:'h', yanchor:'bottom', y:1.05, x:0, bgcolor:'rgba(0,0,0,0)'};
  lay.margin = {l:200, r:60, t:55, b:45};
  lay.height = Math.max(CFG.alto, sorted.length*28 + 100);
  Plotly.react(div, traces, lay, OPTS);
}
```

**Resumen del problema raíz**: el filtro anterior (`Plus != 'Proxies'`) era incorrecto porque `Plus` indica el *método de cálculo en la Valorización*, no si el emisor tiene cobertura ESG propia. Un emisor con cobertura ESG propia (como Ferreyros) podía tener `Plus='Portafolio'` o `Plus='Proxies'` dependiendo de cómo se procesó. El campo correcto es `ISIN_Origen='VP'` que viene directamente de BD1_S y significa que los datos ESG del instrumento vinieron del proveedor (MSCI) y no de un proxy sectorial. Con este cambio, los ~245 emisores únicos VP de Integra ya están disponibles para el chart (top 10 por Intensidad), y los marcadores de benchmark aparecen solo en los que además tienen un proxy asignado en la hoja BU de Lista Proxies.
