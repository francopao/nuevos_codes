Private Function ExpandirFormula(ByVal frm As String, ByVal re As Object, _
    ByVal wsData As Worksheet, ByVal lastCol As Long, ByVal lastColLetter As String, _
    ByRef huboCambio As Boolean, ByRef huboOmision As Boolean) As String

    Dim mc As Object
    Dim m As Object
    Dim resultado As String
    Dim fila As Long
    Dim k As Long
    Dim nuevoTrozo As String

    resultado = frm
    huboCambio = False
    huboOmision = False

    Set mc = re.Execute(frm)
    If mc.Count = 0 Then
        ExpandirFormula = frm
        Exit Function
    End If

    For k = mc.Count - 1 To 0 Step -1
        Set m = mc(k)
        fila = 0
        On Error Resume Next
        fila = CLng(Mid(m.SubMatches(1), 2))
        On Error GoTo 0

        If fila > 0 And Not IsEmpty(wsData.Cells(fila, lastCol).Value) Then
            nuevoTrozo = m.SubMatches(0) & lastColLetter & m.SubMatches(1)
            resultado = Left(resultado, m.FirstIndex) & nuevoTrozo & Mid(resultado, m.FirstIndex + m.Length + 1)
            huboCambio = True
        Else
            huboOmision = True
        End If
    Next k

    ExpandirFormula = resultado

End Function

Sub Restaurar_Ultimo_Backup()

    Dim wsPER As Worksheet
    Dim wsBackup As Worksheet
    Dim ws As Worksheet
    Dim ultimoBackup As Worksheet
    Dim r As Long
    Dim nombreChart As String
    Dim idxSerie As Long
    Dim formulaOriginal As String

    On Error GoTo ErrHandler

    For Each ws In ThisWorkbook.Sheets
        If Left(ws.Name, 4) = "Bkp_" Then
            If ultimoBackup Is Nothing Then
                Set ultimoBackup = ws
            ElseIf ws.Name > ultimoBackup.Name Then
                Set ultimoBackup = ws
            End If
        End If
    Next ws

    If ultimoBackup Is Nothing Then
        MsgBox "No se encontró ninguna hoja de backup.", vbExclamation
        Exit Sub
    End If

    Set wsPER = ThisWorkbook.Sheets("PER")
    Set wsBackup = ultimoBackup

    r = 2
    Do While wsBackup.Cells(r, 1).Value <> ""
        nombreChart = wsBackup.Cells(r, 1).Value
        idxSerie = wsBackup.Cells(r, 2).Value
        formulaOriginal = wsBackup.Cells(r, 3).Value

        On Error Resume Next
        wsPER.ChartObjects(nombreChart).Chart.SeriesCollection(idxSerie).Formula = formulaOriginal
        On Error GoTo ErrHandler

        r = r + 1
    Loop

    MsgBox "Restauración completada desde: " & wsBackup.Name, vbInformation
    Exit Sub

ErrHandler:
    MsgBox "Error al restaurar: " & Err.Description, vbCritical

End Sub
